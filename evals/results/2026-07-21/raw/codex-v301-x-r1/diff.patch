 """Small public text helpers."""
 
 
+def _normalized_words(value: str) -> list[str]:
+    """Return case-folded words split on Unicode whitespace."""
+    return value.casefold().split()
+
+
 def slugify(value: str) -> str:
     """Return a lowercase, hyphen-separated slug."""
-    return "-".join(value.strip().lower().split())
+    return "-".join(_normalized_words(value))
 
 
 def tag_key(value: str) -> str:
     """Return a lowercase, underscore-separated tag key."""
-    return "_".join(value.strip().lower().split())
