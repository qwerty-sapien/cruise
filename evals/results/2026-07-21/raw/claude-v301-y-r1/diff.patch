 """Small public text helpers."""
 
+import unicodedata
+
+
+def _normalize_words(value: str) -> list[str]:
+    """Casefold and split into words, Unicode whitespace aware."""
+    normalized = unicodedata.normalize("NFKC", value)
+    return normalized.casefold().split()
+
 
 def slugify(value: str) -> str:
     """Return a lowercase, hyphen-separated slug."""
-    return "-".join(value.strip().lower().split())
+    return "-".join(_normalize_words(value))
 
 
 def tag_key(value: str) -> str:
     """Return a lowercase, underscore-separated tag key."""
-    return "_".join(value.strip().lower().split())
+    return "_".join(_normalize_words(value))
