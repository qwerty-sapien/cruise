+    def test_slugify_handles_mixed_unicode_whitespace(self):
+        #   (nbsp),   (em space), 　 (ideographic space), \t, \n
+        value = " Hello WORLD　Foo\tBar\n"
+        self.assertEqual(slugify(value), "hello-world-foo-bar")
+
+    def test_tag_key_handles_mixed_unicode_whitespace(self):
+        value = " Hello WORLD　Foo\tBar\n"
+        self.assertEqual(tag_key(value), "hello_world_foo_bar")
+
+    def test_slugify_handles_unicode_casing(self):
+        # German sharp s (ß) casefolds to "ss"; Turkish İ folds via NFKC+casefold
+        self.assertEqual(slugify("STRASSE Straße"), "strasse-strasse")
+        self.assertEqual(slugify("İstanbul"), "i̇stanbul")
+
+    def test_tag_key_handles_unicode_casing(self):
+        self.assertEqual(tag_key("STRASSE Straße"), "strasse_strasse")
+
 
 if __name__ == "__main__":
     unittest.main()
