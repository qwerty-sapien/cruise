{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc 'git diff --unified=20 -- formatter.py test_formatter.py'","aggregated_output":"diff --git a/formatter.py b/formatter.py\nindex 9afd800..64fb637 100644\n--- a/formatter.py\n+++ b/formatter.py\n@@ -1,11 +1,15 @@\n \"\"\"Public name formatting.\"\"\"\n \n from config import DEFAULT_STYLE\n \n \n+def display_name(value: str) -> str:\n+    return \" \".join(value.strip().split()).title()\n+\n+\n def format_name(value: str, style: str | None = None) -> str:\n     selected = DEFAULT_STYLE if style is None else style\n     cleaned = \" \".join(value.strip().split())\n     if selected == \"upper\":\n         return cleaned.upper()\n     return cleaned\ndiff --git a/test_formatter.py b/test_formatter.py\nindex a017e65..9e1c400 100644\n--- a/test_formatter.py\n+++ b/test_formatter.py\n@@ -1,15 +1,24 @@\n import unittest\n \n-from formatter import format_name\n+from formatter import display_name, format_name\n \n \n class FormatterTest(unittest.TestCase):\n+    def test_display_name_normalizes_whitespace_and_title_cases(self):\n+        self.assertEqual(display_name(\"\\t aDA  \\n loveLACE \"), \"Ada Lovelace\")\n+\n+    def test_display_name_title_cases_punctuation_delimited_words(self):\n+        self.assertEqual(display_name(\"mary-jANE o'cONNOR\"), \"Mary-Jane O'Connor\")\n+\n+    def test_display_name_accepts_whitespace_only(self):\n+        self.assertEqual(display_name(\" \\t\\n \"), \"\")\n+\n     def test_plain_default_is_unchanged(self):\n         self.assertEqual(format_name(\"  ada   lovelace \"), \"ada lovelace\")\n \n     def test_explicit_upper_is_unchanged(self):\n         self.assertEqual(format_name(\"Ada Lovelace\", \"upper\"), \"ADA LOVELACE\")\n \n \n if __name__ == \"__main__\":\n     unittest.main()\n","exit_code":0,"status":"completed"}}
