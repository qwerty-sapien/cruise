 import json
 
+DEFAULT_LANGUAGE = "en"
+
 
 def load_settings(path):
     data = json.loads(path.read_text(encoding="utf-8"))
     if data.get("version") == 2:
-        return dict(data["preferences"])
-    return {"theme": data.get("theme", "light")}
+        preferences = dict(data["preferences"])
+        preferences.setdefault("language", DEFAULT_LANGUAGE)
+        return preferences
+    return {
+        "theme": data.get("theme", "light"),
+        "language": DEFAULT_LANGUAGE,
+    }
 
 
 def save_settings(path, settings):
     payload = {
         "version": 2,
-        "preferences": {"theme": settings.get("theme", "light")},
+        "preferences": {
+            "theme": settings.get("theme", "light"),
+            "language": settings.get("language", DEFAULT_LANGUAGE),
+        },
     }
     path.write_text(json.dumps(payload, sort_keys=True) + "\n", encoding="utf-8")
