+++++++++++++++++++++---\\n skills/build/SKILL.md     |  16 +++-\\n tests/claude-cli.test.mjs |   1 +\\n tests/cli-simple.test.mjs |  17 +++++\\n tests/queue.test.mjs      | 152 +++++++++++++++++++++++++++++++++++-\\n 6 files changed, 401 insertions(+), 25 deletions(-)\\ndiff --git a/README.md b/README.md\\nindex cb7edd6..9f08f1f 100644\\n--- a/README.md\\n+++ b/README.md\\n@@ -5,16 +5,17 @@ launcher. The same five intent-based skills run natively on Codex and Claude\\n Code while each host keeps its own permissions, models, session controls, and\\n agent plumbing.\\n \\n-Cruise records the exact terminal request in `.cruise/ORIGIN.md`. Goal runs\\n-also maintain the advisory `.cruise/FLIGHT.md` described below. Neither file\\n-is an approval or source of authority, and Cruise does not create a parallel\\n-workflow database, approval ledger, archive, or run directory.\\n+Cruise records an exact terminal skill request in `.cruise/ORIGIN.md`. Build\\n+can compile an advisory `.cruise/QUEUE.md`, and each Goal run maintains the\\n+advisory `.cruise/FLIGHT.md` described below. None is an approval or source of\\n+authority, and Cruise does not create a parallel workflow database, approval\\n+ledger, archive, or run directory.\\n \\n ## Choose a skill\\n \\n | Skill | Use it when |\\n | --- | --- |\\n-| `build` | You need to shape a project or milestone before implementation. |\\n+| `build` | You need to clarify a project and compile goal-sized milestones before implementation. |\\n | `quick` | The requested change is small, understood, and low risk. |\\n | `refine` | The outcome is finite but needs a short plan first. |\\n | `goal` | The work is consequential or multi-step and should run to completion. |\\n@@ -35,6 +36,19 @@ and k<truncated omitted_approx_tokens=\\\"6447\\\" />r: 'claude' }, {\\n+      output: { write() {} },\\n+      async milestoneRunner({ milestone }) {\\n+        calls.push(milestone.id);\\n+        return { status: 'blocked', reason: 'material user decision required' };\\n+      },\\n+    });\\n+    assert.equal(exitCode, 2);\\n+    assert.deepEqual(calls, ['M1']);\\n+    assert.deepEqual((await readQueue(cwd)).milestones.map(({ status }) => status), ['blocked', 'pending']);\\n+  } finally {\\n+    await rm(cwd, { recursive: true, force: true });\\n+  }\\n+});\\n+\\n+test('queue run records flight compilation failures instead of leaving active state', async () => {\\n+  const cwd = await mkdtemp(join(tmpdir(), 'cruise-queue-run-compile-failure-'));\\n+  try {\\n+    await writeQueue(cwd, projectQueue());\\n+    let ran = false;\\n+    const exitCode = await runQueue({ cwd, provider: 'codex' }, {\\n+      output: { write() {} },\\n+      async flightWriter() { throw new Error('FLIGHT.md is not writable'); },\\n+      async milestoneRunner() { ran = true; return { status: 'complete' }; },\\n+    });\\n+    assert.equal(exitCode, 2);\\n+    assert.equal(ran, false);\\n+    assert.equal((await readQueue(cwd)).milestones[0].status, 'blocked');\\n+  } finally {\\n+    await rm(cwd, { recursive: true, force: true });\\n+  }\\n+});\\n+\\n+test('the real queue Goal adapter uses the Claude flight status as its terminal handshake', async () => {\\n+  const base = {\\n+    cwd: '/workspace',\\n+    provider: 'claude',\\n+    milestone: { id: 'M1' },\\n+    prompt: 'Run M1.',\\n+  };\\n+  const goalRunner = async () => ({ status: 'complete', exitCode: 0 });\\n+  assert.equal((await runQueueGoal(base, {\\n+    goalRunner,\\n+    flightReader: async () => ({ status: 'active' }),\\n+  })).status, 'stalled');\\n+  assert.equal((await runQueueGoal(base, {\\n+    goalRunner,\\n+    flightReader: async () => ({ status: 'blocked' }),\\n+  })).status, 'blocked');\\n+  assert.equal((await runQueueGoal(base, {\\n+    goalRunner,\\n+    flightReader: async () => ({ status: 'complete' }),\\n+  })).status, 'complete');\\n+});\\n\\n\"},{\"type\":\"input_text\",\"text\":\"\\n[116] tool wait_agent call: {\\\"timeout_ms\\\":30000}\\n\"},{\"t