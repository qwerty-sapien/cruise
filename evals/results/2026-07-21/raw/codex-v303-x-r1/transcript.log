20\\t  let output;\\n   421\\t  if (state.ladder === 'stalled') {\\n   422\\t    output = { systemMessage: stallMessage(state, observation.reason) };\\n   423\\t  } else if (state.blocks_in_cycle >= blockCap) {\\n   424\\t    state.ladder = 'stalled';\\n   425\\t    output = { systemMessage: stallMessage(state, observation.reason, true) };\\n   426\\t  } else if (state.ladder === 'realign') {\\n   427\\t    state.ladder = 'final';\\n   428\\t    state.blocks_in_cycle += 1;\\n   429\\t    state.interventions.push({ level: 'final-experiment', at: now, reason: observation.reason });\\n   430\\t    output = { decision: 'block', reason: finalReason(observation.reason) };\\n   431\\t  } else if (state.ladder === 'final') {\\n   432\\t    state.ladder = 'stalled';\\n   433\\t    output = { systemMessage: stallMessage(state, observation.reason) };\\n   434\\t  } else if (\\n   435\\t    state.quiet_stops >= flight.stall.quietTurns ||\\n   436\\t    state.same_failure >= flight.stall.sameFailure\\n   437\\t  ) {\\n   438\\t    state.ladder = 'realign';\\n   439\\t    state.blocks_in_cycle += 1;\\n   440\\t    state.interventions.push({ level: 'realign', at: now, reason: observation.reason });\\n   441\\t    output = { decision: 'block', reason: realignReason(observation.reason) };\\n   442\\t  } else {\\n   443\\t    state.blocks_in_cycle += 1;\\n   444\\t    output = { decision: 'block', reason: standardReason(observation.reason) };\\n   445\\t  }\\n   446\\t  await writeState(directory, state);\\n   447\\t  return output;\\n   448\\t}\\n   449\\t\\n   450\\tasync function readInput(stream) {\\n   451\\t  let text = '';\\n   452\\t  for await (const chunk of stream) {\\n   453\\t    text += chunk;\\n   454\\t    if (text.length > 1_000_000) throw new Error('hook input exceeds 1 MB');\\n   455\\t  }\\n   456\\t  return JSON.parse(text);\\n   457\\t}\\n   458\\t\\n   459\\texport async function main({ input = process.stdin, output = process.stdout } = {}) {\\n   460\\t  try {\\n   461\\t    const result = await runStopSupervisor(await readInput(input));\\n   462\\t    if (result) output.write(JSON.stringify(result));\\n   463\\t  } catch (error) {\\n   464\\t    output.write(JSON.stringify({\\n   465\\t      systemMessage: `Cruise Goal stop supervisor failed open: ${cleanMessage(error?.message)}. The stop was allowed; delete .cruise/.supervisor.json if its scratch state is damaged.`,\\n   466\\t    }));\\n   467\\t  }\\n   468\\t  return 0;\\n   469\\t}\\n   470\\t\\n   471\\tconst invoked = process.argv[1] ? resolve(process.argv[1]) : null;\\n   472\\tif (invoked === fileURLToPath(import.meta.url)) process.exitCode = await main();\\n     1\\timport assert from 'node:assert/strict';\\n     2\\timport { mkdtemp, mkdir, readFile, readdir, rm, symlink, utimes, writeFile } from 'node:fs/promises';\\n     3\\timport { tmpdir } from 'node:os';\\n     4\\timport { join, resolve } from 'node:path';\\n     5\\timport { spawnSync } from 'node:child_process';\\n     6\\timport test from 'node:test';\\n     7\\t\\n     8\\timport { parseHookFlightPlan } from '../hooks/stop-supervisor.mjs';\\n     9\\t\\n    10\\tconst HOOK = resolve('hooks/stop-supervisor.mjs');\\n    11\\t\\n    12\\tfunction flight({ status = 'active', quietTurns = 1, sameFailure = 9, outcome = 'Finish safely' } = {}) {\\n    13\\t  return `---\\n    14\\tversion: 1\\n    15\\tstatus: ${status}\\n    16\\toutcome: ${outcome}\\n    17\\tstall:\\n    18\\t  quiet_turns: ${quietTurns}\\n    19\\t  same_failure: ${sameFailure}\\n    20\\t---\\n    21\\t# Flight plan\\n    22\\t`;\\n    23\\t}\\n    24\\t\\n    25\\tasync function fixture(options = {}) {\\n    26\\t  const cwd = await mkdtemp(join(tmpdir(), 'cruise-stop-hook-'));\\n    27\\t  await mkdir(join(cwd, '.cruise'));\\n    28\\t  if (options.withFlight !== false) {\\n    29\\t    await writeFile(join(cwd, '.cruise', 'FLIGHT.md'), flight(options), 'utf8');\\n    30\\t  }\\n    31\\t  if (options.git !== false) {\\n    32\\t    const initialized = spawnSync('git', ['init', '--quiet'], { cwd, encoding: 'utf8' });\\n    33\\t    assert.equal(initialized.status, 0, initialized.stderr);\\n    34\\t  }\\n    35\\t  return cwd;\\n    36\\t}\\n    37\\t\\n    38\\tfunction invoke(cwd, overrides = {}, { goalSession = true } = {}) {\\n    39\\t  const input = {\\n    40\\t    session_id: 'fixture-session',\\n    41\\t    transcript_path: join(cwd, 'transcript.jsonl'),\\n    42\\t    cwd,\\n    43\\t    permission_mode: 'default',\\n    44\\t    hook_event_name: 'Stop',\\n    45\\t    stop_hook_active: false,\\n    46\\t    last_assistant_message: 'Implemented the next step.',\\n    47\\t    ...overrides,\\n    48\\t  };\\n    49\\t  const env = { ...process.env };\\n    50\\t  if (goalSession) env.CRUISE_CLAUDE_GOAL = '1';\\n    51\\t  else delete env.CRUISE_CLAUDE_GOAL;\\n    52\\t  const result = spawnSync(process.execPath, [HOOK], {\\n    53\\t    input: JSON.stringify(input),\\n    54\\t    encoding: 'utf8',\\n    55\\t    timeout: 10_000,\\n    56\\t    env,\\n    57\\t  });\\n    58\\t  assert.equal(result.status, 0, result.stderr);\\n    59\\t  return result.stdout ? JSON.parse(result.stdout) : null;\\n    60\\t}\\n    61\\t\\n    62\\ttest('quiet evidence climbs through continuation, realignment, final experiment, then bounded allow', async () => {\\n    63\\t  const cwd = await fixture({ quietTurns: 1 });\\n    64\\t  try {\\n    65\\t    const outputs = [invoke(cwd), invoke(cwd), invoke(cwd), invoke(cwd)];\\n    66\\t    assert.equal(outputs[0].decision, 'block');\\n    67\\t    assert.match(outputs[0].reason, /Continue the active Goal/u);\\n    68\\t    assert.equal(outputs[1].decision, 'block');\\n    69\\t    assert.match(outputs[1].reason, /realignment|non-progress/iu);\\n    70\\t    assert.equal(outputs[2].decision, 'block');\\n    71\\t    assert.match(outputs[2].reason, /final supervised continuation/iu);\\n    72\\t    assert.equal(outputs[3].decision, undefined);\\n    73\\t    assert.match(outputs[3].systemMessage, /allowed this stop/iu);\\n    74\\t    assert.match(outputs[3].systemMessage, /Interventions attempted: realign, final-experiment/u);\\n    75\\t\\n    76\\t    const state = JSON.parse(await readFile(join(cwd, '.cruise', '.supervisor.json'), 'utf8'));\\n    77\\t    assert.equal(state.blocks_in_cycle, 3, 'quiet_turns + 2 is the hard block cap');\\n    78\\t    assert.equal(state.ladder, 'stalled');\\n    79\\t    assert.match(await readFile(join(cwd, '.cruise', '.gitignore'), 'utf8'), /^\\\\.supervisor\\\\.json$/mu);\\n    80\\t  } finally {\\n    81\\t    await rm(cwd, { recursive: true, force: true });\\n    82\\t  }\\n    83\\t});\\n    84\\t\\n    85\\ttest('missing, complete, and blocked flight plans leave non-active sessions inert', async () => {\\n    86\\t  for (const options of [{ withFlight: false }, { status: 'complete' }, { status: 'blocked' }]) {\\n    87\\t    const cwd = await fixture(options);\\n    88\\t    try {\\n    89\\t      assert.equal(invoke(cwd), null);\\n    90\\t      await assert.rejects(readFile(join(cwd, '.cruise', '.supervisor.json'), 'utf8'), { code: 'ENOENT' });\\n    91\\t    } finally {\\n    92\\t      await rm(cwd, { recursive: true, force: true });\\n    93\\t    }\\n    94\\t  }\\n    95\\t});\\n    96\\t\\n    97\\ttest('a fresh active plan is inert outside a launcher-marked Goal session', async () => {\\n    98\\t  const cwd = await fixture();\\n    99\\t  try {\\n   100\\t    assert.equal(invoke(cwd, {}, { goalSession: false }), null);\\n   101\\t    await assert.rejects(readFile(join(cwd, '.cruise', '.supervisor.json'), 'utf8'), { code: 'ENOENT' });\\n   102\\t  } finally {\\n   103\\t    await rm(cwd, { recursive: true, force: true });\\n   104\\t  }\\n   105\\t});\\n   106\\t\\n   107\\ttest('an active flight plan older than 48 hours is inert', async () => {\\n   108\\t  const cwd = await fixture();\\n   109\\t  try {\\n   110\\t    const stale = new Date(Date.now() - (49 * 60 * 60 * 1_000));\\n   111\\t    await utimes(join(cwd, '.cruise', 'FLIGHT.md'), stale, stale);\\n   112\\t    assert.equal(invoke(cwd), null);\\n   113\\t    await assert.rejects(readFile(join(cwd, '.cruise', '.supervisor.json'), 'utf8'), { code: 'ENOENT' });\\n   114\\t  } finally {\\n   115\\t    await rm(cwd, { recursive: true, force: true });\\n   116\\t  }\\n   117\\t});\\n   118\\t\\n   119\\ttest('changing flight-plan frontmatter resets the supervision cycle', async () => {\\n   120\\t  const cwd = await fixture({ quietTurns: 1, outcome: 'First outcome' });\\n   121\\t  try {\\n   122\\t    const first = invoke(cwd);\\n   123\\t    assert.match(first.reason, /baseline fingerprint/u);\\n   124\\t    await writeFile(\\n   125\\t      join(cwd, '.cruise', 'FLIGHT.md'),\\n   126\\t      flight({ quietTurns: 1, outcome: 'Realigned outcome' }),\\n   127\\t      'utf8',\\n   128\\t    );\\n   129\\t    const afterChange = invoke(cwd);\\n   130\\t    assert.equal(afterChange.decision, 'block');\\n   131\\t    assert.match(afterChange.reason, /baseline fingerprint/u);\\n   132\\t    assert.doesNotMatch(afterChange.reason, /non-progress/u);\\n   133\\t    const state = JSON.parse(await readFile(join(cwd, '.cruise', '.supervisor.json'), 'utf8'));\\n   134\\t    assert.equal(state.blocks_in_cycle, 1);\\n   135\\t    assert.equal(state.turns_observed, 1);\\n   136\\t  } finally {\\n   137\\t    await rm(cwd, { recursive: true, force: true });\\n   138\\t  }\\n   139\\t});\\n   140\\t\\n   141\\ttest('new workspace evidence restarts supervision after a stall report', async () => {\\n   142\\t  const cwd = await fixture({ quietTurns: 1 });\\n   143\\t  try {\\n   144\\t    invoke(cwd);\\n   145\\t    invoke(cwd);\\n   146\\t    invoke(cwd);\\n   147\\t    assert.match(invoke(cwd).systemMessage, /allowed this stop/iu);\\n   148\\t    await writeFile(join(cwd, 'new-evidence.txt'), 'material delta\\\\n', 'utf8');\\n   149\\t    const resumed = invoke(cwd);\\n   150\\t    assert.equal(resumed.decision, 'block');\\n   151\\t    assert.match(resumed.reason, /new fingerprint/u);\\n   152\\t    const state = JSON.parse(await readFile(join(cwd, '.cruise', '.supervisor.json'), 'utf8'));\\n   153\\t    assert.equal(state.ladder, 'normal');\\n   154\\t    assert.equal(state.blocks_in_cycle, 1);\\n   155\\t  } finally {\\n   156\\t    await rm(cwd, { recursive: true, force: true });\\n   157\\t  }\\n   158\\t});\\n   159\\t\\n   160\\ttest('same normalized failure can trigger realignment without git evidence', async () => {\\n   161\\t  const cwd = await fixture({ git: false, quietTurns: 9, sameFailure: 2 });\\n   162\\t  try {\\n   163\\t    assert.match(invoke(cwd, { last_assistant_message: 'Error: failed at /tmp/a.js:12' }).reason, /Continue/u);\\n   164\\t    const repeated = invoke(cwd, { last_assistant_message: 'ERROR: failed at /work/b.js:98' });\\n   165\\t    assert.equal(repeated.decision, 'block');\\n   166\\t    assert.match(repeated.reason, /non-progress/u);\\n   167\\t    assert.match(repeated.reason, /failure signature [a-f\\\\d]{12} repeated 2 consecutive stops/u);\\n   168\\t  } finally {\\n   169\\t    await rm(cwd, { recursive: true, force: true });\\n   170\\t  }\\n   171\\t});\\n   172\\t\\n   173\\ttest('corrupt scratch state fails open with an allow report and exit zero', async () => {\\n   174\\t  const cwd = await fixture();\\n   175\\t  try {\\n   176\\t    assert.equal(invoke(cwd).decision, 'block');\\n   177\\t    await writeFile(join(cwd, '.cruise', '.supervisor.json'), '{not-json', 'utf8');\\n   178\\t    const output = invoke(cwd);\\n   179\\t    assert.equal(output.decision, undefined);\\n   180\\t    assert.match(output.systemMessage, /failed open/iu);\\n   181\\t    assert.match(output.systemMessage, /stop was allowed/iu);\\n   182\\t  } finally {\\n   183\\t    await rm(cwd, { recursive: true, force: true });\\n   184\\t  }\\n   185\\t});\\n   186\\t\\n   187\\ttest('a symlinked scratch directory fails open without writing through it', async () => {\\n   188\\t  const cwd = await mkdtemp(join(tmpdir(), 'cruise-stop-link-cwd-'));\\n   189\\t  const outside = await mkdtemp(join(tmpdir(), 'cruise-stop-link-target-'));\\n   190\\t  try {\\n   191\\t    await writeFile(join(outside, 'FLIGHT.md'), flight(), 'utf8');\\n   192\\t    await symlink(outside, join(cwd, '.cruise'), 'dir');\\n   193\\t    const output = invoke(cwd);\\n   194\\t    assert.equal(output.decision, undefined);\\n   195\\t    assert.match(output.systemMessage, /failed open/iu);\\n   196\\t    assert.deepEqual(await readdir(outside), ['FLIGHT.md']);\\n   197\\t  } finally {\\n   198\\t    await rm(cwd, { recursive: true, force: true });\\n   199\\t    await rm(outside, { recursive: true, force: true });\\n   200\\t  }\\n   201\\t});\\n   202\\t\\n   203\\ttest('hook registration uses the standalone plugin-root command form', async () => {\\n   204\\t  const registration = JSON.parse(await readFile(resolve('hooks/hooks.json'), 'utf8'));\\n   205\\t  const command = registration.hooks.Stop[0].hooks[0];\\n   206\\t  assert.deepEqual(command, {\\n   207\\t    type: 'command',\\n   208\\t    command: 'node',\\n   209\\t    args: ['${CLAUDE_PLUGIN_ROOT}/hooks/stop-supervisor.mjs'],\\n   210\\t    timeout: 30,\\n   211\\t  });\\n   212\\t});\\n   213\\t\\n   214\\ttest('unsafe stall integers fall back instead of defeating the block cap', () => {\\n   215\\t  const plan = parseHookFlightPlan(`---\\n   216\\tstatus: active\\n   217\\tstall:\\n   218\\t  quiet_turns: ${'9'.repeat(400)}\\n   219\\t  same_failure: ${'9'.repeat(400)}\\n   220\\t---\\n   221\\t`);\\n   222\\t  assert.deepEqual(plan.stall, { quietTurns: 3, sameFailure: 3 });\\n   223\\t});\\n   224\\t\\n   225\\ttest('malformed or schema-invalid frontmatter never activates supervision', () => {\\n   226\\t  const malformed = [\\n   227\\t    '---\\\\nstatus: active\\\\nstatus: active\\\\n---\\\\n',\\n   228\\t    '---\\\\nstatus: active\\\\n outcome: odd indentation\\\\n---\\\\n',\\n   229\\t    '---\\\\nstatus: active\\\\nverify: npm test\\\\n---\\\\n',\\n   230\\t    '---\\\\nstatus: active\\\\nscope: nope\\\\n---\\\\n',\\n   231\\t  ];\\n   232\\t  for (const text of malformed) assert.equal(parseHookFlightPlan(text), null);\\n   233\\t});\\n✔ Claude sessions load the plugin and invoke the slash-command skill natively (1.632041ms)\\n✔ the published package contains both plugin manifests and only the active runtime closure (3.014083ms)\\n✔ Claude worker levels map to Claude model aliases and native effort values (0.202541ms)\\n✔ Claude CLI transport inherits the native TUI and returns its exit status (0.272583ms)\\n✔ only launcher-started Goal sessions activate the Claude Stop supervisor (0.549625ms)\\n✔ quiet evidence climbs through continuation, realignment, final experiment, then bounded allow (301.399667ms)\\n✔ missing, complete, and blocked flight plans leave non-active sessions inert (173.506625ms)\\n✔ a fresh active plan is inert outside a launcher-marked Goal session (60.780208ms)\\n✔ an active flight plan older than 48 hours is inert (62.954209ms)\\n✔ changing flight-plan frontmatter resets the supervision cycle (140.983292ms)\\n✔ new workspace evidence restarts supervision after a stall report (288.64375ms)\\n✔ same normalized failure can trigger realignment without git evidence (106.114875ms)\\n✔ corrupt scratch state fails open with an allow report and exit zero (115.225375ms)\\n✔ a symlinked scratch directory fails open without writing through it (51.579ms)\\n✔ hook registration uses the standalone plugin-root command form (0.856ms)\\n✔ unsafe stall integers fall back instead of defeating the block cap (2.13975ms)\\n✔ malformed or schema-invalid frontmatter never activates supervision (0.327916ms)\\nℹ tests 17\\nℹ suites 0\\nℹ pass 17\\nℹ fail 0\\nℹ cancelled 0\\nℹ skipped 0\\nℹ todo 0\\nℹ duration_ms 1362.964209\\n\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"019f8387-af78-7a61-94d2-042f27f768e3\"}}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:339:{\"timestamp\":\"2026-07-21T07:16:25.637Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"call_id\":\"call_ykadlQ7yIPkYKhfoTl6vfNIg\",\"output\":[{\"type\":\"input_text\",\"text\":\"Script completed\\nWall time 0.2 seconds\\nOutput:\\n\"},{\"type\":\"input_text\",\"text\":\"   125\\t        cursor = next - 1;\\n   126\\t      } else result[key] = null;\\n   127\\t    }\\n   128\\t    cursor += 1;\\n   129\\t  }\\n   130\\t  return [result, cursor];\\n   131\\t}\\n   132\\t\\n   133\\tfunction isMapping(value) {\\n   134\\t  return value !== null && typeof value === 'object' && !Array.isArray(value);\\n   135\\t}\\n   136\\t\\n   137\\tfunction stringList(value) {\\n   138\\t  return Array.isArray(value) && value.every((item) => typeof item === 'string' && !/[\\\\r\\\\n]/u.test(item));\\n   139\\t}\\n   140\\t\\n   141\\t// TODO(v0.3): consolidate this strict reader and fingerprint helper only when\\n   142\\t// the packaged hook can remain a standalone process with no runtime coupling.\\n   143\\texport function parseHookFlightPlan(text) {\\n   144\\t  try {\\n   145\\t    if (typeof text !== 'string' || text.length > 1_000_000) return null;\\n   146\\t    const lines = text.replace(/^\\\\uFEFF/u, '').split(/\\\\r?\\\\n/u);\\n   147\\t    if (lines[0]?.trim() !== '---') return null;\\n   148\\t    const closing = lines.findIndex((line, index) => index > 0 && line.trim() === '---');\\n   149\\t    if (closing < 0) return null;\\n   150\\t    const frontmatter = lines.slice(1, closing).join('\\\\n');\\n   151\\t    const tokens = tokensFor(frontmatter);\\n   152\\t    const [raw, consumed] = tokens.length ? parseBlock(tokens, 0, 0) : [{}, 0];\\n   153\\t    if (consumed !== tokens.length || !isMapping(raw)) return null;\\n   154\\t    const status = raw.status ?? 'active';\\n   155\\t    if (!['active', 'complete', 'blocked'].includes(status)) return null;\\n   156\\t    const version = raw.version ?? 1;\\n   157\\t    const outcome = raw.outcome ?? '';\\n   158\\t    const verify = raw.verify ?? [];\\n   159\\t    const scope = raw.scope ?? {};\\n   160\\t    const invariants = raw.invariants ?? [];\\n   161\\t    const stall = raw.stall ?? {};\\n   162\\t    if (\\n   163\\t      !Number.isSafeInteger(version) || version < 1 ||\\n   164\\t      typeof outcome !== 'string' || /[\\\\r\\\\n]/u.test(outcome) ||\\n   165\\t      !stringList(verify) ||\\n   166\\t      !isMapping(scope) ||\\n   167\\t      !stringList(scope.touchpoints ?? []) ||\\n   168\\t      !stringList(scope.non_goals ?? []) ||\\n   169\\t      !stringList(invariants) ||\\n   170\\t      !isMapping(stall)\\n   171\\t    ) return null;\\n   172\\t    return {\\n   173\\t      status,\\n   174\\t      stall: {\\n   175\\t        quietTurns: positiveInteger(stall.quiet_turns, DEFAULT_STALL.quietTurns),\\n   176\\t        sameFailure: positiveInteger(stall.same_failure, DEFAULT_STALL.sameFailure),\\n   177\\t      },\\n   178\\t      frontmatterHash: digest(frontmatter),\\n   179\\t    };\\n   180\\t  } catch {\\n   181\\t    return null;\\n   182\\t  }\\n   183\\t}\\n   184\\t\\n   185\\tasync function readFlightPlan(cwd, now) {\\n\\\"---\\\\nstatus: active\\\\noutcome: \\\\\\\"line\\\\\\\\nbreak\\\\\\\"\\\\n---\\\\n\\\" [ '---', 'status: active', 'outcome: \\\"line\\\\\\\\nbreak\\\"', '---', '' ]\\n\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"019f8387-af78-7a61-94d2-042f27f768e3\"}}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:374:{\"timestamp\":\"2026-07-21T07:24:13.070Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"call_id\":\"call_8lmKNeQkVz90DN0u7e8LZV71\",\"output\":[{\"type\":\"input_text\",\"text\":\"Script completed\\nWall time 0.1 seconds\\nOutput:\\n\"},{\"type\":\"input_text\",\"text\":\"Warning: truncated output (original token count: 14026)\\nTotal output lines: 1311\\n\\n# Task E — Build as queue compiler: `.cruise/QUEUE.md` and sequential supervised runs\\n\\n## Context\\n\\nYou are working in the `cruise` repository, a dual-host coding-workflow\\nplugin. By now the repo has: five skills (`skills/*/SKILL.md`); a launcher\\n(`scripts/cruise.mjs`) whose Codex goal loop is supervised\\n(`scripts/lib/supervisor.mjs` — evidence-based stall detection with a\\nrealign → final-experiment → pause ladder, exit code 3 for `stalled`); a\\nflight-plan module (`scripts/lib/flight-plan.mjs`) reading/writing\\n`.cruise/FLIGHT.md` (pinned schema: frontmatter with `status`, `outcome`,\\n`verify`, `scope.touchpoints`, `scope.non_goals`, `invariants`, `stall`);\\nand a Claude Stop-hook supervisor (`hooks/`) driven by the same flight\\nplan. The current `skills/build/SKILL.md` is a 13-line stub.\\n\\n**Design philosophy (non-negotiable).** Cruise v0.1 had a build-queue\\ncontrol plane (contracts, milestone ledgers, digests) and it was retired.\\nThe queue you build is the opposite kind of object: one small, advisory,\\nuser-editable markdown file — the compiled output of a clarification\\nconversation, the input to sequential supervised goal runs. It grants\\nnothing, gates nothing, and the user can reorder or edit it freely between\\n(not during) runs.\\n\\n## What you are building\\n\\nThe user's mental model: build is the bowling setup for a whole project —\\nclarify the vision once, decompose it into goal-sized milestones, then let\\nthe queue run each milestone as a supervised goal with its own flight plan.\\n\\n### Pinned contract: `.cruise/QUEUE.md`\\n\\n```markdown\\n---\\nversion: 1\\nmilestones:\\n  - id: M1\\n    status: pending        # pending | active | complete | blocked | stalled\\n    outcome: <one line, falsifiable>\\n    verify: [npm test]\\n    depends: []            # ids that must be complete first\\n    touchpoints: [src/parser/]\\n    non_goals: [\\\"No API redesign\\\"]\\n    invariants: [\\\"CLI flags unchanged\\\"]\\n  - id: M2\\n    ...\\n---\\n# Queue\\n\\n<prose: project vision, per-milestone rationale, cross-milestone\\ncompatibility obligations, sequencing reasoning>\\n```\\n\\n### 1. `scripts/lib/queue.mjs` (new)\\n\\nSame conventions as `flight-plan.mjs` (no dependencies, never throws on\\nmalformed input, unknown keys preserved):\\n\\n```js\\nexport const QUEUE_FILE = '.cruise/QUEUE.md';\\nexport function parseQueue(text)            // -> { version, milestones[], body, raw } | null\\nexport async function readQueue(cwd)\\nexport async function writeQueue(cwd, queue)\\nexport function nextReadyMilestone(queue)   // first pending whose depends are all complete; null otherwise\\nexport function milestoneToFlightPlan(milestone, queueBody)\\n// -> flight-plan shape (status: 'active'), carrying the milestone's\\n//    outcome/verify/touchpoints/non_goals/invariants and a body that cites\\n//    the queue's cross-milestone compatibility obligations\\n```\\n\\n### 2. `skills/build/SKILL.md` rewrite\\n\\nKeep it compact (about a page) and in the existing frank tone:\\n\\n- Inspect the repository first; ask only material questions — the ones\\n  whose answers change the decomposition (product intent, hard\\n  constraints, compatibility obligations, what must never break).\\n- Decompose into **goal-sized** milestones: each independently completable\\n  and verifiable by its own `verify` commands, ordered by real dependency,\\n  with explicit non-goals so later milestones don't bleed into earlier\\n  ones (this is the anti-scope-drift mechanism).\\n- Cross-milestone reconciliation obligations (backward/forward\\n  compatibility, migration reversibility) are stated once in the queue\\n  body and inherited by every generated flight plan.\\n- Write `.cruise/QUEUE.md`; present the queue in conversation for the user\\n  to adjust; the file is advisory and user-editable. Do not implement\\n  milestones inside a build conversation — that is what the queue run or\\n  an explicit goal invocation is for. No approval phrases, no digests.\\n\\n### 3. Launcher: `cruise queue` command\\n\\nExtend `scripts/cruise.mjs` (`parseArgs`, `HELP`, `main`):\\n\\n- `cruise queue status [-C dir]` — print milestones with status/depends.\\n- `cruise queue run [-C dir]` — loop:\\n  1. `nextReadyMilestone`; none pending → print summary, exit 0 (or exit 2\\n     if pending-but-blocked-by-deps remain).\\n  2. Mark it `active`, write the queue, compile its flight plan via\\n     `milestoneToFlightPlan` + `writeFlightPlan`.\\n  3. Run a supervised goal session for the milestone's outcome — reuse the\\n     existing `runStart` goal path for the selected provider (Codex\\n     `SimpleCruiseSession`, Claude native session with the Stop-hook\\n     supervisor); the request text is the milestone outcome plus a pointer\\n     to the flight plan.\\n  4. Map the session result back: complete → `complete`, continue to the\\n     next ready milestone; stalled/blocked/failed → record that status on\\n     the milestone, stop the queue, print which milestone stopped and why,\\n     exit 3 (stalled) or 2 (otherwise). Never auto-skip a failed milestone.\\n- Between milestones is the user-edit window; re-read the queue file fresh\\n  each iteration so mid-queue edits take effect.\\n- Structure the runner so tests can inject a fake session runner.\\n\\n### 4. Docs\\n\\nUpdate the README usage section with a build → queue run example and the\\ncommand table. (Task F owns the full docs rewrite.)\\n\\n## Files you own\\n\\n`scripts/lib/queue.mjs` (new), `tests/queue.test.mjs` (new),\\n`skills/build/SKILL.md`, `scripts/cruise.mjs` (queue command),\\n`package.json` (`files` + `test`), README usage section.\\n\\n## Files you must not touch\\n\\n`supervisor.mjs`, `simple-session.mjs` internals (consume `runStart`/session\\nclasses as-is; if you need a small seam — e.g. exporting a run-one-goal\\nhelper — add it minimally and say so), `hooks/**`, `flight-plan.mjs`\\n(public API only), `skills/goal/SKILL.md`, `skills/debug/SKILL.md`.\\n\\n## Acceptance criteria\\n\\n- `npm test` green. New tests cover: queue parse/write round-trip,\\n  `nextReadyMilestone` dependency logic (including cycles → null +\\n  warning), `milestoneToFlightPlan` field mapping, and a full\\n  `queue run` orchestration with an injected fake runner exercising the\\n  complete / stalled / blocked paths and mid-queue file edits.\\n- `claude plugin validate .` passes; `cruise --help` documents `queue`.\\n- A queue run touches only `.cruise/QUEUE.md` and `.cruise/FLIGHT.md` —\\n  no ledgers, archives, digests, or per-milestone directories.\\n M README.md\\n M scripts/cruise.mjs\\n M skills/build/SKILL.md\\n M tests/cli-simple.test.mjs\\n M tests/queue.test.mjs\\n6015bac add advisory milestone queue contract\\n package.json          |   3 +-\\n scripts/lib/queue.mjs | 407 ++++++++++++++++++++++++++++++++++++++++++++++++++\\n tests/queue.test.mjs  | 133 +++++++++++++++++\\n 3 files changed, 542 insertions(+), 1 deletion(-)\\ndiff --git a/README.md b/README.md\\nindex cb7edd6..9f08f1f 100644\\n--- a/README.md\\n+++ b/README.md\\n@@ -5,16 +5,17 @@ launcher. The same five intent-based skills run natively on Codex and Claude\\n Code while each host keeps its own permissions, models, session controls, and\\n agent plumbing.\\n \\n-Cruise records the exact terminal request in `.cruise/ORIGIN.md`. Goal runs\\n-also maintain the advisory `.cruise/FLIGHT.md` described below. Neither file\\n-is an approval or source of authority, and Cruise does not create a parallel\\n-workflow database, approval ledger, archive, or run directory.\\n+Cruise records an exact terminal skill request in `.cruise/ORIGIN.md`. Build\\n+can compile an advisory `.cruise/QUEUE.md`, and each Goal run maintains the\\n+advisory `.cruise/FLIGHT.md` described below. None is an approval or source of\\n+authority, and Cruise does not create a parallel workflow database, approval\\n+ledger, archive, or run directory.\\n \\n ## Choose a skill\\n \\n | Skill | Use it when |\\n | --- | --- |\\n-| `build` | You need to shape a project or milestone before implementation. |\\n+| `build` | You need to clarify a project and compile goal-sized milestones before implementation. |\\n | `quick` | The requested change is small, understood, and low risk. |\\n | `refine` | The outcome is finite but needs a short plan first. |\\n | `goal` | The work is consequential or multi-step and should run to completion. |\\n@@ -35,6 +36,19 @@ and keeps its status truthful. You may edit it at any time; it is advisory and\\n grants or gates nothing. The selected host's native permissions remain the only\\n authority for work and effects.\\n \\n+## Build queues\\n+\\n+Build inspects the repository, clarifies only material product and compatibility\\n+questions, and writes goal-sized milestones to `.cruise/QUEUE.md`. Each\\n+milestone owns an outcome, verification, dependency list, touchpoints,\\n+non-goals, and invariants. Cross-milestone compatibility obligations live once\\n+in the Markdown body and are inherited by every generated flight plan.\\n+\\n+The queue is user-editable and advisory. Reorder or adjust it between milestone\\n+runs, then inspect or execute it with `cruise queue status` and\\n+`cruise queue run`. Queue execution is sequential: it never skips a blocked or\\n+stalled milestone, and it stops with a report instead of inventing authority.\\n+\\n ## Provider integration\\n \\n Cruise shares its skills and terminal UI, but not its host control plane:\\n@@ -125,6 +139,23 @@ cruise --claude refine -C ~/src/app \\\"Add bounded retry handling\\\"\\n cruise --claude goal -C ~/src/app \\\"Migrate the API\\\"\\n ```\\n \\n+Compile a project once, review the Markdown queue, then run each milestone as a\\n+supervised Goal on the selected provider:\\n+\\n+```sh\\n+cruise build -C ~/src/app \\\"Add a compatible parser migration\