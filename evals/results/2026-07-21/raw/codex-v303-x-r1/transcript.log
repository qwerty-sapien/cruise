ests for repo and cleaning notifier\",\"019f7b3a-f6f3-7d23-87b5-3ec39dd20424\":\"GitHub Actions npm ci fails on missing packages/cli/dist/bin.js after postinstall\",\"019f8020-d573-7650-a7c4-078d0f4e3874\":\"Adversarial review of RouteConfig validation in src/celltrack_alpha/types.py and solver.py, tests/te\",\"019f8082-206f-7463-b763-c3a1174547be\":\"cruise-cli v0.1.0 index.js npm package structure check and creation\",\"019f80ae-f212-71b0-8f36-93f22e344164\":\"Claude-compatible cruise UX plumbing, command prefix toggles, selectors, TUI parity, Codex isolation\",\"019f8269-ece3-7751-a1f4-29a115c2ac79\":\"Compare cruise:goal, cruise:refine, Codex goal and /plan, Claude plan mode, plus closest plugin anal\",\"019f82cb-cda3-7192-ab6b-e5157300e3b7\":\"reports/g02 scores.json, 6bba holdout, division_metrics.py, celltrack_alpha bh_grap\",\"019f836a-6c24-7cc2-a5b3-7d87672f1b74\":\"Codex goal objective file at <USER_HOME>/.codex/attachments/6b24fed5-f93f-484c-988c-6c15d5f90401/go\"},\"unread-thread-ids-by-host-v1\":{\"local\":[\"019f711f-e97a-7862-900d-b7bc8557e5de\",\"019f7120-062c-71e3-ad0b-2999c22f9918\",\"019f711f-f7eb-71d0-b51f-462050028374\",\"019f7133-073a-71f2-bfdf-e32aca5e9a12\",\"019f7133-1a53-79c2-893a-91c039029871\",\"019f72c4-ab11-7232-a2b0-b2efb132cdca\",\"019f72cd-7c7f-7313-9284-61c9a5ecdaa0\",\"019f72e2-2876-78e0-913b-64d0ec1b6ed9\",\"019f72f3-f1dd-7990-91d1-90d4ce3d0a5d\",\"019f72f9-8882-70f1-b01a-d8f2c2838bf3\",\"019f7301-7177-7ea0-ba92-0212e88b4f1f\",\"019f7307-67c8-7652-947c-671f6c52bde3\",\"019f7314-a110-7da1-94f4-0717f9d2f2e7\",\"019f730f-669a-7b53-a629-2775b0896807\",\"019f731e-5902-7603-a05b-8684d6082abb\",\"019f731f-5ab7-7623-bd33-cbfa048e642f\",\"019f7329-e932-7350-b988-a4975ff67560\",\"019f7331-a289-7f33-a7cc-31a2fe5cc65d\",\"019f733c-0afe-7d11-8a51-5acf9620d396\",\"019f733f-afb1-7d43-8650-4f90dfaeb460\",\"019f7354-ad31-7663-9ea4-060d4df99b4f\",\"019f7354-c08c-7000-993c-06ac6c4ebcb3\",\"019f7357-8661-7e92-810e-51008a25ab08\",\"019f8020-d573-7650-