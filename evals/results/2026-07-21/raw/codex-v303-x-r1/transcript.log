 1]))) {\\n      return value.slice(0, index).trimEnd();\\n    }\\n    escaped = false;\\n  }\\n  if (quote) throw new Error('unterminated quoted scalar');\\n  return value.trimEnd();\\n}\\n\\nfunction parseScalar(value) {\\n  const scalar = value.trim();\\n  if (scalar === '[]') return [];\\n  if (scalar === '{}') return {};\\n  if (scalar === 'null' || scalar === '~') return null;\\n  if (scalar === 'true') return true;\\n  if (scalar === 'false') return false;\\n  if (/^-?(?:0|[1-9]\\\\d*)(?:\\\\.\\\\d+)?$/u.test(scalar)) return Number(scalar);\\n  if (scalar.startsWith('\\\"')) {\\n    const parsed = JSON.parse(scalar);\\n    if (typeof parsed !== 'string') throw new Error('quoted values must be strings');\\n    return parsed;\\n  }\\n  if (scalar.startsWith(\\\"'\\\")) {\\n    if (!scalar.endsWith(\\\"'\\\") || scalar.length < 2) throw new Error('invalid quoted scalar');\\n    return scalar.slice(1, -1).replace(/''/gu, \\\"'\\\");\\n  }\\n  if (!scalar || /^[!&*>|[{]/u.test(scalar)) throw new Error('unsupported YAML scalar');\\n  return scalar;\\n}\\n\\nfunction frontmatterTokens(source) {\\n  const tokens = [];\\n  for (const [index, raw] of source.split(/\\\\r?\\\\n/u).entries()) {\\n    if (raw.includes('\\\\t')) throw new Error('tabs are not valid indentation');\\n    const indent = raw.match(/^ */u)[0].length;\\n    const content = stripComment(raw.slice(indent));\\n    if (!content.trim()) continue;\\n    if (indent % 2 !== 0) throw new Error('indentation must use two spaces');\\n    tokens.push({ indent, content: content.trim(), line: index + 1 });\\n  }\\n  if (tokens.length > 1_000) throw new Error('frontmatter is too large');\\n  return tokens;\\n}\\n\\nfunction parseBlock(tokens, start, indent, depth = 0) {\\n  if (depth > 10) throw new Error('frontmatter is too deeply nested');\\n  const sequence = tokens[start]?.content === '-' || tokens[start]?.content.startsWith('- ');\\n  const result = sequence ? [] : {};\\n  let cursor = start;\\n  while (cursor < tokens.length && tokens[cursor].indent >= indent) {\\n    const token = tokens[cursor];\\n    if (token.indent !== indent) throw new Error(`unexpected indentation on line ${token.line}`);\\n    const item = token.content === '-' || token.content.startsWith('- ');\\n    if (item !== sequence) throw new Error(`mixed mapping and sequence on line ${token.line}`);\\n    if (sequence) {\\n      const rest = token.content.slice(1).trim();\\n      if (rest) result.push(parseScalar(rest));\\n      else if (tokens[cursor + 1]?.indent === indent + 2) {\\n        const [child, next] = parseBlock(tokens, cursor + 1, indent + 2, depth + 1);\\n        result.push(child);\\n        cursor = next - 1;\\n      } else result.push(null);\\n    } else {\\n      const separator = token.content.indexOf(':');\\n      if (separator < 1) throw new Error(`expected a mapping on line ${token.line}`);\\n      const key = token.content.slice(0, separator).trim();\\n      if (!/^[A-Za-z_][A-Za-z0-9_-]*$/u.test(key) || Object.hasOwn(result, key)) {\\n        throw new Error(`invalid or duplicate key on line ${token.line}`);\\n      }\\n      const rest = token.content.slice(separator + 1).trim();\\n      if (rest) result[key] = parseScalar(rest);\\n      else if (tokens[cursor + 1]?.indent === indent + 2) {\\n        const [child, next] = parseBlock(tokens, cursor + 1, indent + 2, depth + 1);\\n        result[key] = child;\\n        cursor = next - 1;\\n      } else result[key] = null;\\n    }\\n    cursor += 1;\\n  }\\n  return [result, cursor];\\n}\\n\\nfunction stringArray(value, name) {\\n  if (!Array.isArray(value) || value.some((item) => typeof item !== 'string')) {\\n    throw new TypeError(`${name} must be an array of strings`);\\n  }\\n  return [...value];\\n}\\n\\nfunction positiveInteger(value, fallback, name) {\\n  const resolved = value ?? fallback;\\n  if (!Number.isInteger(resolved) || resolved < 1) throw new TypeError(`${name} must be a positive integer`);\\n  return resolved;\\n}\\n\\nfunction normalize(raw, body = '') {\\n  if (!isObject(raw) || typeof body !== 'string') throw new TypeError('invalid flight plan');\\n  const version = raw.version ?? 1;\\n  const status = raw.status ?? 'active';\\n  const outcome = raw.outcome ?? '';\\n  if (!Number.isInteger(version) || version < 1) throw new TypeError('version must be a positive integer');\\n  if (!STATUSES.has(status)) throw new TypeError('status must be active, complete, or blocked');\\n  if (typeof outcome !== 'string') throw new TypeError('outcome must be a string');\\n  const scope = raw.scope ?? {};\\n  const stall = raw.stall ?? {};\\n  if (!isObject(scope) || !isObject(stall)) throw new TypeError('scope and stall must be mappings');\\n  return {\\n    version,\\n    status,\\n    outcome,\\n    verify: stringArray(raw.verify ?? [], 'verify'),\\n    scope: {\\n      touchpoints: stringArray(scope.touchpoints ?? [], 'scope.touchpoints'),\\n      nonGoals: stringArray(scope.non_goals ?? [], 'scope.non_goals'),\\n    },\\n    invariants: stringArray(raw.invariants ?? [], 'invariants'),\\n    stall: {\\n      quietTurns: positiveInteger(stall.quiet_turns, DEFAULT_STALL.quietTurns, 'stall.quiet_turns'),\\n      sameFailure: positiveInteger(stall.same_failure, DEFAULT_STALL.sameFailure, 'stall.same_failure'),\\n    },\\n    body,\\n    raw,\\n  };\\n}\\n\\n// Pure and deliberately fail-safe: an advisory note can never break a run.\\nexport function parseFlightPlan(text) {\\n  try {\\n    if (typeof text !== 'string' || text.length > 1_000_000) return null;\\n    const lines = text.replace(/^\\\\uFEFF/u, '').split(/\\\\r?\\\\n/u);\\n    if (lines[0]?.trim() !== '---') return null;\\n    const closing = lines.findIndex((line, index) => index > 0 && line.trim() === '---');\\n    if (closing < 0) return null;\\n    const tokens = frontmatterTokens(lines.slice(1, closing).join('\\\\n'));\\n    const raw = tokens.length ? parseBlock(tokens, 0, 0)[0] : {};\\n    const consumed = tokens.length ? parseBlock(tokens, 0, 0)[1] : 0;\\n    if (consumed !== tokens.length || !isObject(raw)) return null;\\n    return normalize(raw, lines.slice(closing + 1).join('\\\\n'));\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nfunction scalarText(value) {\\n  if (value === null) return 'null';\\n  if (typeof value === 'boolean' || typeof value === 'number') return String(value);\\n  if (typeof value !== 'string') throw new TypeError('frontmatter scalar is not serializable');\\n  if (\\n    value &&\\n    !/^[-?:,[\\\\]{}#&*!|>'\\\"%@`]/u.test(value) &&\\n    !/[#:]/u.test(value) &&\\n    !/^(?:true|false|null|~|-?(?:0|[1-9]\\\\d*)(?:\\\\.\\\\d+)?)$/u.test(value)\\n  ) return value;\\n  return JSON.stringify(value);\\n}\\n\\nfunction serializeValue(key, value, indent) {\\n  const prefix = ' '.repeat(indent);\\n  if (Array.isArray(value)) {\\n    if (!value.length) return [`${prefix}${key}: []`];\\n    return [`${prefix}${key}:`, ...value.flatMap((item) => {\\n      if (isObject(item) || Array.isArray(item)) return [`${prefix}  -`, ...serializeObject(item, indent + 4)];\\n      return [`${prefix}  - ${scalarText(item)}`];\\n    })];\\n  }\\n  if (isObject(value)) {\\n    if (!Object.keys(value).length) return [`${prefix}${key}: {}`];\\n    return [`${prefix}${key}:`, ...serializeObject(value, indent + 2)];\\n  }\\n  return [`${prefix}${key}: ${scalarText(value)}`];\\n}\\n\\nfunction serializeObject(value, indent = 0) {\\n  if (!isObject(value)) throw new TypeError('frontmatter root must be a mapping');\\n  return Object.entries(value).flatMap(([key, item]) => {\\n    if (!/^[A-Za-z_][A-Za-z0-9_-]*$/u.test(key)) throw new TypeError(`invalid frontmatter key ${key}`);\\n    return serializeValue(key, item, indent);\\n  });\\n}\\n\\nfunction serializablePlan(plan) {\\n  if (!isObject(plan)) throw new TypeError('flight plan must be an object');\\n  const raw = isObject(plan.raw) ? plan.raw : {};\\n  const scopeRaw = isObject(raw.scope) ? raw.scope : {};\\n  const stallRaw = isObject(raw.stall) ? raw.stall : {};\\n  const known = normalize({\\n    version: plan.version ?? raw.version,\\n    status: plan.status ?? raw.status,\\n    outcome: plan.outcome ?? raw.outcome,\\n    verify: plan.verify ?? raw.verify,\\n    scope: {\\n      ...scopeRaw,\\n      touchpoints: plan.scope?.touchpoints ?? scopeRaw.touchpoints,\\n      non_goals: plan.scope?.nonGoals ?? scopeRaw.non_goals,\\n    },\\n    invariants: plan.invariants ?? raw.invariants,\\n    stall: {\\n      ...stallRaw,\\n      quiet_turns: plan.stall?.quietTurns ?? stallRaw.quiet_turns,\\n      same_failure: plan.stall?.sameFailure ?? stallRaw.same_failure,\\n    },\\n  }, plan.body ?? '');\\n  const extras = Object.fromEntries(Object.entries(raw).filter(([key]) => !KNOWN_KEYS.has(key)));\\n  return {\\n    normalized: known,\\n    frontmatter: {\\n      version: known.version,\\n      status: known.status,\\n      outcome: known.outcome,\\n      verify: known.verify,\\n      scope: {\\n        touchpoints: known.scope.touchpoints,\\n        non_goals: known.scope.nonGoals,\\n        ...Object.fromEntries(Object.entries(scopeRaw).filter(([key]) => !['touchpoints', 'non_goals'].includes(key))),\\n      },\\n      invariants: known.invariants,\\n      stall: {\\n        quiet_turns: known.stall.quietTurns,\\n        same_failure: known.stall.sameFailure,\\n        ...Object.fromEntries(Object.entries(stallRaw).filter(([key]) => !['quiet_turns', 'same_failure'].includes(key))),\\n      },\\n      ...extras,\\n    },\\n  };\\n}\\n\\nexport async function readFlightPlan(cwd) {\\n  try {\\n    return parseFlightPlan(await readFile(join(cwd, FLIGHT_FILE), 'utf8'));\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nexport async function writeFlightPlan(cwd, plan) {\\n  const { normalized, frontmatter } = serializablePlan(plan);\\n  const directory = join(cwd, '.cruise');\\n  await mkdir(directory, { recursive: true, mode: 0o700 });\\n  const directoryMetadata = await lstat(directory);\\n  if (directoryMetadata.isSymbolicLink() || !directoryMetadata.isDirectory()) {\\n    throw new Error(`${directory} must be a directory.`);\\n  }\\n  const path = join(cwd, FLIGHT_FILE);\\n  try {\\n    const existing = await lstat(path);\\n    if (existing.isSymbolicLink() || !existing.isFile()) throw new Error(`${path} must be a regular file.`);\\n  } catch (error) {\\n    if (error?.code !== 'ENOENT') throw error;\\n  }\\n  const text = `---\\\\n${serializeObject(frontmatter).join('\\\\n')}\\\\n---\\\\n${normalized.body}`;\\n  await writeFile(path, text, { encoding: 'utf8', mode: 0o600 });\\n  return normalized;\\n}\\n\"}},\"status\":\"completed\"}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:85:{\"timestamp\":\"2026-07-21T06:52:21.105Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"patch_apply_end\",\"call_id\":\"exec-b9b5c1b9-1dae-4c06-a2d2-986bfbdf8305\",\"turn_id\":\"019f836a-7f45-7002-996e-c2d98a1f90e7\",\"stdout\":\"Success. Updated the following files:\\nA <PLUGIN_ROOT>/tests/flight-plan.test.mjs\\nM <PLUGIN_ROOT>/package.json\\nM <PLUGIN_ROOT>/skills/goal/SKILL.md\\nM <PLUGIN_ROOT>/scripts/lib/simple-session.mjs\\nM <PLUGIN_ROOT>/scripts/lib/claude-cli.mjs\\nM <PLUGIN_ROOT>/README.md\\n\",\"stderr\":\"\",\"success\":true,\"changes\":{\"<PLUGIN_ROOT>/scripts/lib/claude-cli.mjs\":{\"type\":\"update\",\"unified_diff\":\"@@ -19,2 +19,3 @@\\n   'Claude Code exposes no documented Codex-style Goal lifecycle API to plugins; do not invent Goal endpoints or Goal state.',\\n+  'For Goal work, resolve the outcome, scope fence, invariants, acceptance commands, and stall tuning, then write the user-editable advisory .cruise/FLIGHT.md as the first execution act; reread it at each micro-goal, realign scope drift, re-verify affected invariants, and keep its status truthful through completion or a concrete blocker. It grants and gates nothing.',\\n ].join(' ');\\n\",\"move_path\":null},\"<PLUGIN_ROOT>/scripts/lib/simple-session.mjs\":{\"type\":\"update\",\"unified_diff\":\"@@ -20,4 +20,4 @@\\n   'The user explicitly invoked Cruise Goal, which authorizes autonomous end-to-end progress within the normal Codex workspace and permission boundaries.',\\n-  'Use the first read-only Plan turn only to inspect the repository and form a codebase-aware, strongly aligned plan for the first ready micro-goal. Unless the user explicitly requested planning or research only, that plan is not an endpoint: the following native Goal turn must immediately implement it.',\\n-  'For every micro-goal, reconcile the requested outcome and current repository evidence; make a compact plan for the next ready slice; implement it; run focused verification; remediate in-scope failures; recheck alignment and regression risk; then immediately execute the next ready micro-goal.',\\n+  'Use the first read-only Plan turn only to inspect the repository, resolve the outcome, touchpoints, non-goals, invariants, acceptance commands, and stall tuning, and form a strongly aligned plan for the first ready micro-goal. Unless the user explicitly requested planning or research only, that plan is not an endpoint: the following native Goal turn must immediately implement it and write the advisory .cruise/FLIGHT.md as its first execution act.',\\n+  'For every micro-goal, reread and reconcile the user-editable flight plan with the requested outcome and current repository evidence; realign before work outside its touchpoints or inside its non-goals; re-verify affected invariants; make a compact plan for the next ready slice; implement it; run focused verification; remediate in-scope failures; recheck alignment and regression risk; then immediately execute the next ready micro-goal.',\\n   'When changed behavior has meaningful concurrency, lifecycle, migration, public-contract, security, integration, or edge-case risk, use available independent reviewers or a bounded agent swarm to try to break it. Give them non-overlapping probes, reproduce credible findings, and refine before advancing. Skip this for simple low-risk work and never claim independent coverage that did not run.',\\n@@ -25,3 +25,3 @@\\n   'Do not mark the Goal paused or blocked merely because a phase ended or because a fresh continuation is needed. Cruise starts another turn automatically while the Goal remains active.',\\n-  'Keep the native Goal active until every requested acceptance and verification criterion passes. Then mark it complete. Mark it blocked only for a concrete unresolved blocker and state the evidence needed to resume.',\\n+  'Keep the native Goal active until every requested acceptance and verification criterion passes, then set the flight plan and Goal to complete. Set both to blocked only for a concrete unresolved blocker, stating the blocker and evidence needed to resume in the flight-plan body. The flight plan grants and gates nothing; native permissions remain authoritative.',\\n ].join(' ');\\n@@ -30,3 +30,3 @@\\n   'Begin with this sole read-only Plan-mode bootstrap, not a plan-only handoff.',\\n-  'Inspect the codebase and state a compact plan for the first ready, in-scope micro-goal.',\\n+  'Inspect the codebase, resolve the advisory flight plan fields, and state a compact plan for the first ready, in-scope micro-goal. This turn cannot write .cruise/FLIGHT.md.',\\n   'Do not implement in this Plan turn. Unless the request explicitly limits work to planning or research, switch to Default mode immediately afterward and implement and verify this micro-goal.',\\n@@ -36,5 +36,5 @@\\n   'Continue the active Cruise Goal now; this is execution, not a request for a new plan review.',\\n-  'Reconcile the requested outcome, current repository evidence, completed work, and remaining acceptance criteria.',\\n+  'Write .cruise/FLIGHT.md first if execution has not created it yet, then reread and reconcile its user-editable outcome, scope fence, invariants, acceptance commands, and stall tuning with current repository evidence, completed work, and remaining criteria.',\\n   'Draft only a compact, codebase-aware plan for the next ready micro-goal, then immediately implement it and run focused verification.',\\n-  'Remediate in-scope failures, recheck alignment and regression risk, use bounded independent breakage probes when the change warrants them, and continue until the Goal is truthfully complete or a concrete material blocker requires the user.',\\n+  'Remediate in-scope failures, recheck alignment and regression risk, use bounded independent breakage probes when the change warrants them, and continue until the flight plan and Goal are truthfully complete or both report a concrete material blocker.',\\n   'Routine micro-goal progression is already authorized; do not ask the user for a phase or plan approval.',\\n\",\"move_path\":null},\"<PLUGIN_ROOT>/README.md\":{\"type\":\"update\",\"unified_diff\":\"@@ -7,5 +7,5 @@\\n \\n-Cruise keeps only one local record: `.cruise/ORIGIN.md`, containing the exact\\n-request that started the most recent terminal run. It is a convenience note,\\n-not an approval or source of authority. Cruise does not create a parallel\\n+Cruise records the exact terminal request in `.cruise/ORIGIN.md`. Goal runs\\n+also maintain the advisory `.cruise/FLIGHT.md` described below. Neither file\\n+is an approval or source of authority, and Cruise does not create a parallel\\n workflow database, approval ledger, archive, or run directory.\\n@@ -28,2 +28,11 @@\\n \\n+## Flight plans\\n+\\n+At the start of Goal execution, Cruise compiles the clarified outcome, expected\\n+touchpoints, non-goals, invariants, verification commands, and stall tuning into\\n+`.cruise/FLIGHT.md`. The agent rereads this small Markdown note as work advances\\n+and keeps its status truthful. You may edit it at any time; it is advisory and\\n+grants or gates nothing. The selected host's native permissions remain the only\\n+authority for work and effects.\\n+\\n ## Provider integration\\n@@ -129,3 +138,4 @@\\n Every terminal invocation replaces `.cruise/ORIGIN.md` with that invocation's\\n-exact request. Direct plugin invocations create no Cruise files.\\n+exact request. Direct plugin invocations do not create an Origin note; Goal\\n+execution may still maintain its advisory flight plan.\\n \\n\",\"move_path\":null},\"<PLUGIN_ROOT>/tests/flight-plan.test.mjs\":{\"type\":\"add\",\"content\":\"import assert from 'node:assert/strict';\\nimport { mkdtemp, readFile, rm } from 'node:fs/promises';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport test from 'node:test';\\n\\nimport {\\n  DEFAULT_STALL,\\n  FLIGHT_FILE,\\n  parseFlightPlan,\\n  readFlightPlan,\\n  writeFlightPlan,\\n} from '../scripts/lib/flight-plan.mjs';\\n\\ntest('missing optional fields receive advisory defaults', () => {\\n  const plan = parseFlightPlan('---\\\\noutcome: Ship the parser\\\\n---\\\\n# Flight plan\\\\n\\\\nKeep it small.');\\n  assert.deepEqual(plan, {\\n    version: 1,\\n    status: 'active',\\n    outcome: 'Ship the parser',\\n    verify: [],\\n    scope: { touchpoints: [], nonGoals: [] },\\n    invariants: [],\\n    stall: { quietTurns: DEFAULT_STALL.quietTurns, sameFailure: DEFAULT_STALL.sameFailure },\\n    body: '# Flight plan\\\\n\\\\nKeep it small.',\\n    raw: { outcome: 'Ship the parser' },\\n  });\\n});\\n\\ntest('write and read round-trip the pinned schema and unknown extensions', async () => {\\n  const cwd = await mkdtemp(join(tmpdir(), 'cruise-flight-'));\\n  try {\\n    await writeFlightPlan(cwd, {\\n      version: 1,\\n      status: 'active',\\n      outcome: 'Make parsing failures harmless',\\n      verify: ['npm test', 'node --check scripts/lib/flight-plan.mjs'],\\n      scope: { touchpoints: ['scripts/lib/'], nonGoals: ['No public API redesign'] },\\n      invariants: ['Existing CLI flags keep their behavior'],\\n      stall: { quietTurns: 4, sameFailure: 2 },\\n      body: '# Flight plan\\\\n\\\\nThe host remains the authority.',\\n      raw: {\\n        owner: 'user-editable',\\n        scope: { reviewer: 'optional' },\\n        stall: { strategy: 'realign' },\\n      },\\n    });\\n\\n    const plan = await readFlightPlan(cwd);\\n    assert.equal(plan.outcome, 'Make parsing failures harmless');\\n    assert.deepEqual(plan.verify, ['npm test', 'node --check scripts/lib/flight-plan.mjs']);\\n    assert.deepEqual(plan.scope, {\\n      touchpoints: ['scripts/lib/'],\\n      nonGoals: ['No public API redesign'],\\n    });\\n    assert.deepEqual(plan.stall, { quietTurns: 4, sameFailure: 2 });\\n    assert.equal(plan.raw.owner, 'user-editable');\\n    assert.equal(plan.raw.scope.reviewer, 'optional');\\n    assert.equal(plan.raw.stall.strategy, 'realign');\\n    assert.equal(plan.body, '# Flight plan\\\\n\\\\nThe host remains the authority.');\\n    assert.match(await readFile(join(cwd, FLIGHT_FILE), 'utf8'), /^---\\\\nversion: 1\\\\nstatus: active/u);\\n  } finally {\\n    await rm(cwd, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('malformed or invalid frontmatter returns null', async () => {\\n  const inputs = [\\n    '',\\n    'outcome: missing fences',\\n    '---\\\\noutcome: never closed',\\n    '---\\\\n status: active\\\\n---\\\\n',\\n    '---\\\\nstatus: launched\\\\n---\\\\n',\\n    '---\\\\nverify: npm test\\\\n---\\\\n',\\n    '---\\\\nstall:\\\\n  quiet_turns: 0\\\\n---\\\\n',\\n  ];\\n  for (const input of inputs) assert.equal(parseFlightPlan(input), null);\\n\\n  const cwd = await mkdtemp(join(tmpdir(), 'cruise-flight-missing-'));\\n  try {\\n    assert.equal(await readFlightPlan(cwd), null);\\n  } finally {\\n    await rm(cwd, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('parseFlightPlan never throws on pathological text', () => {\\n  const inputs = [\\n    null,\\n    42,\\n    '\\\\u0000\\\\u0001\\\\u0002',\\n    `---\\\\n${'  nested:\\\\n'.repeat(20)}value: nope\\\\n---\\\\n`,\\n    `---\\\\nitems:\\\\n${'  - value\\\\n'.repeat(1_100)}---\\\\n`,\\n    '---\\\\nvalue: \\\"unterminated\\\\n---\\\\n',\\n    '---\\\\n__proto__:\\\\n  polluted: true\\\\n---\\\\n',\\n  ];\\n  for (const input of inputs) assert.doesNotThrow(() => parseFlightPlan(input));\\n});\\n\"},\"<PLUGIN_ROOT>/package.json\":{\"type\":\"update\",\"unified_diff\":\"@@ -24,2 +24,3 @@\\n     \\\"scripts/lib/claude-cli.mjs\\\",\\n+    \\\"scripts/lib/flight-plan.mjs\\\",\\n     \\\"scripts/lib/line-input.mjs\\\",\\n@@ -35,3 +36,3 @@\\n   \\\"scripts\\\": {\\n-    \\\"test\\\": \\\"node --test tests/app-server-client.test.mjs tests/line-input.test.mjs tests/picker.test.mjs tests/origin-note.test.mjs tests/debug-skill.test.mjs tests/simple-worker.test.mjs tests/claude-cli.test.mjs tests/cli-simple.test.mjs tests/simple-session.test.mjs\\\",\\n+    \\\"test\\\": \\\"node --test tests/app-server-client.test.mjs tests/line-input.test.mjs tests/picker.test.mjs tests/origin-note.test.mjs tests/flight-plan.test.mjs tests/debug-skill.test.mjs tests/simple-worker.test.mjs tests/claude-cli.test.mjs tests/cli-simple.test.mjs tests/simple-session.test.mjs\\\",\\n     \\\"validate\\\": \\\"npm test\\\"\\n\",\"move_path\":null},\"<PLUGIN_ROOT>/skills/goal/SKILL.md\":{\"type\":\"update\",\"unified_diff\":\"@@ -18,2 +18,8 @@\\n \\n+## Keep an advisory flight plan\\n+\\n+During the initial inspection, resolve the outcome, scope fence, invariants, acceptance commands, and useful stall tuning. Write them to `.cruise/FLIGHT.md` as the first act of execution mode; Codex's bootstrap Plan turn is read-only, so do not fight it. The flight plan is a user-editable advisory note, not permission, authority, or a gate. It does not change `.cruise/ORIGIN.md` semantics.\\n+\\n+At each micro-goal reconciliation, reread the flight plan. Work outside its `touchpoints`, work that enters a `non_goals` fence, or changes that threaten an invariant require realignment or a material user decision; re-verify every invariant whose surface changed. Set `status: complete` only when acceptance evidence passes. Set `status: blocked` only for a concrete blocker and state that blocker in the body.\\n+\\n Run a closed execution loop for every micro-goal:\\n\",\"move_path\":null}},\"status\":\"completed\"}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:114:{\"timestamp\":\"2026-07-21T06:52:32.012Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"call_id\":\"call_G96SxehRHPMfW55Am0gk9m9g\",\"output\":[{\"type\":\"input_text\",\"text\":\"Script completed\\nWall time 0.1 seconds\\nOutput:\\n\"},{\"type\":\"input_text\",\"text\":\"# Orchestrator — execute the full Cruise v0.3 DAG in one run\\n\\nYou are executing a six-task implementation plan for the `cruise` repository\\n(the current working directory). The six task specifications already exist\\nas files in `prompts/`; **they are the authoritative specs — this document\\nonly sequences them and sets ground rules.** Read each one in full\\nimmediately before starting that task, and follow it exactly, including its\\nacceptance criteria and its design-philosophy section.\\n\\n## Execution order\\n\\nRun the tasks **serially, on the current branch**, in this order:\\n\\n```text\\n1. prompts/A-hygiene.md            (delete retired v0.1 control plane)\\n2. prompts/B-flight-plan.md        (.cruise/FLIGHT.md + flight-plan.mjs)\\n3. prompts/C-codex-supervisor.md   (stall supervisor in the Codex goal loop)\\n4. prompts/D-claude-hooks.md       (Stop-hook supervisor for Claude Code)\\n5. prompts/E-build-queue.md        (.cruise/QUEUE.md + `cruise queue run`)\\n6. prompts/F-evals-and-docs.md     (paired evals + docs reconciliation)\\n```\\n\\nBecause you are one session on one branch, the specs' inter-task rules\\ntranslate as follows:\\n\\n- **\\\"Files you must not touch\\\" lists mean \\\"not during this task.\\\"** They\\n  were written to keep parallel sessions mergeable; for you they are phase\\n  scope fences. Do Task C's work in Task C, not opportunistically during\\n  Task B.\\n- **\\\"Expected merge conflict\\\" notes do not apply.** Additions to\\n  `package.json` (`files`, `test`) simply accumulate across tasks.\\n- **The C∥D decoupling rule still stands as written:** D's hook script\\n  re-implements its own small fingerprint helper rather than importing\\n  `supervisor.mjs`, and marks it with a consolidation TODO. Do not\\n  \\\"improve\\\" this by sharing code — the decoupling is deliberate (the hook\\n  must run as a standalone process from the packaged plugin).\\n- Where a spec says another task \\\"owns\\\" a file you later reach (e.g. C owns\\n  `LIMIT_POLICY.md`, F owns the README rewrite), that ownership arrives\\n  when you reach that task.\\n\\nIf `prompts/` is untracked, commit it first (\\\"add v0.3 implementation\\ns[stdout]
pecs\\\") so history records what was executed.\\n\\n## Gates between tasks\\n\\nAfter each task, before starting the next:\\n\\n1. Run `npm test` — must be green, including that task's new suites.\\n2. Run `node scripts/cruise.mjs --help` — must succeed.\\n3. Run `claude plugin validate .` if the `claude` CLI is available;\\n   otherwise note its absence once and continue.\\n4. Confirm the task's own acceptance-criteria checklist item by item.\\n   An unmet criterion is a blocker for that task, not a note for later.\\n5. Commit in the reviewable slices the spec asks for. Never carry\\n   uncommitted work across a task boundary.\\n\\nIf a gate cannot be satisfied after genuine remediation attempts, stop the\\nrun there and report: which task, which criterion, what you tried, and what\\nevidence or decision is needed. Do not proceed to a later task on top of a\\nfailed gate, and do not weaken a criterion to pass it.\\n\\n## Ground rules for the whole run\\n\\n- **The design philosophy in the specs is non-negotiable.** Artifacts\\n  (`FLIGHT.md`, `QUEUE.md`) are advisory compiled intent, never authority;\\n  supervision is evidence-based, user-tunable, and fail-safe (ladders end\\n  in pause-with-report / allow-with-report). If an implementation choice\\n  seems to require an approval object, ledger, digest, archive, or\\n  run-control authority, the choice is wrong — find the advisory-shaped\\n  alternative or stop and report the tension.\\n- Do not redesign the specs. If two specs genuinely conflict at a seam\\n  (e.g. an API detail B pinned that C needs shaped differently), resolve\\n  it with the smallest change, note the deviation explicitly in that\\n  task's commit message and your final report, and keep the pinned public\\n  contracts (`FLIGHT.md` schema, `flight-plan.mjs` API, supervisor verdict\\n  levels, `QUEUE.md` schema) stable — later tasks and documentation\\n  depend on them verbatim.\\n- No new runtime dependencies anywhere in the run.\\n- Keep code style matched to the existing live modules\\n  (`simple-session.mjs`, `origin-note.mjs`): plain ESM, no frameworks,\\n  `node --test` for tests.\\n\\n## Task F specifics\\n\\nTask F's paired evaluations require live hosts. Run `cruise doctor` for\\nboth providers first; execute every trial the environment supports, build\\nthe remainder as runnable fixtures, and record honestly what stayed gated.\\n**Never fabricate, extrapolate, or summarize a trial that did not run.**\\nA partial-but-honest F is a successful F; an embellished one is a failed\\nrun.\\n\\n## Final report\\n\\nEnd with: tasks completed with commit ranges; total lines deleted (A) and\\nadded; every deviation from a spec with its rationale; gate results per\\ntask; eval verdict or gated-status summary from F; and the single next\\naction you would recommend.---\\nname: goal\\ndescription: \\\"Autonomously complete consequential or multi-step work through native Codex Goal state: plan just enough to begin, then implement, validate, adversarially challenge when warranted, and refine until the outcome is complete.\\\"\\n---\\n\\n# Cruise Goal\\n\\nFor consequential work, inspect the repository, make a proportionate plan, and use Codex’s native Goal state when available. Treat an explicit `cruise goal` invocation as authorization to carry the requested work through to completion within the normal workspace and permission boundaries. That authorization includes routine Plan-to-Goal, contract, and phase transitions; never require a copied approval phrase, digest acknowledgement, or an `--auto-approve` incantation. Respect an explicit request to only plan, research, or prepare; otherwise, a plan is an instruction to implement, never the Goal’s endpoint.\\n\\nStart in Plan mode only long enough to establish a codebase-aware execution path. Identify the requested outcome, protected behavior, likely owners and touch points, acceptance evidence, and the smallest ready micro-goal. State a compact, strongly aligned plan for that micro-goal, then immediately transition to Goal execution and implement it. Do not wait for a routine plan review, phase approval, or a new invocation. When the host exposes a read-only Plan mode, do not implement in that initial turn; move directly to the active Goal execution turn instead.\\n\\nRun a closed execution loop for every micro-goal:\\n\\n1. Reconcile the requested outcome, current repository evidence, prior changes, and remaining acceptance criteria.\\n2. Draft only the next ready micro-goal’s actionable plan: ownership, files or interfaces, implementation approach, risks, and focused verification.\\n3. Implement the micro-goal, run the focused checks, and remediate in-scope failures.\\n4. Recheck alignment and regression risk. Incorporate confirmed findings, update the next micro-goal, and continue immediately while work remains.\\n\\nDo not present phase, checkpoint, or routine next-step approvals such as “Approve P-03” or “Stop after P-02”. A completed turn is a continuation point, not a human gate. Keep the native Goal active through planning, implementation, validation, and refinement; finish it only once the requested outcome and its evidence are complete.\\n\\nUse an adversarial review or agent swarm only when it has a meaningful chance to expose a bug: for example, changed concurrency or lifecycle behavior, migrations, public contracts, security-sensitive logic, broad integration paths, or an implementation with unresolved edge-case risk. Give independent reviewers bounded, non-overlapping probes or isolated scopes; ask them to try to break the implementation rather than repeat its happy path. Reproduce and resolve credible findings before advancing. Do not create a swarm for a simple, low-risk change, and do not claim independent coverage when it was unavailable.\\n\\nAsk the user only when repository evidence cannot resolve a material product decision, the work needs a scope or safety expansion, authentication or secret entry is required, or Codex requires approval for an external or destructive effect. Do not ask about routine sequencing, ordinary implementation choices, or whether to execute an already planned in-scope micro-goal. Do not mark the Goal blocked merely because another internal phase remains. Mark it complete only after its requested evidence passes; mark it blocked only with a concrete unresolved blocker and the evidence or decision needed to resume.\\n\\nCruise does not create a Goal suite, approval digest, archive, attempt ledger, or run-control directory. The launcher may write `.cruise/ORIGIN.md` containing exactly the request; it is a note only and does not authorize work.\\n\\nIf a worker stream fails, state the observed failure category and retry normally when appropriate. Never require a magic retry phrase, a fresh Cruise run, an archive, or a DNS-health assertion that the error does not support.\\n# Task B — Flight plan: compile intent into `.cruise/FLIGHT.md`\\n\\n## Context\\n\\nYou are working in the `cruise` repository, a dual-host coding-workflow\\nplugin for Codex and Claude Code. Five prompt-only skills live in\\n`skills/*/SKILL.md`; an optional launcher (`scripts/cruise.mjs`) drives a\\nCodex app-server session (`scripts/lib/simple-session.mjs`) or spawns a\\nnative `claude` session (`scripts/lib/claude-cli.mjs`). Today Cruise\\npersists exactly one file, `.cruise/ORIGIN.md` — the verbatim user request\\n(`scripts/lib/origin-note.mjs`).\\n\\n**Design philosophy (non-negotiable).** Cruise v0.1 was a state-owning\\ncontrol plane (YAML contracts, queues, approval digests, ledgers) and was\\ndeliberately retired; the prohibitions in the skill files are its\\npostmortem. The flight plan must NOT recreate it. `FLIGHT.md` is compiled\\nper-run intent: small, advisory, user-editable, regenerated each run. It is\\nnever an approval object, never an authority, never a ledger. The host's\\nnative permissions remain the only authority for work and effects.\\n\\n## What you are building\\n\\n`goal` runs (and later `build` queues — out of scope here) begin with a\\nclarification pass. Its output should be written down once as a **flight\\nplan** the rest of the run can reconcile against: outcome, scope fence,\\ninvariants, acceptance evidence, and stall tuning. Downstream tasks (a Codex\\nloop supervisor and a Claude Stop-hook supervisor) will read this file to\\ndetect scope drift and unproductive loops, so the schema below is a pinned\\ncontract — implement it exactly.\\n\\n### Pinned contract: `.cruise/FLIGHT.md`\\n\\nYAML frontmatter + markdown body:\\n\\n```markdown\\n---\\nversion: 1\\nstatus: active            # active | complete | blocked\\noutcome: <one line, falsifiable>\\nverify:\\n  - npm test              # commands whose exit codes define acceptance\\nscope:\\n  touchpoints:            # paths/globs expected to change\\n    - src/parser/\\n  non_goals:\\n    - \\\"No public API redesign\\\"\\ninvariants:               # protected behavior / compat obligations\\n  - \\\"Existing CLI flags keep their behavior\\\"\\nstall:\\n  quiet_turns: 3          # consecutive no-evidence turns before realignment\\n  same_failure: 3         # identical failure signatures before realignment\\n---\\n# Flight plan\\n\\n<prose: the outcome, why the scope fence sits where it does, the\\ncompatibility/reconciliation obligations, how acceptance is evidenced,\\nopen questions>\\n```\\n\\nParser rules: a missing file yields `null`; malformed frontmatter yields\\n`null` (never throw — a broken advisory file must never break a run);\\nunknown frontmatter keys are preserved on read and round-tripped on write\\n(downstream tasks extend the schema); every field is optional with defaults.\\n\\n### Pinned contract: `scripts/lib/flight-plan.mjs`\\n\\n```js\\nexport const FLIGHT_FILE = '.cruise/FLIGHT.md';\\nexport const DEFAULT_STALL = Object.freeze({ quietTurns: 3, sameFailure: 3 });\\n\\n// Pure. Returns the parsed shape below, or null for missing/unparseable text.\\nexport function parseFlightPlan(text)\\n// -> { version, status, outcome, verify: string[],\\n//      scope: { touchpoints: string[], nonGoals: string[] },\\n//      invariants: string[], stall: { quietTurns, sameFailure },\\n//      body: string, raw: object }\\n\\nexport async function readFlightPlan(cwd)          // null if absent/invalid\\nexport async function writeFlightPlan(cwd, plan)   // creates .cruise/, serializes\\n```\\n\\nImplement YAML handling with no new runtime dependencies (the repo is\\ndependency-free; a small hand-rolled parser for this restricted subset is\\nfine and preferred — mirror the style of `origin-note.mjs`).\\n\\n## Task\\n\\n1. Implement `scripts/lib/flight-plan.mjs` per the contract, with tests in\\n   `tests/flight-plan.test.mjs` (round-trip, defaults, malformed input →\\n   null, unknown-key preservation). Add the test to `package.json`'s `test`\\n   script and the module to the `files` array.\\n2. **`skills/goal/SKILL.md`:** add a compact section instructing the agent\\n   to compile the flight plan. Key behaviors, written in the skill's\\n   existing frank tone:\\n   - During the initial codebase inspection, resolve outcome, scope fence,\\n     invariants, and acceptance evidence; then write `.cruise/FLIGHT.md`\\n     **as the first act of execution mode** (on Codex the bootstrap Plan\\n     turn is read-only and cannot write it; do not fight that).\\n   - Each micro-goal iteration's reconcile step checks the flight plan:\\n     work outside `touchpoints`/`non_goals` means stop and realign or ask;\\n     invariants are re-verified when touched.\\n   - On completion, set `status: complete`; on a concrete blocker,\\n     `status: blocked` with the blocker stated in the body.\\n   - The flight plan is an advisory note the user may edit at any time; it\\n     grants nothing and gates nothing. Keep `ORIGIN.md` semantics unchanged.\\n3. **`scripts/lib/simple-session.mjs`:** extend the instruction strings\\n   (`AUTONOMOUS_GOAL_INSTRUCTIONS`, `GOAL_BOOTSTRAP_INSTRUCTIONS`,\\n   `GOAL_CONTINUATION_INSTRUCTIONS`) to reference the flight plan: write it\\n   as the first execution act; reconcile each micro-goal against it;\\n   maintain its `status` field truthfully. Touch only the instruction\\n   strings — do not modify the loop mechanics (Task C owns those).\\n4. **`scripts/lib/claude-cli.mjs`:** extend `CLAUDE_HOST_INSTRUCTIONS`\\n   equivalently for the Claude path.\\n5. Update the flight-plan paragraph of `README.md` (one short section; Task\\n   F owns the full rewrite).\\n\\n## Files you own\\n\\n`scripts/lib/flight-plan.mjs` (new), `tests/flight-plan.test.mjs` (new),\\n`skills/goal/SKILL.md`, instruction strings in\\n`scripts/lib/simple-session.mjs` and `scripts/lib/claude-cli.mjs`,\\n`package.json` (`files` + `test` additions), one README section.\\n\\n## Files you must not touch\\n\\nThe `SimpleCruiseSession` loop/supervision mechanics (Task C), anything\\nunder `hooks/` (Task D), `skills/build/SKILL.md` (Task E),\\n`LIMIT_POLICY.md` (Task C). A parallel hygiene task also edits\\n`package.json`; a merge conflict in `files` is expected — union the lists.\\n\\n## Acceptance criteria\\n\\n- `npm test` green, including the new suite.\\n- `claude plugin validate .` passes.\\n- `parseFlightPlan` never throws on arbitrary text (add a fuzz-ish test\\n  with a few pathological inputs).\\n- Skill text stays compact — the goal skill should grow by well under a\\n  page; no ceremony, no approval language, no new required user steps.\\n\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"019f8372-68fb-7750-8775-7cd68e300b6f\"}}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:118:{\"timestamp\":\"2026-07-21T06:52:36.104Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"call_id\":\"call_G7gFXuwvi3Z7E6DD8ftW8XaV\",\"output\":[{\"type\":\"input_text\",\"text\":\"Script completed\\nWall time 0.1 seconds\\nOutput:\\n\"},{\"type\":\"input_text\",\"text\":\" M README.md\\n M package.json\\n M scripts/lib/claude-cli.mjs\\n M scripts/lib/simple-session.mjs\\n M skills/goal/SKILL.md\\n M tests/claude-cli.test.mjs\\n M tests/simple-session.test.mjs\\n?? scripts/lib/flight-plan.mjs\\n?? tests/flight-plan.test.mjs\\ndiff --git a/README.md b/README.md\\nindex bca6764..cb7edd6 100644\\n--- a/README.md\\n+++ b/README.md\\n@@ -5,9 +5,9 @@ launcher. The same five intent-based skills run natively on Codex and Claude\\n Code while each host keeps its own permissions, models, session controls, and\\n agent plumbing.\\n \\n-Cruise keeps only one local record: `.cruise/ORIGIN.md`, containing the exact\\n-request that started the most recent terminal run. It is a convenience note,\\n-not an approval or source of authority. Cruise does not create a parallel\\n+Cruise records the exact terminal request in `.cruise/ORIGIN.md`. Goal runs\\n+also maintain the advisory `.cruise/FLIGHT.md` described below. Neither file\\n+is an approval or source of authority, and Cruise does not create a parallel\\n workflow database, approval ledger, archive, or run directory.\\n \\n ## Choose a skill\\n@@ -26,6 +26,15 @@ launch implementation; they are not a completion boundary. It still asks for\\n material product decisions, secrets, scope changes, and approvals required by\\n the active host.\\n \\n+## Flight plans\\n+\\n+At the start of Goal execution, Cruise compiles the clarified outcome, expected\\n+touchpoints, non-goals, invariants, verification commands, and stall tuning into\\n+`.cruise/FLIGHT.md`. The agent rereads this small Markdown note as work advances\\n+and keeps its status truthful. You may edit it at any time; it is advisory and\\n+grants or gates nothing. The selected host's native permissions remain the only\\n+authority for work and effects.\\n+\\n ## Provider integration\\n \\n Cruise shares its skills and terminal UI, but not its host control plane:\\n@@ -127,7 +136,8 @@ that worker invocation only. Debug also accepts request-scoped natural-language\\n swarm controls such as `swarm=always, swarm-size=8, swarm-depth=3`.\\n \\n Every terminal invocation replaces `.cruise/ORIGIN.md` with that invocation's\\n-exact request. Direct plugin invocations create no Cruise files.\\n+exact request. Direct plugin invocations do not create an Origin note; Goal\\n+execution may still maintain its advisory flight plan.\\n \\n ## Troubleshooting\\n \\ndiff --git a/package.json b/package.json\\nindex 930c091..a780a67 100644\\n--- a/package.json\\n+++ b/package.json\\n@@ -22,6 +22,7 @@\\n     \\\"scripts/cruise.mjs\\\",\\n     \\\"scripts/lib/app-server-client.mjs\\\",\\n     \\\"scripts/lib/claude-cli.mjs\\\",\\n+    \\\"scripts/lib/flight-plan.mjs\\\",\\n     \\\"scripts/lib/line-input.mjs\\\",\\n     \\\"scripts/lib/model-policy.mjs\\\",\\n     \\\"scripts/lib/origin-note.mjs\\\",\\n@@ -33,7 +34,7 @@\\n     \\\"skills/\\\"\\n   ],\\n   \\\"scripts\\\": {\\n-    \\\"test\\\": \\\"node --test tests/app-server-client.test.mjs tests/line-input.test.mjs tests/picker.test.mjs tests/origin-note.test.mjs tests/debug-skill.test.mjs tests/simple-worker.test.mjs tests/claude-cli.test.mjs tests/cli-simple.test.mjs tests/simple-session.test.mjs\\\",\\n+    \\\"test\\\": \\\"node --test tests/app-server-client.test.mjs tests/line-input.test.mjs tests/picker.test.mjs tests/origin-note.test.mjs tests/flight-plan.test.mjs tests/debug-skill.test.mjs tests/simple-worker.test.mjs tests/claude-cli.test.mjs tests/cli-simple.test.mjs tests/simple-session.test.mjs\\\",\\n     \\\"validate\\\": \\\"npm test\\\"\\n   },\\n   \\\"engines\\\": {\\ndiff --git a/scripts/lib/claude-cli.mjs b/scripts/lib/claude-cli.mjs\\nindex dd13a1c..0f9f1b3 100644\\n--- a/scripts/lib/claude-cli.mjs\\n+++ b/scripts/lib/claude-cli.mjs\\n@@ -17,6 +17,7 @@ const CLAUDE_HOST_INSTRUCTIONS = [\\n   'This Cruise session is running on Claude Code.',\\n   'Use Claude Code native permissions, task tracking, resumable sessions, skills, and subagents.',\\n   'Claude Code exposes no documented Codex-style Goal lifecycle API to plugins; do not invent Goal endpoints or Goal state.',\\n+  'For Goal work, resolve the outcome, scope fence, invariants, acceptance commands, and stall tuning, then write the user-editable advisory .cruise/FLIGHT.md as the first execution act; reread it at each micro-goal, realign scope drift, re-verify affected invariants, and keep its status truthful through completion or a concrete blocker. It grants and gates nothing.',\\n ].join(' ');\\n \\n export function claudeSessionArgs({ pluginRoot, skill, prompt }) {\\ndiff --git a/scripts/lib/simple-session.mjs b/scripts/lib/simple-session.mjs\\nindex 2d2f49e..13a8de4 100644\\n--- a/scripts/lib/simple-session.mjs\\n+++ b/scripts/lib/simple-session.mjs\\n@@ -18,25 +18,25 @@ const MATERIAL_GOAL_DECISION = /\\\\b(?:not\\\\s+requested|out(?:side)?\\\\s+(?:the\\\\s+)?s\\n \\n const AUTONOMOUS_GOAL_INSTRUCTIONS = [\\n   'The user explicitly invoked Cruise Goal, which authorizes autonomous end-to-end progress within the normal Codex workspace and permission boundaries.',\\n-  'Use the first read-only Plan turn only to inspect the repository and form a codebase-aware, strongly aligned plan for the first ready micro-goal. Unless the user explicitly requested planning or research only, that plan is not an endpoint: the following native Goal turn must immediately implement it.',\\n-  'For every micro-goal, reconcile the requested outcome and current repository evidence; make a compact plan for the next ready slice; implement it; run focused verification; remediate in-scope failures; recheck alignment and regression risk; then immediately execute the next ready micro-goal.',\\n+  'Use the first read-only Plan turn only to inspect the repository, resolve the outcome, touchpoints, non-goals, invariants, acceptance commands, and stall tuning, and form a strongly aligned plan for the first ready micro-goal. Unless the user explicitly requested planning or research only, that plan is not an endpoint: the following native Goal turn must immediately implement it and write the advisory .cruise/FLIGHT.md as its first execution act.',\\n+  'For every micro-goal, reread and reconcile the user-editable flight plan with the requested outcome and current repository evidence; realign before work outside its touchpoints or inside its non-goals; re-verify affected invariants; make a compact plan for the next ready slice; implement it; run focused verification; remediate in-scope failures; recheck alignment and regression risk; then immediately execute the next ready micro-goal.',\\n   'When changed behavior has meaningful concurrency, lifecycle, migration, public-contract, security, integration, or edge-case risk, use available independent reviewers or a bounded agent swarm to try to break it. Give them non-overlapping probes, reproduce credible findings, and refine before advancing. Skip this for simple low-risk work and never claim independent coverage that did not run.',\\n   'Do not ask the user to approve a phase, checkpoint, plan handoff, or ordinary next step. Ask only for a material product decision that repository evidence cannot resolve, a scope or safety expansion, authentication or secret entry, or a host-required external or destructive approval.',\\n   'Do not mark the Goal paused or blocked merely because a phase ended or because a fresh continuation is needed. Cruise starts another turn automatically while the Goal remains active.',\\n-  'Keep the native Goal active until every requested acceptance and verification criterion passes. Then mark it complete. Mark it blocked only for a concrete unresolved blocker and state the evidence needed to resume.',\\n+  'Keep the native Goal active until every requested acceptance and verification criterion passes, then set the flight plan and Goal to complete. Set both to blocked only for a concrete unresolved blocker, stating the blocker and evidence needed to resume in the flight-plan body. The flight plan grants and gates nothing; native permissions remain authoritative.',\\n ].join(' ');\\n \\n const GOAL_BOOTSTRAP_INSTRUCTIONS = [\\n   'Begin with this sole read-only Plan-mode bootstrap, not a plan-only handoff.',\\n-  'Inspect the codebase and state a compact plan for the first ready, in-scope micro-goal.',\\n+  'Inspect the codebase, resolve the advisory flight plan fields, and state a compact plan for the first ready, in-scope micro-goal. This turn cannot write .cruise/FLIGHT.md.',\\n   'Do not implement in this Plan turn. Unless the request explicitly limits work to planning or research, switch to Default mode immediately afterward and implement and verify this micro-goal.',\\n ].join(' ');\\n \\n const GOAL_CONTINUATION_INSTRUCTIONS = [\\n   'Continue the active Cruise Goal now; this is execution, not a request for a new plan review.',\\n-  'Reconcile the requested outcome, current repository evidence, completed work, and remaining acceptance criteria.',\\n+  'Write .cruise/FLIGHT.md first if execution has not created it yet, then reread and reconcile its user-editable outcome, scope fence, invariants, acceptance commands, and stall tuning with current repository evidence, completed work, and remaining criteria.',\\n   'Draft only a compact, codebase-aware plan for the next ready micro-goal, then immediately implement it and run focused verification.',\\n-  'Remediate in-scope failures, recheck alignment and regression risk, use bounded independent breakage probes when the change warrants them, and continue until the Goal is truthfully complete or a concrete material blocker requires the user.',\\n+  'Remediate in-scope failures, recheck alignment and regression risk, use bounded independent breakage probes when the change warrants them, and continue until the flight plan and Goal are truthfully complete or both report a concrete material blocker.',\\n   'Routine micro-goal progression is already authorized; do not ask the user for a phase or plan approval.',\\n ].join(' ');\\n \\ndiff --git a/skills/goal/SKILL.md b/skills/goal/SKILL.md\\nindex 8616c2d..c18c611 100644\\n--- a/skills/goal/SKILL.md\\n+++ b/skills/goal/SKILL.md\\n@@ -16,6 +16,12 @@ Treat worker-level and communication-manner preferences as natural-language inst\\n \\n Establish a codebase-aware execution path only long enough to begin. Identify the requested outcome, protected behavior, likely owners and touch points, acceptance evidence, and the smallest ready micro-goal. State a compact, strongly aligned plan for that micro-goal, then implement it. Do not wait for a routine plan review, phase approval, or a new invocation. On Codex, respect the launcher's initial read-only Plan turn and move directly into active Goal execution afterward. On Claude Code, plan in the current session without manufacturing a mode transition.\\n \\n+## Keep an advisory flight plan\\n+\\n+During the initial inspection, resolve the outcome, scope fence, invariants, acceptance commands, and useful stall tuning. Write them to `.cruise/FLIGHT.md` as the first act of execution mode; Codex's bootstrap Plan turn is read-only, so do not fight it. The flight plan is a user-editable advisory note, not permission, authority, or a gate. It does not change `.cruise/ORIGIN.md` semantics.\\n+\\n+At each micro-goal reconciliation, reread the flight plan. Work outside its `touchpoints`, work that enters a `non_goals` fence, or changes that threaten an invariant require realignment or a material user decision; re-verify every invariant whose surface changed. Set `status: complete` only when acceptance evidence passes. Set `status: blocked` only for a concrete blocker and state that blocker in the body.\\n+\\n Run a closed execution loop for every micro-goal:\\n \\n 1. Reconcile the requested outcome, current repository evidence, prior changes, and remaining acceptance criteria.\\nimport { lstat, mkdir, readFile, writeFile } from 'node:fs/promises';\\nimport { join } from 'node:path';\\n\\nexport const FLIGHT_FILE = '.cruise/FLIGHT.md';\\nexport const DEFAULT_STALL = Object.freeze({ quietTurns: 3, sameFailure: 3 });\\n\\nconst STATUSES = new Set(['active', 'complete', 'blocked']);\\nconst KNOWN_KEYS = new Set(['version', 'status', 'outcome', 'verify', 'scope', 'invariants', 'stall']);\\n\\nfunction isObject(value) {\\n  return value !== null && typeof value === 'object' && !Array.isArray(value);\\n}\\n\\nfunction stripComment(value) {\\n  let quote = null;\\n  let escaped = false;\\n  for (let index = 0; index < value.length; index += 1) {\\n    const character = value[index];\\n    if (quote === '\\\"' && character === '\\\\\\\\' && !escaped) {\\n      escaped = true;\\n      continue;\\n    }\\n    if (character === quote && !escaped) quote = null;\\n    else if (!quote && (character === '\\\"' || character === \\\"'\\\")) quote = character;\\n    else if (!quote && character === '#' && (index === 0 || /\\\\s/u.test(value[index - 1]))) {\\n      return value.slice(0, index).trimEnd();\\n    }\\n    escaped = false;\\n  }\\n  if (quote) throw new Error('unterminated quoted scalar');\\n  return value.trimEnd();\\n}\\n\\nfunction parseScalar(value) {\\n  const scalar = value.trim();\\n  if (scalar === '[]') return [];\\n  if (scalar === '{}') return {};\\n  if (scalar === 'null' || scalar === '~') return null;\\n  if (scalar === 'true') return true;\\n  if (scalar === 'false') return false;\\n  if (/^-?(?:0|[1-9]\\\\d*)(?:\\\\.\\\\d+)?$/u.test(scalar)) return Number(scalar);\\n  if (scalar.startsWith('\\\"')) {\\n    const parsed = JSON.parse(scalar);\\n    if (typeof parsed !== 'string') throw new Error('quoted values must be strings');\\n    return parsed;\\n  }\\n  if (scalar.startsWith(\\\"'\\\")) {\\n    if (!scalar.endsWith(\\\"'\\\") || scalar.length < 2) throw new Error('invalid quoted scalar');\\n    return scalar.slice(1, -1).replace(/''/gu, \\\"'\\\");\\n  }\\n  if (!scalar || /^[!&*>|[{]/u.test(scalar)) throw new Error('unsupported YAML scalar');\\n  return scalar;\\n}\\n\\nfunction frontmatterTokens(source) {\\n  const tokens = [];\\n  for (const [index, raw] of source.split(/\\\\r?\\\\n/u).entries()) {\\n    if (raw.includes('\\\\t')) throw new Error('tabs are not valid indentation');\\n    const indent = raw.match(/^ */u)[0].length;\\n    const content = stripComment(raw.slice(indent));\\n    if (!content.trim()) continue;\\n    if (indent % 2 !== 0) throw new Error('indentation must use two spaces');\\n    tokens.push({ indent, content: content.trim(), line: index + 1 });\\n  }\\n  if (tokens.length > 1_000) throw new Error('frontmatter is too large');\\n  return tokens;\\n}\\n\\nfunction parseBlock(tokens, start, indent, depth = 0) {\\n  if (depth > 10) throw new Error('frontmatter is too deeply nested');\\n  const sequence = tokens[start]?.content === '-' || tokens[start]?.content.startsWith('- ');\\n  const result = sequence ? [] : {};\\n  let cursor = start;\\n  while (cursor < tokens.length && tokens[cursor].indent >= indent) {\\n    const token = tokens[cursor];\\n    if (token.indent !== indent) throw new Error(`unexpected indentation on line ${token.line}`);\\n    const item = token.content === '-' || token.content.startsWith('- ');\\n    if (item !== sequence) throw new Error(`mixed mapping and sequence on line ${token.line}`);\\n    if (sequence) {\\n      const rest = token.content.slice(1).trim();\\n      if (rest) result.push(parseScalar(rest));\\n      else if (tokens[cursor + 1]?.indent === indent + 2) {\\n        const [child, next] = parseBlock(tokens, cursor + 1, indent + 2, depth + 1);\\n        result.push(child);\\n        cursor = next - 1;\\n      } else result.push(null);\\n    } else {\\n      const separator = token.content.indexOf(':');\\n      if (separator < 1) throw new Error(`expected a mapping on line ${token.line}`);\\n      const key = token.content.slice(0, separator).trim();\\n      if (\\n        !/^[A-Za-z_][A-Za-z0-9_-]*$/u.test(key) ||\\n        ['__proto__', 'constructor', 'prototype'].includes(key) ||\\n        Object.hasOwn(result, key)\\n      ) {\\n        throw new Error(`invalid or duplicate key on line ${token.line}`);\\n      }\\n      const rest = token.content.slice(separator + 1).trim();\\n      if (rest) result[key] = parseScalar(rest);\\n      else if (tokens[cursor + 1]?.indent === indent + 2) {\\n        const [child, next] = parseBlock(tokens, cursor + 1, indent + 2, depth + 1);\\n        result[key] = child;\\n        cursor = next - 1;\\n      } else result[key] = null;\\n    }\\n    cursor += 1;\\n  }\\n  return [result, cursor];\\n}\\n\\nfunction stringArray(value, name) {\\n  if (!Array.isArray(value) || value.some((item) => typeof item !== 'string')) {\\n    throw new TypeError(`${name} must be an array of strings`);\\n  }\\n  return [...value];\\n}\\n\\nfunction positiveInteger(value, fallback, name) {\\n  const resolved = value ?? fallback;\\n  if (!Number.isInteger(resolved) || resolved < 1) throw new TypeError(`${name} must be a positive integer`);\\n  return resolved;\\n}\\n\\nfunction normalize(raw, body = '') {\\n  if (!isObject(raw) || typeof body !== 'string') throw new TypeError('invalid flight plan');\\n  const version = raw.version ?? 1;\\n  const status = raw.status ?? 'active';\\n  const outcome = raw.outcome ?? '';\\n  if (!Number.isInteger(version) || version < 1) throw new TypeError('version must be a positive integer');\\n  if (!STATUSES.has(status)) throw new TypeError('status must be active, complete, or blocked');\\n  if (typeof outcome !== 'string') throw new TypeError('outcome must be a string');\\n  const scope = raw.scope ?? {};\\n  const stall = raw.stall ?? {};\\n  if (!isObject(scope) || !isObject(stall)) throw new TypeError('scope and stall must be mappings');\\n  return {\\n    version,\\n    status,\\n    outcome,\\n    verify: stringArray(raw.verify ?? [], 'verify'),\\n    scope: {\\n      touchpoints: stringArray(scope.touchpoints ?? [], 'scope.touchpoints'),\\n      nonGoals: stringArray(scope.non_goals ?? [], 'scope.non_goals'),\\n    },\\n    invariants: stringArray(raw.invariants ?? [], 'invariants'),\\n    stall: {\\n      quietTurns: positiveInteger(stall.quiet_turns, DEFAULT_STALL.quietTurns, 'stall.quiet_turns'),\\n      sameFailure: positiveInteger(stall.same_failure, DEFAULT_STALL.sameFailure, 'stall.same_failure'),\\n    },\\n    body,\\n    raw,\\n  };\\n}\\n\\n// Pure and deliberately fail-safe: an advisory note can never break a run.\\nexport function parseFlightPlan(text) {\\n  try {\\n    if (typeof text !== 'string' || text.length > 1_000_000) return null;\\n    const lines = text.replace(/^\\\\uFEFF/u, '').split(/\\\\r?\\\\n/u);\\n    if (lines[0]?.trim() !== '---') return null;\\n    const closing = lines.findIndex((line, index) => index > 0 && line.trim() === '---');\\n    if (closing < 0) return null;\\n    const tokens = frontmatterTokens(lines.slice(1, closing).join('\\\\n'));\\n    const [raw, consumed] = tokens.length ? parseBlock(tokens, 0, 0) : [{}, 0];\\n    if (consumed !== tokens.length || !isObject(raw)) return null;\\n    return normalize(raw, lines.slice(closing + 1).join('\\\\n'));\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nfunction scalarText(value) {\\n  if (value === null) return 'null';\\n  if (typeof value === 'boolean' || typeof value === 'number') return String(value);\\n  if (typeof value !== 'string') throw new TypeError('frontmatter scalar is not serializable');\\n  if (\\n    value &&\\n    !/^[-?:,[\\\\]{}#&*!|>'\\\"%@`]/u.test(value) &&\\n    !/[#:]/u.test(value) &&\\n    !/^(?:true|false|null|~|-?(?:0|[1-9]\\\\d*)(?:\\\\.\\\\d+)?)$/u.test(value)\\n  ) return value;\\n  return JSON.stringify(value);\\n}\\n\\nfunction serializeValue(key, value, indent) {\\n  const prefix = ' '.repeat(indent);\\n  if (Array.isArray(value)) {\\n    if (!value.length) return [`${prefix}${key}: []`];\\n    return [`${prefix}${key}:`, ...serializeSequence(value, indent + 2)];\\n  }\\n  if (isObject(value)) {\\n    if (!Object.keys(value).length) return [`${prefix}${key}: {}`];\\n    return [`${prefix}${key}:`, ...serializeObject(value, indent + 2)];\\n  }\\n  return [`${prefix}${key}: ${scalarText(value)}`];\\n}\\n\\nfunction serializeSequence(value, indent) {\\n  const prefix = ' '.repeat(indent);\\n  return value.flatMap((item) => {\\n    if (Array.isArray(item)) return [`${prefix}-`, ...serializeSequence(item, indent + 2)];\\n    if (isObject(item)) return [`${prefix}-`, ...serializeObject(item, indent + 2)];\\n    return [`${prefix}- ${scalarText(item)}`];\\n  });\\n}\\n\\nfunction serializeObject(value, indent = 0) {\\n  if (!isObject(value)) throw new TypeError('frontmatter root must be a mapping');\\n  return Object.entries(value).flatMap(([key, item]) => {\\n    if (!/^[A-Za-z_][A-Za-z0-9_-]*$/u.test(key)) throw new TypeError(`invalid frontmatter key ${key}`);\\n    return serializeValue(key, item, indent);\\n  });\\n}\\n\\nfunction serializablePlan(plan) {\\n  if (!isObject(plan)) throw new TypeError('flight plan must be an object');\\n  const raw = isObject(plan.raw) ? plan.raw : {};\\n  const scopeRaw = isObject(raw.scope) ? raw.scope : {};\\n  const stallRaw = isObject(raw.stall) ? raw.stall : {};\\n  const known = normalize({\\n    version: plan.version ?? raw.version,\\n    status: plan.status ?? raw.status,\\n    outcome: plan.outcome ?? raw.outcome,\\n    verify: plan.verify ?? raw.verify,\\n    scope: {\\n      ...scopeRaw,\\n      touchpoints: plan.scope?.touchpoints ?? scopeRaw.touchpoints,\\n      non_goals: plan.scope?.nonGoals ?? scopeRaw.non_goals,\\n    },\\n    invariants: plan.invariants ?? raw.invariants,\\n    stall: {\\n      ...stallRaw,\\n      quiet_turns: plan.stall?.quietTurns ?? stallRaw.quiet_turns,\\n      same_failure: plan.stall?.sameFailure ?? stallRaw.same_failure,\\n    },\\n  }, plan.body ?? '');\\n  const extras = Object.fromEntries(Object.entries(raw).filter(([key]) => !KNOWN_KEYS.has(key)));\\n  return {\\n    normalized: known,\\n    frontmatter: {\\n      version: known.version,\\n      status: known.status,\\n      outcome: known.outcome,\\n      verify: known.verify,\\n      scope: {\\n        touchpoints: known.scope.touchpoints,\\n        non_goals: known.scope.nonGoals,\\n        ...Object.fromEntries(Object.entries(scopeRaw).filter(([key]) => !['touchpoints', 'non_goals'].includes(key))),\\n      },\\n      invariants: known.invariants,\\n      stall: {\\n        quiet_turns: known.stall.quietTurns,\\n        same_failure: known.stall.sameFailure,\\n        ...Object.fromEntries(Object.entries(stallRaw).filter(([key]) => !['quiet_turns', 'same_failure'].includes(key))),\\n      },\\n      ...extras,\\n    },\\n  };\\n}\\n\\nexport async function readFlightPlan(cwd) {\\n  try {\\n    return parseFlightPlan(await readFile(join(cwd, FLIGHT_FILE), 'utf8'));\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nexport async function writeFlightPlan(cwd, plan) {\\n  const { normalized, frontmatter } = serializablePlan(plan);\\n  const directory = join(cwd, '.cruise');\\n  await mkdir(directory, { recursive: true, mode: 0o700 });\\n  const directoryMetadata = await lstat(directory);\\n  if (directoryMetadata.isSymbolicLink() || !directoryMetadata.isDirectory()) {\\n    throw new Error(`${directory} must be a directory.`);\\n  }\\n  const path = join(cwd, FLIGHT_FILE);\\n  try {\\n    const existing = await lstat(path);\\n    if (existing.isSymbolicLink() || !existing.isFile()) throw new Error(`${path} must be a regular file.`);\\n  } catch (error) {\\n    if (error?.code !== 'ENOENT') throw error;\\n  }\\n  const text = `---\\\\n${serializeObject(frontmatter).join('\\\\n')}\\\\n---\\\\n${normalized.body}`;\\n  await writeFile(path, text, { encoding: 'utf8', mode: 0o600 });\\n  return normalized;\\n}\\nimport assert from 'node:assert/strict';\\nimport { mkdtemp, readFile, rm } from 'node:fs/promises';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport test from 'node:test';\\n\\nimport {\\n  DEFAULT_STALL,\\n  FLIGHT_FILE,\\n  parseFlightPlan,\\n  readFlightPlan,\\n  writeFlightPlan,\\n} from '../scripts/lib/flight-plan.mjs';\\n\\ntest('missing optional fields receive advisory defaults', () => {\\n  const plan = parseFlightPlan('---\\\\noutcome: Ship the parser\\\\n---\\\\n# Flight plan\\\\n\\\\nKeep it small.');\\n  assert.deepEqual(plan, {\\n    version: 1,\\n    status: 'active',\\n    outcome: 'Ship the parser',\\n    verify: [],\\n    scope: { touchpoints: [], nonGoals: [] },\\n    invariants: [],\\n    stall: { quietTurns: DEFAULT_STALL.quietTurns, sameFailure: DEFAULT_STALL.sameFailure },\\n    body: '# Flight plan\\\\n\\\\nKeep it small.',\\n    raw: { outcome: 'Ship the parser' },\\n  });\\n});\\n\\ntest('write and read round-trip the pinned schema and unknown extensions', async () => {\\n  const cwd = await mkdtemp(join(tmpdir(), 'cruise-flight-'));\\n  try {\\n    await writeFlightPlan(cwd, {\\n      version: 1,\\n      status: 'active',\\n      outcome: 'Make parsing failures harmless',\\n      verify: ['npm test', 'node --check scripts/lib/flight-plan.mjs'],\\n      scope: { touchpoints: ['scripts/lib/'], nonGoals: ['No public API redesign'] },\\n      invariants: ['Existing CLI flags keep their behavior'],\\n      stall: { quietTurns: 4, sameFailure: 2 },\\n      body: '# Flight plan\\\\n\\\\nThe host remains the authority.',\\n      raw: {\\n        owner: 'user-editable',\\n        scope: { reviewer: 'optional' },\\n        stall: { strategy: 'realign' },\\n      },\\n    });\\n\\n    const plan = await readFlightPlan(cwd);\\n    assert.equal(plan.outcome, 'Make parsing failures harmless');\\n    assert.deepEqual(plan.verify, ['npm test', 'node --check scripts/lib/flight-plan.mjs']);\\n    assert.deepEqual(plan.scope, {\\n      touchpoints: ['scripts/lib/'],\\n      nonGoals: ['No public API redesign'],\\n    });\\n    assert.deepEqual(plan.stall, { quietTurns: 4, sameFailure: 2 });\\n    assert.equal(plan.raw.owner, 'user-editable');\\n    assert.equal(plan.raw.scope.reviewer, 'optional');\\n    assert.equal(plan.raw.stall.strategy, 'realign');\\n    assert.equal(plan.body, '# Flight plan\\\\n\\\\nThe host remains the authority.');\\n    assert.match(await readFile(join(cwd, FLIGHT_FILE), 'utf8'), /^---\\\\nversion: 1\\\\nstatus: active/u);\\n  } finally {\\n    await rm(cwd, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('malformed or invalid frontmatter returns null', async () => {\\n  const inputs = [\\n    '',\\n    'outcome: missing fences',\\n    '---\\\\noutcome: never closed',\\n    '---\\\\n status: active\\\\n---\\\\n',\\n    '---\\\\nstatus: launched\\\\n---\\\\n',\\n    '---\\\\nverify: npm test\\\\n---\\\\n',\\n    '---\\\\nstall:\\\\n  quiet_turns: 0\\\\n---\\\\n',\\n  ];\\n  for (const input of inputs) assert.equal(parseFlightPlan(input), null);\\n\\n  const cwd = await mkdtemp(join(tmpdir(), 'cruise-flight-missing-'));\\n  try {\\n    assert.equal(await readFlightPlan(cwd), null);\\n  } finally {\\n    await rm(cwd, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('parseFlightPlan never throws on pathological text', () => {\\n  const inputs = [\\n    null,\\n    42,\\n    '\\\\u0000\\\\u0001\\\\u0002',\\n    `---\\\\n${'  nested:\\\\n'.repeat(20)}value: nope\\\\n---\\\\n`,\\n    `---\\\\nitems:\\\\n${'  - value\\\\n'.repeat(1_100)}---\\\\n`,\\n    '---\\\\nvalue: \\\"unterminated\\\\n---\\\\n',\\n    '---\\\\n__proto__:\\\\n  polluted: true\\\\n---\\\\n',\\n  ];\\n  for (const input of inputs) assert.doesNotThrow(() => parseFlightPlan(input));\\n});\\n{\\n  \\\"name\\\": \\\"cruise-code\\\",\\n  \\\"version\\\": \\\"0.1.0\\\",\\n  \\\"type\\\": \\\"module\\\",\\n  \\\"description\\\": \\\"Cruise plugins and terminal launcher for Codex and Claude Code\\\",\\n  \\\"main\\\": \\\"index.js\\\",\\n  \\\"homepage\\\": \\\"https://github.com/qwerty-sapien/cruise#readme\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"git+https://github.com/qwerty-sapien/cruise.git\\\"\\n  },\\n  \\\"bugs\\\": {\\n    \\\"url\\\": \\\"https://github.com/qwerty-sapien/cruise/issues\\\"\\n  },\\n  \\\"bin\\\": {\\n    \\\"cruise\\\": \\\"index.js\\\"\\n  },\\n  \\\"files\\\": [\\n    \\\".codex-plugin/\\\",\\n    \\\".claude-plugin/\\\",\\n    \\\"index.js\\\",\\n    \\\"scripts/cruise.mjs\\\",\\n    \\\"scripts/lib/app-server-client.mjs\\\",\\n    \\\"scripts/lib/claude-cli.mjs\\\",\\n    \\\"scripts/lib/flight-plan.mjs\\\",\\n    \\\"scripts/lib/line-input.mjs\\\",\\n    \\\"scripts/lib/model-policy.mjs\\\",\\n    \\\"scripts/lib/origin-note.mjs\\\",\\n    \\\"scripts/lib/picker.mjs\\\",\\n    \\\"scripts/lib/provider.mjs\\\",\\n    \\\"scripts/lib/simple-session.mjs\\\",\\n    \\\"scripts/lib/simple-worker.mjs\\\",\\n    \\\"scripts/lib/worker-policy.mjs\\\",\\n    \\\"skills/\\\"\\n  ],\\n  \\\"scripts\\\": {\\n    \\\"test\\\": \\\"node --test tests/app-server-client.test.mjs tests/line-input.test.mjs tests/picker.test.mjs tests/origin-note.test.mjs tests/flight-plan.test.mjs tests/debug-skill.test.mjs tests/simple-worker.test.mjs tests/claude-cli.test.mjs tests/cli-simple.test.mjs tests/simple-session.test.mjs\\\",\\n    \\\"validate\\\": \\\"npm test\\\"\\n  },\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\">=20\\\"\\n  },\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"keywords\\\": [\\n    \\\"codex\\\",\\n    \\\"codex-cli\\\",\\n    \\\"codex-plugin\\\",\\n    \\\"claude-code\\\",\\n    \\\"claude-code-plugin\\\",\\n    \\\"cli\\\",\\n    \\\"coding-agent\\\",\\n    \\\"developer-tools\\\",\\n    \\\"agentic-workflows\\\",\\n    \\\"workflow-automation\\\"\\n  ]\\n}\\n\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"019f8372-68fb-7750-8775-7cd68e300b6f\"}}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:134:{\"timestamp\":\"2026-07-21T06:53:09.879Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"call_id\":\"call_AtQDY4UzacN8AMeFHF1AY2W0\",\"output\":[{\"type\":\"input_text\",\"text\":\"Script completed\\nWall time 0.1 seconds\\nOutput:\\n\"},{\"type\":\"input_text\",\"text\":\"Warning: truncated output (original token count: 12380)\\nTotal output lines: 828\\n\\nimport assert from 'node:assert/strict';\\nimport { EventEmitter } from 'node:events';\\nimport { mkdtemp, rm } from 'node:fs/promises';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport test from 'node:test';\\n\\nimport {\\n  automaticGoalAuthorization,\\n  automaticRoutineGoalAdvance,\\n  SimpleCruiseInterruptedError,\\n  SimpleCruiseSession,\\n} from '../scripts/lib/simple-session.mjs';\\n\\nclass FakeClient extends EventEmitter {\\n  async start() {}\\n  async stop() {}\\n  async request(method) {\\n    if (method === 'thread/start') return { thread: { id: 'thread-1' } };\\n    if (method === 'turn/start') {\\n      queueMicrotask(() => {\\n        this.emit('notification', { method: 'item/agentMessage/delta', params: { delta: 'done' } });\\n        this.emit('notification', { method: 'turn/completed', params: { turn: { id: 'turn-1', status: 'completed' } } });\\n      });\\n      return { turn: { id: 'turn-1' } };\\n    }\\n    throw new Error(`unexpected request ${method}`);\\n  }\\n}\\n\\ntest('simple sessions send one normal skill turn without control-plane instructions', async (t) => {\\n  const root = await mkdtemp(join(tmpdir(), 'cruise-simple-session-'));\\n  t.after(() => rm(root, { recursive: true, force: true }));\\n  const client = new FakeClient();\\n  let output = '';\\n  const session = new SimpleCruiseSession({\\n    client,\\n    cwd: root,\\n    prompt: 'Inspect this repository.',\\n    skill: 'quick',\\n    skillPath: '/tmp/quick-skill.md',\\n    pickOne: async () => ({ status: 'cancelled' }),\\n    readLine: async () => '',\\n    output: { write(value) { output += value; } },\\n  });\\n  assert.deepEqual(await session.run(), { status: 'complete', skill: 'quick', threadId: 'thread-1' });\\n  assert.match(output, /done/u);\\n});\\n\\ntest('Goal auto-advances each completed active turn until native completion', async (t) => {\\n  const root = await mkdtemp(join(tmpdir(), 'cruise-simple-goal-'));\\n  t.after(() => rm(root, { recursive: true, force: true }));\\n  class GoalClient extends EventEmitter {\\n    constructor() {\\n      super();\\n      this.calls = [];\\n      this.goal = null;\\n      this.turns = 0;\\n      this.nativeCompletionEmitted = false;\\n    }\\n\\n    async start() {}\\n    async stop() {}\\n\\n    async request(method, params = {}) {\\n      this.calls.push({ method, params });\\n      if (method === 'thread/start') {\\n        return { thread: { id: 'thread-goal' }, model: 'gpt-test', reasoningEffort: 'medium' };\\n      }\\n      if (method === 'thread/settings/update') return {};\\n      if (method === 'thread/goal/get') return { goal: this.goal };\\n      if (method === 'thread/goal/set') {\\n        this.goal = { objective: params.objective, status: params.status };\\n        queueMicrotask(() => {\\n          this.emit('notification', {\\n            method: 'turn/started',\\n            params: { threadId: 'thread-goal', turn: { id: 'turn-native', status: 'inProgress' } },\\n          });\\n          this.emit('notification', {\\n            method: 'turn/completed',\\n            params: { threadId: 'another-thread', turn: { id: 'turn-native', status: 'completed' } },\\n          });\\n          setImmediate(() => {\\n            this.nativeCompletionEmitted = true;\\n            this.emit('notification', {\\n              method: 'turn/completed',\\n              params: { threadId: 'thread-goal', turn: { id: 'turn-native', status: 'completed' } },\\n            });\\n          });\\n        });\\n        return { goal: this.goal };\\n      }\\n      if (method === 'turn/start') {\\n        if (!this.nativeCompletionEmitted) {\\n          throw new Error('the foreign completion advanced the Goal before its native Plan turn completed');\\n        }\\n        this.turns += 1;\\n        const id = `turn-${this.turns}`;\\n        queueMicrotask(() => {\\n          if (this.turns === 1) {\\n            this.goal = { ...this.goal, status: 'complete' };\\n            this.emit('notification', {\\n              method: 'thread/goal/updated',\\n              params: { threadId: 'thread-goal', goal: this.goal },\\n            });\\n          }\\n          this.emit('notification', {\\n            method: 'turn/completed',\\n            params: { threadId: 'thread-goal', turn: { id, status: 'completed' } },\\n          });\\n        });\\n        return { turn: { id } };\\n      }\\n      throw new Error(`unexpected request ${method}`);\\n    }\\n  }\\n\\n  const client = new GoalClient();\\n  const session = new SimpleCruiseSession({\\n    client,\\n    cwd: root,\\n    prompt: 'Implement and verify the full migration.',\\n    skill: 'goal',\\n    skillPath: '/tmp/goal-skill.md',\\n    pickOne: async () => {\\n      throw new Error('routine Goal progression must not open the picker');\\n    },\\n    readLine: async () => '',\\n  });\\n  const result = await session.run();\\n\\n  assert.equal(result.status, 'complete');\\n  assert.equal(client.turns, 1);\\n  assert.deepEqual(\\n    client.calls.map(({ method }) => method),\\n    ['thread/start', 'thread/settings/update', 'thread/goal/get', 'thread/goal/set', 'thread/goal/get', 'thread/settings/update', 'turn/start', 'thread/goal/get'],\\n  );\\n  const continuation = client.calls.find(({ method }) => method === 'turn/start').params.input;\\n  const objective = client.calls.find(({ method }) => method === 'thread/goal/set').params.objective;\\n  assert.match(objective, /sole read-only Plan-mode bootstrap/u);\\n  assert.match(objective, /\\\\.cruise\\\\/FLIGHT\\\\.md/u);\\n  assert.match(objective, /implement, verify, realign, and continue/u);\\n  assert.equal(continuation.some((item) => item.type === 'skill'), false);\\n  assert.match(continuation[0].text, /next ready micro-goal/u);\\n  assert.match(continuation[0].text, /immediately implement/u);\\n  assert.match(continuation[0].text, /independent breakage probes/u);\\n  assert.match(continuation[0].text, /flight plan/u);\\n  const [planSettings, executionSettings] = client.calls\\n    .filter(({ method }) => method === 'thread/settings/update')\\n    .map(({ params }) => params);\\n  assert.equal(continuation[0].type, 'text');\\n  assert.equal(planSettings.collaborationMode.mode, 'plan');\\n  assert.equal(planSettings.sandboxPolicy.type, 'readOnly');\\n  assert.equal(executionSettings.collaborationMode.mode, 'default');\\n  assert.equal(executionSettings.sandboxPolicy.type, 'workspaceWrite');\\n  assert.equal(client.calls.find(({ method }) => method === 'turn/start').params.collaborationMode.mode, 'default');\\n  assert.equal(client.calls.find(({ method }) => method === 'turn/start').params.sandboxPolicy.type, 'workspaceWrite');\\n});\\n\\ntest('interrupting an activation pauses a Goal that became active in flight', async (t) => {\\n  const root = await mkdtemp(join(tmpdir(), 'cruise-interrupted-goal-'));\\n  t.after(() => rm(root, { recursive: true, force: true }));\\n  let releaseActivation;\\n  const activationGate = new Promise((resolve) => {\\n    releaseActivation = resolve;\\n  });\\n  class InterruptibleGoalClient extends EventEmitter {\\n    constructor() {\\n      super();\\n      this.calls = [];\\n      this.goal = null;\\n    }\\n\\n    async start() {}\\n    async stop() {}\\n\\n    async request(method, params = {}) {\\n      this.calls.push({ method, params });\\n      if (method === 'thread/start') return { thread: { id: 'thread-interrupt' } };\\n      if (method === 'thread/settings/update') return {};\\n      if (method === 'thread/goal/get') return { goal: this.goal };\\n      if (method === 'thread/goal/set' && params.status === 'active') {\\n        await activationGate;\\n        this.goal = { objective: params.objective, status: 'active' };\\n        return { goal: this.goal };\\n      }\\n      if (method === 'thread/goal/set' && params.status === 'paused') {\\n        this.goal = { objective: params.objective, status: 'paused' };\\n        return { goal: this.goal };\\n      }\\n      throw new Error(`unexpected request ${method}`);\\n    }\\n  }\\n\\n  const client = new InterruptibleGoalClient();\\n  const session = new SimpleCruiseSession({\\n    client,\\n    cwd: root,\\n    prompt: 'Implement the migration.',\\n    skill: 'goal',\\n    skillPath: '/tmp/goal-skill.md',\\n    pickOne: async () => ({ status: 'cancelled' }),\\n    readLine: async () => '',\\n  });\\n  const running = session.run();\\n  await new Promise((resolve) => setImmediate(resolve));\\n  assert.equal(\\n    client.calls.some(({ method, params }) => method === 'thread/goal/set' && params.status === 'active'),\\n    true,\\n  );\\n  const interrupted = session.interrupt();\\n  releaseActivation();\\n  await interrupted;\\n  await assert.rejects(running, (error) => error instanceof SimpleCruiseInterruptedError);\\n  assert.equal(client.goal.status, 'paused');\\n  assert.equal(\\n    client.calls.some(({ method, params }) => method === 'thread/goal/set' && params.status === 'paused'),\\n    true,\\n  );\\n});\\n\\ntest('a plan-only Goal completes after its native Plan turn without implementation', async (t) => {\\n  const root = await mkdtemp(join(tmpdir(), 'cruise-plan-only-goal-'));\\n  t.after(() => rm(root, { recursive: true, force: true }));\\n  class PlanOnlyGoalClient extends EventEmitter {\\n    constructor() {\\n      super();\\n      this.calls = [];\\n      this.goal = null;\\n    }\\n\\n    async start() {}\\n    async stop() {}\\n\\n    async request(method, params = {}) {\\n      this.calls.push({ method, params });\\n      if (method === 'thread/start') return { thread: { id: 'thread-plan-only' } };\\n      if (method === 'thread/settings/update') return {};\\n      if (method === 'thread/goal/get') return { goal: this.goal };\\n      if (method === 'thread/goal/set') {\\n        this.goal = { objective: params.objective, status: params.status };\\n        if (params.status === 'active') {\\n          queueMicrotask(() => {\\n            this.emit('notification', {\\n              method: 'turn/started',\\n              params: { threadId: 'thread-plan-only', turn: { id: 'turn-plan', status: 'inProgress' } },\\n            });\\n            this.emit('notification', {\\n              method: 'turn/completed',\\n              params: { threadId: 'thread-plan-only', turn: { id: 'turn-plan', status: 'completed' } },\\n            });\\n          });\\n        }\\n        return { goal: this.goal };\\n      }\\n      if (method === 'turn/start') {\\n        throw new Error('a plan-only Goal must not start a Default-mode implementation turn');\\n      }\\n      throw new Error(`unexpected request ${method}`);\\n    }\\nimport assert from 'node:assert/strict';\\nimport { EventEmitter } from 'node:events';\\nimport { readFile } from 'node:fs/promises';\\nimport test from 'node:test';\\n\\nimport {\\n  CLAUDE_WORKER_LEVEL_POLICY,\\n  claudeSessionArgs,\\n  claudeWorkerArgs,\\n  runClaudeCli,\\n} from '../scripts/lib/claude-cli.mjs';\\n\\ntest('Claude sessions load the plugin and invoke the slash-command skill natively', () => {\\n  const args = claudeSessionArgs({\\n    pluginRoot: '/workspace/cruise',\\n    skill: 'goal',\\n    prompt: 'Complete the migration.',\\n  });\\n  assert.deepEqual(args.slice(0, 4), [\\n    '--plugin-dir',\\n    '/workspace/cruise',\\n    '--name',\\n    'Cruise goal',\\n  ]);\\n  assert.equal(args.at(-1), '/cruise:goal Complete the migration.');\\n  assert.equal(args.includes('--permission-mode'), false);\\n  assert.match(args[args.indexOf('--append-system-prompt') + 1], /no documented Codex-style Goal lifecycle API/u);\\n  assert.match(args[args.indexOf('--append-system-prompt') + 1], /\\\\.cruise\\\\/FLIGHT\\\\.md/u);\\n});\\n\\ntest('the published package contains both plugin manifests and only the active runtime closure', async () => {\\n  const metadata = JSON.parse(await readFile(new URL('../package.json', import.meta.url), 'utf8'));\\n  assert.equal(metadata.files.includes('.codex-plugin/'), true);\\n  assert.equal(metadata.files.includes('.claude-plugin/'), true);\\n  assert.equal(metadata.files.includes('scripts/'), false);\\n  assert.equal(metadata.files.includes('scripts/cruise.mjs'), true);\\n  assert.equal(metadata.files.includes('scripts/lib/provider.mjs'), true);\\n  assert.equal(metadata.files.includes('scripts/lib/claude-cli.mjs'), true);\\n  assert.equal(metadata.files.includes('scripts/lib/flight-plan.mjs'), true);\\n});\\n\\ntest('Claude worker levels map to Claude model aliases and native effort values', () => {\\n  assert.deepEqual(CLAUDE_WORKER_LEVEL_POLICY[1], { model: 'haiku', effort: 'low' });\\n  assert.deepEqual(CLAUDE_WORKER_LEVEL_POLICY[7], { model: 'opus', effort: 'max' });\\n  const defaultArgs = claudeWorkerArgs({ task: 'Run tests.' });\\n  assert.equal(defaultArgs.includes('--model'), false);\\n  assert.equal(defaultArgs.includes('--effort'), false);\\n  const selectedArgs = claudeWorkerArgs({ task: 'Run tests.', level: 6 });\\n  assert.deepEqual(\\n    selectedArgs.slice(selectedArgs.indexOf('--model'), selectedArgs.indexOf('--model') + 4),\\n    ['--model', 'opus', '--effort', 'high'],\\n  );\\n});\\n\\ntest('Claude CLI transport inherits the native TUI and returns its exit status', async () => {\\n  const calls = [];\\n  class Child extends EventEmitter {}\\n  const resultPromise = runClaudeCli({\\n    cwd: '/workspace',\\n    args: ['--version'],\\n    env: { TEST: '1' },\\n    spawnFn(command, args, options) {\\n      calls.push({ command, args, options });\\n      const child = new Child();\\n      queueMicrotask(() => child.emit('exit', 0, null));\\n      return child;\\n    },\\n  });\\n  assert.deepEqual(await resultPromise, { code: 0, signal: null });\\n  assert.equal(calls[0].command, 'claude');\\n  assert.equal(calls[0].options.stdio, 'inherit');\\n  assert.equal(calls[0].options.cwd, '/workspace');\\n});\\nimport { EventEmitter } from 'node:events';\\n\\nconst TERMINAL_GOAL_STATUSES = new Set([\\n  'paused',\\n  'blocked',\\n  'usageLimited',\\n  'budgetLimited',\\n  'complete',\\n]);\\n\\nconst ROUTINE_GOAL_ADVANCE_QUESTION = /^(?:(?:[ptm]-?\\\\d+|phase\\\\s*\\\\d+|subtask\\\\s*\\\\d+|task\\\\s*\\\\d+|micro[-\\\\s]?goal)\\\\s*)?(?:(?:has\\\\s+)?passed(?:\\\\s+its)?(?:\\\\s+focused)?(?:\\\\s+readiness)?\\\\s+checks|is\\\\s+ready|is\\\\s+complete|completed)\\\\.?\\\\s*(?:what\\\\s+next|continue|proceed|advance)?\\\\??$/iu;\\nconst ROUTINE_GOAL_ADVANCE_OPTION = /^\\\\s*(?:approve\\\\s+(?:[ptm]-?\\\\d+|phase\\\\s*\\\\d+|subtask\\\\s*\\\\d+|task\\\\s*\\\\d+|micro[-\\\\s]?goal)(?:\\\\s+only)?|(?:proceed|continue|advance|resume|start|implement|execute)\\\\s+(?:the\\\\s+)?(?:next\\\\s+)?(?:ready\\\\s+)?(?:[ptm]-?\\\\d+|phase\\\\s*\\\\d+|subtask\\\\s*\\\\d+|task\\\\s*\\\\d+|micro[-\\\\s]?goal))\\\\b/iu;\\nconst PREPARATION_ONLY_GOAL_PROMPT = /\\\\b(?:only\\\\s+(?:plan|research|prepare|design)|(?:plan|research|prepare|design)\\\\s+only|do\\\\s+not\\\\s+(?:implement|edit|write(?:\\\\s+code)?|execute)|do\\\\s+not\\\\s+make\\\\s+(?:code\\\\s+)?changes|without\\\\s+implementation)\\\\b/iu;\\nconst GOAL_AUTHORIZATION_CONTEXT = /\\\\b(?:plan(?:\\\\s+and\\\\s+goal)?|goal|cruise|contract|phase|micro[-\\\\s]?goal|next\\\\s+(?:step|phase|micro[-\\\\s]?goal))\\\\b/iu;\\nconst GOAL_AUTHORIZATION_OPTION = /^\\\\s*(?:approve(?:\\\\s+(?:both|the\\\\s+(?:plan|goal|contract)|[a-z]+-?\\\\d+\\\\s+contract))?|start\\\\s+cruise|continue|proceed|execute|implement)\\\\b/iu;\\nconst HIGH_RISK_GOAL_AUTHORIZATION = /\\\\b(?:credential|secret|password|token|authentication|login|payment|purchase|production|deploy|publish|release|delete|remove|reset|rewrite|force|sudo|sensitive|private\\\\s+data)\\\\b/iu;\\nconst MATERIAL_GOAL_DECISION = /\\\\b(?:not\\\\s+requested|out(?:side)?\\\\s+(?:the\\\\s+)?scope|scope\\\\s+(?:change|expansion)|which\\\\s+(?:option|approach)|user\\\\s+preference)\\\\b/iu;\\n\\nconst AUTONOMOUS_GOAL_INSTRUCTIONS = [\\n  'The user explicitly invoked Cruise Goal, which authorizes autonomous end-to-end progress within the normal Codex workspace and permission boundaries.',\\n  'Use the first read-only Plan turn only to inspect the repository, resolve the outcome, touchpoints, non-goals, invariants, acceptance commands, and stall tuning, and form a strongly aligned plan for the first ready micro-goal. Unless the user explicitly requested planning or research only, that plan is not an endpoint: the following native Goal turn must immediately implement it and write the advisory .cruise/FLIGHT.md as its first execution act.',\\n  'For every micro-goal, reread and reconcile the user-editable flight plan with the requested outcome and current repository evidence; realign before work outside its touchpoints or inside its non-goals; re-verify affected invariants; make a compact plan for the next ready slice; implement it; run focused verification; remediate in-scope failures; recheck alignment and regression risk; then immediately execute the next ready micro-goal.',\\n  'When changed behavior has meaningful concurrency, lifecycle, migration, public-contract, security, integration, or edge-case risk, use available independent reviewers or a bounded agent swarm to try to break it. Give them non-overlapping probes, reproduce credible findings, and refine before advancing. Skip this for simple low-risk work and never claim independent coverage that did not run.',\\n  'Do not ask the user to approve a phase, checkpoint, plan handoff, or ordinary next step. Ask only for a material product decision that repository evidence cannot resolve, a scope or safety expansion, authentication or secret entry, or a host-required external or destructive approval.',\\n  'Do not mark the Goal paused or blocked merely because a phase ended or because a fresh continuation is needed. Cruise starts another turn automatically while the Goal remains active.',\\n  'Keep the native Goal active until every requested acceptance and verification criterion passes, then set the flight plan and Goal to complete. Set both to blocked only for a concrete unresolved blocker, stating the blocker and evidence needed to resume in the flight-plan body. The flight plan grants and gates nothing; native permissions remain authoritative.',\\n].join(' ');\\n\\nconst GOAL_BOOTSTRAP_INSTRUCTIONS = [\\n  'Begin with this sole read-only Plan-mode bootstrap, not a plan-only handoff.',\\n  'Inspect the codebase, resolve the advisory flight plan fields, and state a compact plan for the first ready, in-scope micro-goal. This turn cannot write .cruise/FLIGHT.md.',\\n  'Do not implement in this Plan turn. Unless the request explicitly limits work to planning or research, switch to Default mode immediately afterward and implement and verify this micro-goal.',\\n].join(' ');\\n\\nconst GOAL_CONTINUATION_INSTRUCTIONS = [\\n  'Continue the active Cruise Goal now; this is execution, not a request for a new plan review.',\\n  'Write .cruise/FLIGHT.md first if execution has not created it yet, then reread and reconcile its user-editable outcome, scope fence, invariants, acceptance commands, and stall tuning with current repository evidence, completed work, and remaining criteria.',\\n  'Draft only a compact, codebase-aware plan for the next ready micro-goal, then immediately implement it and run focused verification.',\\n  'Remediate in-scope failures, recheck alignment and regression risk, use bounded independent breakage probes when the change warrants them, and continue until the flight plan and Goal are truthfully complete or both report a concrete material blocker.',\\n  'Routine micro-goal progression is already authorized; do not ask the user for a phase or plan approval.',\\n].join(' ');\\n\\n\\nfunction deferred() {\\n  let resolve;\\n  let reject;\\n  const promise = new Promise((resolvePromise, rejectPromise) => {\\n    resolve = resolvePromise;\\n    reject = rejectPromise;\\n  });\\n  return { promise, resolve, reject };\\n}\\n\\nfunction selectionValue(selection) {\\n  return selection?.value ?? selection?.label ?? null;\\n}\\n\\nfunction optionValue(option) {\\n  if (typeof option === 'string') return option;\\n  return option?.value ?? option?.label ?? null;\\n}\\n\\nfunction optionLabel(option) {\\n  if (typeof option === 'string') return option;\\n  return option?.label ?? option?.value ?? '';\\n}\\n\\nfunction isPreparationOnlyGoalPrompt(prompt) {\\n  return PREPARATION_ONLY_GOAL_PROMPT.test(String(prompt ?? ''));\\n}\\n\\n/**\\n * Phase gates are an implementation detail of a Goal, not a fresh user\\n * authorization.  Accept only an unmistakably routine structured gate; all\\n * material choices and every free-text question still go to the user.\\n */\\nexport function automaticRoutineGoalAdvance(params = {}) {\\n  const questions = Array.isArray(params.questions) ? params.questions : [];\\n  if (questions.length === 0) return null;\\n\\n  const answers = {};\\n  for (const question of questions) {\\n    const options = Array.isArray(question?.options) ? question.options : [];\\n    if (!ROUTINE_GOA[stdout]
L_AD…2380 tokens truncated…   cwd,\\n    args: claudeSessionArgs({ pluginRoot, skill, prompt }),\\n    spawnFn,\\n  });\\n  return Object.freeze({\\n    status: result.code === 0 ? 'complete' : result.code === 130 ? 'interrupted' : 'failed',\\n    exitCode: result.code,\\n  });\\n}\\n\\nexport async function runClaudeWorker({ cwd, task, level = null, spawnFn } = {}) {\\n  const result = await runClaudeCli({\\n    cwd,\\n    args: claudeWorkerArgs({ task, level }),\\n    spawnFn,\\n  });\\n  if (result.code !== 0) {\\n    throw new Error(`Claude Code worker exited with status ${result.code}`);\\n  }\\n  return Object.freeze({ output: '', effectsObserved: false });\\n}\\n---\\nname: goal\\ndescription: \\\"Autonomously complete consequential or multi-step work: plan just enough to begin, implement, validate, adversarially challenge when warranted, and refine until the outcome is complete.\\\"\\n---\\n\\n# Cruise Goal\\n\\nFor consequential work, inspect the repository and make a proportionate plan. Treat an explicit `cruise goal` invocation as authorization to carry the requested work through to completion within the normal workspace and permission boundaries. That authorization includes routine planning and phase transitions; never require a copied approval phrase, digest acknowledgement, or an `--auto-approve` incantation. Respect an explicit request to only plan, research, or prepare; otherwise, a plan is an instruction to implement, never the endpoint.\\n\\n## Use the selected host natively\\n\\n- **Codex:** use native Goal state when it is available. A Goal starts with the host's read-only Plan-mode turn and then moves to normal Goal execution. Keep the Goal active through implementation and verification, and use the Goal status as the completion authority.\\n- **Claude Code:** no documented Codex-style Goal lifecycle endpoint is available to plugins. Do not invent one. Stay in the user's current Claude permission mode, maintain the work as a concise native task list, and continue the execution loop in the same resumable session. Do not enter Claude's approval-gated `/plan` mode merely as ceremony; use it only when the user requested read-only planning. Use native Claude subagents for bounded independent work when warranted. Interruption and continuation are the native session controls (`Ctrl-C`, `/resume`, `--continue`, and `--resume`), not synthetic Cruise Goal states.\\n\\nTreat worker-level and communication-manner preferences as natural-language instructions for this request only. Never persist or globally enforce them. Override the ordinary worker level only when the user explicitly asks for a higher, lower, or numbered level; an explicit terminal `cruise worker --level <1-7>` selection has highest priority for that invocation.\\n\\nEstablish a codebase-aware execution path only long enough to begin. Identify the requested outcome, protected behavior, likely owners and touch points, acceptance evidence, and the smallest ready micro-goal. State a compact, strongly aligned plan for that micro-goal, then implement it. Do not wait for a routine plan review, phase approval, or a new invocation. On Codex, respect the launcher's initial read-only Plan turn and move directly into active Goal execution afterward. On Claude Code, plan in the current session without manufacturing a mode transition.\\n\\n## Keep an advisory flight plan\\n\\nDuring the initial inspection, resolve the outcome, scope fence, invariants, acceptance commands, and useful stall tuning. Write them to `.cruise/FLIGHT.md` as the first act of execution mode; Codex's bootstrap Plan turn is read-only, so do not fight it. The flight plan is a user-editable advisory note, not permission, authority, or a gate. It does not change `.cruise/ORIGIN.md` semantics.\\n\\nAt each micro-goal reconciliation, reread the flight plan. Work outside its `touchpoints`, work that enters a `non_goals` fence, or changes that threaten an invariant require realignment or a material user decision; re-verify every invariant whose surface changed. Set `status: complete` only when acceptance evidence passes. Set `status: blocked` only for a concrete blocker and state that blocker in the body.\\n\\nRun a closed execution loop for every micro-goal:\\n\\n1. Reconcile the requested outcome, current repository evidence, prior changes, and remaining acceptance criteria.\\n2. Draft only the next ready micro-goal’s actionable plan: ownership, files or interfaces, implementation approach, risks, and focused verification.\\n3. Implement the micro-goal, run the focused checks, and remediate in-scope failures.\\n4. Recheck alignment and regression risk. Incorporate confirmed findings, update the next micro-goal, and continue immediately while work remains.\\n\\nDo not present phase, checkpoint, or routine next-step approvals such as “Approve P-03” or “Stop after P-02”. A completed turn is a continuation point, not a human gate. Keep the host-native execution state active through planning, implementation, validation, and refinement; finish only once the requested outcome and its evidence are complete.\\n\\nUse an adversarial review or agent swarm only when it has a meaningful chance to expose a bug: for example, changed concurrency or lifecycle behavior, migrations, public contracts, security-sensitive logic, broad integration paths, or an implementation with unresolved edge-case risk. Give independent reviewers bounded, non-overlapping probes or isolated scopes; ask them to try to break the implementation rather than repeat its happy path. Reproduce and resolve credible findings before advancing. Do not create a swarm for a simple, low-risk change, and do not claim independent coverage when it was unavailable.\\n\\nAsk the user only when repository evidence cannot resolve a material product decision, the work needs a scope or safety expansion, authentication or secret entry is required, or the host requires approval for an external or destructive effect. Do not ask about routine sequencing, ordinary implementation choices, or whether to execute an already planned in-scope micro-goal. Do not report blocked merely because another internal phase remains. Report completion only after the requested evidence passes; report blocked only with a concrete unresolved blocker and the evidence or decision needed to resume.\\n\\nCruise does not create a Goal suite, approval digest, archive, attempt ledger, or run-control directory. The launcher may write `.cruise/ORIGIN.md` containing exactly the request; it is a note only and does not authorize work.\\n\\nIf a worker stream fails, state the observed failure category and retry normally when appropriate. Never require a magic retry phrase, a fresh Cruise run, an archive, or a DNS-health assertion that the error does not support.\\nscripts/lib/claude-cli.mjs:19:  'Claude Code exposes no documented Codex-style Goal lifecycle API to plugins; do not invent Goal endpoints or Goal state.',\\nscripts/lib/claude-cli.mjs:20:  'For Goal work, resolve the outcome, scope fence, invariants, acceptance commands, and stall tuning, then write the user-editable advisory .cruise/FLIGHT.md as the first execution act; reread it at each micro-goal, realign scope drift, re-verify affected invariants, and keep its status truthful through completion or a concrete blocker. It grants and gates nothing.',\\nscripts/lib/simple-session.mjs:20:  'The user explicitly invoked Cruise Goal, which authorizes autonomous end-to-end progress within the normal Codex workspace and permission boundaries.',\\nscripts/lib/simple-session.mjs:21:  'Use the first read-only Plan turn only to inspect the repository, resolve the outcome, touchpoints, non-goals, invariants, acceptance commands, and stall tuning, and form a strongly aligned plan for the first ready micro-goal. Unless the user explicitly requested planning or research only, that plan is not an endpoint: the following native Goal turn must immediately implement it and write the advisory .cruise/FLIGHT.md as its first execution act.',\\nscripts/lib/simple-session.mjs:22:  'For every micro-goal, reread and reconcile the user-editable flight plan with the requested outcome and current repository evidence; realign before work outside its touchpoints or inside its non-goals; re-verify affected invariants; make a compact plan for the next ready slice; implement it; run focused verification; remediate in-scope failures; recheck alignment and regression risk; then immediately execute the next ready micro-goal.',\\nscripts/lib/simple-session.mjs:25:  'Do not mark the Goal paused or blocked merely because a phase ended or because a fresh continuation is needed. Cruise starts another turn automatically while the Goal remains active.',\\nscripts/lib/simple-session.mjs:26:  'Keep the native Goal active until every requested acceptance and verification criterion passes, then set the flight plan and Goal to complete. Set both to blocked only for a concrete unresolved blocker, stating the blocker and evidence needed to resume in the flight-plan body. The flight plan grants and gates nothing; native permissions remain authoritative.',\\nscripts/lib/simple-session.mjs:31:  'Inspect the codebase, resolve the advisory flight plan fields, and state a compact plan for the first ready, in-scope micro-goal. This turn cannot write .cruise/FLIGHT.md.',\\nscripts/lib/simple-session.mjs:36:  'Continue the active Cruise Goal now; this is execution, not a request for a new plan review.',\\nscripts/lib/simple-session.mjs:37:  'Write .cruise/FLIGHT.md first if execution has not created it yet, then reread and reconcile its user-editable outcome, scope fence, invariants, acceptance commands, and stall tuning with current repository evidence, completed work, and remaining criteria.',\\nscripts/lib/simple-session.mjs:39:  'Remediate in-scope failures, recheck alignment and regression risk, use bounded independent breakage probes when the change warrants them, and co