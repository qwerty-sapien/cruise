et cursor = start;\\n    74\\t  while (cursor < tokens.length && tokens[cursor].indent >= indent) {\\n    75\\t    const token = tokens[cursor];\\n    76\\t    if (token.indent !== indent) throw new Error(`unexpected indentation on line ${token.line}`);\\n    77\\t    const item = token.content === '-' || token.content.startsWith('- ');\\n    78\\t    if (item !== sequence) throw new Error(`mixed mapping and sequence on line ${token.line}`);\\n    79\\t    if (sequence) {\\n    80\\t      const rest = token.content.slice(1).trim();\\n    81\\t      if (rest) result.push(parseScalar(rest));\\n    82\\t      else if (tokens[cursor + 1]?.indent === indent + 2) {\\n    83\\t        const [child, next] = parseBlock(tokens, cursor + 1, indent + 2, depth + 1);\\n    84\\t        result.push(child);\\n    85\\t        cursor = next - 1;\\n    86\\t      } else result.push(null);\\n    87\\t    } else {\\n    88\\t      const separator = token.content.indexOf(':');\\n    89\\t      if (separator < 1) throw new Error(`expected a mapping on line ${token.line}`);\\n    90\\t      const key = token.content.slice(0, separator).trim();\\n    91\\t      if (\\n    92\\t        !/^[A-Za-z_][A-Za-z0-9_-]*$/u.test(key) ||\\n    93\\t        ['__proto__', 'constructor', 'prototype'].includes(key) ||\\n    94\\t        Object.hasOwn(result, key)\\n    95\\t      ) {\\n    96\\t        throw new Error(`invalid or duplicate key on line ${token.line}`);\\n    97\\t      }\\n    98\\t      const rest = token.content.slice(separator + 1).trim();\\n    99\\t      if (rest) result[key] = parseScalar(rest);\\n   100\\t      else if (tokens[cursor + 1]?.indent === indent + 2) {\\n   101\\t        const [child, next] = parseBlock(tokens, cursor + 1, indent + 2, depth + 1);\\n   102\\t        result[key] = child;\\n   103\\t        cursor = next - 1;\\n   104\\t      } else result[key] = null;\\n   105\\t    }\\n   106\\t    cursor += 1;\\n   107\\t  }\\n   108\\t  return [result, cursor];\\n   109\\t}\\n   110\\t\\n   111\\tfunction stringArray(value, name) {\\n   112\\t  if (!Array.isArray(value) || value.some((item) => typeof item !== 'string' || /[\\\\r\\\\n]/u.test(item))) {\\n   113\\t    throw new TypeError(`${name} must be an array of strings`);\\n   114\\t  }\\n   115\\t  return [...value];\\n   116\\t}\\n   117\\t\\n   118\\tfunction positiveInteger(value, fallback, name) {\\n   119\\t  const resolved = value === undefined ? fallback : value;\\n   120\\t  if (!Number.isInteger(resolved) || resolved < 1) throw new TypeError(`${name} must be a positive integer`);\\n   121\\t  return resolved;\\n   122\\t}\\n   123\\t\\n   124\\tfunction normalize(raw, body = '') {\\n   125\\t  if (!isObject(raw) || typeof body !== 'string') throw new TypeError('invalid flight plan');\\n   126\\t  const version = raw.version === undefined ? 1 : raw.version;\\n   127\\t  const status = raw.status === undefined ? 'active' : raw.status;\\n   128\\t  const outcome = raw.outcome === undefined ? '' : raw.outcome;\\n   129\\t  if (!Number.isInteger(version) || version < 1) throw new TypeError('version must be a positive integer');\\n   130\\t  if (!STATUSES.has(status)) throw new TypeError('status must be active, complete, or blocked');\\n   131\\t  if (typeof outcome !== 'string' || /[\\\\r\\\\n]/u.test(outcome)) throw new TypeError('outcome must be one line');\\n   132\\t  const scope = raw.scope === undefined ? {} : raw.scope;\\n   133\\t  const stall = raw.stall === undefined ? {} : raw.stall;\\n   134\\t  if (!isObject(scope) || !isObject(stall)) throw new TypeError('scope and stall must be mappings');\\n   135\\t  return {\\n   136\\t    version,\\n   137\\t    status,\\n   138\\t    outcome,\\n   139\\t    verify: stringArray(raw.verify === undefined ? [] : raw.verify, 'verify'),\\n   140\\t    scope: {\\n   141\\t      touchpoints: stringArray(scope.touchpoints === undefined ? [] : scope.touchpoints, 'scope.touchpoints'),\\n   142\\t      nonGoals: stringArray(scope.non_goals === undefined ? [] : scope.non_goals, 'scope.non_goals'),\\n   143\\t    },\\n   144\\t    invariants: stringArray(raw.invariants === undefined ? [] : raw.invariants, 'invariants'),\\n   145\\t    stall: {\\n   146\\t      quietTurns: positiveInteger(stall.quiet_turns, DEFAULT_STALL.quietTurns, 'stall.quiet_turns'),\\n   147\\t      sameFailure: positiveInteger(stall.same_failure, DEFAULT_STALL.sameFailure, 'stall.same_failure'),\\n   148\\t    },\\n   149\\t    body,\\n   150\\t    raw,\\n   151\\t  };\\n   152\\t}\\n   153\\t\\n   154\\t// Pure and deliberately fail-safe: an advisory note can never break a run.\\n   155\\texport function parseFlightPlan(text) {\\n   156\\t  try {\\n   157\\t    if (typeof text !== 'string' || text.length > 1_000_000) return null;\\n   158\\t    const lines = text.replace(/^\\\\uFEFF/u, '').split(/\\\\r?\\\\n/u);\\n   159\\t    if (lines[0]?.trim() !== '---') return null;\\n   160\\t    const closing = lines.findIndex((line, index) => index > 0 && line.trim() === '---');\\n   161\\t    if (closing < 0) return null;\\n   162\\t    const tokens = frontmatterTokens(lines.slice(1, closing).join('\\\\n'));\\n   163\\t    const [raw, consumed] = tokens.length ? parseBlock(tokens, 0, 0) : [{}, 0];\\n   164\\t    if (consumed !== tokens.length || !isObject(raw)) return null;\\n   165\\t    return normalize(raw, lines.slice(closing + 1).join('\\\\n'));\\n   166\\t  } catch {\\n   167\\t    return null;\\n   168\\t  }\\n   169\\t}\\n   170\\t\\n   171\\tfunction scalarText(value) {\\n   172\\t  if (value === null) return 'null';\\n   173\\t  if (typeof value === 'boolean' || typeof value === 'number') return String(value);\\n   174\\t  if (typeof value !== 'string') throw new TypeError('frontmatter scalar is not serializable');\\n   175\\t  if (\\n   176\\t    value &&\\n   177\\t    value === value.trim() &&\\n   178\\t    !/[\\\\r\\\\n]/u.test(value) &&\\n   179\\t    !/^[-?:,[\\\\]{}#&*!|>'\\\"%@`]/u.test(value) &&\\n   180\\t    !/[#:]/u.test(value) &&\\n   181\\t    !/^(?:true|false|null|~|-?(?:0|[1-9]\\\\d*)(?:\\\\.\\\\d+)?)$/u.test(value)\\n   182\\t  ) return value;\\n   183\\t  return JSON.stringify(value);\\n   184\\t}\\n   185\\t\\n   186\\tfunction serializeValue(key, value, indent) {\\n   187\\t  const prefix = ' '.repeat(indent);\\n   188\\t  if (Array.isArray(value)) {\\n   189\\t    if (!value.length) return [`${prefix}${key}: []`];\\n   190\\t    return [`${prefix}${key}:`, ...serializeSequence(value, indent + 2)];\\n   191\\t  }\\n   192\\t  if (isObject(value)) {\\n   193\\t    if (!Object.keys(value).length) return [`${prefix}${key}: {}`];\\n   194\\t    return [`${prefix}${key}:`, ...serializeObject(value, indent + 2)];\\n   195\\t  }\\n   196\\t  return [`${prefix}${key}: ${scalarText(value)}`];\\n   197\\t}\\n   198\\t\\n   199\\tfunction serializeSequence(value, indent) {\\n   200\\t  const prefix = ' '.repeat(indent);\\n   201\\t  return value.flatMap((item) => {\\n   202\\t    if (Array.isArray(item)) return [`${prefix}-`, ...serializeSequence(item, indent + 2)];\\n   203\\t    if (isObject(item)) return [`${prefix}-`, ...serializeObject(item, indent + 2)];\\n   204\\t    return [`${prefix}- ${scalarText(item)}`];\\n   205\\t  });\\n   206\\t}\\n   207\\t\\n   208\\tfunction serializeObject(value, indent = 0) {\\n   209\\t  if (!isObject(value)) throw new TypeError('frontmatter root must be a mapping');\\n   210\\t  return Object.entries(value).flatMap(([key, item]) => {\\n   211\\t    if (!/^[A-Za-z_][A-Za-z0-9_-]*$/u.test(key)) throw new TypeError(`invalid frontmatter key ${key}`);\\n   212\\t    return serializeValue(key, item, indent);\\n   213\\t  });\\n   214\\t}\\n   215\\t\\n   216\\tfunction serializablePlan(plan) {\\n   217\\t  if (!isObject(plan)) throw new TypeError('flight plan must be an object');\\n   218\\t  const raw = isObject(plan.raw) ? plan.raw : {};\\n   219\\t  const scopeRaw = isObject(raw.scope) ? raw.scope : {};\\n   220\\t  const stallRaw = isObject(raw.stall) ? raw.stall : {};\\n   221\\t  const known = normalize({\\n   222\\t    version: plan.version ?? raw.version,\\n   223\\t    status: plan.status ?? raw.status,\\n   224\\t    outcome: plan.outcome ?? raw.outcome,\\n   225\\t    verify: plan.verify ?? raw.verify,\\n   226\\t    scope: {\\n   227\\t      ...scopeRaw,\\n   228\\t      touchpoints: plan.scope?.touchpoints ?? scopeRaw.touchpoints,\\n   229\\t      non_goals: plan.scope?.nonGoals ?? scopeRaw.non_goals,\\n   230\\t    },\\n   231\\t    invariants: plan.invariants ?? raw.invariants,\\n   232\\t    stall: {\\n   233\\t      ...stallRaw,\\n   234\\t      quiet_turns: plan.stall?.quietTurns ?? stallRaw.quiet_turns,\\n   235\\t      same_failure: plan.stall?.sameFailure ?? stallRaw.same_failure,\\n   236\\t    },\\n   237\\t  }, plan.body ?? '');\\n   238\\t  const extras = Object.fromEntries(Object.entries(raw).filter(([key]) => !KNOWN_KEYS.has(key)));\\n   239\\t  return {\\n   240\\t    normalized: known,\\n   241\\t    frontmatter: {\\n   242\\t      version: known.version,\\n   243\\t      status: known.status,\\n   244\\t      outcome: known.outcome,\\n   245\\t      verify: known.verify,\\n   246\\t      scope: {\\n   247\\t        touchpoints: known.scope.touchpoints,\\n   248\\t        non_goals: known.scope.nonGoals,\\n   249\\t        ...Object.fromEntries(Object.entries(scopeRaw).filter(([key]) => !['touchpoints', 'non_goals'].includes(key))),\\n   250\\t      },\\n   251\\t      invariants: known.invariants,\\n   252\\t      stall: {\\n   253\\t        quiet_turns: known.stall.quietTurns,\\n   254\\t        same_failure: known.stall.sameFailure,\\n   255\\t        ...Object.fromEntries(Object.entries(stallRaw).filter(([key]) => !['quiet_turns', 'same_failure'].includes(key))),\\n   256\\t      },\\n   257\\t      ...extras,\\n   258\\t    },\\n   259\\t  };\\n   260\\t}\\n   261\\t\\n   262\\texport async function readFlightPlan(cwd) {\\n   263\\t  try {\\n   264\\t    return parseFlightPlan(await readFile(join(cwd, FLIGHT_FILE), 'utf8'));\\n   265\\t  } catch {\\n   266\\t    return null;\\n   267\\t  }\\n   268\\t}\\n   269\\t\\n   270\\texport async function writeFlightPlan(cwd, plan) {\\n   271\\t  const { normalized, frontmatter } = serializablePlan(plan);\\n   272\\t  const directory = join(cwd, '.cruise');\\n   273\\t  await mkdir(directory, { recursive: true, mode: 0o700 });\\n   274\\t  const directoryMetadata = await lstat(directory);\\n   275\\t  if (directoryMetadata.isSymbolicLink() || !directoryMetadata.isDirectory()) {\\n   276\\t    throw new Error(`${directory} must be a directory.`);\\n   277\\t  }\\n   278\\t  const path = join(cwd, FLIGHT_FILE);\\n   279\\t  try {\\n   280\\t    const existing = await lstat(path);\\n   281\\t    if (existing.isSymbolicLink() || !existing.isFile()) throw new Error(`${path} must be a regular file.`);\\n   282\\t  } catch (error) {\\n   283\\t    if (error?.code !== 'ENOENT') throw error;\\n   284\\t  }\\n   285\\t  const text = `---\\\\n${serializeObject(frontmatter).join('\\\\n')}\\\\n---\\\\n${normalized.body}`;\\n   286\\t  await writeFile(path, text, { encoding: 'utf8', mode: 0o600 });\\n   287\\t  return normalized;\\n   288\\t}\\n     1\\timport { spawn as nodeSpawn } from 'node:child_process';\\n     2\\t\\n     3\\timport { normalizeRecommendedLevel } from './worker-policy.mjs';\\n     4\\timport { skillReference } from './provider.mjs';\\n     5\\t\\n     6\\texport const CLAUDE_WORKER_LEVEL_POLICY = Object.freeze({\\n     7\\t  1: Object.freeze({ model: 'haiku', effort: 'low' }),\\n     8\\t  2: Object.freeze({ model: 'haiku', effort: 'medium' }),\\n     9\\t  3: Object.freeze({ model: 'sonnet', effort: 'low' }),\\n    10\\t  4: Object.freeze({ model: 'sonnet', effort: 'medium' }),\\n    11\\t  5: Object.freeze({ model: 'sonnet', effort: 'high' }),\\n    12\\t  6: Object.freeze({ model: 'opus', effort: 'high' }),\\n    13\\t  7: Object.freeze({ model: 'opus', effort: 'max' }),\\n    14\\t});\\n    15\\t\\n    16\\tconst CLAUDE_HOST_INSTRUCTIONS = [\\n    17\\t  'This Cruise session is running on Claude Code.',\\n    18\\t  'Use Claude Code native permissions, task tracking, resumable sessions, skills, and subagents.',\\n    19\\t  'Claude Code exposes no documented Codex-style Goal lifecycle API to plugins; do not invent Goal endpoints or Goal state.',\\n    20\\t  'For Goal work, resolve the outcome, scope fence, invariants, acceptance commands, and stall tuning, then write the user-editable advisory .cruise/FLIGHT.md as the first execution act; reread it at each micro-goal, realign scope drift, re-verify affected invariants, and keep its status truthful through completion or a concrete blocker. It grants and gates nothing.',\\n    21\\t].join(' ');\\n    22\\t\\n    23\\texport function claudeSessionArgs({ pluginRoot, skill, prompt }) {\\n    24\\t  if (typeof pluginRoot !== 'string' || !pluginRoot) throw new TypeError('pluginRoot is required');\\n    25\\t  if (typeof skill !== 'string' || !skill) throw new TypeError('skill is required');\\n    26\\t  if (typeof prompt !== 'string' || !prompt.trim()) throw new TypeError('prompt is required');\\n    27\\t  return [\\n    28\\t    '--plugin-dir',\\n    29\\t    pluginRoot,\\n    30\\t    '--name',\\n    31\\t    `Cruise ${skill}`,\\n    32\\t    '--append-system-prompt',\\n    33\\t    CLAUDE_HOST_INSTRUCTIONS,\\n    34\\t    `${skillReference('claude', skill)} ${prompt}`,\\n    35\\t  ];\\n    36\\t}\\n    37\\t\\n    38\\texport function claudeWorkerArgs({ task, level = null }) {\\n    39\\t  if (typeof task !== 'string' || !task.trim()) throw new TypeError('worker task is required');\\n    40\\t  const args = ['--name', level === null ? 'Cruise worker' : `Cruise worker L${level}`];\\n    41\\t  if (level !== null) {\\n    42\\t    const selection = CLAUDE_WORKER_LEVEL_POLICY[normalizeRecommendedLevel(level)];\\n     1\\t# Cruise\\n     2\\t\\n     3\\tCruise is a small, dual-host coding workflow plugin and optional terminal\\n     4\\tlauncher. The same five intent-based skills run natively on Codex and Claude\\n     5\\tCode while each host keeps its own permissions, models, session controls, and\\n     6\\tagent plumbing.\\n     7\\t\\n     8\\tCruise records the exact terminal request in `.cruise/ORIGIN.md`. Goal runs\\n     9\\talso maintain the advisory `.cruise/FLIGHT.md` described below. Neither file\\n    10\\tis an approval or source of authority, and Cruise does not create a parallel\\n    11\\tworkflow database, approval ledger, archive, or run directory.\\n    12\\t\\n    13\\t## Choose a skill\\n    14\\t\\n    15\\t| Skill | Use it when |\\n    16\\t| --- | --- |\\n    17\\t| `build` | You need to shape a project or milestone before implementation. |\\n    18\\t| `quick` | The requested change is small, understood, and low risk. |\\n    19\\t| `refine` | The outcome is finite but needs a short plan first. |\\n    20\\t| `goal` | The work is consequential or multi-step and should run to completion. |\\n    21\\t| `debug` | You have a clear or vague failure, or want adversarial UX quality control. |\\n    22\\t\\n    23\\t`goal` is the autonomous lane: it starts with a compact codebase-aware plan,\\n    24\\tthen implements, verifies, realigns, and advances ready in-scope work. Plans\\n    25\\tlaunch implementation; they are not a completion boundary. It still asks for\\n    26\\tmaterial product decisions, secrets, scope changes, and approvals required by\\n    27\\tthe active host.\\n    28\\t\\n    29\\t## Flight plans\\n    30\\t\\n    31\\tAt the start of Goal execution, Cruise compiles the clarified outcome, expected\\n    32\\ttouchpoints, non-goals, invariants, verification commands, and stall tuning into\\n    33\\t`.cruise/FLIGHT.md`. The agent rereads this small Markdown note as work advances\\n    34\\tand keeps its status truthful. You may edit it at any time; it is advisory and\\n    35\\tgrants or gates nothing. The selected host's native permissions remain the only\\n    36\\tauthority for work and effects.\\n    37\\t\\n    38\\t## Provider integration\\n    39\\t\\n    40\\tCruise shares its skills and terminal UI, but not its host control plane:\\n    41\\t\\n    42\\t| Surface | Codex | Claude Code |\\n    43\\t| --- | --- | --- |\\n    44\\t| Skill syntax | `$cruise:goal` | `/cruise:goal` |\\n    45\\t| Plugin manifest | `.codex-plugin/plugin.json` | `.claude-plugin/plugin.json` |\\n    46\\t| Task transport | Codex app-server | Native interactive `claude` process |\\n    47\\t| Planning | Native Plan collaboration mode | Native `/plan` or `--permission-mode plan` when planning-only is requested |\\n    48\\t| Autonomous goal | Native Goal lifecycle and status | In-session task list and execution loop; no documented equivalent Goal lifecycle API is exposed to plugins |\\n    49\\t| Pause/resume | Native Goal pause plus task continuation | `Ctrl-C`, `/resume`, `--continue`, and `--resume` |\\n    50\\t| Workers | Live Codex model catalog and reasoning effort | Claude model aliases and native effort levels |\\n\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"019f8372-68fb-7750-8775-7cd68e300b6f\"}}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:165:{\"timestamp\":\"2026-07-21T06:54:38.796Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"agent_message\",\"message\":\"- **High — Goal instructions directly contradict the required flight-plan bootstrap.** In [simple-session.mjs](<PLUGIN_ROOT>/scripts/lib/simple-session.mjs:245), every session receives “Cruise keeps only `.cruise/ORIGIN.md`,” immediately followed for Goal sessions by instructions to create `.cruise/FLIGHT.md`. The adjacent prohibition on “YAML workflow artifacts” adds ambiguity because `FLIGHT.md` contains YAML frontmatter. Reproduction: capture `thread/start.params.developerInstructions` for any Goal session; both directives appear in the same developer message. A compliant agent may obey the earlier prohibition and never create the pinned artifact. Update the generic instruction to explicitly allow the advisory `FLIGHT.md` while retaining the control-plane prohibition.\",\"phase\":\"final_answer\",\"memory_citation\":null}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:166:{\"timestamp\":\"2026-07-21T06:54:38.796Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"message\",\"id\":\"msg_09e11be78a1e8a3a016a5f17abcfc88191af91537329628c0f\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"- **High — Goal instructions directly contradict the required flight-plan bootstrap.** In [simple-session.mjs](<PLUGIN_ROOT>/scripts/lib/simple-session.mjs:245), every session receives “Cruise keeps only `.cruise/ORIGIN.md`,” immediately followed for Goal sessions by instructions to create `.cruise/FLIGHT.md`. The adjacent prohibition on “YAML workflow artifacts” adds ambiguity because `FLIGHT.md` contains YAML frontmatter. Reproduction: capture `thread/start.params.developerInstructions` for any Goal session; both directives appear in the same developer message. A compliant agent may obey the earlier prohibition and never create the pinned artifact. Update the generic instruction to explicitly allow the advisory `FLIGHT.md` while retaining the control-plane prohibition.\"}],\"phase\":\"final_answer\",\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"019f8374-5d62-79d3-af42-6ebd1317d5cf\"}}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:168:{\"timestamp\":\"2026-07-21T06:54:38.899Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"task_complete\",\"turn_id\":\"019f8374-5d62-79d3-af42-6ebd1317d5cf\",\"last_agent_message\":\"- **High — Goal instructions directly contradict the required flight-plan bootstrap.** In [simple-session.mjs](<PLUGIN_ROOT>/scripts/lib/simple-session.mjs:245), every session receives “Cruise keeps only `.cruise/ORIGIN.md`,” immediately followed for Goal sessions by instructions to create `.cruise/FLIGHT.md`. The adjacent prohibition on “YAML workflow artifacts” adds ambiguity because `FLIGHT.md` contains YAML frontmatter. Reproduction: capture `thread/start.params.developerInstructions` for any Goal session; both directives appear in the same developer message. A compliant agent may obey the earlier prohibition and never create the pinned artifact. Update the generic instruction to explicitly allow the advisory `FLIGHT.md` while retaining the control-plane prohibition.\",\"completed_at\":1784616878,\"duration_ms\":9676,\"time_to_first_token_ms\":6719}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:177:{\"timestamp\":\"2026-07-21T07:01:04.565Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"call_id\":\"call_6ocozKmmFMobYsCe9Hf597qc\",\"output\":[{\"type\":\"input_text\",\"text\":\"Script completed\\nWall time 0.1 seconds\\nOutput:\\n\"},{\"type\":\"input_text\",\"text\":\"# Task C — Codex loop supervisor: mechanical stall detection in the goal loop\\n\\n## Context\\n\\nYou are working in the `cruise` repository, a dual-host coding-workflow\\nplugin. On the Codex path, `scripts/cruise.mjs` → `SimpleCruiseSession`\\n(`scripts/lib/simple-session.mjs`) drives a native Codex Goal: it activates\\nthe Goal, runs a read-only Plan bootstrap turn, then loops — re-injecting\\n`GOAL_CONTINUATION_INSTRUCTIONS` while the Goal status stays `active`, and\\nauto-answering routine gate questions via `automaticGoalProgress`.\\n\\n**The gap you are closing:** that loop prevents *stall-by-asking* (the agent\\nstopping for routine approvals) but does nothing about *stall-by-ramming* —\\nan agent making no progress yet continuing forever. There is no progress\\ncheck between turns, no repeated-failure detection, no oscillation\\ndetection. If the Goal never reaches a terminal status the loop re-prompts\\nindefinitely; the only backstop is Ctrl-C.\\n\\nA prior task (B) added `scripts/lib/flight-plan.mjs` and the\\n`.cruise/FLIGHT.md` artifact. Its relevant contract:\\n\\n```js\\nimport { readFlightPlan, DEFAULT_STALL } from './flight-plan.mjs';\\n// readFlightPlan(cwd) -> null | { ..., stall: { quietTurns, sameFailure },\\n//                                 verify: string[], scope: {...}, status }\\n// DEFAULT_STALL = { quietTurns: 3, sameFailure: 3 }\\n```\\n\\n**Design philosophy (non-negotiable).** `LIMIT_POLICY.md` forbids hidden\\nnumeric workload ceilings but explicitly allows a \\\"Liveness and recovery\\\"\\nclass. Your supervisor must be exactly that: evidence-based (it trips on\\nobserved non-progress, never on turn count alone), user-tunable (thresholds\\nfrom the flight plan), and fail-safe (the escalation ladder ends in *pause\\nwith a human-readable report*, never an infinite retry loop and never a\\nsilent kill). It is advisory toward the agent and honest toward the user.\\n\\n## What you are building\\n\\n### `scripts/lib/supervisor.mjs` (new) — pinned contract\\n\\n```js\\nexport class GoalSupervisor {\\n  constructor({ stall = DEFAULT_STALL } = {})\\n  // Called after every continuation turn.\\n  recordTurn({ fingerprint, failureSignature })\\n  // -> { level: 'ok' | 'realign' | 'final-experiment' | 'stall', reason }\\n}\\n\\n// Hash of observable workspace evidence: `git status --porcelain=v1` +\\n// `git diff` + `git diff --cached` (execFile, never shell interpolation).\\n// Returns null when cwd is not a git repo (signal disabled, never throws).\\nexport async function captureWorkspaceFingerprint(cwd)\\n\\n// Extract error-ish lines (/\\\\b(error|fail(ed|ure)?|exception|panic|\\n// traceback)\\\\b/i) from the turn's agent text, normalize (strip digits,\\n// hex, absolute paths, whitespace runs), hash. Null when no failure text.\\nexport function extractFailureSignature(turnText)\\n```\\n\\nLadder semantics (state machine inside `GoalSupervisor`):\\n\\n- **Evidence delta observed** (fingerprint changed vs. previous turn and is\\n  not a repeat of an *earlier* fingerprint) → counters reset, `ok`.\\n- **Quiet turn** (fingerprint unchanged) or **repeated failure** (same\\n  signature as previous turns): count separately; when either count reaches\\n  its threshold → `realign` (returned exactly once).\\n- Still no evidence delta after the realign turn → `final-experiment`\\n  (returned exactly once).\\n- Still nothing → `stall`.\\n- **Oscillation** (fingerprint equals an earlier-seen value with different\\n  values in between, e.g. edit-then-revert cycles) counts as a quiet turn,\\n  and the `reason` names it.\\n- `reason` strings are specific and human-readable: what was observed, how\\n  many times, which signature (truncated).\\n\\n### Wiring in `simple-session.mjs`\\n\\n1. Buffer each turn's agent-message text (the `item/agentMessage/delta`\\n   notifications), capped at ~64 KB per turn, reset per turn.\\n2. In the `while (this.skill === 'goal')` loop, after each completed\\n   continuation turn: capture the fingerprint, extract the failure\\n   signature, call `recordTurn`. Read stall thresholds lazily each\\n   iteration via `readFlightPlan(this.cwd)` (the user may edit mid-run;\\n   absent file → `DEFAULT_STALL`).\\n3. Act on the verdict by *changing the injected instructions*, not by\\n   silently killing anything:\\n   - `realign` → instead of the standard continuation text, inject a\\n     realignment instruction: name the observed repetition verbatim from\\n     `reason`, state that repeating the same approach is not authorized\\n     progress, and require either the smallest discriminating experiment\\n     that yields new evidence or an explicit statement of the blocker.\\n   - `final-experiment` → inject: produce new evidence this turn or set the\\n     Goal to blocked yourself with a concrete blocker report; this is the\\n     last supervised continuation.\\n   - `stall` → call the existing `pauseActiveGoal()`, print a stall report\\n     to the user (turns observed, fingerprints/signatures involved, the two\\n     interventions already attempted, suggested next human actions), and\\n     return a result with `status: 'stalled'`.\\n4. `runStart` in `scripts/cruise.mjs`: map `stalled` to exit code 3\\n   (0 complete, 2 other non-complete, 130 interrupted stay as-is). Update\\n   the `HELP` text with one line about supervised goal runs.\\n\\n### Documentation\\n\\n- `LIMIT_POLICY.md`: add the supervisor to the \\\"Liveness and recovery\\\"\\n  table — evidence-based trip conditions, user-tunable via flight plan,\\n  terminates in pause-with-report.\\n- `skills/goal/SKILL.md`: edit **only the Codex bullet** in \\\"Use the\\n  selected host natively\\\": one or two sentences that supervised realignment\\n  turns are normal and must be answered with a changed approach or an\\n  honest blocker, never a re-run of the same failing attempt.\\n\\n## Files you own\\n\\n`scripts/lib/supervisor.mjs` (new), `tests/supervisor.test.mjs` (new),\\nloop mechanics in `scripts/lib/simple-session.mjs`, `scripts/cruise.mjs`\\n(exit code + HELP), `LIMIT_POLICY.md`, the Codex bullet of\\n`skills/goal/SKILL.md`, `package.json` (`files` + `test` additions).\\n\\n## Files you must not touch\\n\\n`hooks/**` and the Claude bullet of `skills/goal/SKILL.md` (a parallel task\\nD owns those), `skills/build/SKILL.md` (Task E), `flight-plan.mjs` (extend\\nvia its public API only), `claude-cli.mjs`. A parallel task also edits\\n`package.json` `files`; union on merge.\\n\\n## Acceptance criteria\\n\\n- `npm test` green. New unit tests cover: verdict sequences (progress →\\n  ok; N quiet → realign → final-experiment → stall; recovery resets;\\n  oscillation detection; repeated-failure path independent of fingerprint\\n  path), fingerprint null outside git repos, signature normalization\\n  (same error with different line numbers/paths → same hash).\\n- Integration test drives `SimpleCruiseSession` with a fake client through\\n  a no-progress sequence and asserts: realignment text injected, then\\n  final-experiment text, then Goal paused + `status: 'stalled'` + report\\n  written to the error output stream.\\n- A progressing goal run's behavior is byte-identical to today's\\n  (supervision must be invisible when there is progress).\\n- No shell string interpolation; `execFile` only; a non-git cwd degrades\\n  gracefully to signature-only supervision.\\n\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"019f837a-56d2-77f1-bda9-d41d805796c6\"}}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:181:{\"timestamp\":\"2026-07-21T07:01:08.284Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"call_id\":\"call_7rsXUQPZtnKKBfeBEbrJJiJT\",\"output\":[{\"type\":\"input_text\",\"text\":\"Script completed\\nWall time 0.1 seconds\\nOutput:\\n\"},{\"type\":\"input_text\",\"text\":\" M LIMIT_POLICY.md\\n M package.json\\n M scripts/cruise.mjs\\n M scripts/lib/simple-session.mjs\\n M skills/goal/SKILL.md\\n M tests/cli-simple.test.mjs\\n M tests/simple-session.test.mjs\\n?? scripts/lib/supervisor.mjs\\n?? tests/supervisor.test.mjs\\ndiff --git a/LIMIT_POLICY.md b/LIMIT_POLICY.md\\nindex 0080f57..1a30c11 100644\\n--- a/LIMIT_POLICY.md\\n+++ b/LIMIT_POLICY.md\\n@@ -30,6 +30,7 @@ Service quotas and Codex host-action limits are host/protocol constraints. This\\n \\n | Operation | Rule |\\n | --- | --- |\\n+| Codex Goal loop supervision | Trips only on observed unchanged/oscillating workspace evidence or a repeated normalized failure signature; thresholds are user-tunable in `.cruise/FLIGHT.md`; after one realignment and one final experiment it pauses the native Goal with a human-readable report |\\n | Deep Doctor skill probe | Fixed `60000 ms` deadline; performance target below `15000 ms` |\\n | Troubleshoot workflow | No workflow deadline; cancellation and bounded process cleanup remain available |\\n | Automatic update hook | Waits for active Cruise processes without an attempt ceiling; concurrent hooks coalesce behind a stale-owner-aware lock |\\ndiff --git a/package.json b/package.json\\nindex a780a67..14f98da 100644\\n--- a/package.json\\n+++ b/package.json\\n@@ -30,11 +30,12 @@\\n     \\\"scripts/lib/provider.mjs\\\",\\n     \\\"scripts/lib/simple-session.mjs\\\",\\n     \\\"scripts/lib/simple-worker.mjs\\\",\\n+    \\\"scripts/lib/supervisor.mjs\\\",\\n     \\\"scripts/lib/worker-policy.mjs\\\",\\n     \\\"skills/\\\"\\n   ],\\n   \\\"scripts\\\": {\\n-    \\\"test\\\": \\\"node --test tests/app-server-client.test.mjs tests/line-input.test.mjs tests/picker.test.mjs tests/origin-note.test.mjs tests/flight-plan.test.mjs tests/debug-skill.test.mjs tests/simple-worker.test.mjs tests/claude-cli.test.mjs tests/cli-simple.test.mjs tests/simple-session.test.mjs\\\",\\n+    \\\"test\\\": \\\"node --test tests/app-server-client.test.mjs tests/line-input.test.mjs tests/picker.test.mjs tests/origin-note.test.mjs tests/flight-plan.test.mjs tests/supervisor.test.mjs tests/debug-skill.test.mjs tests/simple-worker.test.mjs tests/claude-cli.test.mjs tests/cli-simple.test.mjs tests/simple-session.test.mjs\\\",\\n     \\\"validate\\\": \\\"npm test\\\"\\n   },\\n   \\\"engines\\\": {\\ndiff --git a/scripts/cruise.mjs b/scripts/cruise.mjs\\nindex 43b91e1..68e66c8 100755\\n--- a/scripts/cruise.mjs\\n+++ b/scripts/cruise.mjs\\n@@ -36,11 +36,13 @@ Usage:\\n   cruise [--codex|--claude] worker [--level <1-7>] [-C <directory>] <task...>\\n   cruise [--codex|--claude] doctor [--json]\\n \\n-Cruise records only the exact request in .cruise/ORIGIN.md. It has no\\n-Cruise-owned approval authority, archive, YAML workflow, packet, report,\\n-digest, run directory, or retry ledger. The selected host's native permissions\\n-remain the authority for work and effects. Codex is the default; CRUISE_PROVIDER\\n-may set a request-scoped default to codex or claude.\\n+Cruise records the exact request in .cruise/ORIGIN.md; Goal runs may also keep\\n+an advisory .cruise/FLIGHT.md. Codex Goal loops use evidence-based stall\\n+supervision and pause with a report after two visible realignment attempts.\\n+Cruise has no approval authority, archive, run-control YAML, digest, or retry\\n+ledger. The selected host's native permissions remain the authority for work\\n+and effects. Codex is the default; CRUISE_PROVIDER may set a request-scoped\\n+default to codex or claude.\\n `;\\n \\n function displayError(value) {\\n@@ -165,6 +167,7 @@ export async function runStart(\\n   {\\n     clientFactory = (input) => new AppServerClient(input),\\n     claudeRunner = runClaudeSession,\\n+    sessionFactory = (input) => new SimpleCruiseSession(input),\\n   } = {},\\n ) {\\n   const cwd = await validateWorkingDirectory(options.cwd);\\n@@ -186,7 +189,7 @@ export async function runStart(\\n       process.stderr.write(`Cruise warning: ${displayError(error.message)}\\\\n`);\\n     },\\n   });\\n-  const session = new SimpleCruiseSession({\\n+  const session = sessionFactory({\\n     client,\\n     cwd,\\n     prompt: options.prompt,\\n@@ -199,7 +202,7 @@ export async function runStart(\\n   process.on('SIGINT', onSigint);\\n   try {\\n     const result = await session.run();\\n-    return result.status === 'complete' ? 0 : 2;\\n+    return result.status === 'complete' ? 0 : result.status === 'stalled' ? 3 : 2;\\n   } catch (error) {\\n     if (error instanceof SimpleCruiseInterruptedError) return 130;\\n     throw error;\\ndiff --git a/scripts/lib/simple-session.mjs b/scripts/lib/simple-session.mjs\\nindex 4b4cf76..fb96651 100644\\n--- a/scripts/lib/simple-session.mjs\\n+++ b/scripts/lib/simple-session.mjs\\n@@ -1,5 +1,12 @@\\n import { EventEmitter } from 'node:events';\\n \\n+import { DEFAULT_STALL, readFlightPlan } from './flight-plan.mjs';\\n+import {\\n+  captureWorkspaceFingerprint,\\n+  extractFailureSignature,\\n+  GoalSupervisor,\\n+} from './supervisor.mjs';\\n+\\n const TERMINAL_GOAL_STATUSES = new Set([\\n   'paused',\\n   'blocked',\\n@@ -40,6 +47,39 @@ const GOAL_CONTINUATION_INSTRUCTIONS = [\\n   'Routine micro-goal progression is already authorized; do not ask the user for a phase or plan approval.',\\n ].join(' ');\\n \\n+const MAX_TURN_AGENT_TEXT = 64 * 1024;\\n+\\n+function realignmentInstructions(reason) {\\n+  return [\\n+    `Cruise supervision observed: ${reason}.`,\\n+    'Repeating the same approach is not authorized progress.',\\n+    'Change approach now: run the smallest discriminating experiment that produces new workspace evidence, or set the Goal to blocked and state the concrete blocker and evidence needed to resume.',\\n+  ].join(' ');\\n+}\\n+\\n+function finalExperimentInstructions(reason) {\\n+  return [\\n+    `Cruise supervision still observes no progress after realignment: ${reason}.`,\\n+    'Produce new workspace evidence this turn or set the Goal to blocked yourself with a concrete blocker report.',\\n+    'This is the last supervised continuation before Cruise pauses the Goal with a stall report.',\\n+  ].join(' ');\\n+}\\n+\\n+function stallReport(verdict, summary) {\\n+  const fingerprints = summary.fingerprints.length ? summary.fingerprints.join(', ') : 'unavailable';\\n+  const signatures = summary.failureSignatures.length ? summary.failureSignatures.join(', ') : 'none';\\n+  const interventions = summary.interventions.map(({ level, reason }) => `${level}: ${reason}`).join('\\\\n  - ');\\n+  return [\\n+    `Cruise Goal stalled after ${summary.turnsObserved} supervised continuation turns.`,\\n+    `Observed: ${verdict.reason}.`,\\n+    `Workspace fingerprints involved: ${fingerprints}.`,\\n+    `Failure signatures involved: ${signatures}.`,\\n+    `Interventions already attempted:\\\\n  - ${interventions || 'realignment and final experiment'}`,\\n+    'The native Goal is paused; no work was silently killed.',\\n+    'Suggested next actions: inspect the last failure and diff, edit .cruise/FLIGHT.md stall tuning if warranted, provide missing evidence or a material decision, then resume the Goal.',\\n+  ].join('\\\\n');\\n+}\\n+\\n \\n function deferred() {\\n   let resolve;\\n@@ -195,6 +235,9 @@ export class SimpleCruiseSession extends EventEmitter {\\n     input = process.stdin,\\n     output = process.stdout,\\n     errorOutput = process.stderr,\\n+    supervisor = new GoalSupervisor(),\\n+    captureFingerprint = captureWorkspaceFingerprint,\\n+    readPlan = readFlightPlan,\\n   }) {\\n     super();\\n     if (!client || !cwd || !prompt || !skill || !skillPath) {\\n@@ -212,6 +255,10 @@ export class SimpleCruiseSession extends EventEmitter {\\n     this.input = input;\\n     this.output = output;\\n     this.errorOutput = errorOutput;\\n+    this.supervisor = supervisor;\\n+    this.captureFingerprint = captureFingerprint;\\n+    this.readPlan = readPlan;\\n+    this.turnAgentText = '';\\n     this.threadId = null;\\n     this.threadModel = null;\\n     this.threadReasoningEffort = null;\\n@@ -254,6 +301,7 @@ export class SimpleCruiseSession extends EventEmitter {\\n \\n       let result;\\n       let goalExecutionMode = false;\\n+      let continuationCompleted = false;\\n       if (this.skill === 'goal') {\\n         await this.updateGoalMode('plan');\\n         const nativeTurn = this.waitForNativeGoalTurn();\\n@@ -296,6 +344,22 @@ export class SimpleCruiseSession extends EventEmitter {\\n             goal: completed,\\n           };\\n         }\\n+        let continuationInstructions = GOAL_CONTINUATION_INSTRUCTIONS;\\n+        if (continuationCompleted) {\\n+          const verdict = await this.superviseGoalTurn();\\n+          if (verdict.level === 'stall') {\\n+            await this.pauseActiveGoal();\\n+            this.errorOutput.write(`${stallReport(verdict, this.supervisor.summary())}\\\\n`);\\n+            return {\\n+              status: 'stalled',\\n+              skill: this.skill,\\n+              threadId: this.threadId,\\n+              goal: this.goal,\\n+            };\\n+          }\\n+          if (verdict.level === 'realign') continuationInstructions = realignmentInstructions(verdict.reason);\\n+          else if (verdict.level === 'final-experiment') continuationInstructions = finalExperimentInstructions(verdict.reason);\\n+        }\\n         if (!goalExecutionMode) {\\n           await this.updateGoalMode('default');\\n           goalExecutionMode = true;\\n@@ -303,10 +367,11 @@ export class SimpleCruiseSession extends EventEmitter {\\n         result = await this.startTurn([\\n           {\\n             type: 'text',\\n-            text: GOAL_CONTINUATION_INSTRUCTIONS,\\n+            text: continuationInstructions,\\n             text_elements: [],\\n           },\\n         ], { mode: 'default' });\\n+        continuationCompleted = true;\\n       }\\n       await this.interactions;\\n       if (result.status !== 'completed') {\\n@@ -398,6 +463,7 @@ export class SimpleCruiseSession extends EventEmitter {\\n   }\\n \\n   async startTurn(input, { mode = null } = {}) {\\n+    this.turnAgentText = '';\\n     const completion = deferred();\\n     this.turnId = null;\\n     this.pending = completion;\\n@@ -488,6 +554,18 @@ export class SimpleCruiseSession extends EventEmitter {\\n [stdout]
    this.goal = paused?.goal ?? { ...current, status: 'paused' };\\n   }\\n \\n+  async superviseGoalTurn() {\\n+    const [plan, fingerprint] = await Promise.all([\\n+      Promise.resolve().then(() => this.readPlan(this.cwd)).catch(() => null),\\n+      Promise.resolve().then(() => this.captureFingerprint(this.cwd)).catch(() => null),\\n+    ]);\\n+    this.supervisor.updateStall(plan?.stall ?? DEFAULT_STALL);\\n+    return this.supervisor.recordTurn({\\n+      fingerprint,\\n+      failureSignature: extractFailureSignature(this.turnAgentText),\\n+    });\\n+  }\\n+\\n   enqueueRequest(message) {\\n     this.interactions = this.interactions\\n       .then(() => this.handleRequest(message))\\n@@ -535,7 +613,11 @@ export class SimpleCruiseSession extends EventEmitter {\\n     const params = message.params ?? {};\\n     if (params.threadId && this.threadId && params.threadId !== this.threadId) return;\\n     if (message.method === 'item/agentMessage/delta') {\\n-      this.output.write(String(params.delta ?? ''));\\n+      const delta = String(params.delta ?? '');\\n+      this.output.write(delta);\\n+      if (this.skill === 'goal' && this.turnAgentText.length < MAX_TURN_AGENT_TEXT) {\\n+        this.turnAgentText += delta.slice(0, MAX_TURN_AGENT_TEXT - this.turnAgentText.length);\\n+      }\\n     } else if (message.method === 'turn/started') {\\n       if (this.pending && this.turnId === null && params.turn?.id) {\\n         this.turnId = params.turn.id;\\ndiff --git a/skills/goal/SKILL.md b/skills/goal/SKILL.md\\nindex c18c611..58c5269 100644\\n--- a/skills/goal/SKILL.md\\n+++ b/skills/goal/SKILL.md\\n@@ -9,7 +9,7 @@ For consequential work, inspect the repository and make a proportionate plan. Tr\\n \\n ## Use the selected host natively\\n \\n-- **Codex:** use native Goal state when it is available. A Goal starts with the host's read-only Plan-mode turn and then moves to normal Goal execution. Keep the Goal active through implementation and verification, and use the Goal status as the completion authority.\\n+- **Codex:** use native Goal state when it is available. A Goal starts with the host's read-only Plan-mode turn and then moves to normal Goal execution. Keep the Goal active through implementation and verification, and use the Goal status as the completion authority. Supervised realignment turns are normal: answer them with a changed, evidence-producing approach or an honest blocker, never another run of the same failing attempt.\\n - **Claude Code:** no documented Codex-style Goal lifecycle endpoint is available to plugins. Do not invent one. Stay in the user's current Claude permission mode, maintain the work as a concise native task list, and continue the execution loop in the same resumable session. Do not enter Claude's approval-gated `/plan` mode merely as ceremony; use it only when the user requested read-only planning. Use native Claude subagents for bounded independent work when warranted. Interruption and continuation are the native session controls (`Ctrl-C`, `/resume`, `--continue`, and `--resume`), not synthetic Cruise Goal states.\\n \\n Treat worker-level and communication-manner preferences as natural-language instructions for this request only. Never persist or globally enforce them. Override the ordinary worker level only when the user explicitly asks for a higher, lower, or numbered level; an explicit terminal `cruise worker --level <1-7>` selection has highest priority for that invocation.\\ndiff --git a/tests/cli-simple.test.mjs b/tests/cli-simple.test.mjs\\nindex f790e89..92a439d 100644\\n--- a/tests/cli-simple.test.mjs\\n+++ b/tests/cli-simple.test.mjs\\n@@ -132,6 +132,23 @@ test('starting Cruise persists only the exact ORIGIN.md request before the norma\\n   assert.equal(await readOriginPrompt(root), prompt);\\n });\\n \\n+test('a supervised Goal stall maps to exit code 3', async (t) => {\\n+  const root = await mkdtemp(join(tmpdir(), 'cruise-start-stalled-'));\\n+  t.after(() => rm(root, { recursive: true, force: true }));\\n+  const canonicalRoot = await realpath(root);\\n+  const result = await runStart({ cwd: root, prompt: 'Finish it.', skill: 'goal' }, {\\n+    clientFactory: () => ({}),\\n+    sessionFactory(input) {\\n+      assert.equal(input.cwd, canonicalRoot);\\n+      return {\\n+        async run() { return { status: 'stalled' }; },\\n+        async interrupt() {},\\n+      };\\n+    },\\n+  });\\n+  assert.equal(result, 3);\\n+});\\n+\\n test('Claude start uses the native Claude adapter and preserves the ORIGIN note', async (t) => {\\n   const root = await mkdtemp(join(tmpdir(), 'cruise-start-claude-'));\\n   t.after(() => rm(root, { recursive: true, force: true }));\\ndiff --git a/tests/simple-session.test.mjs b/tests/simple-session.test.mjs\\nindex 3afc03e..09801c1 100644\\n--- a/tests/simple-session.test.mjs\\n+++ b/tests/simple-session.test.mjs\\n@@ -159,6 +159,95 @@ test('Goal auto-advances each completed active turn until native completion', as\\n   assert.equal(client.calls.find(({ method }) => method === 'turn/start').params.sandboxPolicy.type, 'workspaceWrite');\\n });\\n \\n+test('Goal supervision realigns, runs one final experiment, then pauses with a report', async (t) => {\\n+  const root = await mkdtemp(join(tmpdir(), 'cruise-stalled-goal-'));\\n+  t.after(() => rm(root, { recursive: true, force: true }));\\n+  class StalledGoalClient extends EventEmitter {\\n+    constructor() {\\n+      super();\\n+      this.calls = [];\\n+      this.goal = null;\\n+      this.turns = 0;\\n+    }\\n+\\n+    async start() {}\\n+    async stop() {}\\n+\\n+    async request(method, params = {}) {\\n+      this.calls.push({ method, params });\\n+      if (method === 'thread/start') return { thread: { id: 'thread-stalled' } };\\n+      if (method === 'thread/settings/update') return {};\\n+      if (method === 'thread/goal/get') return { goal: this.goal };\\n+      if (method === 'thread/goal/set') {\\n+        this.goal = { objective: params.objective, status: params.status };\\n+        if (params.status === 'active') {\\n+          queueMicrotask(() => {\\n+            this.emit('notification', {\\n+              method: 'turn/started',\\n+              params: { threadId: 'thread-stalled', turn: { id: 'native-plan', status: 'inProgress' } },\\n+            });\\n+            this.emit('notification', {\\n+              method: 'turn/completed',\\n+              params: { threadId: 'thread-stalled', turn: { id: 'native-plan', status: 'completed' } },\\n+            });\\n+          });\\n+        }\\n+        return { goal: this.goal };\\n+      }\\n+      if (method === 'turn/start') {\\n+        this.turns += 1;\\n+        const id = `stalled-turn-${this.turns}`;\\n+        queueMicrotask(() => {\\n+          this.emit('notification', {\\n+            method: 'item/agentMessage/delta',\\n+            params: { threadId: 'thread-stalled', delta: 'Still investigating without new evidence.\\\\n' },\\n+          });\\n+          this.emit('notification', {\\n+            method: 'turn/completed',\\n+            params: { threadId: 'thread-stalled', turn: { id, status: 'completed' } },\\n+          });\\n+        });\\n+        return { turn: { id } };\\n+      }\\n+      throw new Error(`unexpected request ${method}`);\\n+    }\\n+  }\\n+\\n+  const client = new StalledGoalClient();\\n+  let report = '';\\n+  const session = new SimpleCruiseSession({\\n+    client,\\n+    cwd: root,\\n+    prompt: 'Complete the work without looping.',\\n+    skill: 'goal',\\n+    skillPath: '/tmp/goal-skill.md',\\n+    pickOne: async () => ({ status: 'cancelled' }),\\n+    readLine: async () => '',\\n+    output: { write() {} },\\n+    errorOutput: { write(value) { report += value; } },\\n+    captureFingerprint: async () => 'fixed-fingerprint',\\n+    readPlan: async () => ({ stall: { quietTurns: 1, sameFailure: 9 } }),\\n+  });\\n+  const result = await session.run();\\n+\\n+  assert.equal(result.status, 'stalled');\\n+  assert.equal(result.goal.status, 'paused');\\n+  const instructions = client.calls\\n+    .filter(({ method }) => method === 'turn/start')\\n+    .map(({ params }) => params.input[0].text);\\n+  assert.equal(instructions.length, 4);\\n+  assert.match(instructions[2], /Repeating the same approach is not authorized progress/u);\\n+  assert.match(instructions[2], /workspace fingerprint fixed-finger was unchanged/u);\\n+  assert.match(instructions[3], /last supervised continuation/u);\\n+  assert.deepEqual(client.calls\\n+    .filter(({ method }) => method === 'thread/goal/set')\\n+    .map(({ params }) => params.status), ['active', 'paused']);\\n+  assert.match(report, /stalled after 4 supervised continuation turns/u);\\n+  assert.match(report, /Interventions already attempted/u);\\n+  assert.match(report, /native Goal is paused/u);\\n+  assert.match(report, /Suggested next actions/u);\\n+});\\n+\\n test('interrupting an activation pauses a Goal that became active in flight', async (t) => {\\n   const root = await mkdtemp(join(tmpdir(), 'cruise-interrupted-goal-'));\\n   t.after(() => rm(root, { recursive: true, force: true }));\\nimport { execFile } from 'node:child_process';\\nimport { createHash } from 'node:crypto';\\nimport { promisify } from 'node:util';\\n\\nimport { DEFAULT_STALL } from './flight-plan.mjs';\\n\\nconst execFileAsync = promisify(execFile);\\nconst FAILURE_LINE = /\\\\b(?:error|fail(?:ed|ure)?|exception|panic|traceback)\\\\b/iu;\\n\\nfunction digest(value) {\\n  return createHash('sha256').update(value).digest('hex');\\n}\\n\\nfunction short(value) {\\n  return value ? value.slice(0, 12) : 'unavailable';\\n}\\n\\nfunction assertThreshold(value, name) {\\n  if (!Number.isInteger(value) || value < 1) throw new TypeError(`${name} must be a positive integer`);\\n  return value;\\n}\\n\\nexport class GoalSupervisor {\\n  constructor({ stall = DEFAULT_STALL } = {}) {\\n    this.stall = null;\\n    this.updateStall(stall);\\n    this.turnsObserved = 0;\\n    this.quietTurns = 0;\\n    this.sameFailure = 0;\\n    this.previousFingerprint = null;\\n    this.previousFailure = null;\\n    this.seenFingerprints = new Set();\\n    this.seenFailures = new Set();\\n    this.stage = 'observing';\\n    this.interventions = [];\\n  }\\n\\n  updateStall(stall = DEFAULT_STALL) {\\n    this.stall = Object.freeze({\\n      quietTurns: assertThreshold(stall?.quietTurns, 'stall.quietTurns'),\\n      sameFailure: assertThreshold(stall?.sameFailure, 'stall.sameFailure'),\\n    });\\n  }\\n\\n  recordTurn({ fingerprint = null, failureSignature = null } = {}) {\\n    if (fingerprint !== null && typeof fingerprint !== 'string') throw new TypeError('fingerprint must be a string or null');\\n    if (failureSignature !== null && typeof failureSignature !== 'string') throw new TypeError('failureSignature must be a string or null');\\n    this.turnsObserved += 1;\\n\\n    let workspaceObservation = null;\\n    let progress = false;\\n    if (fingerprint !== null) {\\n      if (this.previousFingerprint === null) {\\n        workspaceObservation = `workspace baseline fingerprint ${short(fingerprint)} was recorded`;\\n      } else if (fingerprint !== this.previousFingerprint && !this.seenFingerprints.has(fingerprint)) {\\n        progress = true;\\n        workspaceObservation = `workspace evidence changed to new fingerprint ${short(fingerprint)}`;\\n      } else if (fingerprint === this.previousFingerprint) {\\n        this.quietTurns += 1;\\n        workspaceObservation = `workspace fingerprint ${short(fingerprint)} was unchanged for ${this.quietTurns} consecutive turn${this.quietTurns === 1 ? '' : 's'}`;\\n      } else {\\n        this.quietTurns += 1;\\n        workspaceObservation = `workspace oscillated to earlier fingerprint ${short(fingerprint)} after ${this.quietTurns} unproductive turn${this.quietTurns === 1 ? '' : 's'}`;\\n      }\\n      this.previousFingerprint = fingerprint;\\n      this.seenFingerprints.add(fingerprint);\\n    }\\n\\n    if (failureSignature === null) {\\n      this.sameFailure = 0;\\n      this.previousFailure = null;\\n    } else {\\n      this.sameFailure = failureSignature === this.previousFailure ? this.sameFailure + 1 : 1;\\n      this.previousFailure = failureSignature;\\n      this.seenFailures.add(failureSignature);\\n    }\\n\\n    if (progress) {\\n      this.quietTurns = 0;\\n      this.sameFailure = 0;\\n      this.stage = 'observing';\\n      this.interventions = [];\\n      return { level: 'ok', reason: workspaceObservation };\\n    }\\n\\n    const reason = this.#reason(workspaceObservation, failureSignature);\\n    if (this.stage === 'realigned') {\\n      this.stage = 'final';\\n      this.interventions.push({ level: 'final-experiment', reason });\\n      return { level: 'final-experiment', reason };\\n    }\\n    if (this.stage === 'final' || this.stage === 'stalled') {\\n      this.stage = 'stalled';\\n      return { level: 'stall', reason };\\n    }\\n    if (\\n      this.quietTurns >= this.stall.quietTurns ||\\n      this.sameFailure >= this.stall.sameFailure\\n    ) {\\n      this.stage = 'realigned';\\n      this.interventions.push({ level: 'realign', reason });\\n      return { level: 'realign', reason };\\n    }\\n    return { level: 'ok', reason };\\n  }\\n\\n  #reason(workspaceObservation, failureSignature) {\\n    const reasons = [];\\n    if (workspaceObservation) reasons.push(workspaceObservation);\\n    else reasons.push('workspace fingerprint evidence was unavailable');\\n    if (failureSignature !== null) {\\n      reasons.push(`failure signature ${short(failureSignature)} repeated ${this.sameFailure} consecutive turn${this.sameFailure === 1 ? '' : 's'}`);\\n    } else {\\n      reasons.push('no repeated failure signature was present');\\n    }\\n    return reasons.join('; ');\\n  }\\n\\n  summary() {\\n    return Object.freeze({\\n      turnsObserved: this.turnsObserved,\\n      fingerprints: Object.freeze([...this.seenFingerprints].map(short)),\\n      failureSignatures: Object.freeze([...this.seenFailures].map(short)),\\n      interventions: Object.freeze(this.interventions.map((item) => Object.freeze({ ...item }))),\\n    });\\n  }\\n}\\n\\nexport async function captureWorkspaceFingerprint(cwd) {\\n  try {\\n    const options = { cwd, encoding: 'utf8', maxBuffer: Infinity };\\n    const [status, diff, cached] = await Promise.all([\\n      execFileAsync('git', ['status', '--porcelain=v1'], options),\\n      execFileAsync('git', ['diff'], options),\\n      execFileAsync('git', ['diff', '--cached'], options),\\n    ]);\\n    return digest(`${status.stdout}\\\\u0000${diff.stdout}\\\\u0000${cached.stdout}`);\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nexport function extractFailureSignature(turnText) {\\n  if (typeof turnText !== 'string') return null;\\n  const lines = turnText.split(/\\\\r?\\\\n/u).filter((line) => FAILURE_LINE.test(line));\\n  if (!lines.length) return null;\\n  const normalized = lines.map((line) => line\\n    .replace(/\\\\b[A-Za-z]:\\\\\\\\(?:[^\\\\\\\\\\\\s:'\\\"]+\\\\\\\\)*[^\\\\\\\\\\\\s:'\\\"]+/gu, '<path>')\\n    .replace(/\\\\/(?:[^/\\\\s:'\\\"]+\\\\/)*[^/\\\\s:'\\\"]+/gu, '<path>')\\n    .replace(/\\\\b(?:0x[a-f\\\\d]+|[a-f\\\\d]{7,})\\\\b/giu, '<hex>')\\n    .replace(/\\\\d+/gu, '<n>')\\n    .replace(/\\\\s+/gu, ' ')\\n    .trim()\\n    .toLowerCase())\\n    .filter(Boolean);\\n  return normalized.length ? digest(normalized.join('\\\\n')) : null;\\n}\\nimport assert from 'node:assert/strict';\\nimport { mkdtemp, rm } from 'node:fs/promises';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport test from 'node:test';\\n\\nimport {\\n  captureWorkspaceFingerprint,\\n  extractFailureSignature,\\n  GoalSupervisor,\\n} from '../scripts/lib/supervisor.mjs';\\n\\ntest('new workspace evidence is progress and resets an active ladder', () => {\\n  const supervisor = new GoalSupervisor({ stall: { quietTurns: 2, sameFailure: 2 } });\\n  assert.equal(supervisor.recordTurn({ fingerprint: 'alpha' }).level, 'ok');\\n  assert.equal(supervisor.recordTurn({ fingerprint: 'alpha' }).level, 'ok');\\n  assert.equal(supervisor.recordTurn({ fingerprint: 'alpha' }).level, 'realign');\\n  assert.equal(supervisor.recordTurn({ fingerprint: 'bravo' }).level, 'ok');\\n  assert.equal(supervisor.recordTurn({ fingerprint: 'bravo' }).level, 'ok');\\n  assert.equal(supervisor.summary().interventions.length, 0);\\n});\\n\\ntest('quiet turns climb once through realign, final experiment, and stall', () => {\\n  const supervisor = new GoalSupervisor({ stall: { quietTurns: 2, sameFailure: 9 } });\\n  const levels = [\\n    supervisor.recordTurn({ fingerprint: 'same' }).level,\\n    supervisor.recordTurn({ fingerprint: 'same' }).level,\\n    supervisor.recordTurn({ fingerprint: 'same' }).level,\\n    supervisor.recordTurn({ fingerprint: 'same' }).level,\\n    supervisor.recordTurn({ fingerprint: 'same' }).level,\\n  ];\\n  assert.deepEqual(levels, ['ok', 'ok', 'realign', 'final-experiment', 'stall']);\\n  assert.match(supervisor.summary().interventions[0].reason, /unchanged for 2 consecutive turns/u);\\n  assert.deepEqual(supervisor.summary().interventions.map(({ level }) => level), [\\n    'realign',\\n    'final-experiment',\\n  ]);\\n});\\n\\ntest('returning to an earlier fingerprint is named as oscillation', () => {\\n  const supervisor = new GoalSupervisor({ stall: { quietTurns: 1, sameFailure: 9 } });\\n  assert.equal(supervisor.recordTurn({ fingerprint: 'before' }).level, 'ok');\\n  assert.equal(supervisor.recordTurn({ fingerprint: 'after' }).level, 'ok');\\n  const verdict = supervisor.recordTurn({ fingerprint: 'before' });\\n  assert.equal(verdict.level, 'realign');\\n  assert.match(verdict.reason, /oscillated to earlier fingerprint/u);\\n});\\n\\ntest('repeated failures supervise a non-git workspace independently', () => {\\n  const supervisor = new GoalSupervisor({ stall: { quietTurns: 9, sameFailure: 2 } });\\n  const signature = 'a'.repeat(64);\\n  assert.equal(supervisor.recordTurn({ fingerprint: null, failureSignature: signature }).level, 'ok');\\n  const realign = supervisor.recordTurn({ fingerprint: null, failureSignature: signature });\\n  assert.equal(realign.level, 'realign');\\n  assert.match(realign.reason, /failure signature a{12} repeated 2 consecutive turns/u);\\n  assert.equal(supervisor.recordTurn({ fingerprint: null, failureSignature: signature }).level, 'final-experiment');\\n  assert.equal(supervisor.recordTurn({ fingerprint: null, failureSignature: signature }).level, 'stall');\\n});\\n\\ntest('workspace fingerprinting is disabled without a git repository', async () => {\\n  const cwd = await mkdtemp(join(tmpdir(), 'cruise-supervisor-no-git-'));\\n  try {\\n    assert.equal(await captureWorkspaceFingerprint(cwd), null);\\n  } finally {\\n    await rm(cwd, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('failure signatures ignore paths, line numbers, hex values, and whitespace', () => {\\n  const first = 'Error: parser failed at /Users/alice/app/parser.js:142 id deadbeef1234';\\n  const second = 'ERROR:   parser failed at /opt/build/parser.js:987 id cafe01234567';\\n  assert.equal(extractFailureSignature(first), extractFailureSignature(second));\\n  assert.equal(extractFailureSignature('Everything passed.'), null);\\n  assert.equal(extractFailureSignature(null), null);\\n});\\n\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"019f837a-56d2-77f1-bda9-d41d805796c6\"}}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:187:{\"timestamp\":\"2026-07-21T07:01:12.644Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"call_id\":\"call_4IHl3lBMOaAjDNw1yeGN2sJA\",\"output\":[{\"type\":\"input_text\",\"text\":\"Script completed\\nWall time 0.1 seconds\\nOutput:\\n\"},{\"type\":\"input_text\",\"text\":\"   220\\t\\n   221\\t/**\\n   222\\t * A normal Codex session. Goal is the autonomous lane: its native Goal remains\\n   223\\t * active across as many ordinary turns as are needed to satisfy its evidence.\\n   224\\t */\\n   225\\texport class SimpleCruiseSession extends EventEmitter {\\n   226\\t  constructor({\\n   227\\t    client,\\n   228\\t    cwd,\\n   229\\t    prompt,\\n   230\\t    skill,\\n   231\\t    skillPath,\\n   232\\t    pickOne,\\n   233\\t    readLine,\\n   234\\t    lineReader = null,\\n   235\\t    input = process.stdin,\\n   236\\t    output = process.stdout,\\n   237\\t    errorOutput = process.stderr,\\n   238\\t    supervisor = new GoalSupervisor(),\\n   239\\t    captureFingerprint = captureWorkspaceFingerprint,\\n   240\\t    readPlan = readFlightPlan,\\n   241\\t  }) {\\n   242\\t    super();\\n   243\\t    if (!client || !cwd || !prompt || !skill || !skillPath) {\\n   244\\t      throw new TypeError('client, cwd, prompt, skill, and skillPath are required');\\n   245\\t    }\\n   246\\t    this.client = client;\\n   247\\t    this.cwd = cwd;\\n   248\\t    this.prompt = prompt;\\n   249\\t    this.skill = skill;\\n   250\\t    this.skillPath = skillPath;\\n   251\\t    this.goalPreparationOnly = skill === 'goal' && isPreparationOnlyGoalPrompt(prompt);\\n   252\\t    this.pickOne = pickOne;\\n   253\\t    this.readLine = readLine;\\n   254\\t    this.lineReader = lineReader;\\n   255\\t    this.input = input;\\n   256\\t    this.output = output;\\n   257\\t    this.errorOutput = errorOutput;\\n   258\\t    this.supervisor = supervisor;\\n   259\\t    this.captureFingerprint = captureFingerprint;\\n   260\\t    this.readPlan = readPlan;\\n   261\\t    this.turnAgentText = '';\\n   262\\t    this.threadId = null;\\n   263\\t    this.threadModel = null;\\n   264\\t    this.threadReasoningEffort = null;\\n   265\\t    this.turnId = null;\\n   266\\t    this.pending = null;\\n   267\\t    this.earlyTurnResults = new Map();\\n   268\\t    this.goal = null;\\n   269\\t    this.interrupted = false;\\n   270\\t    this.stopping = false;\\n   271\\t    this.interactions = Promise.resolve();\\n   272\\t    this.onRequest = (message) => this.enqueueRequest(message);\\n   273\\t    this.onNotification = (message) => this.handleNotification(message);\\n   274\\t    this.onExit = (info) => this.handleExit(info);\\n   275\\t  }\\n   276\\t\\n   277\\t  async run() {\\n   278\\t    this.client.on('request', this.onRequest);\\n   279\\t    this.client.on('notification', this.onNotification);\\n   280\\t    this.client.on('exit', this.onExit);\\n   281\\t    try {\\n   282\\t      await this.client.start();\\n   283\\t      const started = await this.client.request('thread/start', {\\n   284\\t        cwd: this.cwd,\\n   285\\t        runtimeWorkspaceRoots: [],\\n   286\\t        approvalPolicy: 'on-request',\\n   287\\t        sandbox: 'workspace-write',\\n   288\\t        serviceName: 'cruise',\\n   289\\t        ephemeral: false,\\n   290\\t        developerInstructions: [\\n   291\\t          'Work directly with the user request and the repository.',\\n   292\\t          'Cruise keeps .cruise/ORIGIN.md as a verbatim request note; Goal work may also maintain the user-editable advisory .cruise/FLIGHT.md.',\\n   293\\t          'Do not create Cruise run-control files, approval digests, archives, or YAML workflow state. FLIGHT.md frontmatter is an advisory note, not workflow authority.',\\n   294\\t          'Use normal Codex approvals and report failures factually.',\\n   295\\t          ...(this.skill === 'goal' ? [AUTONOMOUS_GOAL_INSTRUCTIONS] : []),\\n   296\\t        ].join(' '),\\n   297\\t      });\\n   298\\t      this.threadId = started.thread.id;\\n   299\\t      this.threadModel = started.model ?? null;\\n   300\\t      this.threadReasoningEffort = started.reasoningEffort ?? null;\\n   301\\t\\n   302\\t      let result;\\n   303\\t      let goalExecutionMode = false;\\n   304\\t      let continuationCompleted = false;\\n   305\\t      if (this.skill === 'goal') {\\n   306\\t        await this.updateGoalMode('plan');\\n   307\\t        const nativeTurn = this.waitForNativeGoalTurn();\\n   308\\t        try {\\n   309\\t          await this.activateGoal();\\n   310\\t        } catch (error) {\\n   311\\t          this.pending?.reject(error);\\n   312\\t          await nativeTurn.catch(() => {});\\n   313\\t          throw error;\\n   314\\t        }\\n   315\\t        result = await nativeTurn;\\n   316\\t      } else {\\n   317\\t        result = await this.startTurn([\\n   318\\t          { type: 'skill', name: this.skill, path: this.skillPath },\\n   319\\t          {\\n   320\\t            type: 'text',\\n   321\\t            text: this.prompt,\\n   322\\t            text_elements: [],\\n   323\\t          },\\n   324\\t        ]);\\n   325\\t      }\\n   326\\t      while (this.skill === 'goal') {\\n   327\\t        await this.interactions;\\n   328\\t        if (result.status !== 'completed') {\\n   329\\t          throw new Error(`Cruise ${this.skill} ended with status ${result.status}.`);\\n   330\\t        }\\n   331\\t        const goal = await this.refreshGoal();\\n   332\\t        if (TERMINAL_GOAL_STATUSES.has(goal?.status)) {\\n   333\\t          return { status: goal.status, skill: this.skill, threadId: this.threadId, goal };\\n   334\\t        }\\n   335\\t        if (goal?.status !== 'active') {\\n   336\\t          throw new Error(`Cruise Goal entered unsupported status ${String(goal?.status ?? 'missing')}.`);\\n   337\\t        }\\n   338\\t        if (this.goalPreparationOnly) {\\n   339\\t          const completed = await this.completePreparedGoal(goal);\\n   340\\t          return {\\n   341\\t            status: completed.status,\\n   342\\t            skill: this.skill,\\n   343\\t            threadId: this.threadId,\\n   344\\t            goal: completed,\\n   345\\t          };\\n   346\\t        }\\n   347\\t        let continuationInstructions = GOAL_CONTINUATION_INSTRUCTIONS;\\n   348\\t        if (continuationCompleted) {\\n   349\\t          const verdict = await this.superviseGoalTurn();\\n   350\\t          if (verdict.level === 'stall') {\\n   351\\t            await this.pauseActiveGoal();\\n   352\\t            this.errorOutput.write(`${stallReport(verdict, this.supervisor.summary())}\\\\n`);\\n   353\\t            return {\\n   354\\t              status: 'stalled',\\n   355\\t              skill: this.skill,\\n   356\\t              threadId: this.threadId,\\n   357\\t              goal: this.goal,\\n   358\\t            };\\n   359\\t          }\\n   360\\t          if (verdict.level === 'realign') continuationInstructions = realignmentInstructions(verdict.reason);\\n   361\\t          else if (verdict.level === 'final-experiment') continuationInstructions = finalExperimentInstructions(verdict.reason);\\n   362\\t        }\\n   363\\t        if (!goalExecutionMode) {\\n   364\\t          await this.updateGoalMode('default');\\n   365\\t          goalExecutionMode = true;\\n   366\\t        }\\n   367\\t        result = await this.startTurn([\\n   368\\t          {\\n   369\\t            type: 'text',\\n   370\\t            text: continuationInstructions,\\n   371\\t            text_elements: [],\\n   372\\t          },\\n   373\\t        ], { mode: 'default' });\\n   374\\t        continuationCompleted = true;\\n   375\\t      }\\n   376\\t      await this.interactions;\\n   377\\t      if (result.status !== 'completed') {\\n   378\\t        throw new Error(`Cruise ${this.skill} ended with status ${result.status}.`);\\n   379\\t      }\\n   380\\t      return { status: 'complete', skill: this.skill, threadId: this.threadId };\\n   381\\t    } finally {\\n   382\\t      this.stopping = true;\\n   383\\t      this.client.off?.('request', this.onRequest);\\n   384\\t      this.client.off?.('notification', this.onNotification);\\n   385\\t      this.client.off?.('exit', this.onExit);\\n   386\\t      await this.client.stop().catch(() => {});\\n   387\\t    }\\n   388\\t  }\\n   389\\t\\n   390\\t  async activateGoal() {\\n   391\\t    if (this.interrupted) throw new SimpleCruiseInterruptedError();\\n   392\\t    const current = await this.client.request('thread/goal/get', { threadId: this.threadId });\\n   393\\t    if (this.interrupted) throw new SimpleCruiseInterruptedError();\\n   394\\t    if (current?.goal) {\\n   395\\t      throw new Error(`Cruise cannot replace the existing native Goal (${current.goal.status}).`);\\n   396\\t    }\\n   397\\t    const objective = [\\n   398\\t      `Autonomously complete the user's Cruise Goal: ${this.prompt}`,\\n   399\\t      GOAL_BOOTSTRAP_INSTRUCTIONS,\\n   400\\t      'Use each codebase-aware plan to launch the next ready micro-goal, then implement, verify, realign, and continue without routine phase approvals.',\\n   401\\t    ].join(' ');\\n   402\\t    const activated = await this.client.request('thread/goal/set', {\\n   403\\t      threadId: this.threadId,\\n   404\\t      objective,\\n   405\\t      status: 'active',\\n   406\\t    });\\n   407\\t    if (activated?.goal?.status !== 'active') {\\n   408\\t      throw new Error('Codex did not confirm the native Goal as active.');\\n   409\\t    }\\n   410\\t    this.goal = activated.goal;\\n   410\\t    this.goal = activated.goal;\\n   411\\t    if (this.interrupted) {\\n   412\\t      await this.pauseActiveGoal();\\n   413\\t      throw new SimpleCruiseInterruptedError();\\n   414\\t    }\\n   415\\t  }\\n   416\\t\\n   417\\t  async refreshGoal() {\\n   418\\t    const result = await this.client.request('thread/goal/get', { threadId: this.threadId });\\n   419\\t    this.goal = result?.goal ?? null;\\n   420\\t    return this.goal;\\n   421\\t  }\\n   422\\t\\n   423\\t  async completePreparedGoal(goal) {\\n   424\\t    const completed = await this.client.request('thread/goal/set', {\\n   425\\t      threadId: this.threadId,\\n   426\\t      objective: goal.objective,\\n   427\\t      status: 'complete',\\n   428\\t    });\\n   429\\t    if (completed?.goal?.status !== 'complete') {\\n   430\\t      throw new Error('Codex did not confirm the prepared Goal as complete.');\\n   431\\t    }\\n   432\\t    this.goal = completed.goal;\\n   433\\t    return this.goal;\\n   434\\t  }\\n   435\\t\\n   436\\t  goalTurnSettings(mode) {\\n   437\\t    const collaborationMode = { mode };\\n   438\\t    if (this.threadModel) {\\n   439\\t      collaborationMode.settings = {\\n   440\\t        model: this.threadModel,\\n   441\\t        ...(this.threadReasoningEffort\\n   442\\t          ? { reasoning_effort: this.threadReasoningEffort }\\n   443\\t          : {}),\\n   444\\t        developer_instructions: AUTONOMOUS_GOAL_INSTRUCTIONS,\\n   445\\t      };\\n   446\\t    }\\n   447\\t    return {\\n   448\\t      collaborationMode,\\n   449\\t      sandboxPolicy: mode === 'plan'\\n   450\\t        ? { type: 'readOnly' }\\n   451\\t        : { type: 'workspaceWrite', writableRoots: [this.cwd] },\\n   452\\t    };\\n   453\\t  }\\n   454\\t\\n   455\\t  async updateGoalMode(mode) {\\n   456\\t    const settings = this.goalTurnSettings(mode);\\n   457\\t    await this.client.request('thread/settings/update', {\\n   458\\t      threadId: this.threadId,\\n   459\\t      cwd: this.cwd,\\n   460\\t      approvalPolicy: 'on-request',\\n   461\\t      ...settings,\\n   462\\t    });\\n   463\\t  }\\n   464\\t\\n   465\\t  async startTurn(input, { mode = null } = {}) {\\n   466\\t    this.turnAgentText = '';\\n   467\\t    const completion = deferred();\\n   468\\t    this.turnId = null;\\n   469\\t    this.pending = completion;\\n   470\\t    try {\\n   471\\t      const goalSettings = mode === null ? null : this.goalTurnSettings(mode);\\n   472\\t      const turn = await this.client.request('turn/start', {\\n   473\\t        threadId: this.threadId,\\n   474\\t        input,\\n   475\\t        cwd: this.cwd,\\n   476\\t        runtimeWorkspaceRoots: [],\\n   477\\t        approvalPolicy: 'on-request',\\n   478\\t        ...(goalSettings ?? {\\n   479\\t          sandboxPolicy: { type: 'workspaceWrite', writableRoots: [this.cwd] },\\n   480\\t        }),\\n   481\\t      });\\n   482\\t      if (this.pending === completion) {\\n   483\\t        this.turnId = turn.turn.id;\\n   484\\t        this.resolveEarlyTurnResult(turn.turn.id);\\n   485\\t      }\\n   486\\t      return await completion.promise;\\n   487\\t    } finally {\\n   488\\t      if (this.pending === completion) {\\n   489\\t        this.pending = null;\\n   490\\t        this.earlyTurnResults.clear();\\n   491\\t      }\\n   492\\t    }\\n   493\\t  }\\n   494\\t\\n   495\\t  async waitForNativeGoalTurn() {\\n   496\\t    const completion = deferred();\\n   497\\t    this.turnId = null;\\n   498\\t    this.pending = completion;\\n   499\\t    try {\\n   500\\t      return await completion.promise;\\n   501\\t    } finally {\\n   502\\t      if (this.pending === completion) {\\n   503\\t        this.pending = null;\\n   504\\t        this.earlyTurnResults.clear();\\n   505\\t      }\\n   506\\t    }\\n   507\\t  }\\n   508\\t\\n   509\\t  resolveEarlyTurnResult(turnId) {\\n   510\\t    const early = this.earlyTurnResults.get(turnId);\\n   511\\t    if (!early || !this.pending || this.turnId !== turnId) return;\\n   512\\t    this.earlyTurnResults.delete(turnId);\\n   513\\t    this.turnId = null;\\n   514\\t    if (early.error) this.pending.reject(early.error);\\n   515\\t    else this.pending.resolve(early.turn);\\n   516\\t  }\\n   517\\t\\n   518\\t  settleTurn(turnId, { turn = null, error = null } = {}) {\\n   519\\t    if (!this.pending || !turnId) return;\\n   520\\t    if (this.turnId === null) {\\n   521\\t      this.earlyTurnResults.set(turnId, { turn, error });\\n   522\\t      return;\\n   523\\t    }\\n   524\\t    if (turnId !== this.turnId) return;\\n   525\\t    this.turnId = null;\\n   526\\t    if (error) this.pending.reject(error);\\n   527\\t    else this.pending.resolve(turn);\\n   528\\t  }\\n   529\\t\\n   530\\t  async interrupt() {\\n   531\\t    this.interrupted = true;\\n   532\\t    this.lineReader?.cancel?.('ctrl-c');\\n   533\\t    if (this.threadId && this.turnId) {\\n   534\\t      await this.client.request('turn/interrupt', {\\n   535\\t        threadId: this.threadId,\\n   536\\t        turnId: this.turnId,\\n   537\\t      }).catch(() => {});\\n   538\\t    }\\n   539\\t    await this.pauseActiveGoal().catch(() => {});\\n   540\\t    this.pending?.reject(new SimpleCruiseInterruptedError());\\n   541\\t  }\\n   542\\t\\n   543\\t  async pauseActiveGoal() {\\n   544\\t    if (!this.threadId) return;\\n   545\\t    const current = this.goal ?? (await this.client.request('thread/goal/get', {\\n   546\\t      threadId: this.threadId,\\n   547\\t    })).goal;\\n   548\\t    if (current?.status !== 'active') return;\\n   549\\t    const paused = await this.client.request('thread/goal/set', {\\n   550\\t      threadId: this.threadId,\\n   551\\t      objective: current.objective,\\n   552\\t      status: 'paused',\\n   553\\t    });\\n   554\\t    this.goal = paused?.goal ?? { ...current, status: 'paused' };\\n   555\\t  }\\n   556\\t\\n   557\\t  async superviseGoalTurn() {\\n   558\\t    const [plan, fingerprint] = await Promise.all([\\n   559\\t      Promise.resolve().then(() => this.readPlan(this.cwd)).catch(() => null),\\n   560\\t      Promise.resolve().then(() => this.captureFingerprint(this.cwd)).catch(() => null),\\n   561\\t    ]);\\n   562\\t    this.supervisor.updateStall(plan?.stall ?? DEFAULT_STALL);\\n   563\\t    return this.supervisor.recordTurn({\\n   564\\t      fingerprint,\\n   565\\t      failureSignature: extractFailureSignature(this.turnAgentText),\\n   566\\t    });\\n   567\\t  }\\n   568\\t\\n   569\\t  enqueueRequest(message) {\\n   570\\t    this.interactions = this.interactions\\n   571\\t      .then(() => this.handleRequest(message))\\n   572\\t      .catch((error) => this.client.respondError(message.id, error));\\n   573\\t  }\\n   574\\t\\n   575\\t  async handleRequest(message) {\\n   576\\t    if (this.stopping) return;\\n   577\\t    let result;\\n   578\\t    if (message.method === 'item/tool/requestUserInput') {\\n   579\\t      result = this.skill === 'goal' ? automaticGoalProgress(message.params) : null;\\n   580\\t      if (result === null) {\\n   581\\t        result = await answerUserInput(message.params, {\\n   582\\t          pickOne: this.pickOne,\\n   583\\t          readLine: this.readLine,\\n   584\\t          input: this.input,\\n   585\\t          output: this.errorOutput,\\n   586\\t          lineReader: this.lineReader,\\n   587\\t        });\\n   588\\t      }\\n   589\\t    } else if ([\\n   590\\t      'item/commandExecution/requestApproval',\\n   591\\t      'item/fileChange/requestApproval',\\n   592\\t      'item/permissions/requestApproval',\\n   593\\t    ].includes(message.method)) {\\n   594\\t      const decision = await answerApproval(message.params, {\\n   595\\t        pickOne: this.pickOne,\\n   596\\t        input: this.input,\\n   597\\t        output: this.errorOutput,\\n   598\\t        lineReader: this.lineReader,\\n   599\\t      });\\n   600\\t      result = message.method === 'item/permissions/requestApproval'\\n   601\\t        ? { permissions: decision === 'accept' ? message.params.permissions ?? {} : {}, scope: 'turn' }\\n   602\\t        : { decision };\\n   603\\t    } else if (message.method === 'currentTime/read') {\\n   604\\t      result = { currentTimeAt: Math.floor(Date.now() / 1000) };\\n   605\\t    } else {\\n   606\\t      this.client.respondError(message.id, -32601, `Cruise does not support ${message.method}`);\\n   607\\t      return;\\n   608\\t    }\\n   609\\t    this.client.respond(message.id, result);\\n   610\\t  }\\n   611\\t\\n   612\\t  handleNotification(message) {\\n   613\\t    const params = message.params ?? {};\\n   614\\t    if (params.threadId && this.threadId && params.threadId !== this.threadId) return;\\n   615\\t    if (message.method === 'item/agentMessage/delta') {\\n   616\\t      const delta = String(params.delta ?? '');\\n   617\\t      this.output.write(delta);\\n   618\\t      if (this.skill === 'goal' && this.turnAgentText.length < MAX_TURN_AGENT_TEXT) {\\n   619\\t        this.turnAgentText += delta.slice(0, MAX_TURN_AGENT_TEXT - this.turnAgentText.length);\\n   620\\t      }\\n   621\\t    } else if (message.method === 'turn/started') {\\n   622\\t      if (this.pending && this.turnId === null && params.turn?.id) {\\n   623\\t        this.turnId = params.turn.id;\\n   624\\t        this.resolveEarlyTurnResult(params.turn.id);\\n   625\\t      }\\n   626\\t    } else if (message.method === 'turn/completed') {\\n   627\\t      this.settleTurn(params.turn?.id, { turn: params.turn });\\n   628\\t    } else if (message.method === 'turn/failed') {\\n   629\\t      this.settleTurn(params.turn?.id, {\\n   630\\t        error: new Error(params.turn?.error?.message ?? 'Cruise turn failed.'),\\n   631\\t      });\\n   632\\t    } else if (message.method === 'thread/goal/updated' && params.goal) {\\n   633\\t      this.goal = params.goal;\\n   634\\t    }\\n   635\\t  }\\n   636\\t\\n   637\\t  handleExit(info = {}) {\\n   638\\t    if (!this.stopping) {\\n   639\\t      this.pending?.reject(new Error(`Codex app-server exited (${info.code ?? 'unknown'}).`));\\n   640\\t    }\\n   641\\t  }\\n   642\\t}\\n     1\\t#!/usr/bin/env node\\n     2\\t\\n     3\\timport { spawnSync } from 'node:child_process';\\n     4\\timport { createRequire } from 'node:module';\\n     5\\timport { stat, realpath } from 'node:fs/promises';\\n     6\\timport { createInterface } from 'node:readline/promises';\\n     7\\timport { resolve } from 'node:path';\\n     8\\timport { fileURLToPath } from 'node:url';\\n     9\\t\\n    10\\timport { AppServerClient } from './lib/app-server-client.mjs';\\n    11\\timport { runClaudeSession, runClaudeWorker } from './lib/claude-cli.mjs';\\n    12\\timport { writeOriginPrompt } from './lib/origin-note.mjs';\\n    13\\timport { pickOne } from './lib/picker.mjs';\\n    14\\timport { providerDefinition, resolveProvider, skillReference } from './lib/provider.mjs';\\n    15\\timport {\\n    16\\t  SimpleCruiseInterruptedError,\\n    17\\t  SimpleCruiseSession,\\n    18\\t} from './lib/simple-session.mjs';\\n    19\\timport { runSimpleWorker } from './lib/simple-worker.mjs';\\n    20\\t\\n    21\\tconst require = createRequire(import.meta.url);\\n    22\\tconst packageMetadata = require('../package.json');\\n    23\\t\\n    24\\texport const CLI_VERSION = packageMetadata.version;\\n    25\\texport const PUBLIC_SKILLS = Object.freeze(['build', 'quick', 'refine', 'goal', 'debug']);\\n    26\\t\\n    27\\tconst SCRIPT_PATH = fileURLToPath(import.meta.url);\\n    28\\tconst PACKAGE_ROOT = resolve(fileURLToPath(new URL('../', import.meta.url)));\\n    29\\tconst SKILLS_ROOT = resolve(fileURLToPath(new URL('../skills/', import.meta.url)));\\n    30\\t\\n    31\\tconst HELP = `Cruise ${CLI_VERSION} — a thin Codex and Claude Code task launcher\\n    32\\t\\n    33\\tUsage:\\n    34\\t  cruise [--codex|--claude] [start] [-C <directory>] <request...>\\n    35\\t  cruise [--codex|--claude] <build|quick|refine|goal|debug> [-C <directory>] <request...>\\n    36\\t  cruise [--codex|--claude] worker [--level <1-7>] [-C <directory>] <task...>\\n    37\\t  cruise [--codex|--claude] doctor [--json]\\n    38\\t\\n    39\\tCruise records the exact request in .cruise/ORIGIN.md; Goal runs may also keep\\n    40\\tan advisory .cruise/FLIGHT.md. Codex Goal loops use evidence-based stall\\n    41\\tsupervision and pause with a report after two visible realignment attempts.\\n    42\\tCruise has no approval authority, archive, run-control YAML, digest, or retry\\n    43\\tledger. The selected host's native permissions remain the authority for work\\n    44\\tand effects. Codex is the default; CRUISE_PROVIDER may set a request-scoped\\n    45\\tdefault to codex or claude.\\n    46\\t`;\\n    47\\t\\n    48\\tfunction displayError(value) {\\n    49\\t  return String(value ?? 'Unknown Cruise error')\\n    50\\t    .replace(/[\\\\u0000-\\\\u001f\\\\u007f]+/gu, ' ')\\n    51\\t    .replace(/\\\\s+/gu, ' ')\\n    52\\t    .trim();\\n    53\\t}\\n    54\\t\\n    55\\tfunction extractProviderArgs(argv, env) {\\n    56\\t  const args = [];\\n    57\\t  let selected = null;\\n    58\\t  for (let index = 0; index < argv.length; index += 1) {\\n    59\\t    const arg = argv[index];\\n    60\\t    if (arg === '--') {\\n    61\\t      args.push(...argv.slice(index));\\n    62\\t      break;\\n    63\\t    }\\n    64\\t    let candidate = null;\\n    65\\t    if (arg === '--codex') candidate = 'codex';\\n    66\\t    else if (arg === '--claude') candidate = 'claude';\\n    67\\t    else if (arg === '--provider') {\\n    68\\t      candidate = argv[++index];\\n    69\\t      if (!candidate) throw new Error('--provider requires codex or claude.');\\n    70\\t    }\\n    71\\t    if (candidate === null) {\\n    72\\t      args.push(arg);\\n    73\\t      continue;\\n    74\\t    }\\n    75\\t    const normalized = resolveProvider(candidate, { env: {} });\\n    76\\t    if (selected !== null && selected !== normalized) {\\n    77\\t      throw new Error('Choose only one provider: --codex or --claude.');\\n    78\\t    }\\n    79\\t    selected = normalized;\\n    80\\t  }\\n    81\\t  return { args, provider: resolveProvider(selected, { env }) };\\n    82\\t}\\n    83\\t\\n    84\\texport function parseArgs(argv, { env = process.env } = {}) {\\n    85\\t  const extracted = extractProviderArgs([...argv], env);\\n    86\\t  const args = extracted.args;\\n    87\\t  const provider = extracted.provider;\\n    88\\t  if (args[0] === 'picker-demo') {\\n    89\\t    throw new Error('picker-demo was removed; Cruise selectors are available only when the active host requests a real choice.');\\n    90\\t  }\\n    91\\t  if (args[0] === 'config') {\\n    92\\t    throw new Error(`Cruise has no persistent config command. State worker-level or communication-style preferences in the current ${skillReference(provider, '<skill>')} request.`);\\n    93\\t  }\\n    94\\t  let command = 'start';\\n    95\\t  if (['start', ...PUBLIC_SKILLS, 'worker', 'doctor', 'help'].includes(args[0])) {\\n    96\\t    command = args.shift();\\n    97\\t  }\\n    98\\t  const options = {\\n    99\\t    command,\\n   100\\t    skill: PUBLIC_SKILLS.includes(command) ? command : 'goal',\\n   101\\t    provider,\\n   102\\t    cwd: process.cwd(),\\n   103\\t    json: false,\\n   104\\t    help: false,\\n   105\\t    version: false,\\n   106\\t    level: null,\\n   107\\t    promptParts: [],\\n   108\\t  };\\n   109\\t  for (let index = 0; index < args.length; index += 1) {\\n   110\\t    const arg = args[index];\\n   111\\t    if (arg === '--') {\\n   112\\t      options.promptParts.push(...args.slice(index + 1));\\n   113\\t      break;\\n   114\\t    }\\n   115\\t    if (arg === '-h' || arg === '--help') options.help = true;\\n   116\\t    else if (arg === '-V' || arg === '--version') options.version = true;\\n   117\\t    else if (arg === '--json' && command === 'doctor') options.json = true;\\n   118\\t    else if (arg === '--level') {\\n   119\\t      if (command !== 'worker') throw new Error('--level is supported only by cruise worker.');\\n   120\\t      if (options.level !== null) throw new Error('--level may be supplied only once.');\\n   121\\t      const value = args[++index];\\n   122\\t      if (!/^\\\\d+$/u.test(value ?? '')) throw new Error('--level requires an integer from 1 through 7.');\\n   123\\t      options.level = Number(value);\\n   124\\t      if (options.level < 1 || options.level > 7) {\\n   125\\t        throw new Error('--level requires an integer from 1 through 7.');\\n   126\\t      }\\n   127\\t    }\\n   128\\t    else if (arg === '-C' || arg === '--cwd') {\\n   129\\t      const value = args[++index];\\n   130\\t      if (!value) throw new Error(`${arg} requires a directory.`);\\n   131\\t      options.cwd = resolve(value);\\n   132\\t    } else if (arg.startsWith('-')) {\\n   133\\t      throw new Error(`${arg} is not supported by the prompt-only Cruise runtime.`);\\n   134\\t    } else if (command === 'doctor') {\\n   135\\t      throw new Error(`Unexpected ${command} argument: ${arg}`);\\n   136\\t    } else options.promptParts.push(arg);\\n   137\\t  }\\n   138\\t  if (options.json && command !== 'doctor') throw new Error('--json is supported only by cruise doctor.');\\n   139\\t  const prompt = options.promptParts.join(' ');\\n   140\\t  if (!options.help && !options.version && !['doctor', 'help'].includes(command) && !prompt) {\\n   141\\t    throw new Error('Cruise requires a request.');\\n   142\\t  }\\n   143\\t  return { ...options, prompt };\\n   144\\t}\\n   145\\t\\n   146\\texport async function readLineOnce({ prompt, input = process.stdin, output = process.stderr }) {\\n   147\\t  const readline = createInterface({\\n   148\\t    input,\\n   149\\t    output,\\n   150\\t    terminal: Boolean(input.isTTY && output.isTTY),\\n   151\\t  });\\n   152\\t  try {\\n   153\\t    return await readline.question(prompt);\\n   154\\t  } finally {\\n   155\\t    readline.close();\\n   156\\t  }\\n   157\\t}\\n   158\\t\\n   159\\tasync function validateWorkingDirectory(cwd) {\\n   160\\t  const metadata = await stat(cwd);\\n   161\\t  if (!metadata.isDirectory()) throw new Error(`Not a directory: ${cwd}`);\\n   162\\t  return realpath(cwd);\\n   163\\t}\\n   164\\t\\n   165\\texport async function runStart(\\n   166\\t  options,\\n   167\\t  {\\n   168\\t    clientFactory = (input) => new AppServerClient(input),\\n   169\\t    claudeRunner = runClaudeSession,\\n   170\\t    sessionFactory = (input) => new SimpleCruiseSession(input),\\n   171\\t  } = {},\\n   172\\t) {\\n   173\\t  const cwd = await validateWorkingDirectory(options.cwd);\\n   174\\t  await writeOriginPrompt(cwd, options.prompt);\\n   175\\t  const provider = resolveProvider(options.provider);\\n   176\\t  if (provider === 'claude') {\\n   177\\t    const result = await claudeRunner({\\n   178\\t      cwd,\\n   179\\t      pluginRoot: PACKAGE_ROOT,\\n   180\\t      prompt: options.prompt,\\n   181\\t      skill: options.skill,\\n   182\\t    });\\n   183\\t    return result.exitCode;\\n   184\\t  }\\n   185\\t  const client = clientFactory({\\n   186\\t    spawnOptions: { cwd },\\n   187\\t    clientInfo: { name: 'cruise', title: 'Cruise', version: CLI_VERSION },\\n   188\\t    onError(error) {\\n   189\\t      process.stderr.write(`Cruise warning: ${displayError(error.message)}\\\\n`);\\n   190\\t    },\\n   191\\t  });\\n   192\\t  const session = sessionFactory({\\n   193\\t    client,\\n   194\\t    cwd,\\n   195\\t    prompt: options.prompt,\\n   196\\t    skill: options.skill,\\n   197\\t    skillPath: resolve(SKILLS_ROOT, options.skill, 'SKILL.md'),\\n   198\\t    pickOne,\\n   199\\t    readLine: readLineOnce,\\n   200\\t  });\\n   201\\t  const onSigint = () => void session.interrupt();\\n   202\\t  process.on('SIGINT', onSigint);\\n   203\\t  try {\\n   204\\t    const result = await session.run();\\n   205\\t    return result.status === 'complete' ? 0 : result.status === 'stalled' ? 3 : 2;\\n   206\\t  } catch (error) {\\n   207\\t    if (error instanceof SimpleCruiseInterruptedError) return 130;\\n   208\\t    throw error;\\n   209\\t  } finally {\\n   210\\t    process.removeListener('SIGINT', onSigint);\\n   211\\t  }\\n   212\\t}\\n   213\\t\\n   214\\texport async function runWorker(options, {\\n   215\\t  worker = runSimpleWorker,\\n   216\\t  claudeWorker = runClaudeWorker,\\n   217\\t} = {}) {\\n   218\\t  const cwd = await validateWorkingDirectory(options.cwd);\\n   219\\t  const provider = resolveProvider(options.provider);\\n   220\\t  const selectedWorker = provider === 'claude' ? claudeWorker : worker;\\n   221\\t  const result = await selectedWorker({\\n   222\\t    cwd,\\n   223\\t    task: options.prompt,\\n   224\\t    level: options.level ?? null,\\n   225\\t    onOutput(delta) {\\n   226\\t      process.stdout.write(delta);\\n   227\\t    },\\n   228\\t    onServerRequest: (message) => answerWorkerRequest(message),\\n   229\\t  });\\n   230\\t  if (result.output && !result.output.endsWith('\\\\n')) process.stdout.write('\\\\n');\\ntests/cli-simple.test.mjs:57:  assert.throws(() => parseArgs(['doctor', '--install-worker-rule']), /not supported/u);\\ntests/cli-simple.test.mjs:135:test('a supervised Goal stall maps to exit code 3', async (t) => {\\ntests/cli-simple.test.mjs:136:  const root = await mkdtemp(join(tmpdir(), 'cruise-start-stalled-'));\\ntests/cli-simple.test.mjs:144:        async run() { return { status: 'stalled' }; },\\ntests/supervisor.test.mjs:11:} from '../scripts/lib/supervisor.mjs';\\ntests/supervisor.test.mjs:13:test('new workspace evidence is progress and resets an active ladder', () => {\\ntests/supervisor.test.mjs:14:  const supervisor = new GoalSupervisor({ stall: { quietTurns: 2, sameFailure: 2 } });\\ntests/supervisor.test.mjs:15:  assert.equal(supervisor.recordTurn({ fingerprint: 'alpha' }).level, 'ok');\\ntests/supervisor.test.mjs:16:  assert.equal(supervisor.recordTurn({ fingerprint: 'alpha' }).level, 'ok');\\ntests/supervisor.test.mjs:17:  assert.equal(supervisor.recordTurn({ fingerprint: 'alpha' }).level, 'realign');\\ntests/supervisor.test.mjs:18:  assert.equal(supervisor.recordTurn({ fingerprint: 'bravo' }).level, 'ok');\\ntests/supervisor.test.mjs:19:  assert.equal(supervisor.recordTurn({ fingerprint: 'bravo' }).level, 'ok');\\ntests/supervisor.test.mjs:20:  assert.equal(supervisor.summary().interventions.length, 0);\\ntests/supervisor.test.mjs:23:test('quiet turns climb once through realign, final experiment, and stall', () => {\\ntests/supervisor.test.mjs:24:  const supervisor = new GoalSupervisor({ stall: { quietTurns: 2, sameFailure: 9 } });\\ntests/supervisor.test.mjs:26:    supervisor.recordTurn({ fingerprint: 'same' }).level,\\ntests/supervisor.test.mjs:27:    supervisor.recordTurn({ fingerprint: 'same' }).level,\\ntests/supervisor.test.mjs:28:    supervisor.recordTurn({ fingerprint: 'same' }).level,\\ntests/supervisor.test.mjs:29:    supervisor.recordTurn({ fingerprint: 'same' }).level,\\ntests/supervisor.test.mjs:30:    supervisor.recordTurn({ fingerprint: 'same' }).level,\\ntests/supervisor.test.mjs:32:  assert.deepEqual(levels, ['ok', 'ok', 'realign', 'final-experiment', 'stall']);\\ntests/supervisor.test.mjs:33:  assert.match(supervisor.summary().interventions[0].reason, /unchanged for 2 consecutive turns/u);\\ntests/supervisor.test.mjs:34:  assert.deepEqual(supervisor.summary().interventions.map(({ level }) => level), [\\ntests/supervisor.test.mjs:41:  const supervisor = new GoalSupervisor({ stall: { quietTurns: 1, sameFailure: 9 } });\\ntests/supervisor.test.mjs:42:  assert.equal(supervisor.recordTurn({ fingerprint: 'before' }).level, 'ok');\\ntests/supervisor.test.mjs:43:  assert.equal(supervisor.recordTurn({ fingerprint: 'after' }).level, 'ok');\\ntests/supervisor.test.mjs:44:  const verdict = supervisor.recordTurn({ fingerprint: 'before' });\\ntests/supervisor.test.mjs:49:test('repeated failures supervise a non-git workspace independently', () => {\\ntests/supervisor.test.mjs:50:  const supervisor = new GoalSupervisor({ stall: { quietTurns: 9, sameFailure: 2 } });\\ntests/supervisor.test.mjs:52:  assert.equal(supervisor.recordTurn({ fingerprint: null, failureSignature: signature }).level, 'ok');\\ntests/supervisor.test.mjs:53:  const realign = supervisor.recordTurn({ fingerprint: null, failureSignature: signature });\\ntests/supervisor.test.mjs:56:  assert.equal(supervisor.recordTurn({ fingerprint: null, failureSignature: signature }).level, 'final-experiment');\\ntests/supervisor.test.mjs:57:  assert.equal(supervisor.recordTurn({ fingerprint: null, failureSignature: signature }).level, 'stall');\\ntests/supervisor.test.mjs:61:  const cwd = await mkdtemp(join(tmpdir(), 'cruise-supervisor-no-git-'));\\ntests/simple-session.test.mjs:126:      throw new Error('routine Goal progression must not open the picker');\\ntests/simple-session.test.mjs:162:test('Goal supervision realigns, runs one final experiment, then pauses with a report', async (t) => {\\ntests/simple-session.test.mjs:163:  const root = await mkdtemp(join(tmpdir(), 'cruise-stalled-goal-'));\\ntests/simple-session.test.mjs:178:      if (method === 'thread/start') return { thread: { id: 'thread-stalled' } };\\ntests/simple-session.test.mjs:187:              params: { threadId: 'thread-stalled', turn: { id: 'native-plan', status: 'inProgress' } },\\ntests/simple-session.test.mjs:191:              params: { threadId: 'thread-stalled', turn: { id: 'native-plan', status: 'completed' } },\\ntests/simple-session.test.mjs:199:        const id = `stalled-turn-${this.turns}`;\\ntests/simple-session.test.mjs:203:            params: { threadId: 'thread-stalled', delta: 'Still investigating without new evidence.\\\\n' },\\ntests/simple-session.test.mjs:207:            params: { threadId: 'thread-stalled', turn: { id, status: 'completed' } },\\ntests/simple-session.test.mjs:228:    captureFingerprint: async () => 'fixed-fingerprint',\\ntests/simple-session.test.mjs:229:    readPlan: async () => ({ stall: { quietTurns: 1, sameFailure: 9 } }),\\ntests/simple-session.test.mjs:233:  assert.equal(result.status, 'stalled');\\ntests/simple-session.test.mjs:239:  assert.match(instructions[2], /Repeating the same approach is not authorized progress/u);\\ntests/simple-session.test.mjs:241:  assert.match(instructions[3], /last supervised continuation/u);\\ntests/simple-session.test.mjs:245:  assert.match(report, /stalled after 4 supervised continuation turns/u);\\n\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"019f837a-56d2-77f1-bda9-d41d805796c6\"}}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:230:{\"timestamp\":\"2026-07-21T07:11:22.060Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"call_id\":\"call_2AxxEXkqXH22XwfiqlUiDDXF\",\"output\":[{\"type\":\"input_text\",\"text\":\"Script completed\\nWall time 0.1 seconds\\nOutput:\\n\"},{\"type\":\"input_text\",\"text\":\"# Task D — Claude supervisor: plugin hooks for continuation and stall detection\\n\\n## Context\\n\\nYou are working in the `cruise` repository, a dual-host coding-workflow\\nplugin. On the Claude Code path, the launcher (`scripts/lib/claude-cli.mjs`)\\nspawns a native interactive `claude` session with `--plugin-dir` and the\\n`/cruise:goal` slash command, then walks away — all goal-continuation and\\nanti-stall policy is prompt obedience. On the Codex path a parallel task is\\nadding mechanical supervision inside the launcher's turn loop; Claude needs\\nan equivalent, and the native channel for it is **plugin hooks**.\\n\\nA prior task (B) added `scripts/lib/flight-plan.mjs` writing\\n`.cruise/FLIGHT.md`. Relevant contract (the parser preserves unknown keys;\\n`status` is yours to rely on):\\n\\n```markdown\\n---\\nversion: 1\\nstatus: active            # active | complete | blocked\\noutcome: <one line>\\nverify: [npm test]\\nscope: { touchpoints: [...], non_goals: [...] }\\ninvariants: [...]\\nstall: { quiet_turns: 3, same_failure: 3 }\\n---\\n```\\n\\nThe goal skill already instructs the agent to write this file at execution\\nstart and to set `status: complete` / `blocked` truthfully at the end.\\n\\n**Design philosophy (non-negotiable).** Cruise keeps no authority state.\\nThe hook layer is liveness-and-recovery only: it may nudge continuation and\\nit must fail safe — the escalation ladder ends in *allowing the stop with a\\nstall report*, never an unbounded block-stop loop. It must never block a\\ntool call, never gate host approvals, and must be inert in any session that\\nis not an active cruise goal.\\n\\n## Before designing anything\\n\\nRead the current official Claude Code documentation for plugin hooks\\n(`hooks/hooks.json` inside a plugin, the `Stop` and `PreToolUse` events,\\ntheir stdin JSON and stdout decision contracts, `${CLAUDE_PLUGIN_ROOT}`).\\nVerify the exact field names against the docs — do not code from memory.\\n\\n## What you are building\\n\\n### 1. `hooks/hooks.json` + `hooks/stop-supervisor.mjs` (new)\\n\\nRegister a `Stop` hook running the Node script. Behavior on each stop:\\n\\n- **Activation gate:** read `.cruise/FLIGHT.md` from the session cwd. Inert\\n  (allow stop, no output) unless it parses, `status` is `active`, and the\\n  file's mtime is under 48 hours old (staleness guard against leftovers\\n  from an abandoned run). Re-implement a minimal frontmatter reader inside\\n  the hook script rather than importing `flight-plan.mjs` — the parallel\\n  Codex task owns shared supervisor code and you must stay decoupled;\\n  ~40 duplicated lines are acceptable and marked with a consolidation TODO.\\n- **Evidence check:** compute a workspace fingerprint (hash of\\n  `git status --porcelain=v1` + `git diff` + `git diff --cached` via\\n  `execFile`; treat a non-git cwd as \\\"fingerprint unavailable\\\").\\n- **State across invocations:** hooks are fresh processes, so keep a small\\n  scratch file `.cruise/.supervisor.json`: fingerprint history, ladder\\n  level, a hash of FLIGHT.md frontmatter (reset state when it changes),\\n  timestamps. Create `.cruise/.gitignore` containing `.supervisor.json`.\\n  This file is liveness scratch, documented as such, safe to delete at any\\n  time — it is not run-control authority.\\n- **Ladder** (thresholds from the flight plan's `stall` block, defaults\\n  quiet_turns=3, same_failure=3):\\n  1. Goal active, evidence delta since last stop → block the stop with a\\n     continuation reason (mirror the tone of the Codex\\n     `GOAL_CONTINUATION_INSTRUCTIONS`: reconcile against the flight plan,\\n     implement the next ready micro-goal, verify; routine progression is\\n     already authorized).\\n  2. Quiet stops accumulate → at threshold, block once with a\\n     **realignment** reason: name the observed non-progress, require the\\n     smallest discriminating experiment or an explicit blocker.\\n  3. Next quiet stop → block once more with a **final-experiment** reason:\\n     new evidence this turn, or set `status: blocked` in FLIGHT.md with a\\n     concrete blocker report.\\n  4. Next quiet stop → **allow the stop** and emit a stall report (turns\\n     observed, interventions attempted, suggested human next actions).\\n  - `status: complete` or `blocked` in FLIGHT.md → always allow the stop\\n    (this is how the agent legitimately ends a supervised run).\\n  - Absolute cap: never block more times per ladder cycle than\\n    quiet_turns + 2, regardless of configuration parsing bugs — hard-code\\n    this backstop.\\n\\n### 2. Optional stretch: `PreToolUse` scope-fence advisory\\n\\nIf, after reading the docs, `PreToolUse` supports returning additional\\ncontext without blocking: for `Edit`/`Write` targets outside the flight\\nplan's `scope.touchpoints`, inject a one-line advisory (\\\"outside the\\ndeclared scope fence — confirm this is in scope or realign the flight\\nplan\\\"). Advisory only; never deny the tool call. Skip this entirely if it\\ncannot be done without blocking semantics.\\n\\n### 3. Integration\\n\\n- `.claude-plugin/plugin.json`: register the hooks per the current schema\\n  if the manifest requires it (verify against docs; `claude plugin\\n  validate .` must pass).\\n- `scripts/lib/claude-cli.mjs`: extend `CLAUDE_HOST_INSTRUCTIONS` with one\\n  sentence: a Stop-hook supervisor may inject continuation or realignment\\n  instructions during goal runs; respond by changing approach or reporting\\n  the blocker honestly, never by repeating the failed attempt.\\n- `skills/goal/SKILL.md`: edit **only the Claude bullet** in \\\"Use the\\n  selected host natively\\\" — the flight plan's `status` field is the\\n  completion handshake with the supervisor; keep it truthful.\\n- `package.json`: add `hooks/` to `files`.\\n\\n## Files you own\\n\\n`hooks/` (new), `.claude-plugin/plugin.json`, `scripts/lib/claude-cli.mjs`,\\nthe Claude bullet of `skills/goal/SKILL.md`, `tests/stop-supervisor.test.mjs`\\n(new), `package.json` (`files` + `test` additions), `.cruise/.gitignore`\\ncreation logic.\\n\\n## Files you must not touch\\n\\n`scripts/lib/simple-session.mjs`, `scripts/lib/supervisor.mjs`, the Codex\\nbullet of `skills/goal/SKILL.md`, `LIMIT_POLICY.md` (a parallel task C owns\\nall of these), `skills/build/SKILL.md` (Task E). Union `package.json`\\n`files` on merge.\\n\\n## Acceptance criteria\\n\\n- `claude plugin validate .` passes; `npm test` green.\\n- Hook script is testable without a live Claude session: unit tests feed\\n  fixture stdin JSON + a temp dir with fixture FLIGHT.md/git states and\\n  assert the full ladder (continuation → realign → final-experiment →\\n  allow-with-report), inertness without an active flight plan, staleness\\n  guard, state reset on flight-plan change, and the hard-coded block cap.\\n- The hook never writes anything outside `.cruise/`, never blocks\\n  non-goal sessions, and exits 0 with an allow decision on any internal\\n  error (fail-open for the user, with the error noted in the report —\\n  a broken supervisor must never trap a session).\\n M package.json\\n M scripts/lib/claude-cli.mjs\\n M skills/goal/SKILL.md\\n M tests/claude-cli.test.mjs\\n?? hooks/\\n?? tests/stop-supervisor.test.mjs\\ndiff --git a/package.json b/package.json\\nindex 14f98da..6681359 100644\\n--- a/package.json\\n+++ b/package.json\\n@@ -18,6 +18,7 @@\\n   \\\"files\\\": [\\n     \\\".codex-plugin/\\\",\\n     \\\".claude-plugin/\\\",\\n+    \\\"hooks/\\\",\\n     \\\"index.js\\\",\\n     \\\"scripts/cruise.mjs\\\",\\n     \\\"scripts/lib/app-server-client.mjs\\\",\\n@@ -35,7 +36,7 @@\\n     \\\"skills/\\\"\\n   ],\\n   \\\"scripts\\\": {\\n-    \\\"test\\\": \\\"node --test tests/app-server-client.test.mjs tests/line-input.test.mjs tests/picker.test.mjs tests/origin-note.test.mjs tests/flight-plan.test.mjs tests/supervisor.test.mjs tests/debug-skill.test.mjs tests/simple-worker.test.mjs tests/claude-cli.test.mjs tests/cli-simple.test.mjs tests/simple-session.test.mjs\\\",\\n+    \\\"test\\\": \\\"node --test tests/app-server-client.test.mjs tests/line-input.test.mjs tests/picker.test.mjs tests/origin-note.test.mjs tests/flight-plan.test.mjs tests/supervisor.test.mjs tests/stop-supervisor.test.mjs tests/debug-skill.test.mjs tests/simple-worker.test.mjs tests/claude-cli.test.mjs tests/cli-simple.test.mjs tests/simple-session.test.mjs\\\",\\n     \\\"validate\\\": \\\"npm test\\\"\\n   },\\n   \\\"engines\\\": {\\ndiff --git a/scripts/lib/claude-cli.mjs b/scripts/lib/claude-cli.mjs\\nindex 0f9f1b3..fe3fa66 100644\\n--- a/scripts/lib/claude-cli.mjs\\n+++ b/scripts/lib/claude-cli.mjs\\n@@ -18,6 +18,7 @@ const CLAUDE_HOST_INSTRUCTIONS = [\\n   'Use Claude Code native permissions, task tracking, resumable sessions, skills, and subagents.',\\n   'Claude Code exposes no documented Codex-style Goal lifecycle API to plugins; do not invent Goal endpoints or Goal state.',\\n   'For Goal work, resolve the outcome, scope fence, invariants, acceptance commands, and stall tuning, then write the user-editable advisory .cruise/FLIGHT.md as the first exe[stdout]
cution act; reread it at each micro-goal, realign scope drift, re-verify affected invariants, and keep its status truthful through completion or a concrete blocker. It grants and gates nothing.',\\n+  'A Stop-hook supervisor may inject continuation or realignment instructions during Goal runs; respond by changing approach or reporting the blocker honestly, never by repeating the failed attempt.',\\n ].join(' ');\\n \\n export function claudeSessionArgs({ pluginRoot, skill, prompt }) {\\ndiff --git a/skills/goal/SKILL.md b/skills/goal/SKILL.md\\nindex 58c5269..33abdf2 100644\\n--- a/skills/goal/SKILL.md\\n+++ b/skills/goal/SKILL.md\\n@@ -10,7 +10,7 @@ For consequential work, inspect the repository and make a proportionate plan. Tr\\n ## Use the selected host natively\\n \\n - **Codex:** use native Goal state when it is available. A Goal starts with the host's read-only Plan-mode turn and then moves to normal Goal execution. Keep the Goal active through implementation and verification, and use the Goal status as the completion authority. Supervised realignment turns are normal: answer them with a changed, evidence-producing approach or an honest blocker, never another run of the same failing attempt.\\n-- **Claude Code:** no documented Codex-style Goal lifecycle endpoint is available to plugins. Do not invent one. Stay in the user's current Claude permission mode, maintain the work as a concise native task list, and continue the execution loop in the same resumable session. Do not enter Claude's approval-gated `/plan` mode merely as ceremony; use it only when the user requested read-only planning. Use native Claude subagents for bounded independent work when warranted. Interruption and continuation are the native session controls (`Ctrl-C`, `/resume`, `--continue`, and `--resume`), not synthetic Cruise Goal states.\\n+- **Claude Code:** no documented Codex-style Goal lifecycle endpoint is available to plugins. Do not invent one. Stay in the user's current Claude permission mode, maintain the work as a concise native task list, and continue the execution loop in the same resumable session. Do not enter Claude's approval-gated `/plan` mode merely as ceremony; use it only when the user requested read-only planning. Use native Claude subagents for bounded independent work when warranted. Interruption and continuation are the native session controls (`Ctrl-C`, `/resume`, `--continue`, and `--resume`), not synthetic Cruise Goal states. During a supervised Goal, the flight plan's `status` field is the completion handshake with the Stop hook; keep it truthful.\\n \\n Treat worker-level and communication-manner preferences as natural-language instructions for this request only. Never persist or globally enforce them. Override the ordinary worker level only when the user explicitly asks for a higher, lower, or numbered level; an explicit terminal `cruise worker --level <1-7>` selection has highest priority for that invocation.\\n \\n#!/usr/bin/env node\\n\\nimport { execFile } from 'node:child_process';\\nimport { createHash } from 'node:crypto';\\nimport { lstat, mkdir, readFile, rename, stat, writeFile } from 'node:fs/promises';\\nimport { basename, dirname, join, resolve } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nimport { promisify } from 'node:util';\\n\\nconst execFileAsync = promisify(execFile);\\nconst FLIGHT_FILE = '.cruise/FLIGHT.md';\\nconst STATE_FILE = '.cruise/.supervisor.json';\\nconst GITIGNORE_FILE = '.cruise/.gitignore';\\nconst MAX_FLIGHT_AGE_MS = 48 * 60 * 60 * 1_000;\\nconst DEFAULT_STALL = Object.freeze({ quietTurns: 3, sameFailure: 3 });\\nconst FAILURE_LINE = /\\\\b(?:error|fail(?:ed|ure)?|exception|panic|traceback)\\\\b/iu;\\n\\nfunction digest(value) {\\n  return createHash('sha256').update(value).digest('hex');\\n}\\n\\nfunction short(value) {\\n  return value ? value.slice(0, 12) : 'unavailable';\\n}\\n\\nfunction cleanMessage(value) {\\n  return String(value ?? 'unknown error').replace(/[\\\\u0000-\\\\u001f\\\\u007f]+/gu, ' ').replace(/\\\\s+/gu, ' ').trim();\\n}\\n\\nfunction stripComment(value) {\\n  let quote = null;\\n  let escaped = false;\\n  for (let index = 0; index < value.length; index += 1) {\\n    const character = value[index];\\n    if (quote === '\\\"' && character === '\\\\\\\\' && !escaped) {\\n      escaped = true;\\n      continue;\\n    }\\n    if (character === quote && !escaped) quote = null;\\n    else if (!quote && (character === '\\\"' || character === \\\"'\\\")) quote = character;\\n    else if (!quote && character === '#' && (index === 0 || /\\\\s/u.test(value[index - 1]))) {\\n      return value.slice(0, index).trimEnd();\\n    }\\n    escaped = false;\\n  }\\n  if (quote) throw new Error('unterminated flight-plan scalar');\\n  return value.trim();\\n}\\n\\nfunction scalar(value) {\\n  const text = stripComment(value);\\n  if (text.startsWith('\\\"')) return JSON.parse(text);\\n  if (text.startsWith(\\\"'\\\")) {\\n    if (!text.endsWith(\\\"'\\\")) throw new Error('invalid flight-plan scalar');\\n    return text.slice(1, -1).replace(/''/gu, \\\"'\\\");\\n  }\\n  return text;\\n}\\n\\nfunction positiveInteger(value, fallback) {\\n  if (value === undefined) return fallback;\\n  return /^\\\\d+$/u.test(value) && Number(value) > 0 ? Number(value) : fallback;\\n}\\n\\n// TODO(v0.3): consolidate this reader and fingerprint helper only when the\\n// packaged hook can remain a standalone process with no runtime coupling.\\nexport function parseHookFlightPlan(text) {\\n  try {\\n    if (typeof text !== 'string' || text.length > 1_000_000) return null;\\n    const match = text.replace(/^\\\\uFEFF/u, '').match(/^---\\\\r?\\\\n([\\\\s\\\\S]*?)\\\\r?\\\\n---(?:\\\\r?\\\\n|$)/u);\\n    if (!match) return null;\\n    const frontmatter = match[1];\\n    let status;\\n    let inStall = false;\\n    let quietTurns;\\n    let sameFailure;\\n    for (const raw of frontmatter.split(/\\\\r?\\\\n/u)) {\\n      if (!raw.trim() || raw.trimStart().startsWith('#')) continue;\\n      if (raw.includes('\\\\t')) return null;\\n      const indent = raw.match(/^ */u)[0].length;\\n      const content = stripComment(raw.slice(indent));\\n      if (indent === 0) {\\n        inStall = /^stall\\\\s*:/u.test(content);\\n        const statusMatch = content.match(/^status\\\\s*:\\\\s*(.+)$/u);\\n        if (statusMatch) status = scalar(statusMatch[1]);\\n      } else if (inStall && indent === 2) {\\n        const stallMatch = content.match(/^(quiet_turns|same_failure)\\\\s*:\\\\s*(.+)$/u);\\n        if (stallMatch?.[1] === 'quiet_turns') quietTurns = scalar(stallMatch[2]);\\n        if (stallMatch?.[1] === 'same_failure') sameFailure = scalar(stallMatch[2]);\\n      }\\n    }\\n    if (!['active', 'complete', 'blocked'].includes(status)) return null;\\n    return {\\n      status,\\n      stall: {\\n        quietTurns: positiveInteger(quietTurns, DEFAULT_STALL.quietTurns),\\n        sameFailure: positiveInteger(sameFailure, DEFAULT_STALL.sameFailure),\\n      },\\n      frontmatterHash: digest(frontmatter),\\n    };\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nasync function readFlightPlan(cwd, now) {\\n  const path = join(cwd, FLIGHT_FILE);\\n  try {\\n    const [text, metadata] = await Promise.all([readFile(path, 'utf8'), stat(path)]);\\n    const age = now - metadata.mtimeMs;\\n    if (age < 0 || age >= MAX_FLIGHT_AGE_MS) return null;\\n    return parseHookFlightPlan(text);\\n  } catch (error) {\\n    if (error?.code === 'ENOENT') return null;\\n    throw error;\\n  }\\n}\\n\\nasync function ensureScratchDirectory(cwd) {\\n  const directory = join(cwd, '.cruise');\\n  await mkdir(directory, { recursive: true, mode: 0o700 });\\n  const metadata = await lstat(directory);\\n  if (metadata.isSymbolicLink() || !metadata.isDirectory()) throw new Error('.cruise must be a real directory');\\n  return directory;\\n}\\n\\nasync function atomicWrite(path, text) {\\n  const temporary = join(dirname(path), `.${basename(path)}.${process.pid}.${Date.now()}.tmp`);\\n  await writeFile(temporary, text, { encoding: 'utf8', mode: 0o600, flag: 'wx' });\\n  await rename(temporary, path);\\n}\\n\\nasync function ensureGitignore(directory) {\\n  const path = join(directory, basename(GITIGNORE_FILE));\\n  let text = '';\\n  try {\\n    text = await readFile(path, 'utf8');\\n  } catch (error) {\\n    if (error?.code !== 'ENOENT') throw error;\\n  }\\n  if (text.split(/\\\\r?\\\\n/u).includes('.supervisor.json')) return;\\n  const next = `${text}${text && !text.endsWith('\\\\n') ? '\\\\n' : ''}.supervisor.json\\\\n`;\\n  await atomicWrite(path, next);\\n}\\n\\nfunction newState(flightHash, now) {\\n  return {\\n    version: 1,\\n    flight_hash: flightHash,\\n    has_observation: false,\\n    last_fingerprint: null,\\n    seen_fingerprints: [],\\n    last_failure: null,\\n    same_failure: 0,\\n    quiet_stops: 0,\\n    ladder: 'normal',\\n    blocks_in_cycle: 0,\\n    turns_observed: 0,\\n    interventions: [],\\n    observations: [],\\n    created_at: now,\\n    updated_at: now,\\n  };\\n}\\n\\nfunction validState(value) {\\n  return value &&\\n    value.version === 1 &&\\n    typeof value.flight_hash === 'string' &&\\n    typeof value.has_observation === 'boolean' &&\\n    (value.last_fingerprint === null || typeof value.last_fingerprint === 'string') &&\\n    Array.isArray(value.seen_fingerprints) &&\\n    (value.last_failure === null || typeof value.last_failure === 'string') &&\\n    Number.isInteger(value.same_failure) && value.same_failure >= 0 &&\\n    Number.isInteger(value.quiet_stops) && value.quiet_stops >= 0 &&\\n    ['normal', 'realign', 'final', 'stalled'].includes(value.ladder) &&\\n    Number.isInteger(value.blocks_in_cycle) && value.blocks_in_cycle >= 0 &&\\n    Number.isInteger(value.turns_observed) && value.turns_observed >= 0 &&\\n    Array.isArray(value.interventions) && Array.isArray(value.observations);\\n}\\n\\nasync function readState(directory, flightHash, now) {\\n  const path = join(directory, basename(STATE_FILE));\\n  try {\\n    const parsed = JSON.parse(await readFile(path, 'utf8'));\\n    if (!validState(parsed)) throw new Error('supervisor scratch state is malformed');\\n    return parsed.flight_hash === flightHash ? parsed : newState(flightHash, now);\\n  } catch (error) {\\n    if (error?.code === 'ENOENT') return newState(flightHash, now);\\n    throw error;\\n  }\\n}\\n\\nasync function writeState(directory, state) {\\n  await atomicWrite(join(directory, basename(STATE_FILE)), `${JSON.stringify(state, null, 2)}\\\\n`);\\n}\\n\\nasync function captureWorkspaceFingerprint(cwd) {\\n  try {\\n    const options = { cwd, encoding: 'utf8', maxBuffer: Infinity };\\n    const [statusResult, diffResult, cachedResult] = await Promise.all([\\n      execFileAsync('git', ['status', '--porcelain=v1'], options),\\n      execFileAsync('git', ['diff'], options),\\n      execFileAsync('git', ['diff', '--cached'], options),\\n    ]);\\n    return digest(`${statusResult.stdout}\\\\u0000${diffResult.stdout}\\\\u0000${cachedResult.stdout}`);\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nfunction failureSignature(text) {\\n  if (typeof text !== 'string') return null;\\n  const lines = text.split(/\\\\r?\\\\n/u).filter((line) => FAILURE_LINE.test(line));\\n  if (!lines.length) return null;\\n  const normalized = lines.map((line) => line\\n    .replace(/\\\\b[A-Za-z]:\\\\\\\\(?:[^\\\\\\\\\\\\r\\\\n:]+\\\\\\\\)*[^:\\\\r\\\\n]+?(?=:\\\\d+(?::\\\\d+)?\\\\b|$)/gu, '<path>')\\n    .replace(/\\\\/(?:[^/\\\\r\\\\n:]+\\\\/)*[^:\\\\r\\\\n]+?(?=:\\\\d+(?::\\\\d+)?\\\\b|$)/gu, '<path>')\\n    .replace(/\\\\b(?:0x[a-f\\\\d]+|[a-f\\\\d]{7,})\\\\b/giu, '<hex>')\\n    .replace(/\\\\d+/gu, '<n>')\\n    .replace(/\\\\s+/gu, ' ')\\n    .trim()\\n    .toLowerCase());\\n  return digest(normalized.join('\\\\n'));\\n}\\n\\nfunction resetCycle(state) {\\n  state.quiet_stops = 0;\\n  state.same_failure = 0;\\n  state.ladder = 'normal';\\n  state.blocks_in_cycle = 0;\\n  state.interventions = [];\\n}\\n\\nfunction observe(state, fingerprint, signature, now) {\\n  const priorFingerprint = state.last_fingerprint;\\n  const priorFailure = state.last_failure;\\n  let progress = false;\\n  let reason;\\n  if (!state.has_observation) {\\n    reason = fingerprint === null\\n      ? 'workspace fingerprint unavailable; initial signature-only baseline recorded'\\n      : `workspace baseline fingerprint ${short(fingerprint)} recorded`;\\n  } else if (fingerprint !== null && fingerprint !== priorFingerprint && !state.seen_fingerprints.includes(fingerprint)) {\\n    progress = true;\\n    reason = `workspace evidence changed to new fingerprint ${short(fingerprint)}`;\\n  } else if (fingerprint !== null && fingerprint !== priorFingerprint) {\\n    state.quiet_stops += 1;\\n    reason = `workspace oscillated to earlier fingerprint ${short(fingerprint)} after ${state.quiet_stops} quiet stops`;\\n  } else {\\n    state.quiet_stops += 1;\\n    reason = fingerprint === null\\n      ? `workspace fingerprint unavailable for ${state.quiet_stops} consecutive quiet stops`\\n      : `workspace fingerprint ${short(fingerprint)} unchanged for ${state.quiet_stops} consecutive quiet stops`;\\n  }\\n\\n  state.same_failure = signature === null ? 0 : signature === priorFailure ? state.same_failure + 1 : 1;\\n  if (fingerprint === null && priorFailure !== null && signature !== priorFailure) {\\n    progress = true;\\n    reason = signature === null\\n      ? `failure signature ${short(priorFailure)} cleared in signature-only supervision`\\n      : `failure evidence changed from ${short(priorFailure)} to ${short(signature)} in signature-only supervision`;\\n  }\\n  if (progress) resetCycle(state);\\n  state.has_observation = true;\\n  state.last_fingerprint = fingerprint;\\n  state.last_failure = signature;\\n  if (fingerprint !== null && !state.seen_fingerprints.includes(fingerprint)) {\\n    state.seen_fingerprints.push(fingerprint);\\n    state.seen_fingerprints = state.seen_fingerprints.slice(-32);\\n  }\\n  state.turns_observed += 1;\\n  state.observations.push({ at: now, fingerprint, failure_signature: signature, reason });\\n  state.observations = state.observations.slice(-32);\\n  state.updated_at = now;\\n  return { progress, reason };\\n}\\n\\nfunction standardReason(observation) {\\n  return [\\n    `Cruise Goal supervision observed: ${observation}.`,\\n    'Continue the active Goal: reread .cruise/FLIGHT.md, reconcile scope and invariants, implement the next ready micro-goal, and run its verification.',\\n    'Routine progression is already authorized; keep the flight-plan status truthful.',\\n  ].join(' ');\\n}\\n\\nfunction realignReason(observation) {\\n  return [\\n    `Cruise Goal supervision observed non-progress: ${observation}.`,\\n    'Repeating the same approach is not progress.',\\n    'Run the smallest discriminating experiment that produces new evidence, or set status: blocked in .cruise/FLIGHT.md and state the concrete blocker in its body.',\\n  ].join(' ');\\n}\\n\\nfunction finalReason(observation) {\\n  return [\\n    `Cruise Goal supervision still observes no progress after realignment: ${observation}.`,\\n    'Produce new evidence this turn or set status: blocked in .cruise/FLIGHT.md with a concrete blocker report.',\\n    'This is the final supervised continuation before the hook allows the stop with a stall report.',\\n  ].join(' ');\\n}\\n\\nfunction stallMessage(state, observation, capReached = false) {\\n  const interventions = state.interventions.length\\n    ? state.interventions.map((item) => item.level).join(', ')\\n    : 'continuation cap reached before a complete intervention record';\\n  return [\\n    `Cruise Goal stall supervisor allowed this stop after ${state.turns_observed} observed stops.`,\\n    `Observed: ${observation}.`,\\n    `Interventions attempted: ${interventions}.`,\\n    capReached ? `The hard backstop of ${state.blocks_in_cycle} blocked stops was reached.` : 'The realignment and final-experiment ladder produced no new evidence.',\\n    'Suggested next actions: inspect the last diff and failure, edit .cruise/FLIGHT.md if its scope or tuning is stale, provide missing evidence or a material decision, then resume explicitly.',\\n    'The stop was allowed; this scratch state grants no authority and is safe to delete.',\\n  ].join('\\\\n');\\n}\\n\\nexport async function runStopSupervisor(input, { now = Date.now() } = {}) {\\n  if (!input || input.hook_event_name !== 'Stop' || typeof input.cwd !== 'string' || !input.cwd) return null;\\n  const cwd = resolve(input.cwd);\\n  const flight = await readFlightPlan(cwd, now);\\n  if (!flight || flight.status !== 'active') return null;\\n\\n  const directory = await ensureScratchDirectory(cwd);\\n  await ensureGitignore(directory);\\n  const state = await readState(directory, flight.frontmatterHash, now);\\n  if (state.ladder === 'stalled') {\\n    return { systemMessage: stallMessage(state, state.observations.at(-1)?.reason ?? 'prior stall') };\\n  }\\n  const [fingerprint, signature] = await Promise.all([\\n    captureWorkspaceFingerprint(cwd),\\n    Promise.resolve(failureSignature(input.last_assistant_message)),\\n  ]);\\n  const observation = observe(state, fingerprint, signature, now);\\n  const blockCap = flight.stall.quietTurns + 2;\\n  let output;\\n  if (state.blocks_in_cycle >= blockCap) {\\n    state.ladder = 'stalled';\\n    output = { systemMessage: stallMessage(state, observation.reason, true) };\\n  } else if (state.ladder === 'realign') {\\n    state.ladder = 'final';\\n    state.blocks_in_cycle += 1;\\n    state.interventions.push({ level: 'final-experiment', at: now, reason: observation.reason });\\n    output = { decision: 'block', reason: finalReason(observation.reason) };\\n  } else if (state.ladder === 'final') {\\n    state.ladder = 'stalled';\\n    output = { systemMessage: stallMessage(state, observation.reason) };\\n  } else if (\\n    state.quiet_stops >= flight.stall.quietTurns ||\\n    state.same_failure >= flight.stall.sameFailure\\n  ) {\\n    state.ladder = 'realign';\\n    state.blocks_in_cycle += 1;\\n    state.interventions.push({ level: 'realign', at: now, reason: observation.reason });\\n    output = { decision: 'block', reason: realignReason(observation.reason) };\\n  } else {\\n    state.blocks_in_cycle += 1;\\n    output = { decision: 'block', reason: standardReason(observation.reason) };\\n  }\\n  await writeState(directory, state);\\n  return output;\\n}\\n\\nasync function readInput(stream) {\\n  let text = '';\\n  for await (const chunk of stream) {\\n    text += chunk;\\n    if (text.length > 1_000_000) throw new Error('hook input exceeds 1 MB');\\n  }\\n  return JSON.parse(text);\\n}\\n\\nexport async function main({ input = process.stdin, output = process.stdout } = {}) {\\n  try {\\n    const result = await runStopSupervisor(await readInput(input));\\n    if (result) output.write(JSON.stringify(result));\\n  } catch (error) {\\n    output.write(JSON.stringify({\\n      systemMessage: `Cruise Goal stop supervisor failed open: ${cleanMessage(error?.message)}. The stop was allowed; delete .cruise/.supervisor.json if its scratch state is damaged.`,\\n    }));\\n  }\\n  return 0;\\n}\\n\\nconst invoked = process.argv[1] ? resolve(process.argv[1]) : null;\\nif (invoked === fileURLToPath(import.meta.url)) process.exitCode = await main();\\nimport assert from 'node:assert/strict';\\nimport { mkdtemp, mkdir, readFile, rm, utimes, writeFile } from 'node:fs/promises';\\nimport { tmpdir } from 'node:os';\\nimport { join, resolve } from 'node:path';\\nimport { spawnSync } from 'node:child_process';\\nimport test from 'node:test';\\n\\nconst HOOK = resolve('hooks/stop-supervisor.mjs');\\n\\nfunction flight({ status = 'active', quietTurns = 1, sameFailure = 9, outcome = 'Finish safely' } = {}) {\\n  return `---\\nversion: 1\\nstatus: ${status}\\noutcome: ${outcome}\\nstall:\\n  quiet_turns: ${quietTurns}\\n  same_failure: ${sameFailure}\\n---\\n# Flight plan\\n`;\\n}\\n\\nasync function fixture(options = {}) {\\n  const cwd = await mkdtemp(join(tmpdir(), 'cruise-stop-hook-'));\\n  await mkdir(join(cwd, '.cruise'));\\n  if (options.withFlight !== false) {\\n    await writeFile(join(cwd, '.cruise', 'FLIGHT.md'), flight(options), 'utf8');\\n  }\\n  if (options.git !== false) {\\n    const initialized = spawnSync('git', ['init', '--quiet'], { cwd, encoding: 'utf8' });\\n    assert.equal(initialized.status, 0, initialized.stderr);\\n  }\\n  return cwd;\\n}\\n\\nfunction invoke(cwd, overrides = {}) {\\n  const input = {\\n    session_id: 'fixture-session',\\n    transcript_path: join(cwd, 'transcript.jsonl'),\\n    cwd,\\n    permission_mode: 'default',\\n    hook_event_name: 'Stop',\\n    stop_hook_active: false,\\n    last_assistant_message: 'Implemented the next step.',\\n    ...overrides,\\n  };\\n  const result = spawnSync(process.execPath, [HOOK], {\\n    input: JSON.stringify(input),\\n    encoding: 'utf8',\\n    timeout: 10_000,\\n  });\\n  assert.equal(result.status, 0, result.stderr);\\n  return result.stdout ? JSON.parse(result.stdout) : null;\\n}\\n\\ntest('quiet evidence climbs through continuation, realignment, final experiment, then bounded allow', async () => {\\n  const cwd = await fixture({ quietTurns: 1 });\\n  try {\\n    const outputs = [invoke(cwd), invoke(cwd), invoke(cwd), invoke(cwd)];\\n    assert.equal(outputs[0].decision, 'block');\\n    assert.match(outputs[0].reason, /Continue the active Goal/u);\\n    assert.equal(outputs[1].decision, 'block');\\n    assert.match(outputs[1].reason, /realignment|non-progress/iu);\\n    assert.equal(outputs[2].decision, 'block');\\n    assert.match(outputs[2].reason, /final supervised continuation/iu);\\n    assert.equal(outputs[3].decision, undefined);\\n    assert.match(outputs[3].systemMessage, /allowed this stop/iu);\\n    assert.match(outputs[3].systemMessage, /Interventions attempted: realign, final-experiment/u);\\n\\n    const state = JSON.parse(await readFile(join(cwd, '.cruise', '.supervisor.json'), 'utf8'));\\n    assert.equal(state.blocks_in_cycle, 3, 'quiet_turns + 2 is the hard block cap');\\n    assert.equal(state.ladder, 'stalled');\\n    assert.match(await readFile(join(cwd, '.cruise', '.gitignore'), 'utf8'), /^\\\\.supervisor\\\\.json$/mu);\\n  } finally {\\n    await rm(cwd, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('missing, complete, and blocked flight plans leave non-active sessions inert', async () => {\\n  for (const options of [{ withFlight: false }, { status: 'complete' }, { status: 'blocked' }]) {\\n    const cwd = await fixture(options);\\n    try {\\n      assert.equal(invoke(cwd), null);\\n      await assert.rejects(readFile(join(cwd, '.cruise', '.supervisor.json'), 'utf8'), { code: 'ENOENT' });\\n    } finally {\\n      await rm(cwd, { recursive: true, force: true });\\n    }\\n  }\\n});\\n\\ntest('an active flight plan older than 48 hours is inert', async () => {\\n  const cwd = await fixture();\\n  try {\\n    const stale = new Date(Date.now() - (49 * 60 * 60 * 1_000));\\n    await utimes(join(cwd, '.cruise', 'FLIGHT.md'), stale, stale);\\n    assert.equal(invoke(cwd), null);\\n    await assert.rejects(readFile(join(cwd, '.cruise', '.supervisor.json'), 'utf8'), { code: 'ENOENT' });\\n  } finally {\\n    await rm(cwd, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('changing flight-plan frontmatter resets the supervision cycle', async () => {\\n  const cwd = await fixture({ quietTurns: 1, outcome: 'First outcome' });\\n  try {\\n    const first = invoke(cwd);\\n    assert.match(first.reason, /baseline fingerprint/u);\\n    await writeFile(\\n      join(cwd, '.cruise', 'FLIGHT.md'),\\n      flight({ quietTurns: 1, outcome: 'Realigned outcome' }),\\n      'utf8',\\n    );\\n    const afterChange = invoke(cwd);\\n    assert.equal(afterChange.decision, 'block');\\n    assert.match(afterChange.reason, /baseline fingerprint/u);\\n    assert.doesNotMatch(afterChange.reason, /non-progress/u);\\n    const state = JSON.parse(await readFile(join(cwd, '.cruise', '.supervisor.json'), 'utf8'));\\n    assert.equal(state.blocks_in_cycle, 1);\\n    assert.equal(state.turns_observed, 1);\\n  } finally {\\n    await rm(cwd, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('same normalized failure can trigger realignment without git evidence', async () => {\\n  const cwd = await fixture({ git: false, quietTurns: 9, sameFailure: 2 });\\n  try {\\n    assert.match(invoke(cwd, { last_assistant_message: 'Error: failed at /tmp/a.js:12' }).reason, /Continue/u);\\n    const repeated = invoke(cwd, { last_assistant_message: 'ERROR: failed at /work/b.js:98' });\\n    assert.equal(repeated.decision, 'block');\\n    assert.match(repeated.reason, /non-progress/u);\\n  } finally {\\n    await rm(cwd, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('corrupt scratch state fails open with an allow report and exit zero', async () => {\\n  const cwd = await fixture();\\n  try {\\n    assert.equal(invoke(cwd).decision, 'block');\\n    await writeFile(join(cwd, '.cruise', '.supervisor.json'), '{not-json', 'utf8');\\n    const output = invoke(cwd);\\n    assert.equal(output.decision, undefined);\\n    assert.match(output.systemMessage, /failed open/iu);\\n    assert.match(output.systemMessage, /stop was allowed/iu);\\n  } finally {\\n    await rm(cwd, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('hook registration uses the standalone plugin-root command form', async () => {\\n  const registration = JSON.parse(await readFile(resolve('hooks/hooks.json'), 'utf8'));\\n  const command = registration.hooks.Stop[0].hooks[0];\\n  assert.deepEqual(command, {\\n    type: 'command',\\n    command: 'node',\\n    args: ['${CLAUDE_PLUGIN_ROOT}/hooks/stop-supervisor.mjs'],\\n    timeout: 30,\\n  });\\n});\\n{\\n  \\\"description\\\": \\\"Cruise Goal liveness supervision\\\",\\n  \\\"hooks\\\": {\\n    \\\"Stop\\\": [\\n      {\\n        \\\"hooks\\\": [\\n          {\\n            \\\"type\\\": \\\"command\\\",\\n            \\\"command\\\": \\\"node\\\",\\n            \\\"args\\\": [\\n              \\\"${CLAUDE_PLUGIN_ROOT}/hooks/stop-supervisor.mjs\\\"\\n            ],\\n            \\\"timeout\\\": 30\\n          }\\n        ]\\n      }\\n    ]\\n  }\\n}\\n\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"019f8383-ba1a-7203-8508-59020e902fe9\"}}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:282:{\"timestamp\":\"2026-07-21T07:12:41.221Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call\",\"id\":\"ctc_05cd102a9eb280a0016a5f1be7c38c8191be5578066117f769\",\"status\":\"completed\",\"call_id\":\"call_4ydypLsWpKggnFItVIkrLvpL\",\"name\":\"exec\",\"input\":\"const r = await tools.exec_command({cmd:\\\"node --input-type=module -e 'import { parseHookFlightPlan } from \\\\\\\"./hooks/stop-supervisor.mjs\\\\\\\"; const huge=\\\\\\\"9\\\\\\\".repeat(400); console.log(JSON.stringify({huge:parseHookFlightPlan(`---\\\\\\\\nstatus: active\\\\\\\\nstall:\\\\\\\\n  quiet_turns: ${huge}\\\\\\\\n---\\\\\\\\n`)?.stall, duplicate:parseHookFlightPlan(`---\\\\\\\\nstatus: active\\\\\\\\nstatus: active\\\\\\\\n---\\\\\\\\n`)}));' && node --test tests/stop-supervisor.test.mjs\\\",\\\"workdir\\\":\\\"<PLUGIN_ROOT>\\\",\\\"yield_time_ms\\\":30000,\\\"max_output_tokens\\\":20000});\\ntext(r.output);\",\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"019f8383-ba1a-7203-8508-59020e902fe9\"}}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:289:{\"timestamp\":\"2026-07-21T07:12:48.968Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"call_id\":\"call_QfJVZE3O1jJzDt9BFH14s8f7\",\"output\":[{\"type\":\"input_text\",\"text\":\"Script completed\\nWall time 0.1 seconds\\nOutput:\\n\"},{\"type\":\"input_text\",\"text\":\"tests/stop-supervisor.test.mjs:8:import { parseHookFlightPlan } from '../hooks/stop-supervisor.mjs';\\ntests/stop-supervisor.test.mjs:40:    session_id: 'fixture-session',\\ntests/stop-supervisor.test.mjs:45:    stop_hook_active: false,\\ntests/stop-supervisor.test.mjs:74:    assert.equal(state.ladder, 'stalled');\\ntests/stop-supervisor.test.mjs:166:  const plan = parseHookFlightPlan(`---\\nhooks/stop-supervisor.mjs:60:function positiveInteger(value, fallback) {\\nhooks/stop-supervisor.mjs:68:export function parseHookFlightPlan(text) {\\nhooks/stop-supervisor.mjs:113:    return parseHookFlightPlan(text);\\nhooks/stop-supervisor.mjs:231:  state.ladder = 'normal';\\nhooks/stop-supervisor.mjs:332:  if (state.ladder === 'stalled') {\\nhooks/stop-supervisor.mjs:343:    state.ladder = 'stalled';\\nhooks/stop-supervisor.mjs:345:  } else if (state.ladder === 'realign') {\\nhooks/stop-supervisor.mjs:346:    state.ladder = 'final';\\nhooks/stop-supervisor.mjs:350:  } else if (state.ladder === 'final') {\\nhooks/stop-supervisor.mjs:351:    state.ladder = 'stalled';\\nhooks/stop-supervisor.mjs:357:    state.ladder = 'realign';\\n  }\\n  if (quote) throw new Error('unterminated flight-plan scalar');\\n  return value.trim();\\n}\\n\\nfunction scalar(value) {\\n  const text = stripComment(value);\\n  if (text.startsWith('\\\"')) return JSON.parse(text);\\n  if (text.startsWith(\\\"'\\\")) {\\n    if (!text.endsWith(\\\"'\\\")) throw new Error('invalid flight-plan scalar');\\n    return text.slice(1, -1).replace(/''/gu, \\\"'\\\");\\n  }\\n  return text;\\n}\\n\\nfunction positiveInteger(value, fallback) {\\n  if (value === undefined) return fallback;\\n  const parsed = Number(value);\\n  return /^\\\\d+$/u.test(value) && Number.isSafeInteger(parsed) && parsed > 0 ? parsed : fallback;\\n}\\n\\n// TODO(v0.3): consolidate this reader and fingerprint helper only when the\\n// packaged hook can remain a standalone process with no runtime coupling.\\nexport function parseHookFlightPlan(text) {\\n  try {\\n    if (typeof text !== 'string' || text.length > 1_000_000) return null;\\n    const match = text.replace(/^\\\\uFEFF/u, '').match(/^---\\\\r?\\\\n([\\\\s\\\\S]*?)\\\\r?\\\\n---(?:\\\\r?\\\\n|$)/u);\\n    if (!match) return null;\\n    const frontmatter = match[1];\\n    let status;\\n    let inStall = false;\\n    let quietTurns;\\n    let sameFailure;\\n    for (const raw of frontmatter.split(/\\\\r?\\\\n/u)) {\\n      if (!raw.trim() || raw.trimStart().startsWith('#')) continue;\\n      if (raw.includes('\\\\t')) return null;\\n      const indent = raw.match(/^ */u)[0].length;\\n      const content = stripComment(raw.slice(indent));\\n      if (indent === 0) {\\n        inStall = /^stall\\\\s*:/u.test(content);\\n        const statusMatch = content.match(/^status\\\\s*:\\\\s*(.+)$/u);\\n        if (statusMatch) status = scalar(statusMatch[1]);\\n      } else if (inStall && indent === 2) {\\n        const stallMatch = content.match(/^(quiet_turns|same_failure)\\\\s*:\\\\s*(.+)$/u);\\n        if (stallMatch?.[1] === 'quiet_turns') quietTurns = scalar(stallMatch[2]);\\n        if (stallMatch?.[1] === 'same_failure') sameFailure = scalar(stallMatch[2]);\\n      }\\n    }\\n    if (!['active', 'complete', 'blocked'].includes(status)) return null;\\n    return {\\n      status,\\n      stall: {\\n        quietTurns: positiveInteger(quietTurns, DEFAULT_STALL.quietTurns),\\n        sameFailure: positiveInteger(sameFailure, DEFAULT_STALL.sameFailure),\\n      },\\n      frontmatterHash: digest(frontmatter),\\n    };\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nasync function readFlightPlan(cwd, now) {\\n  const path = join(cwd, FLIGHT_FILE);\\n  try {\\n    const [text, metadata] = await Promise.all([readFile(path, 'utf8'), stat(path)]);\\n    const age = now - metadata.mtimeMs;\\n    if (age < 0 || age >= MAX_FLIGHT_AGE_MS) return null;\\n    return parseHookFlightPlan(text);\\n  } catch (error) {\\n    if (error?.code === 'ENOENT') return null;\\n    throw error;\\n  }\\n}\\n\\nasync function ensureScratchDirectory(cwd) {\\n  const directory = join(cwd, '.cruise');\\n  await mkdir(directory, { recursive: true, mode: 0o700 });\\n  const metadata = await lstat(directory);\\n  if (metadata.isSymbolicLink() || !metadata.isDirectory()) throw new Error('.cruise must be a real directory');\\n  return directory;\\n  ].join(' ');\\n}\\n\\nfunction realignReason(observation) {\\n  return [\\n    `Cruise Goal supervision observed non-progress: ${observation}.`,\\n    'Repeating the same approach is not progress.',\\n    'Run the smallest discriminating experiment that produces new evidence, or set status: blocked in .cruise/FLIGHT.md and state the concrete blocker in its body.',\\n  ].join(' ');\\n}\\n\\nfunction finalReason(observation) {\\n  return [\\n    `Cruise Goal supervision still observes no progress after realignment: ${observation}.`,\\n    'Produce new evidence this turn or set status: blocked in .cruise/FLIGHT.md with a concrete blocker report.',\\n    'This is the final supervised continuation before the hook allows the stop with a stall report.',\\n  ].join(' ');\\n}\\n\\nfunction stallMessage(state, observation, capReached = false) {\\n  const interventions = state.interventions.length\\n    ? state.interventions.map((item) => item.level).join(', ')\\n    : 'continuation cap reached before a complete intervention record';\\n  return [\\n    `Cruise Goal stall supervisor allowed this stop after ${state.turns_observed} observed stops.`,\\n    `Observed: ${observation}.`,\\n    `Interventions attempted: ${interventions}.`,\\n    capReached ? `The hard backstop of ${state.blocks_in_cycle} blocked stops was reached.` : 'The realignment and final-experiment ladder produced no new evidence.',\\n    'Suggested next actions: inspect the last diff and failure, edit .cruise/FLIGHT.md if its scope or tuning is stale, provide missing evidence or a material decision, then resume explicitly.',\\n    'The stop was allowed; this scratch state grants no authority and is safe to delete.',\\n  ].join('\\\\n');\\n}\\n\\nexport async function runStopSupervisor(input, { now = Date.now() } = {}) {\\n  if (!input || input.hook_event_name !== 'Stop' || typeof input.cwd !== 'string' || !input.cwd) return null;\\n  const cwd = resolve(input.cwd);\\n  const flight = await readFlightPlan(cwd, now);\\n  if (!flight || flight.status !== 'active') return null;\\n\\n  const directory = await ensureScratchDirectory(cwd);\\n  await ensureGitignore(directory);\\n  const state = await readState(directory, flight.frontmatterHash, now);\\n  if (state.ladder === 'stalled') {\\n    return { systemMessage: stallMessage(state, state.observations.at(-1)?.reason ?? 'prior stall') };\\n  }\\n  const [fingerprint, signature] = await Promise.all([\\n    captureWorkspaceFingerprint(cwd),\\n    Promise.resolve(failureSignature(input.last_assistant_message)),\\n  ]);\\n  const observation = observe(state, fingerprint, signature, now);\\n  const blockCap = flight.stall.quietTurns + 2;\\n  let output;\\n  if (state.blocks_in_cycle >= blockCap) {\\n    state.ladder = 'stalled';\\n    output = { systemMessage: stallMessage(state, observation.reason, true) };\\n  } else if (state.ladder === 'realign') {\\n    state.ladder = 'final';\\n    state.blocks_in_cycle += 1;\\n    state.interventions.push({ level: 'final-experiment', at: now, reason: observation.reason });\\n    output = { decision: 'block', reason: finalReason(observation.reason) };\\n  } else if (state.ladder === 'final') {\\n    state.ladder = 'stalled';\\n    output = { systemMessage: stallMessage(state, observation.reason) };\\n  } else if (\\n    state.quiet_stops >= flight.stall.quietTurns ||\\n    state.same_failure >= flight.stall.sameFailure\\n  ) {\\n    state.ladder = 'realign';\\n    state.blocks_in_cycle += 1;\\n    state.interventions.push({ level: 'realign', at: now, reason: observation.reason });\\n    output = { decision: 'block', reason: realignReason(observation.reason) };\\n  } else {\\n    state.blocks_in_cycle += 1;\\n    output = { decision: 'block', reason: standardReason(observation.reason) };\\n  }\\n  await writeState(directory, state);\\n  return output;\\n}\\n\\nasync function readInput(stream) {\\n  let text = '';\\n  for await (const chunk of stream) {\\n    text += chunk;\\n    if (text.length > 1_000_000) throw new Error('hook input exceeds 1 MB');\\n  }\\n  return JSON.parse(text);\\n\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"019f8383-ba1a-7203-8508-59020e902fe9\"}}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:302:{\"timestamp\":\"2026-07-21T07:13:24.958Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"agent_message\",\"message\":\"- **High — a fresh active flight plan blocks unrelated Claude sessions.** The hook never checks `session_id`, transcript, invoked skill, or any other Goal-session marker. Reproduction: leave a fresh `status: active` `.cruise/FLIGHT.md`, then invoke the Stop hook from `/cruise:quick` or an ordinary Claude session in the same cwd; it returns `{\\\"decision\\\":\\\"block\\\",...}`. This violates the requirement that the hook be inert in every non-Goal session; the 48-hour guard still permits abandoned plans to affect unrelated work.\\n\\n- **Medium — malformed frontmatter can activate supervision instead of failing open.** `parseHookFlightPlan` accepts duplicate keys and ignores structurally invalid lines. For example, `---\\\\nstatus: active\\\\nstatus: active\\\\n---\\\\n` returns an active plan, while the pinned `flight-plan.mjs` parser rejects duplicate keys. Oddly indented or malformed unrelated fields are likewise ignored. A broken advisory plan can therefore block Stops rather than being inert.\\n\\n- **Medium — once a ladder reaches `stalled`, evidence can never reset it.** `runStopSupervisor` returns the prior stall report before capturing a new fingerprint or failure signature. Reproduction: reach allow-with-report, modify a tracked file, then invoke Stop again with the same active frontmatter; it still allows with the old report and never begins a new cycle. Thus an explicitly resumed Goal cannot recover supervision through new evidence unless the user edits frontmatter or deletes scratch state.\\n\\nThe current registration and stdout shapes match the official Claude Code contract: exec-form `command`/`args`, top-level `decision: \\\"block\\\"` plus `reason`, and omission of `decision` with `systemMessage` to allow-and-report.\",\"phase\":\"final_answer\",\"memory_citation\":null}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-52-15-019f8372-5258-7e53-831c-7ef2f607d9aa.jsonl:303:{\"timestamp\":\"2026-07-21T07:13:24.968Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"message\",\"id\":\"msg_05cd102a9eb280a0016a5f1c0e475881919c032fe9ee6937d2\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"- **High — a fresh active flight plan blocks unrelated Claude sessions.** The hook never checks `session_id`, transcript, invoked skill, or any other Goal-session marker. Reproduction: leave a fresh `status: active` `.cruise/FLIGHT.md`, then invoke the Stop hook from `/cruise:quick` or an ordinary Claude session in the same cwd; it returns `{\\\"decision\\\":\\\"block\\\",...}`. This violates the requirement that the hook be inert in every non-Goal session; the 48-hour guard still permits abandoned plans to affect unrelated work.\\n\\n- **Medium — malformed frontmatter can activate supervision instead of failing open.** `parseHookFlightPlan` accepts duplicate keys and ignores structurally invalid lines. For example, `---\\\\nstatus: active\\\\nstatus: active\\\\n---\\\\n` returns an active plan, while the pinned `flight-plan.mjs` parser rejects duplicate keys. Oddly indented or malformed unrelated fields are likewise ignored. A broken advisory plan can therefore block Stops