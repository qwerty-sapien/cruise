{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,55p' <PLUGIN_ROOT>/README.md && sed -n '240,310p' <PLUGIN_ROOT>/scripts/lib/flight-plan.mjs && sed -n '1,95p' <PLUGIN_ROOT>/tests/flight-plan.test.mjs\"","aggregated_output":"# Cruise\n\nCruise is a small, dual-host coding workflow plugin and optional terminal\nlauncher. The same five intent-based skills run natively on Codex and Claude\nCode while each host keeps its own permissions, models, session controls, and\nagent plumbing.\n\nCruise records an exact terminal skill request in `.cruise/ORIGIN.md`. Build\ncan compile an advisory `.cruise/QUEUE.md`, and each Goal run maintains the\nadvisory `.cruise/FLIGHT.md` described below. None is an approval or source of\nauthority, and Cruise does not create a parallel workflow database, approval\nledger, archive, or run directory.\n\n## Choose a skill\n\n| Skill | Use it when |\n| --- | --- |\n| `build` | You need to clarify a project and compile goal-sized milestones before implementation. |\n| `quick` | The requested change is small, understood, and low risk. |\n| `refine` | The outcome is finite but needs a short plan first. |\n| `goal` | The work is consequential or multi-step and should run to completion. |\n| `debug` | You have a clear or vague failure, or want adversarial UX quality control. |\n\n`goal` is the autonomous lane: it starts with a compact codebase-aware plan,\nthen implements, verifies, realigns, and advances ready in-scope work. Plans\nlaunch implementation; they are not a completion boundary. It still asks for\nmaterial product decisions, secrets, scope changes, and approvals required by\nthe active host.\n\n## Flight plans\n\nAt the start of Goal execution, Cruise compiles the clarified outcome, expected\ntouchpoints, non-goals, invariants, verification commands, and stall tuning into\n`.cruise/FLIGHT.md`. The agent rereads this small Markdown note as work advances\nand keeps its status truthful. You may edit it at any time; it is advisory and\ngrants or gates nothing. The selected host's native permissions remain the only\nauthority for work and effects.\n\n## Build queues\n\nBuild inspects the repository, clarifies only material product and compatibility\nquestions, and writes goal-sized milestones to `.cruise/QUEUE.md`. Each\nmilestone owns an outcome, verification, dependency list, touchpoints,\nnon-goals, and invariants. Cross-milestone compatibility obligations live once\nin the Markdown body and are inherited by every generated flight plan.\n\nThe queue is user-editable and advisory. Reorder or adjust it between milestone\nruns, then inspect or execute it with `cruise queue status` and\n`cruise queue run`. Queue execution is sequential: it never skips a blocked or\nstalled milestone, and it stops with a report instead of inventing authority.\n\n## Provider integration\n\nCruise shares its skills and terminal UI, but not its host control plane:\n\n    normalized: known,\n    frontmatter: {\n      version: known.version,\n      status: known.status,\n      outcome: known.outcome,\n      verify: known.verify,\n      scope: {\n        touchpoints: known.scope.touchpoints,\n        non_goals: known.scope.nonGoals,\n        ...Object.fromEntries(Object.entries(scopeRaw).filter(([key]) => !['touchpoints', 'non_goals'].includes(key))),\n      },\n      invariants: known.invariants,\n      stall: {\n        quiet_turns: known.stall.quietTurns,\n        same_failure: known.stall.sameFailure,\n        ...Object.fromEntries(Object.entries(stallRaw).filter(([key]) => !['quiet_turns', 'same_failure'].includes(key))),\n      },\n      ...extras,\n    },\n  };\n}\n\nexport async function readFlightPlan(cwd) {\n  try {\n    return parseFlightPlan(await readFile(join(cwd, FLIGHT_FILE), 'utf8'));\n  } catch {\n    return null;\n  }\n}\n\nexport async function writeFlightPlan(cwd, plan) {\n  const { normalized, frontmatter } = serializablePlan(plan);\n  const directory = join(cwd, '.cruise');\n  await mkdir(directory, { recursive: true, mode: 0o700 });\n  const directoryMetadata = await lstat(directory);\n  if (directoryMetadata.isSymbolicLink() || !directoryMetadata.isDirectory()) {\n    throw new Error(`${directory} must be a directory.`);\n  }\n  const path = join(cwd, FLIGHT_FILE);\n  try {\n    const existing = await lstat(path);\n    if (existing.isSymbolicLink() || !existing.isFile()) throw new Error(`${path} must be a regular file.`);\n  } catch (error) {\n    if (error?.code !== 'ENOENT') throw error;\n  }\n  const text = `---\\n${serializeObject(frontmatter).join('\\n')}\\n---\\n${normalized.body}`;\n  await writeFile(path, text, { encoding: 'utf8', mode: 0o600 });\n  return normalized;\n}\nimport assert from 'node:assert/strict';\nimport { mkdtemp, readFile, rm } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport test from 'node:test';\n\nimport {\n  DEFAULT_STALL,\n  FLIGHT_FILE,\n  parseFlightPlan,\n  readFlightPlan,\n  writeFlightPlan,\n} from '../scripts/lib/flight-plan.mjs';\n\ntest('missing optional fields receive advisory defaults', () => {\n  const plan = parseFlightPlan('---\\noutcome: Ship the parser\\n---\\n# Flight plan\\n\\nKeep it small.');\n  assert.deepEqual(plan, {\n    version: 1,\n    status: 'active',\n    outcome: 'Ship the parser',\n    verify: [],\n    scope: { touchpoints: [], nonGoals: [] },\n    invariants: [],\n    stall: { quietTurns: DEFAULT_STALL.quietTurns, sameFailure: DEFAULT_STALL.sameFailure },\n    body: '# Flight plan\\n\\nKeep it small.',\n    raw: { outcome: 'Ship the parser' },\n  });\n});\n\ntest('write and read round-trip the pinned schema and unknown extensions', async () => {\n  const cwd = await mkdtemp(join(tmpdir(), 'cruise-flight-'));\n  try {\n    await writeFlightPlan(cwd, {\n      version: 1,\n      status: 'active',\n      outcome: 'Make parsing failures harmless',\n      verify: ['npm test', 'node --check scripts/lib/flight-plan.mjs'],\n      scope: { touchpoints: ['scripts/lib/'], nonGoals: ['No public API redesign'] },\n      invariants: ['Existing CLI flags keep their behavior'],\n      stall: { quietTurns: 4, sameFailure: 2 },\n      body: '# Flight plan\\n\\nThe host remains the authority.',\n      raw: {\n        owner: 'user-editable',\n        scope: { reviewer: 'optional' },\n        stall: { strategy: 'realign' },\n      },\n    });\n\n    const plan = await readFlightPlan(cwd);\n    assert.equal(plan.outcome, 'Make parsing failures harmless');\n    assert.deepEqual(plan.verify, ['npm test', 'node --check scripts/lib/flight-plan.mjs']);\n    assert.deepEqual(plan.scope, {\n      touchpoints: ['scripts/lib/'],\n      nonGoals: ['No public API redesign'],\n    });\n    assert.deepEqual(plan.stall, { quietTurns: 4, sameFailure: 2 });\n    assert.equal(plan.raw.owner, 'user-editable');\n    assert.equal(plan.raw.scope.reviewer, 'optional');\n    assert.equal(plan.raw.stall.strategy, 'realign');\n    assert.equal(plan.body, '# Flight plan\\n\\nThe host remains the authority.');\n    assert.match(await readFile(join(cwd, FLIGHT_FILE), 'utf8'), /^---\\nversion: 1\\nstatus: active/u);\n  } finally {\n    await rm(cwd, { recursive: true, force: true });\n  }\n});\n\ntest('malformed or invalid frontmatter returns null', async () => {\n  const inputs = [\n    '',\n    'outcome: missing fences',\n    '---\\noutcome: never closed',\n    '---\\n status: active\\n---\\n',\n    '---\\nstatus: launched\\n---\\n',\n    '---\\nstatus: null\\n---\\n',\n    '---\\nverify: npm test\\n---\\n',\n    '---\\noutcome: \"two\\\\nlines\"\\n---\\n',\n    '---\\nstall:\\n  quiet_turns: 0\\n---\\n',\n  ];\n  for (const input of inputs) assert.equal(parseFlightPlan(input), null);\n\n  const cwd = await mkdtemp(join(tmpdir(), 'cruise-flight-missing-'));\n  try {\n    assert.equal(await readFlightPlan(cwd), null);\n  } finally {\n    await rm(cwd, { recursive: true, force: true });\n  }\n});\n\ntest('parseFlightPlan never throws on pathological text', () => {\n  const inputs = [\n    null,\n    42,\n    '\\u0000\\u0001\\u0002',\n    `---\\n${'  nested:\\n'.repeat(20)}value: nope\\n---\\n`,\n    `---\\nitems:\\n${'  - value\\n'.repeat(1_100)}---\\n`,\n","exit_code":0,"status":"completed"}}
