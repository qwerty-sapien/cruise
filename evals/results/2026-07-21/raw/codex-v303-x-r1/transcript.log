null);\\\\n+});\\\\n*** Update File: <PLUGIN_ROOT>/tests/claude-cli.test.mjs\\\\n@@\\\\n   CLAUDE_WORKER_LEVEL_POLICY,\\\\n   claudeSessionArgs,\\\\n   claudeWorkerArgs,\\\\n   runClaudeCli,\\\\n+  runClaudeSession,\\\\n } from '../scripts/lib/claude-cli.mjs';\\\\n@@\\\\n test('Claude CLI transport inherits the native TUI and returns its exit status', async () => {\\\\n@@\\\\n   assert.equal(calls[0].options.cwd, '/workspace');\\\\n });\\\\n+\\\\n+test('only launcher-started Goal sessions activate the Claude Stop supervisor', async () => {\\\\n+  const calls = [];\\\\n+  class Child extends EventEmitter {}\\\\n+  const spawnFn = (command, args, options) => {\\\\n+    calls.push({ command, args, options });\\\\n+    const child = new Child();\\\\n+    queueMicrotask(() => child.emit('exit', 0, null));\\\\n+    return child;\\\\n+  };\\\\n+  await runClaudeSession({\\\\n+    cwd: '/workspace',\\\\n+    pluginRoot: '/plugin',\\\\n+    skill: 'goal',\\\\n+    prompt: 'Finish it.',\\\\n+    env: { BASE: 'kept' },\\\\n+    spawnFn,\\\\n+  });\\\\n+  await runClaudeSession({\\\\n+    cwd: '/workspace',\\\\n+    pluginRoot: '/plugin',\\\\n+    skill: 'quick',\\\\n+    prompt: 'Patch it.',\\\\n+    env: { BASE: 'kept' },\\\\n+    spawnFn,\\\\n+  });\\\\n+  assert.deepEqual(calls[0].options.env, { BASE: 'kept', CRUISE_CLAUDE_GOAL: '1' });\\\\n+  assert.deepEqual(calls[1].options.env, { BASE: 'kept' });\\\\n+});\\\\n*** End Patch\\\";text(await tools.apply_patch(patch))\\n\\n\"},{\"type\":\"input_text\",\"text\":\"\\n[45] tool exec result: Script completed\\nWall time 0.9 seconds\\nOutput:\\n\\n{}\\n\"},{\"type\":\"input_text\",\"text\":\"\\n[46] tool exec call: const r=await tools.exec_command({cmd:\\\"node --check hooks/stop-supervisor.mjs && node --test tests/stop-supervisor.test.mjs tests/claude-cli.test.mjs\\\",workdir:\\\"<PLUGIN_ROOT>\\\",yield_time_ms:30000,max_output_tokens:20000});text(r.output);text(`exit=${r.exit_code}`)\\n\\n\"},{\"type\":\"input_text\",\"text\":\