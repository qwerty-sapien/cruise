n+test('a symlinked scratch directory fails open without writing through it', async () => {\\\\n+  const cwd = await mkdtemp(join(tmpdir(), 'cruise-stop-link-cwd-'));\\\\n+  const outside = await mkdtemp(join(tmpdir(), 'cruise-stop-link-target-'));\\\\n+  try {\\\\n+    await writeFile(join(outside, 'FLIGHT.md'), flight(), 'utf8');\\\\n+    await symlink(outside, join(cwd, '.cruise'), 'dir');\\\\n+    const output = invoke(cwd);\\\\n+    assert.equal(output.decision, undefined);\\\\n+    assert.match(output.systemMessage, /failed open/iu);\\\\n+    assert.deepEqual(await readdir(outside), ['FLIGHT.md']);\\\\n+  } finally {\\\\n+    await rm(cwd, { recursive: true, force: true });\\\\n+    await rm(outside, { recursive: true, force: true });\\\\n+  }\\\\n+});\\\\n*** End Patch\\\";text(await tools.apply_patch(patch))\\n\\n\"},{\"type\":\"input_text\",\"text\":\"\\n[37] tool exec result: Script completed\\nWall time 0.3 seconds\\nOutput:\\n\\n{}\\n\"},{\"type\":\"input_text\",\"text\":\"\\n[38] tool exec call: const r=await tools.exec_command({cmd:\\\"node --test tests/stop-supervisor.test.mjs\\\",workdir:\\\"<PLUGIN_ROOT>\\\",yield_time_ms:30000,max_output_tokens:12000});text(r.output);text(`exit=${r.exit_code}`)\\n\\n\"},{\"type\":\"input_text\",\"text\":\"\\n[39] tool exec result: Script completed\\nWall time 1.0 seconds\\nOutput:\\n\\n✔ quiet evidence climbs through continuation, realignment, final experiment, then bounded allow (236.0025ms)\\n✔ missing, complete, and blocked flight plans leave non-active sessions inert (174.274333ms)\\n✔ an active flight plan older than 48 hours is inert (55.971167ms)\\n✔ changing flight-plan frontmatter resets the supervision cycle (124.134041ms)\\n✔ same normalized failure can trigger realignment without git evidence (104.657ms)\\n✔ corrupt scratch state fails open with an allow report and exit zero (110.107792ms)\\n✔ a symlinked scratch directory fails open without writing through it (44.085083ms)\\n✔ hook registration uses the standalone plugin-root command form (0.656209ms)\\n✔ unsafe stall integers fall back instead of defeating the block cap (1.22675ms)\\nℹ tests 9\\nℹ suites 0\\nℹ pass 9\\nℹ fail 0\\nℹ cancelled 0\\nℹ skipped 0\\nℹ todo 0\\nℹ duration_ms 908.324167\\n\\nexit=0\\n\"},{\"type\":\"input_text\",\"text\":\"\\n[40] tool wait_agent call: {\\\"timeout_ms\\\":30000}\\n\"},{\"type\":\"input_text\",\"text\":\"\\n[41] tool wait_agent result: {\\\"message\\\":\\\"Wait completed.\\\",\\\"timed_out\\\":false}\\n\"},{\"type\":\"input_text\",\"text\":\"\\n[42] assistant: Agent message from /root/task_b_adversarial:\\nMessage Type: FINAL_ANSWER\\nTask name: /root\\nSender: /root/task_b_adversarial\\nPayload:\\n- **High — a fresh active flight plan blocks unrelated Claude sessions.** The hook never checks `session_id`, transcript, invoked skill, or any other Goal-session marker. Reproduction: leave a fresh `status: active` `.cruise/FLIGHT.md`, then invoke the Stop hook from `/cruise:quick` or an ordinary Claude session in the same cwd; it returns `{\\\"decision\\\":\\\"block\\\",...}`. This violates the requirement that the hook be inert in every non-Goal session; the 48-hour guard still permits abandoned plans to affect unrelated work.\\n\\n- **Medium — malformed frontmatter can activate supervision instead of failing open.** `parseHookFlightPlan` accepts duplicate keys and ignores structurally invalid lines. For example, `---\\\\nstatus: active\\\\nstatus: active\\\\n---\\\\n` returns an active plan, while the pinned `flight-plan.mjs` parser rejects duplicate keys. Oddly indented or malformed unrelated fields are likewise ignored. A broken advisory plan can therefore block Stops rather than being inert.\\n\\n- **Medium — once a ladder reaches `stalled`, evidence can never reset it.** `runStopSupervisor` returns the prior stall report before capturing a new fingerprint or failure signature. Reproduction: reach allow-with-report, modify a tracked file, then invoke Stop again with the same active frontmatter; it still allows with the old report and never begins a new cycle. Thus an explicitly resumed Goal cannot recover supervision through new evidence unless the user edits frontmatter or deletes scratch state.\\n\\nThe current registration and stdout shapes match the official Claude Code contract: exec-form `command`/`args`, top-level `decision: \\\"block\\\"` plus `reason`, and omission of `decision` with `systemMessage` to allow-and-report.\\n\"},{\"type\":\"input_text\",\"text\":\"\\n[43] assistant: The adversarial probe found three credible lifecycle gaps: non-Goal Claude sessions could inherit a fresh active plan, malformed frontmatter could still activate the hook, and a stalled cycle could not recover after new workspace evidence. I’m fixing all three: request-scoped launcher activation, strict standalone parsing, and evidence-driven restart after a reported stall.\\n\"},{\"type\":\"input_text\",\"text\":\"\\n[44] tool exec call: const patch=\\\"*** Begin Patch\\\\n*** Update File: <PLUGIN_ROOT>/hooks/stop-supervisor.mjs\\\\n@@\\\\n-function scalar(value) {\\\\n-  const text = stripComment(value);\\\\n-  if (text.startsWith('\\\\\\\"')) return JSON.parse(text);\\\\n-  if (text.startsWith(\\\\\\\"'\\\\\\\")) {\\\\n-    if (!text.endsWith(\\\\\\\"'\\\\\\\")) throw new Error('invalid flight-plan scalar');\\\\n-    return text.slice(1, -1).replace(/''/gu, \\\\\\\"'\\\\\\\");\\\\n-  }\\\\n-  return text;\\\\n+function parseScalar(value) {\\\\n+  const text = stripComment(value).trim();\\\\n+  if (text === '[]') return [];\\\\n+  if (text === '{}') return {};\\\\n+  if (text === 'null' || text === '~') return null;\\\\n+  if (text === 'true') return true;\\\\n+  if (text === 'false') return false;\\\\n+  if (/^-?(?:0|[1-9]\\\\\\\\d*)$/u.test(text)) return Number(text);\\\\n+  if (text.startsWith('\\\\\\\"')) {\\\\n+    const parsed = JSON.parse(text);\\\\n+    if (typeof parsed !== 'string') throw new Error('quoted flight-plan values must be st