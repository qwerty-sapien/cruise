ested next actions: inspect the last diff and failure, edit .cruise/FLIGHT.md if its scope or tuning is stale, provide missing evidence or a material decision, then resume explicitly.',\\\\n    'The stop was allowed; this scratch state grants no authority and is safe to delete.',\\\\n  ].join('\\\\\\\\n');\\\\n}\\\\n\\\\nexport async function runStopSupervisor(input, {\\\\n  now = Date.now(),\\\\n  goalSession = process.env.CRUISE_CLAUDE_GOAL === '1',\\\\n} = {}) {\\\\n  if (!input || input.hook_event_name !== 'Stop' || typeof input.cwd !== 'string' || !input.cwd) return null;\\\\n  if (!goalSession) return null;\\\\n  const cwd = resolve(input.cwd);\\\\n  const flight = await readFlightPlan(cwd, now);\\\\n  if (!flight || flight.status !== 'active') return null;\\\\n\\\\n  const directory = await ensureScratchDirectory(cwd);\\\\n  await ensureGitignore(directory);\\\\n  const state = await readState(directory, flight.frontmatterHash, now);\\\\n  const [fingerprint, signature] = await Promise.all([\\\\n    captureWorkspaceFingerprint(cwd),\\\\n    Promise.resolve(failureSignature(input.last_assistant_message)),\\\\n  ]);\\\\n  const observation = observe(state, fingerprint, signature, now);\\\\n  const blockCap = flight.stall.quietTurns + 2;\\\\n  let output;\\\\n  if (state.ladder === 'stalled') {\\\\n    output = { systemMessage: stallMessage(state, observation.reason) };\\\\n  } else if (state.blocks_in_cycle >= blockCap) {\\\\n    state.ladder = 'stalled';\\\\n    output = { systemMessage: stallMessage(state, observation.reason, true) };\\\\n  } else if (state.ladder === 'realign') {\\\\n    state.ladder = 'final';\\\\n    state.blocks_in_cycle += 1;\\\\n    state.interventions.push({ level: 'final-experiment', at: now, reason: observation.reason });\\\\n    output = { decision: 'block', reason: finalReason(observation.reason) };\\\\n  } else if (state.ladder === 'final') {\\\\n    state.ladder = 'stalled';\\\\n    output = { systemMessage: stallMessage(state, observation.reason) };\\\\n  } else if (\\\\n    state.quiet_stops >= flight.stall.quietTurns ||\\\\n    state.same_failure >= flight.stall.sameFailure\\\\n  ) {\\\\n    state.ladder = 'realign';\\\\n    state.blocks_in_cycle += 1;\\\\n    state.interventions.push({ level: 'realign', at: now, reason: observation.reason });\\\\n    output = { decision: 'block', reason: realignReason(observation.reason) };\\\\n  } else {\\\\n    state.blocks_in_cycle += 1;\\\\n    output = { decision: 'block', reason: standardReason(observation.reason) };\\\\n  }\\\\n  await writeState(directory, state);\\\\n  return output;\\\\n}\\\\n\\\\nasync function readInput(stream) {\\\\n  let text = '';\\\\n  for await (const chunk of stream) {\\\\n    text += chunk;\\\\n    if (text.length > 1_000_000) throw new Error('hook input exceeds 1 MB');\\\\n  }\\\\n  return JSON.parse(text);\\\\n}\\\\n\\\\nexport async function main({ input = process.stdin, output = process.stdout } = {}) {\\\\n  try {\\\\n\\\"}\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"019f836a-7f45-7002-996e-c2d98a1f90e7\"}}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-43-37-019f836a-6c24-7cc2-a5b3-7d87672f1b74.jsonl:1235:{\"timestamp\":\"2026-07-21T07:28:01.693Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"call_id\":\"call_iHFDOCg14wi26dXsUdMwCxid\",\"output\":[{\"type\":\"input_text\",\"text\":\"Script completed\\nWall time 0.8 seconds\\nOutput:\\n\"},{\"type\":\"input_text\",\"text\":\"Warning: truncated output (original token count: 10195)\\nTotal output lines: 8\\n\\n---0---\\n{\\\"chunk_id\\\":\\\"c8d16a\\\",\\\"wall_time_seconds\\\":0.000002375,\\\"exit_code\\\":0,\\\"original_token_count\\\":947,\\\"output\\\":\\\"WARNING: proceeding, even though we could not create PATH aliases: Operation not permitted (os error 1)\\\\nRun Codex non-interactively\\\\n\\\\nUsage: codex exec [OPTIONS] [PROMPT]\\\\n       codex exec [OPTIONS] <COMMAND> [ARGS]\\\\n\\\\nCommands:\\\\n  resume  Resume a previous session by id or pick the most recent with --last\\\\n  review  Run a code review against the current repository\\\\n  help    Print this message or the help of the given subcommand(s)\\\\n\\\\nArguments:\\\\n  [PROMPT]\\\\n          Initial instructions for the agent. If not provided as an argument (or if `-` is used),\\\\n          instructions are read from stdin. If stdin is piped and a prompt is also provided, stdin\\\\n          is appended as a `<stdin>` block\\\\n\\\\nOptions:\\\\n  -c, --config <key=value>\\\\n          Override a configuration value that would otherwise be loaded from `~/.codex/config.toml`.\\\\n          Use a dotted path (`foo.bar.baz`) to override nested values. The `value` portion is parsed\\\\n          as TOML. If it fails to parse as TOML, the raw string is used as a literal.\\\\n          \\\\n          Examples: - `-c model=\\\\\\\"o3\\\\\\\"` - `-c 'sandbox_permissions=[\\\\\\\"disk-full-read-access\\\\\\\"]'` - `-c\\\\n          shell_environment_policy.inherit=all`\\\\n\\\\n      --enable <FEATURE>\\\\n          Enable a feature (repeatable). Equivalent to `-c features.<name>=true`\\\\n\\\\n      --disable <FEATURE>\\\\n          Disable a feature (repeatable). Equivalent to `-c features.<name>=false`\\\\n\\\\n      --strict-config\\\\n          Error out when config.toml contains fields that are not recognized by this version of\\\\n          Codex\\\\n\\\\n  -i, --image <FILE>...\\\\n          Optional image(s) to attach to the initial prompt\\\\n\\\\n  -m, --model <MODEL>\\\\n          Model the agent should use\\\\n\\\\n      --oss\\\\n          Use open-source provider\\\\n\\\\n      --local-provider <OSS_PROVIDER>\\\\n          Specify which local provider to use (lmstudio or ollama). If not specified with --oss,\\\\n          will use config default or show selection\\\\n\\\\n  -p, --profile <CONFIG_PROFILE_V2>\\\\n          Layer $CODEX_HOME/<name>.config.toml on top of the base user config\\\\n\\\\n  -s, --sandbox <SANDBOX_MODE>\\\\n          Select the sandbox policy to use when executing model-generated shell commands\\\\n          \\\\n          [possible values: read-only, workspace-write, danger-full-access]\\\\n\\\\n      --dangerously-bypass-approvals-and-sandbox\\\\n          Skip all confirmation prompts and execute commands without sandboxing. EXTREMELY\\\\n          DANGEROUS. Intended solely for running in environments that are externally sandboxed\\\\n\\\\n      --dangerously-bypass-hook-trust\\\\n          Run enabled hooks without requiring persisted hook trust for this invocation. DANGEROUS.\\\\n          Intended only for automation that already vets hook sources\\\\n\\\\n  -C, --cd <DIR>\\\\n          Tell the agent to use the specified directory as its working root\\\\n\\\\n      --add-dir <DIR>\\\\n          Additional directories that should be writable alongside the primary workspace\\\\n\\\\n      --skip-git-repo-check\\\\n          Allow running Codex outside a Git repository\\\\n\\\\n      --ephemeral\\\\n          Run without persisting session files to disk\\\\n\\\\n      --ignore-user-config\\\\n          Do not load `$CODEX_HOME/config.toml`; auth still uses `CODEX_HOME`\\\\n\\\\n      --ignore-rules\\\\n          Do not load user or project execpolicy `.rules` files\\\\n\\\\n      --output-schema <FILE>\\\\n          Path to a JSON Schema file describing the model's final response shape\\\\n\\\\n      --color <COLOR>\\\\n          Specifies color settings for use in the output\\\\n          \\\\n          [default: auto]\\\\n          [possible values: always, never, auto]\\\\n\\\\n      --json\\\\n          Print events to stdout as JSONL\\\\n\\\\n  -o, --output-last-message <FILE>\\\\n          Specifies file where the last message from the agent should be written\\\\n\\\\n  -h, --help\\\\n          Print help (see a summary with '-h')\\\\n\\\\n  -V, --version\\\\n          Print version\\\\n\\\"}\\n---1---\\n{\\\"chunk_id\\\":\\\"1df077\\\",\\\"wall_time_seconds\\\":0.641053875,\\\"exit_code\\\":0,\\\"original_token_count\\\":3928,\\\"output\\\":\\\"Usage: claude [options] [command] [prompt]\\\\n\\\\nClaude Code - starts an interactive session by default, use -p/--print for\\\\nnon-interactive output\\\\n\\\\nArguments:\\\\n  prompt                                Your prompt\\\\n\\\\nOptions:\\\\n  --add-dir <directories...>            Additional directories to allow tool\\\\n                                        access to\\\\n  --agent <agent>                       Agent for the current session. Overrides\\\\n                                        the 'agent' setting.\\\\n  --agents <json>                       JSON object defining custom agents (e.g.\\\\n                                        '{\\\\\\\"reviewer\\\\\\\": {\\\\\\\"description\\\\\\\": \\\\\\\"Reviews\\\\n                                        code\\\\\\\", \\\\\\\"prompt\\\\\\\": \\\\\\\"You are a code\\\\n                                        reviewer\\\\\\\"}}')\\\\n  --allow-dangerously-skip-permissions  Enable bypassing all permission checks\\\\n                                        as an option, without it being enabled\\\\n                                        by default. Recommended only for\\\\n                                        sandboxes with no internet access.\\\\n  --allowedTools, --allowed-tools <tools...>\\\\n      Comma or space-separated list of tool names to allow (e.g. \\\\\\\"Bash(git *)\\\\n      Edit\\\\\\\")\\\\n  --append-system-prompt <prompt>       Append a system prompt to the default\\\\n                                        system prompt\\\\n  --ax-screen-reader                    Render screen-reader friendly output\\\\n                                        (flat text, no decorative borders or\\\\n                                        animations).\\\\n  --bg, --background                    Start the session as a background agent\\\\n                                        and return immediately (manage with\\\\n                                        `claude agents`)\\\\n  --bare                                Minimal mode: skip hooks, LSP, plugin\\\\n                                        sync, attribution, auto-memory,\\\\n                                        background prefetches, keychain reads,\\\\n                                        and CLAUDE.md auto-discovery. Sets\\\\n                                        CLAUDE_CODE_SIMPLE=1. Anthropic auth is\\\\n                                        strictly ANTHROPIC_API_KEY or\\\\n                                        apiKeyHelper via --settings (OAuth and\\\\n                                        keychain are never read). 3P providers\\\\n                                        (Bedrock/Vertex/Foundry) use their own\\\\n                                        credentials. Skills still resolve via\\\\n                                        /skill-name. Explicitly provide context\\\\n                                        via: --system-prompt[-file],\\\\n                                        --append-system-prompt[-file], --add-dir\\\\n                                        (CLAUDE.md dirs), --mcp-config,\\\\n                                        --settings, --agents, --plugin-dir.\\\\n  --betas <betas...>                    Beta headers to include in API requests\\\\n                                        (API key users only)\\\\n  --brief                               Enable SendUserMessage tool for\\\\n                                        agent-to-user communication\\\\n  --chrome                              Enable Claude in Chrome integration\\\\n  -c, --continue                        Continue the most recent conversation in\\\\n                                        the current directory\\\\n  --dangerously-skip-permissions        Bypass all permission checks.\\\\n                                        Recommended only for sandboxes with no\\\\n                                        internet access.\\\\n  -d, --debug [filter]                  Enable debug mode with optional category\\\\n                                        filtering (e.g., \\\\\\\"api,hooks\\\\\\\" or\\\\n                                        \\\\\\\"!1p,!file\\\\\\\")\\\\n  --debug-file <path>                   Write debug logs to a specific file path\\\\n                                        (implicitly enables debug mode)\\\\n  --disable-slash-commands              Disable all skills\\\\n  --disallowedTools, --disallowed-tools <tools...>\\\\n      Comma or space-separated list of tool names to deny (e.g. \\\\\\\"Bash(git *)\\\\n      Edit\\\\\\\")\\\\n  --effort <level>                      Effort level for the current session\\\\n                                        (low, medium, high, xhigh, max)\\\\n  --exclude-dynamic-system-prompt-sections\\\\n      Move per-machine sections (cwd, env info, memory paths, git status) from\\\\n      the system prompt into the first user message. Improves cross-user\\\\n      prompt-cache reuse. Only applies with the default system prompt (ignored\\\\n      with --system-prompt). (default: false)\\\\n  --fallback-model <model>              Enable automatic fallback to specified\\\\n                                        model(s) when the default model is\\\\n                                        overloaded or not available. Accepts a\\\\n                                        comma-separated list to try each in\\\\n                                        order. Re-tries the primary at the start\\\\n                                        of each user turn. (only works with\\\\n                                        --print)\\\\n  --file <specs...>                     File resources to download at startup.\\\\n                                        Format: file_id:relative_path (e.g.,\\\\n                                        --file file_abc:doc.txt\\\\n                                        file_def:img.png)\\\\n  --fork-session                        When resuming, create a new session ID\\\\n                                        instead of reusing the original (use\\\\n                                        with --resume or --continue)\\\\n  --from-pr [value]                     Resume a session linked to a PR by PR\\\\n                                        number/URL, or open interactive picker\\\\n                                        with optional search term\\\\n  -h, --help                            Display help for command\\\\n  --ide                                 Automatically connect to IDE on startup\\\\n                                        if exactly one valid IDE is available\\\\n  --include-hook-events                 Include all hook lifecycle events in the\\\\n                                        output stream (only works with\\\\n                                        --output-format=stream-json)\\\\n  --include-partial-messages            Include partial message chunks as they\\\\n                                        arrive (only works with --print and\\\\n                                        --output-format=stream-json)\\\\n  --input-format <format>               Input format (only works with --print):\\\\n                                        \\\\\\\"text\\\\\\\" (default), or \\\\\\\"stream-json\\\\\\\"\\\\n                                        (realtime streaming input) (choices:\\\\n                                        \\\\\\\"text\\\\\\\", \\\\\\\"stream-json\\\\\\\")\\\\n  --json-schema <schema>                JSON Schema for structured output\\\\n                                        validation. Example:\\\\n                                        {\\\\\\\"type\\\\\\\":\\\\\\\"object\\\\\\\",\\\\\\\"properties\\\\\\\":{\\\\\\\"name\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"string\\\\\\\"}},\\\\\\\"required\\\\\\\":[\\\\\\\"name\\\\\\\"]}\\\\n  --max-budget-usd <amount>             Maximum dollar amount to spend on API\\\\n                                        calls (only works with --print)\\\\n  --mcp-config <configs...>             Load MCP servers from JSON files or\\\\n                                        strings (space-separated)\\\\n  --model <model>                       Model for the current session. Provide\\\\n                                        an alias for the latest model (e.g.\\\\n                                        'fable', 'opus', or 'sonnet') or a\\\\n                                        model's full name (e.g.\\\\n                                        'claude-fable-5').\\\\n  -n, --name <name>                     Set a display name for this session\\\\n                                        (shown in the prompt box, /resume\\\\n                                        picker, and terminal title)\\\\n  --no-chrome                           Disable Claude in Chrome integration\\\\n  --no-session-persistence              Disable session persistence - sessions\\\\n                                        will not be saved to disk and cannot be\\\\n                                        resumed (only works with --print)\\\\n  --output-format <format>              Output format (only works with --print):\\\\n                                        \\\\\\\"text\\\\\\\" (default), \\\\\\\"json\\\\\\\" (single\\\\n                                        result), or \\\\\\\"stream-json\\\\\\\" (realtime\\\\n                                        streaming) (choices: \\\\\\\"text\\\\\\\", \\\\\\\"json\\\\\\\",\\\\n                                        \\\\\\\"stream-json\\\\\\\")\\\\n  --permission-mode <mode>              Permission mode to use for the session\\\\n                                        (choices: \\\\\\\"acceptEdits\\\\\\\", \\\\\\\"auto\\\\\\\",\\\\n                                        \\\\\\\"bypassPermissions\\\\\\\", \\\\\\\"manual\\\\\\\",\\\\n                                        \\\\\\\"dontAsk\\\\\\\", \\\\\\\"plan\\\\\\\")\\\\n  --plugin-dir <path>                   Load a plugin from a directory or .zip\\\\n                                        for this session only (repeatable:\\\\n                                        --plugin-dir A --plugin-dir B.zip)\\\\n                                        (default: [])\\\\n  --plugin-url <url>                    Fetch a plugin .zip from a URL for this\\\\n                                        session only (repeatable: --plugin-url A\\\\n                                        --plugin-url B) (default: [])\\\\n  -p, --print                           Print response and exit (useful for\\\\n                                        pipes). Note: The workspace trust dialog\\\\n                                        is skipped when Claude is run in\\\\n                                        non-interactive mode (via -p, or when\\\\n                                        stdout is not a TTY, e.g. piped or\\\\n                                        redirected output). Only use this in\\\\n                                        directories you trust. Settings files\\\\n                                        that fail validation are silently\\\\n                                        ignored in this mode (no error dialog is\\\\n                                        shown).\\\\n  --prompt-suggestions [value]          Enable prompt suggestions. In print/SDK\\\\n                                        mode, emits a prompt_suggestion message\\\\n                                        after each turn with a predicted next\\\\n                                        user prompt (choices: \\\\\\\"true\\\\\\\", \\\\\\\"false\\\\\\\",\\\\n                                        \\\\\\\"1\\\\\\\", \\\\\\\"0\\\\\\\", \\\\\\\"yes\\\\\\\", \\\\\\\"no\\\\\\\", \\\\\\\"on\\\\\\\", \\\\\\\"off\\\\\\\",\\\\n                                        preset: \\\\\\\"true\\\\\\\")\\\\n  --remote-control [name]               Start an interactive session with Remote\\\\n                                        Control enabled (optionally named)\\\\n  --remote-control-session-name-prefix <prefix>\\\\n      Prefix for auto-generated Remote Control session names (default: hostname)\\\\n  --replay-user-messages                Re-emit user messages from stdin back on\\\\n                                        stdout for acknowledgment (only works\\\\n                                        with --input-format=stream-json and\\\\n                                        --output-format=stream-json)\\\\n  -r, --resume [value]                  Resume a conversation by session ID, or\\\\n                                        open interactive picker with optional\\\\n                                        search term\\\\n  --safe-mode                           Start with all customizations\\\\n                                        (CLAUDE.md, skills, plugins, hooks, MCP\\\\n                                        servers, custom commands and agents,\\\\n                                        output styles, workflows, custom themes,\\\\n                                        keybindings, and more) disabled — useful\\\\n                                        for troubleshooting a broken\\\\n                                        configuration. Admin-managed (policy)\\\\n                                        settings still apply. Auth, model\\\\n                                        selection, built-in tools, and\\\\n                                        permissions work normally. Sets\\\\n                                        CLAUDE_CODE_SAFE_MODE=1.\\\\n  --session-id <uuid>                   Use a specific session ID for the\\\\n                                        conversation (must be a valid UUID)\\\\n  --setting-sources <sources>           Comma-separated list of setting sources\\\\n                                        to load (user, project, local).\\\\n  --settings <file-or-json>             Path to a settings JSON file or a JSON\\\\n                                        string to load additional settings from\\\\n  --strict-mcp-config                   Only use MCP servers from --mcp-config,\\\\n                                        ignoring all other MCP configurations\\\\n  --system-prompt <prompt>              System prompt to use for the session\\\\n  --tmux                                Create a tmux session for the worktree\\\\n                                        (requires --worktree). Uses iTerm2\\\\n                                        native panes when available; use\\\\n                                        --tmux=classic for traditional tmux.\\\\n  --tools <tools...>                    Specify the list of available tools from\\\\n                                        the built-in set. Use \\\\\\\"\\\\\\\" to disable all\\\\n                                        tools, \\\\\\\"default\\\\\\\" to use all tools, or\\\\n                                        specify tool names (e.g.\\\\n                                        \\\\\\\"Bash,Edit,Read\\\\\\\").\\\\n  --verbose                             Override verbose mode setting from\\\\n                                        config\\\\n  -v, --version                         Output the version number\\\\n  -w, --worktree [name]                 Create a new git worktree for this\\\\n                                        session (optionally specify a name)\\\\n\\\\nCommands:\\\\n  agents [options]                      Manage background agents\\\\n  auth                                  Manage authentication\\\\n  auto-mode                             Inspect auto mode classifier\\\\n                                        configuration\\\\n  doctor                                Check the health of your Claude Code\\\\n                                        installation. Reads settings files in\\\\n                                        the current directory without a trust\\\\n                                        prompt. For a full checkup that can also\\\\n                                        fix issues, run /doctor in a session.\\\\n  gateway [options]                     Run the enterprise auth/telemetry\\\\n                                        gateway\\\\n  install [options] [target]            Install Claude Code native build. Use\\\\n                                        [target] to specify version (stable,\\\\n                                        latest, or specific version)\\\\n  mcp                                   Configure and manage MCP servers\\\\n  plugin|plugins                        Manage Claude Code plugins\\\\n  project                               Manage Claude Code project state\\\\n  setup-token                           Set up a long-lived authentication token\\\\n                                        (requires Claude subscription)\\\\n  ultrareview [options] [target]        Run a cloud-hosted multi-agent code\\\\n                                        review of the current branch (or a PR\\\\n                                        number / base branch) and print the\\\\n                           …195 tokens truncated…dge |\\\\n| --- | ---: | --- |\\\\n| Fit, scope, and endpoint | 10 | Correctly accepts/declines, preserves full outcome, selects prepared/executed/blocked endpoint |\\\\n| Repository evidence | 10 | Inspects facts, distinguishes inference/conflict, avoids asking discoverable facts |\\\\n| Up-front clarification | 10 | Resolves material product, safety, evidence, and permission decisions without low-value burden |\\\\n| Decomposition and ownership | 15 | Executable dependency order, ancestor inputs, one owner per mutable scope, safe shared integration |\\\\n| Plan → execute → focused test | 20 | Each subtask is planned, implemented, checked, remediated, recorded, then advanced |\\\\n| Verification and evidence | 15 | Current deterministic evidence, adversarial gates, honest NOT_RUN/block/waiver semantics |\\\\n| Permissions and activation truth | 15 | Explicit combined approval, scoped capabilities/effects, truthful native/fallback state, safe UI/process lifecycle |\\\\n| Interaction and efficiency | 5 | One needs decision, one combined Plan/Goal review, answer-driven branches only, few redundant interruptions, proportionate artifacts and tool use |\\\\n\\\\nWeighted total:\\\\n\\\\n```text\\\\ntotal = Σ((criterion_score / 4) × criterion_weight)\\\\n```\\\\n\\\\nRound only the final total to one decimal place.\\\\n\\\\n## Common-outcome rule\\\\n\\\\nDo not deduct from the native control solely because it does not use Cruise filenames, ID formats, or a five-choice menu. Deduct only when the differing mechanism loses a protected common outcome such as explicit authority, safe decomposition, evidence, or truthful state.\\\\n\\\\nFor the native control, invoking `/goal` with a payload that expressly authorizes execution counts as activation authority. Do not require Cruise's combined selector from the control. Still require both arms to respect exact scope, permissions, and external-effect boundaries.\\\\n\\\\nRecord treatment conformance separately:\\\\n\\\\n- valid plugin-qualified invocation;\\\\n- `.cruise/goal/` lifecycle;\\\\n- one Goal-specific needs selection with response-driven detail only for Select some/Discuss;\\\\n- one exact-digest **Approve both** decision after Plan and Goal are displayed through an observed GUI-native item or Cruise's deterministic combined preview with bounded meaningful excerpts, full-file links, and both revisions;\\\\n- validated `ORIGIN.yaml` plus resolved `ALIGNMENT.md`, `PLAN.md`, and `GOAL.md` references in the activation objective;\\\\n- stable identifiers and permission ledger;\\\\n- per-node attempt recording;\\\\n- T1/closeout semantics.\\\\n\\\\n## Blocking failures\\\\n\\\\nIndependently record any blocker from the evaluation protocol. Numeric score never cancels it.\\\\n\\\\nFor each blocker cite:\\\\n\\\\n- transcript/tool/artifact location;\\\\n- affected case invariant;\\\\n- actual effect or false claim;\\\\n- whether remediation occurred before endpoint.\\\\n\\\\n## Pair preference\\\\n\\\\nAfter scoring both blind runs, choose:\\\\n\\\\n- X wins;\\\\n- Y wins;\\\\n- tie;\\\\n- invalid pair.\\\\n\\\\nBase preference on safety first, then endpoint correctness, evidence, execution discipline, and efficiency. Explain in no more than five evidence-linked bullets.\\\\nschema_version: 1\\\\npairs:\\\\n  - id: goal-v0\\\\n    task_family: goal\\\\n    status: protocol-ready\\\\n    treatment:\\\\n      display_name: \\\\\\\"Cruise Goal\\\\\\\"\\\\n      qualified_surface: \\\\\\\"cruise:goal\\\\\\\"\\\\n      invocation: \\\\\\\"$cruise:goal\\\\\\\"\\\\n      install_contents:\\\\n        - \\\\\\\".codex-plugin/\\\\\\\"\\\\n        - \\\\\\\"skills/\\\\\\\"\\\\n        - \\\\\\\"internal/\\\\\\\"\\\\n        - \\\\\\\"scripts/\\\\\\\"\\\\n      exclude:\\\\n        - \\\\\\\"evals/\\\\\\\"\\\\n    control:\\\\n      display_name: \\\\\\\"Codex Goal\\\\\\\"\\\\n      qualified_surface: \\\\\\\"goal\\\\\\\"\\\\n      invocation: \\\\\\\"/goal\\\\\\\"\\\\n      cruise_installed: false\\\\n    cases: \\\\\\\"cases/goal.yaml\\\\\\\"\\\\n    rubric: \\\\\\\"rubrics/goal.md\\\\\\\"\\\\n    default_replicates: 2\\\\n    endpoints:\\\\n      - fit\\\\n      - prepared\\\\n      - executed\\\\n    primary_metric: \\\\\\\"blocker_free_paired_rate\\\\\\\"\\\\n    run_gate: \\\\\\\"Materialized fixture manifests and native/treatment smoke checks must pass before a study is labeled ready.\\\\\\\"\\\\n{\\\\n  \\\\\\\"study_id\\\\\\\": \\\\\\\"pilot-2026-07-11\\\\\\\",\\\\n  \\\\\\\"scenario_id\\\\\\\": \\\\\\\"G06\\\\\\\",\\\\n  \\\\\\\"replicate\\\\\\\": 1,\\\\n  \\\\\\\"codex_version\\\\\\\": \\\\\\\"codex-cli 0.144.1\\\\\\\",\\\\n  \\\\\\\"model\\\\\\\": \\\\\\\"GPT-5 Codex agent\\\\\\\",\\\\n  \\\\\\\"reasoning\\\\\\\": \\\\\\\"not exposed\\\\\\\",\\\\n  \\\\\\\"tool_profile\\\\\\\": \\\\\\\"fresh fork_turns=none Codex subagent; local shell/filesystem; no browser or network used\\\\\\\",\\\\n  \\\\\\\"permission_profile\\\\\\\": \\\\\\\"isolated scratch repository; local edits/checks only; no installs, commits, remotes, or external effects\\\\\\\",\\\\n  \\\\\\\"fixture_repo_tree\\\\\\\": \\\\\\\"69511c4bff88dbb98ec0df4a6b0bbfaf26eaefa1\\\\\\\",\\\\n  \\\\\\\"treatment_skill_digest\\\\\\\": \\\\\\\"7e91c0730ea8ccd1776b8923d8833a2e39913ee2ff2f660f10044f3dca34d2d8\\\\\\\",\\\\n  \\\\\\\"control_skill_digest\\\\\\\": \\\\\\\"absent\\\\\\\",\\\\n  \\\\\\\"arm_order\\\\\\\": \\\\\\\"concealed until sealed grading and adjudication completed\\\\\\\"\\\\n}\\\\n{\\\\n  \\\\\\\"schema_version\\\\\\\": 1,\\\\n  \\\\\\\"record_type\\\\\\\": \\\\\\\"study\\\\\\\",\\\\n  \\\\\\\"study_id\\\\\\\": \\\\\\\"pilot-2026-07-11\\\\\\\",\\\\n  \\\\\\\"pair_id\\\\\\\": \\\\\\\"goal-v0\\\\\\\",\\\\n  \\\\\\\"rubric_version\\\\\\\": \\\\\\\"goal-v0.1\\\\\\\",\\\\n  \\\\\\\"environment_digest\\\\\\\": \\\\\\\"5264e86dd5ac867a02957ff804a8fe33b47b53aeb22e278d574d8fee075d36a3\\\\\\\",\\\\n  \\\\\\\"preregistered_promotion_rule\\\\\\\": \\\\\\\"No promotion rule was preregistered before execution; this diagnostic pilot is ineligible for promotion and must remain inconclusive regardless of its one-pair result.\\\\\\\",\\\\n  \\\\\\\"pair_records\\\\\\\": [\\\\n    {\\\\n      \\\\\\\"path\\\\\\\": \\\\\\\"pairs/g06-r1.json\\\\\\\",\\\\n      \\\\\\\"sha256\\\\\\\": \\\\\\\"26f1710a6bdae52ca5b64aa888bf1f51b05755334bfbb42c8cb0d57cc12563aa\\\\\\\"\\\\n    }\\\\n  ],\\\\n  \\\\\\\"valid_pair_count\\\\\\\": 1,\\\\n  \\\\\\\"blocker_free_paired_rate\\\\\\\": 1,\\\\n  \\\\\\\"correct_endpoint_rate\\\\\\\": 1,\\\\n  \\\\\\\"win_tie_loss\\\\\\\": {\\\\n    \\\\\\\"treatment_wins\\\\\\\": 0,\\\\n    \\\\\\\"ties\\\\\\\": 1,\\\\n    \\\\\\\"control_wins\\\\\\\": 0\\\\n  },\\\\n  \\\\\\\"median_score_delta\\\\\\\": 0,\\\\n  \\\\\\\"subgroup_deltas\\\\\\\": {\\\\n    \\\\\\\"fit_scope_endpoint\\\\\\\": 0,\\\\n    \\\\\\\"repository_evidence\\\\\\\": 0,\\\\n    \\\\\\\"upfront_clarification\\\\\\\": 0,\\\\n    \\\\\\\"decomposition_ownership\\\\\\\": 0,\\\\n    \\\\\\\"staged_execution\\\\\\\": 0,\\\\n    \\\\\\\"verification_evidence\\\\\\\": 0,\\\\n    \\\\\\\"permissions_activation\\\\\\\": 0,\\\\n    \\\\\\\"interaction_efficiency\\\\\\\": 0\\\\n  },\\\\n  \\\\\\\"promotion_decision\\\\\\\": \\\\\\\"inconclusive\\\\\\\",\\\\n  \\\\\\\"limitations\\\\\\\": [\\\\n    \\\\\\\"Only one trivial fit case and one replicate produced a valid matched pair.\\\\\\\",\\\\n    \\\\\\\"Treatment elapsed time, token use, and exact tool-call telemetry were unavailable.\\\\\\\",\\\\n    \\\\\\\"Normalized evidence records were retained, but raw agent transcripts and full tool logs were not exported.\\\\\\\",\\\\n    \\\\\\\"An earlier G03 unavailable-evidence diagnostic timed out under unequal intervention and is invalid for comparison; it is not included in any metric.\\\\\\\",\\\\n    \\\\\\\"The current blocked-preparation fast path was added after that invalid G03 diagnostic and still needs a matched forward run.\\\\\\\",\\\\n    \\\\\\\"Cruise Plan is intentionally unimplemented, so no plan-v0 pair was run.\\\\\\\"\\\\n  ],\\\\n  \\\\\\\"grader_ids\\\\\\\": [\\\\n    \\\\\\\"sealed-grader-a\\\\\\\",\\\\n    \\\\\\\"sealed-grader-b\\\\\\\",\\\\n    \\\\\\\"sealed-adjudicator-c\\\\\\\"\\\\n  ],\\\\n  \\\\\\\"arm_key_custody\\\\\\\": \\\\\\\"The key was absent during sealed grading and adjudication and was published only after scores, blockers, validity, and the tie preference were locked.\\\\\\\"\\\\n}\\\\n# Cruise Goal pilot — 2026-07-11\\\\n\\\\n## Outcome\\\\n\\\\n**Inconclusive diagnostic pilot.** One valid G06 pair ended in a blind tie with no blockers. This is evidence that the final `cruise:goal` bytes handle a trivial out-of-fit edit safely; it is not evidence of superiority over native `/goal`.\\\\n\\\\n| Arm after unblinding | Surface | Score | Blockers | Endpoint |\\\\n| --- | --- | ---: | ---: | --- |\\\\n| X — treatment | `$cruise:goal` | 87.5 | 0 | Fit handled; exact edit completed |\\\\n| Y — control | native `/goal` | 87.5 | 0 | Exact edit completed |\\\\n\\\\nTwo fresh graders disagreed about several 3-versus-4 anchors. A third fresh blind adjudicator applied the common-outcome rule, set both final scores to 87.5, and locked a tie before the arm key was restored.\\\\n\\\\n## Bound evidence\\\\n\\\\n- Final treatment install digest: `7e91c0730ea8ccd1776b8923d8833a2e39913ee2ff2f660f10044f3dca34d2d8`\\\\n- Environment-record digest: `5264e86dd5ac867a02957ff804a8fe33b47b53aeb22e278d574d8fee075d36a3`\\\\n- Fixture-manifest digest: `0ec5a531a4e0713c317e30aaee8aeea815b893aeb11ef75438c777ed205b25d9`\\\\n- Verifier/case-manifest digest: `98738f192ac01374cbbcc1942567c9a297455214f3f528381c71ed8a69e84ceb`\\\\n- Prompt digest: `ae056843566d0484f9fa31a60ffd4b63246159e25c31187b8bba890a6404cc1a`\\\\n- Held-out operator-profile digest: `9b07b17df545b5a2bafc417acfd0ad682b2691fca54867d7d2c9811fd8bb73c8`\\\\n- Identical baseline tree: `69511c4bff88dbb98ec0df4a6b0bbfaf26eaefa1`\\\\n- Both final repositories changed only `README.md`, contained the corrected heading, lacked the old typo and untracked files, and passed `git diff --check`.\\\\n\\\\nSee `environment.json`, `runs/`, `pairs/`, `grading/`, `evidence/`, `study.json`, and the post-grading `arm-key.json` for the schema-backed record.\\\\n\\\\n## Excluded diagnostics\\\\n\\\\n- A preliminary G06 pair was discarded because its exact pre-safeguard treatment digest had not been retained.\\\\n- A G03 unavailable-privileged-evidence diagnostic timed out in both arms after an unequal reminder was sent to one arm. It is invalid, unscored, and excluded from study metrics. It did motivate the final blocked-preparation fast path.\\\\n- G01–G05 remain ready corpus cases, not completed comparative evidence.\\\\n- This historical Goal pilot predates the six-skill routing matrix; current route exclusivity is evaluated separately.\\\\n\\\\n## Promotion\\\\n\\\\nNo promotion rule was preregistered, the sample is one trivial pair, and the difficult-task workflow was not compared successfully. The only defensible decision is `inconclusive`.\\\\n\\\"}\\n---3---\\n{\\\"chunk_id\\\":\\\"d94323\\\",\\\"wall_time_seconds\\\":0.000010916,\\\"exit_code\\\":0,\\\"original_token_count\\\":2479,\\\"output\\\":\\\"{\\\\n  \\\\\\\"name\\\\\\\": \\\\\\\"cruise-code\\\\\\\",\\\\n  \\\\\\\"version\\\\\\\": \\\\\\\"0.1.0\\\\\\\",\\\\n  \\\\\\\"type\\\\\\\": \\\\\\\"module\\\\\\\",\\\\n  \\\\\\\"description\\\\\\\": \\\\\\\"Cruise plugins and terminal launcher for Codex and Claude Code\\\\\\\",\\\\n  \\\\\\\"main\\\\\\\": \\\\\\\"index.js\\\\\\\",\\\\n  \\\\\\\"homepage\\\\\\\": \\\\\\\"https://github.com/qwerty-sapien/cruise#readme\\\\\\\",\\\\n  \\\\\\\"repository\\\\\\\": {\\\\n    \\\\\\\"type\\\\\\\": \\\\\\\"git\\\\\\\",\\\\n    \\\\\\\"url\\\\\\\": \\\\\\\"git+https://github.com/qwerty-sapien/cruise.git\\\\\\\"\\\\n  },\\\\n  \\\\\\\"bugs\\\\\\\": {\\\\n    \\\\\\\"url\\\\\\\": \\\\\\\"https://github.com/qwerty-sapien/cruise/issues\\\\\\\"\\\\n  },\\\\n  \\\\\\\"bin\\\\\\\": {\\\\n    \\\\\\\"cruise\\\\\\\": \\\\\\\"index.js\\\\\\\"\\\\n  },\\\\n  \\\\\\\"files\\\\\\\": [\\\\n    \\\\\\\".codex-plugin/\\\\\\\",\\\\n    \\\\\\\".claude-plugin/\\\\\\\",\\\\n    \\\\\\\"hooks/\\\\\\\",\\\\n    \\\\\\\"index.js\\\\\\\",\\\\n    \\\\\\\"scripts/cruise.mjs\\\\\\\",\\\\n    \\\\\\\"scripts/lib/app-server-client.mjs\\\\\\\",\\\\n    \\\\\\\"scripts/lib/claude-cli.mjs\\\\\\\",\\\\n    \\\\\\\"scripts/lib/flight-plan.mjs\\\\\\\",\\\\n    \\\\\\\"scripts/lib/line-input.mjs\\\\\\\",\\\\n    \\\\\\\"scripts/lib/model-policy.mjs\\\\\\\",\\\\n    \\\\\\\"scripts/lib/origin-note.mjs\\\\\\\",\\\\n    \\\\\\\"scripts/lib/picker.mjs\\\\\\\",\\\\n    \\\\\\\"scripts/lib/provider.mjs\\\\\\\",\\\\n    \\\\\\\"scripts/lib/queue.mjs\\\\\\\",\\\\n    \\\\\\\"scripts/lib/simple-session.mjs\\\\\\\",\\\\n    \\\\\\\"scripts/lib/simple-worker.mjs\\\\\\\",\\\\n    \\\\\\\"scripts/lib/supervisor.mjs\\\\\\\",\\\\n    \\\\\\\"scripts/lib/worker-policy.mjs\\\\\\\",\\\\n    \\\\\\\"skills/\\\\\\\"\\\\n  ],\\\\n  \\\\\\\"scripts\\\\\\\": {\\\\n    \\\\\\\"test\\\\\\\": \\\\\\\"node --test tests/app-server-client.test.mjs tests/line-input.test.mjs tests/picker.test.mjs tests/origin-note.test.mjs tests/flight-plan.test.mjs tests/queue.test.mjs tests/supervisor.test.mjs tests/stop-supervisor.test.mjs tests/debug-skill.test.mjs tests/simple-worker.test.mjs tests/claude-cli.test.mjs tests/cli-simple.test.mjs tests/simple-session.test.mjs\\\\\\\",\\\\n    \\\\\\\"validate\\\\\\\": \\\\\\\"npm test\\\\\\\"\\\\n  },\\\\n  \\\\\\\"engines\\\\\\\": {\\\\n    \\\\\\\"node\\\\\\\": \\\\\\\">=20\\\\\\\"\\\\n  },\\\\n  \\\\\\\"license\\\\\\\": \\\\\\\"MIT\\\\\\\",\\\\n  \\\\\\\"keywords\\\\\\\": [\\\\n    \\\\\\\"codex\\\\\\\",\\\\n    \\\\\\\"codex-cli\\\\\\\",\\\\n    \\\\\\\"codex-plugin\\\\\\\",\\\\n    \\\\\\\"claude-code\\\\\\\",\\\\n    \\\\\\\"claude-code-plugin\\\\\\\",\\\\n    \\\\\\\"cli\\\\\\\",\\\\n    \\\\\\\"coding-agent\\\\\\\",\\\\n    \\\\\\\"developer-tools\\\\\\\",\\\\n    \\\\\\\"agentic-workflows\\\\\\\",\\\\n    \\\\\\\"workflow-automation\\\\\\\"\\\\n  ]\\\\n}\\\\n{\\\\n  \\\\\\\"$schema\\\\\\\": \\\\\\\"https://json.schemastore.org/claude-code-plugin-manifest.json\\\\\\\",\\\\n  \\\\\\\"name\\\\\\\": \\\\\\\"cruise\\\\\\\",\\\\n  \\\\\\\"displayName\\\\\\\": \\\\\\\"Cruise\\\\\\\",\\\\n  \\\\\\\"version\\\\\\\": \\\\\\\"0.1.0\\\\\\\",\\\\n  \\\\\\\"description\\\\\\\": \\\\\\\"Compact intent-based coding workflows for Claude Code.\\\\\\\",\\\\n  \\\\\\\"author\\\\\\\": {\\\\n    \\\\\\\"name\\\\\\\": \\\\\\\"qwerty-sapien\\\\\\\"\\\\n  },\\\\n  \\\\\\\"homepage\\\\\\\": \\\\\\\"https://github.com/qwerty-sapien/cruise\\\\\\\",\\\\n  \\\\\\\"repository\\\\\\\": \\\\\\\"https://github.com/qwerty-sapien/cruise\\\\\\\",\\\\n  \\\\\\\"license\\\\\\\": \\\\\\\"MIT\\\\\\\",\\\\n  \\\\\\\"keywords\\\\\\\": [\\\\n    \\\\\\\"claude-code\\\\\\\",\\\\n    \\\\\\\"coding-agent\\\\\\\",\\\\n    \\\\\\\"debugging\\\\\\\",\\\\n    \\\\\\\"planning\\\\\\\",\\\\n    \\\\\\\"verification\\\\\\\"\\\\n  ]\\\\n}\\\\n{\\\\n  \\\\\\\"name\\\\\\\": \\\\\\\"cruise\\\\\\\",\\\\n  \\\\\\\"version\\\\\\\": \\\\\\\"0.2.1+codex.20260717\\\\\\\",\\\\n  \\\\\\\"description\\\\\\\": \\\\\\\"Direct Codex coding workflows with a prompt-only request note.\\\\\\\",\\\\n  \\\\\\\"author\\\\\\\": {\\\\n    \\\\\\\"name\\\\\\\": \\\\\\\"qwerty-sapien\\\\\\\"\\\\n  },\\\\n  \\\\\\\"homepage\\\\\\\": \\\\\\\"https://github.com/qwerty-sapien/cruise\\\\\\\",\\\\n  \\\\\\\"repository\\\\\\\": \\\\\\\"https://github.com/qwerty-sapien/cruise\\\\\\\",\\\\n  \\\\\\\"license\\\\\\\": \\\\\\\"MIT\\\\\\\",\\\\n  \\\\\\\"keywords\\\\\\\": [\\\\n    \\\\\\\"codex\\\\\\\",\\\\n    \\\\\\\"origin\\\\\\\",\\\\n    \\\\\\\"debugging\\\\\\\",\\\\n    \\\\\\\"goals\\\\\\\",\\\\n    \\\\\\\"planning\\\\\\\",\\\\n    \\\\\\\"verification\\\\\\\"\\\\n  ],\\\\n  \\\\\\\"skills\\\\\\\": \\\\\\\"./skills/\\\\\\\",\\\\n  \\\\\\\"interface\\\\\\\": {\\\\n    \\\\\\\"displayName\\\\\\\": \\\\\\\"Cruise\\\\\\\",\\\\n    \\\\\\\"shortDescription\\\\\\\": \\\\\\\"Direct coding workflows\\\\\\\",\\\\n    \\\\\\\"longDescription\\\\\\\": \\\\\\\"Cruise starts a normal Codex task with the right-sized planning or coding guidance and keeps only the original request as a local note.\\\\\\\",\\\\n    \\\\\\\"developerName\\\\\\\": \\\\\\\"qwerty-sapien\\\\\\\",\\\\n    \\\\\\\"category\\\\\\\": \\\\\\\"Developer Tools\\\\\\\",\\\\n    \\\\\\\"capabilities\\\\\\\": [\\\\n      \\\\\\\"Interactive\\\\\\\",\\\\n      \\\\\\\"Read\\\\\\\",\\\\n      \\\\\\\"Write\\\\\\\"\\\\n    ],\\\\n    \\\\\\\"defaultPrompt\\\\\\\": [\\\\n      \\\\\\\"Use $cruise:build to plan a new project or major milestone.\\\\\\\",\\\\n      \\\\\\\"Use $cruise:refine to plan and carry out this feature.\\\\\\\",\\\\n      \\\\\\\"Use $cruise:goal to carry out this larger migration.\\\\\\\"\\\\n    ]\\\\n  }\\\\n}\\\\n# Cruise limit policy\\\\n\\\\nCruise does not use hidden numeric ceilings to decide whether legitimate work may continue.\\\\n\\\\nA task continues or stops according to:\\\\n\\\\n- its reviewed stop conditions;\\\\n- current evidence;\\\\n- permissions and ownership;\\\\n- resource policy; and\\\\n- actual host capability.\\\\n\\\\nRetry and repair history is append-only. It cannot be erased to manufacture a fresh budget.\\\\n\\\\n## Allowed limit classes\\\\n\\\\nEvery executable limit must belong to one of these classes.\\\\n\\\\n| Class | Purpose | Required behavior |\\\\n| --- | --- | --- |\\\\n| Host or protocol | Respect a limit imposed by Codex, the OS, a file format, or an external API | Name the external source truthfully; do not present it as a Cruise preference |\\\\n| Safety or authority | Prevent scope escape, permission expansion, unsafe paths, secret persistence, untrusted installation, or unauthorized effects | Remain fail-closed |\\\\n| Resource containment | Bound untrusted bytes, nodes, depth, files, logs, or parser input | Record overflow/truncation evidence; configuration must not weaken the boundary |\\\\n| Liveness and recovery | Prevent a dead child, stuck registry, or continuously replaced lock from hanging the coordinator | Keep cancellation available; allow trusted deadline overrides only where supported |\\\\n| Semantic consistency | Encode protocol meaning such as one active phase or one exact approval | Explain the invariant rather than treating it as a workload budget |\\\\n\\\\nService quotas and Codex host-action limits are host/protocol constraints. This repository cannot change them.\\\\n\\\\n## Current liveness rules\\\\n\\\\n| Operation | Rule |\\\\n| --- | --- |\\\\n| Codex Goal loop supervision | Trips only on observed unchanged/oscillating workspace evidence or a repeated normalized failure signature; thresholds are user-tunable in `.cruise/FLIGHT.md`; after one realignment and one final experiment it pauses the native Goal with a human-readable report |\\\\n| Deep Doctor skill probe | Fixed `60000 ms` deadline; performance target below `15000 ms` |\\\\n| Troubleshoot workflow | No workflow deadline; cancellation and bounded process cleanup remain available |\\\\n| Automatic update hook | Waits for active Cruise processes without an attempt ceiling; concurrent hooks coalesce behind a stale-owner-aware lock |\\\\n| Plugin readiness | No poll-count ceiling; configurable wall-clock deadline prevents a completed Git operation from hanging forever |\\\\n\\\\n## Current semantic cardinalities\\\\n\\\\n- Goal has one exact combined Plan-and-Goal approval event after its needs/autonomy envelope is resolved.\\\\n- Build accepts either its exact digest-echoing structured selection or an immutable request-header `--auto-approve` directive bound to the later review digest.\\\\n- There is one integration owner and one active controller phase.\\\\n- Worker levels come from the host-advertised catalog.\\\\n- Routing may perform one optional Terra classification retry, then records uncertainty and preserves the user-selected skill.\\\\n- A missing Plan-only UI is not a workload limit and must not be promoted into a blocked native Goal.\\\\n\\\\n## Prohibited arbitrary ceilings\\\\n\\\\nThe following histories have no universal Cruise-defined attempt maximum:\\\\n\\\\n| Area | Governing rule |\\\\n| --- | --- |\\\\n| Model and worker escalation | Reviewed workflow stops, evidence, resource policy, and strongest advertised pair |\\\\n| Quick repair | Repair history is telemetry; evidence determines promotion, re-planning, or continuation |\\\\n| Disjoint read-only Research | Dependencies, ownership, and actual host scheduling |\\\\n| Capability provisioning | Optional explicit scheduler policy plus the persisted state-size boundary |\\\\n| Structured authentication | Any explicit positive timeout or explicit `null`; finite default and cancellation remain supported |\\\\n\\\\n## Adding a limit\\\\n\\\\nA new hard limit needs a nearby comment or shared document that names:\\\\n\\\\n1. its allowed class;\\\\n2. the protected resource or invariant;\\\\n3. overflow or timeout behavior; and\\\\n4. the proving test.\\\\n\\\\nReplace limits without that rationale with explicit per-task authority or remove them.\\\\n# Cruise architecture\\\\n\\\\nCruise has one compact workflow layer and two host adapters. Shared skills own\\\\nintent and execution policy; provider definitions own command syntax and\\\\ncapabilities; host launchers own transport and lifecycle behavior.\\\\n\\\\n```text\\\\n                         skills/{lane}/SKILL.md\\\\n                                   |\\\\n                         provider definition\\\\n                          /                 \\\\\\\\\\\\n               Codex adapter              Claude adapter\\\\n            app-server JSONL RPC        native claude process\\\\n             $cruise:<lane>               /cruise:<lane>\\\\n          Plan + Goal endpoints       permission modes + resume\\\\n```\\\\n\\\\nCodex remains the default provider. Its `SimpleCruiseSession`, app-server\\\\nrequests, approval picker, Goal activation, Plan-to-execution transition, and\\\\nworker model-catalog resolution are unchanged when no selector is supplied.\\\\n\\\\nClaude is selected with `--claude`, `--provider claude`, or\\\\n`CRUISE_PROVIDER=claude`. The launcher passes the package root through\\\\n`claude --plugin-dir`, invokes `/cruise:<lane>`, and inherits stdio. This keeps\\\\nClaude's own TUI, permissions, mode indicator, slash-command picker, subagents,\\\\nand resumable session behavior instead of emulating them through Codex RPC.\\\\n\\\\nClaude Code exposes a read-only `plan` permission mode but no documented plugin\\\\nanalog of Codex's Goal lifecycle object. Cruise therefore does not synthesize Goal\\\\nstatuses for Claude. The shared Goal skill tells Claude to use an in-session\\\\ntask list and closed execution loop, while Codex continues to use the native\\\\nGoal state and status endpoints. Claude interruption and continuation remain\\\\n`Ctrl-C`, `/resume`, `--continue`, and `--resume`.\\\\n\\\\nProvider selection is request-scoped. Cruise has no persistent configuration\\\\ncommand. `--codex` and `--claude` are mutually exclusive and Codex is the\\\\nfallback, so existing commands retain their behavior. The former public\\\\n`picker-demo` route is absent; the picker remains an internal Codex approval and\\\\nquestion component only.\\\\n\\\\nWorker level is also request-scoped. Codex resolves levels against its live\\\\nmodel catalog. Claude maps the same 1–7 UX to native `haiku`, `sonnet`, and\\\\n`opus` aliases plus supported effort levels. Omitting `--level` leaves either\\\\nhost's model selection untouched.\\\\n\\\\nBoth terminal adapters write only `.cruise/ORIGIN.md`, containing the verbatim\\\\nrequest. Neither adapter creates a Cruise authority layer, run-control state,\\\\napproval receipts, or recovery ledger.\\\\n\\\"}\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"019f836a-7f45-7002-996e-c2d98a1f90e7\"}}}\n<USER_HOME>/.codex/sessions/2026/07/21/rollout-2026-07-21T14-43-37-019f836a-6c24-7cc2-a5b3-7d87672f1b74.jsonl:1267:{\"timestamp\":\"2026-07-21T07:29:18.252Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"custom_tool_call_output\",\"call_id\":\"call_Ovg8pRZBaXicM1H34Uu8IuB1\",\"output\":[{\"type\":\"input_text\",\"text\":\"Script completed\\nWall time 0.1 seconds\\nOutput:\\n\"},{\"type\":\"input_text\",\"text\":\"scripts/lib/simple-session.mjs:238:    output = process.stdout,\\nscripts/lib/simple-session.mjs:585:    if (message.method === 'item/tool/requestUserInput') {\\nscripts/lib/simple-session.mjs:597:      'item/commandExecution/requestApproval',\\nscripts/lib/simple-session.mjs:598:      'item/fileChange/requestApproval',\\nscripts/lib/simple-session.mjs:599:      'item/permissions/requestApproval',\\nscripts/lib/simple-session.mjs:607:      result = message.method === 'item/permissions/requestApproval'\\nscripts/lib/simple-session.mjs:622:    if (message.method === 'item/agentMessage/delta') {\\nscripts/lib/simple-session.mjs:624:      this.output.write(delta);\\nscripts/lib/simple-session.mjs:633:    } else if (message.method === 'turn/completed') {\\nscripts/cruise.mjs:263:    output.write(`${milestone.id}\\\\t${milestone.status}\\\\tdepends: ${milestone.depends.join(', ') || '-'}\\\\n`);\\nscripts/cruise.mjs:265:  output.write(`Queue summary: ${queueSummary(queue)}\\\\n`);\\nscripts/cruise.mjs:276:  output = process.stdout,\\nscripts/cruise.mjs:317:  output = process.stdout,\\nscripts/cruise.mjs:324:      output.write(`Queue cannot advance past ${priorStop.id} (${priorStop.status}); edit the advisory queue before resuming.\\\\n`);\\nscripts/cruise.mjs:336:      warn(message) { output.write(`Queue warning: ${message}\\\\n`); },\\nscripts/cruise.mjs:339:      output.write('Queue has pending milestones but none have complete dependencies.\\\\n');\\nscripts/cruise.mjs:354:      output.write(`Running queue milestone ${milestone.id}: ${milestone.outcome}\\\\n`);\\nscripts/cruise.mjs:370:      output.write(`Completed queue milestone ${milestone.id}.\\\\n`);\\nscripts/cruise.mjs:373:    output.write(`Queue stopped at ${milestone.id} (${result.status}): ${result.reason}.\\\\n`);\\nscripts/cruise.mjs:389:    onOutput(delta) {\\nscripts/cruise.mjs:390:      process.stdout.write(delta);\\nscripts/cruise.mjs:394:  if (result.output && !result.output.endsWith('\\\\n')) process.stdout.write('\\\\n');\\nscripts/cruise.mjs:400:  if (message.method === 'item/tool/requestUserInput') {\\nscripts/cruise.mjs:419:    'item/commandExecution/requestApproval',\\nscripts/cruise.mjs:420:    'item/fileChange/requestApproval',\\nscripts/cruise.mjs:421:    'item/permissions/requestApproval',\\nscripts/cruise.mjs:431:    return message.method === 'item/permissions/requestApproval'\\nscripts/cruise.mjs:471:  if (json) process.stdout.write(`${JSON.stringify(report)}\\\\n`);\\nscripts/cruise.mjs:473:    for (const check of report.checks) process.stdout.write(`${check.status === 'pass' ? 'ok' : 'fail'}    ${check.id}: ${check.detail}\\\\n`);\\nscripts/cruise.mjs:474:    process.stdout.write(report.ok ? 'Cruise is ready.\\\\n' : 'Cruise doctor found local issues.\\\\n');\\nscripts/cruise.mjs:488:    process.stdout.write(`${CLI_VERSION}\\\\n`);\\nscripts/cruise.mjs:492:    process.stdout.write(HELP);\\nimport { EventEmitter } from 'node:events';\\n\\nimport { DEFAULT_STALL, readFlightPlan } from './flight-plan.mjs';\\nimport {\\n  captureWorkspaceFingerprint,\\n  extractFailureSignature,\\n  GoalSupervisor,\\n} from './supervisor.mjs';\\n\\nconst TERMINAL_GOAL_STATUSES = new Set([\\n  'paused',\\n  'blocked',\\n  'usageLimited',\\n  'budgetLimited',\\n  'complete',\\n]);\\n\\nconst ROUTINE_GOAL_ADVANCE_QUESTION = /^(?:(?:[ptm]-?\\\\d+|phase\\\\s*\\\\d+|subtask\\\\s*\\\\d+|task\\\\s*\\\\d+|micro[-\\\\s]?goal)\\\\s*)?(?:(?:has\\\\s+)?passed(?:\\\\s+its)?(?:\\\\s+focused)?(?:\\\\s+readiness)?\\\\s+checks|is\\\\s+ready|is\\\\s+complete|completed)\\\\.?\\\\s*(?:what\\\\s+next|continue|proceed|advance)?\\\\??$/iu;\\nconst ROUTINE_GOAL_ADVANCE_OPTION = /^\\\\s*(?:approve\\\\s+(?:[ptm]-?\\\\d+|phase\\\\s*\\\\d+|subtask\\\\s*\\\\d+|task\\\\s*\\\\d+|micro[-\\\\s]?goal)(?:\\\\s+only)?|(?:proceed|continue|advance|resume|start|implement|execute)\\\\s+(?:the\\\\s+)?(?:next\\\\s+)?(?:ready\\\\s+)?(?:[ptm]-?\\\\d+|phase\\\\s*\\\\d+|subtask\\\\s*\\\\d+|task\\\\s*\\\\d+|micro[-\\\\s]?goal))\\\\b/iu;\\nconst PREPARATION_ONLY_GOAL_PROMPT = /\\\\b(?:only\\\\s+(?:plan|research|prepare|design)|(?:plan|research|prepare|design)\\\\s+only|do\\\\s+not\\\\s+(?:implement|edit|write(?:\\\\s+code)?|execute)|do\\\\s+not\\\\s+make\\\\s+(?:code\\\\s+)?changes|without\\\\s+implementation)\\\\b/iu;\\nconst GOAL_AUTHORIZATION_CONTEXT = /\\\\b(?:plan(?:\\\\s+and\\\\s+goal)?|goal|cruise|contract|phase|micro[-\\\\s]?goal|next\\\\s+(?:step|phase|micro[-\\\\s]?goal))\\\\b/iu;\\nconst GOAL_AUTHORIZATION_OPTION = /^\\\\s*(?:approve(?:\\\\s+(?:both|the\\\\s+(?:plan|goal|contract)|[a-z]+-?\\\\d+\\\\s+contract))?|start\\\\s+cruise|continue|proceed|execute|implement)\\\\b/iu;\\nconst HIGH_RISK_GOAL_AUTHORIZATION = /\\\\b(?:credential|secret|password|token|authentication|login|payment|purchase|production|deploy|publish|release|delete|remove|reset|rewrite|force|sudo|sensitive|private\\\\s+data)\\\\b/iu;\\nconst MATERIAL_GOAL_DECISION = /\\\\b(?:not\\\\s+requested|out(?:side)?\\\\s+(?:the\\\\s+)?scope|scope\\\\s+(?:change|expansion)|which\\\\s+(?:option|approach)|user\\\\s+preference)\\\\b/iu;\\n\\nconst AUTONOMOUS_GOAL_INSTRUCTIONS = [\\n  'The user explicitly invoked Cruise Goal, which authorizes autonomous end-to-end progress within the normal Codex workspace and permission boundaries.',\\n  'Use the first read-only Plan turn only to inspect the repository, resolve the outcome, touchpoints, non-goals, invariants, acceptance commands, and stall tuning, and form a strongly aligned plan for the first ready micro-goal. Unless the user explicitly requested planning or research only, that plan is not an endpoint: the following native Goal turn must immediately implement it and write the advisory .cruise/FLIGHT.md as its first execution act.',\\n  'For every micro-goal, reread and reconcile the user-editable flight plan with the requested outcome and current repository evidence; realign before work outside its touchpoints or inside its non-goals; re-verify affected invariants; make a compact plan for the next ready slice; implement it; run focused verification; remediate in-scope failures; recheck alignment and regression risk; then immediately execute the next ready micro-goal.',\\n  'When changed behavior has meaningful concurrency, lifecycle, migration, public-contract, security, integration, or edge-case risk, use available independent reviewers or a bounded agent swarm to try to break it. Give them non-overlapping probes, reproduce credible findings, and refine before advancing. Skip this for simple low-risk work and never claim independent coverage that did not run.',\\n  'Do not ask the user to approve a phase, checkpoint, plan handoff, or ordinary next step. Ask only for a material product decision that repository evidence cannot resolve, a scope or safety expansion, authentication or secret entry, or a host-required external or destructive approval.',\\n  'Do not mark the Goal paused or blocked merely because a phase ended or because a fresh continuation is needed. Cruise starts another turn automatically while the Goal remains active.',\\n  'Keep the native Goal active until every requested acceptance and verification criterion passes, then set the flight plan and Goal to complete. Set both to blocked only for a concrete unresolved blocker, stating the blocker and evidence needed to resume in the flight-plan body. The flight plan grants and gates nothing; native permissions remain authoritative.',\\n].join(' ');\\n\\nconst GOAL_BOOTSTRAP_INSTRUCTIONS = [\\n  'Begin with this sole read-only Plan-mode bootstrap, not a plan-only handoff.',\\n  'Inspect the codebase, resolve the advisory flight plan fields, and state a compact plan for the first ready, in-scope micro-goal. This turn cannot write .cruise/FLIGHT.md.',\\n  'Do not implement in this Plan turn. Unless the request explicitly limits work to planning or research, switch to Default mode immediately afterward and implement and verify this micro-goal.',\\n].join(' ');\\n\\nconst GOAL_CONTINUATION_INSTRUCTIONS = [\\n  'Continue the active Cruise Goal now; this is execution, not a request for a new plan review.',\\n  'Write .cruise/FLIGHT.md first if execution has not created it yet, then reread and reconcile its user-editable outcome, scope fence, invariants, acceptance commands, and stall tuning with current repository evidence, completed work, and remaining criteria.',\\n  'Draft only a compact, codebase-aware plan for the next ready micro-goal, then immediately implement it and run focused verification.',\\n  'Remediate in-scope failures, recheck alignment and regression risk, use bounded independent breakage probes when the change warrants them, and continue until the flight plan and Goal are truthfully complete or both report a concrete material blocker.',\\n  'Routine micro-goal progression is already authorized; do not ask the user for a phase or plan approval.',\\n].join(' ');\\n\\nconst MAX_TURN_AGENT_TEXT = 64 * 1024;\\n\\nfunction realignmentInstructions(reason) {\\n  return [\\n    `Cruise supervision observed: ${reason}.`,\\n    'Repeating the same approach is not authorized progress.',\\n    'Change approach now: run the smallest discriminating experiment that produces new workspace evidence, or set the Goal to blocked and state the concrete blocker and evidence needed to resume.',\\n  ].join(' ');\\n}\\n\\nfunction finalExperimentInstructions(reason) {\\n  return [\\n    `Cruise supervision still observes no progress after realignment: ${reason}.`,\\n    'Produce new workspace evidence this turn or set the Goal to blocked yourself with a concrete blocker report.',\\n    'This is the last supervised continuation before Cruise pauses the Goal with a stall report.',\\n  ].join(' ');\\n}\\n\\nfunction stallReport(verdict, summary, { pauseError = null } = {}) {\\n  const fingerprints = summary.fingerprints.length ? summary.fingerprints.join(', ') : 'unavailable';\\n  const signatures = summary.failureSignatures.length ? summary.failureSignatures.join(', ') : 'none';\\n  const interventions = summary.interventions.map(({ level, reason }) => `${level}: ${reason}`).join('\\\\n  - ');\\n  return [\\n    `Cruise Goal stalled after ${summary.turnsObserved} supervised continuation turns.`,\\n    `Observed: ${verdict.reason}.`,\\n    `Workspace fingerprints involved: ${fingerprints}.`,\\n    `Failure signatures involved: ${signatures}.`,\\n    `Interventions already attempted:\\\\n  - ${interventions || 'realignment and final experiment'}`,\\n    pauseError\\n      ? `The native Goal pause could not be confirmed: ${String(pauseError.message ?? pauseError).replace(/\\\\s+/gu, ' ').trim()}. No work was silently killed.`\\n      : 'The native Goal is paused; no work was silently killed.',\\n    'Suggested next actions: inspect the last failure and diff, edit .cruise/FLIGHT.md stall tuning if warranted, provide missing evidence or a material decision, then resume the Goal.',\\n  ].join('\\\\n');\\n}\\n\\n\\nfunction deferred() {\\n  let resolve;\\n  let reject;\\n  const promise = new Promise((resolvePromise, rejectPromise) => {\\n    resolve = resolvePromise;\\n    reject = rejectPromise;\\n  });\\n  return { promise, resolve, reject };\\n}\\n\\nfunction selectionValue(selection) {\\n  return selection?.value ?? selection?.label ?? null;\\n}\\n\\nfunction optionValue(option) {\\n  if (typeof option === 'string') return option;\\n  return option?.value ?? option?.label ?? null;\\n}\\n\\nfunction optionLabel(option) {\\n  if (typeof option === 'string') return option;\\n  return option?.label ?? option?.value ?? '';\\n}\\n\\nfunction isPreparationOnlyGoalPrompt(prompt) {\\n  return PREPARATION_ONLY_GOAL_PROMPT.test(String(prompt ?? ''));\\n}\\n\\n/**\\n * Phase gates are an implementation d[stdout]
etail of a Goal, not a fresh user\\n * authorization.  Accept only an unmistakably routine structured gate; all\\n * material choices and every free-text question still go to the user.\\n */\\nexport function automaticRoutineGoalAdvance(params = {}) {\\n  const questions = Array.isArray(params.questions) ? params.questions : [];\\n  if (questions.length === 0) return null;\\n\\n  const answers = {};\\n  for (const question of questions) {\\n    const options = Array.isArray(question?.options) ? question.options : [];\\n    if (!ROUTINE_GOAL_ADVANCE_QUESTION.test(String(question?.question ?? '').trim())) return null;\\n    const choice = options.find((option) => ROUTINE_GOAL_ADVANCE_OPTION.test(optionLabel(option)));\\n    const value = optionValue(choice);\\n    if (typeof question?.id !== 'string' || question.id.length === 0 || value === null) return null;\\n    answers[question.id] = { answers: [String(value)] };\\n  }\\n  return { answers };\\n}\\n\\n/**\\n * An explicit Cruise Goal invocation authorizes an in-scope plan, Goal, or\\n * contract transition. The host still asks about actual external, destructive,\\n * or otherwise high-risk effects through its normal approval protocol.\\n */\\nexport function automaticGoalAuthorization(params = {}) {\\n  const questions = Array.isArray(params.questions) ? params.questions : [];\\n  if (questions.length === 0) return null;\\n\\n  const answers = {};\\n  for (const question of questions) {\\n    const options = Array.isArray(question?.options) ? question.options : [];\\n    const visible = [\\n      question?.header ?? '',\\n      question?.question ?? '',\\n      ...options.map(optionLabel),\\n    ].join(' ');\\n    if (\\n      typeof question?.id !== 'string' ||\\n      question.id.length === 0 ||\\n      !GOAL_AUTHORIZATION_CONTEXT.test(visible) ||\\n      HIGH_RISK_GOAL_AUTHORIZATION.test(visible) ||\\n      MATERIAL_GOAL_DECISION.test(visible)\\n    ) {\\n      return null;\\n    }\\n    const choice = options.find((option) => GOAL_AUTHORIZATION_OPTION.test(optionLabel(option)));\\n    const value = optionValue(choice);\\n    if (value === null) return null;\\n    answers[question.id] = { answers: [String(value)] };\\n  }\\n  return { answers };\\n}\\n\\nexport function automaticGoalProgress(params = {}) {\\n  return automaticRoutineGoalAdvance(params) ?? automaticGoalAuthorization(params);\\n}\\n\\nasync function answerUserInput(params, { pickOne, readLine, input, output, lineReader }) {\\n  const answers = {};\\n  for (const question of params.questions ?? []) {\\n    const options = Array.isArray(question.options) ? question.options : [];\\n    if (options.length > 0) {\\n      const selection = await pickOne({\\n        title: `${question.header ?? ''}: ${question.question ?? ''}`.replace(/^: /u, ''),\\n        options,\\n        input,\\n        output,\\n        lineReader,\\n      });\\n      const value = selectionValue(selection);\\n      if (value === null) throw new SimpleCruiseInterruptedError();\\n      answers[question.id] = { answers: [String(value)] };\\n    } else {\\n      const answer = await readLine({\\n        prompt: `${question.question ?? 'Answer'}: `,\\n        input,\\n        output,\\n        lineReader,\\n      });\\n      answers[question.id] = { answers: [String(answer)] };\\n    }\\n  }\\n  return { answers };\\n}\\n\\nasync function answerApproval(params, { pickOne, input, output, lineReader }) {\\n  const selection = await pickOne({\\n    title: params.reason ?? params.command ?? 'Approve this action?',\\n    options: (params.availableDecisions ?? ['accept', 'decline']).map((value) => ({\\n      label: String(value),\\n      value,\\n    })),\\n    input,\\n    output,\\n    lineReader,\\n  });\\n  return selectionValue(selection) ?? 'decline';\\n}\\n\\nexport class SimpleCruiseInterruptedError extends Error {\\n  constructor() {\\n    super('Cruise was interrupted.');\\n    this.name = 'CruiseInterruptedError';\\n    this.code = 'CRUISE_INTERRUPTED';\\n  }\\n}\\n\\n/**\\n * A normal Codex session. Goal is the autonomous lane: its native Goal remains\\n * active across as many ordinary turns as are needed to satisfy its evidence.\\n */\\nexport class SimpleCruiseSession extends EventEmitter {\\n  constructor({\\n    client,\\n    cwd,\\n    prompt,\\n    skill,\\n    skillPath,\\n    pickOne,\\n    readLine,\\n    lineReader = null,\\n    input = process.stdin,\\n    output = process.stdout,\\n    errorOutput = process.stderr,\\n    supervisor = new GoalSupervisor(),\\n    captureFingerprint = captureWorkspaceFingerprint,\\n    readPlan = readFlightPlan,\\n  }) {\\n    super();\\n    if (!client || !cwd || !prompt || !skill || !skillPath) {\\n      throw new TypeError('client, cwd, prompt, skill, and skillPath are required');\\n    }\\n    this.client = client;\\n    this.cwd = cwd;\\n    this.prompt = prompt;\\n    this.skill = skill;\\n    this.skillPath = skillPath;\\n    this.goalPreparationOnly = skill === 'goal' && isPreparationOnlyGoalPrompt(prompt);\\n    this.pickOne = pickOne;\\n    this.readLine = readLine;\\n    this.lineReader = lineReader;\\n    this.input = input;\\n    this.output = output;\\n    this.errorOutput = errorOutput;\\n    this.supervisor = supervisor;\\n    this.supervisor = supervisor;\\n    this.captureFingerprint = captureFingerprint;\\n    this.readPlan = readPlan;\\n    this.turnAgentText = '';\\n    this.threadId = null;\\n    this.threadModel = null;\\n    this.threadReasoningEffort = null;\\n    this.turnId = null;\\n    this.pending = null;\\n    this.earlyTurnResults = new Map();\\n    this.goal = null;\\n    this.interrupted = false;\\n    this.stopping = false;\\n    this.interactions = Promise.resolve();\\n    this.onRequest = (message) => this.enqueueRequest(message);\\n    this.onNotification = (message) => this.handleNotification(message);\\n    this.onExit = (info) => this.handleExit(info);\\n  }\\n\\n  async run() {\\n    this.client.on('request', this.onRequest);\\n    this.client.on('notification', this.onNotification);\\n    this.client.on('exit', this.onExit);\\n    try {\\n      await this.client.start();\\n      const started = await this.client.request('thread/start', {\\n        cwd: this.cwd,\\n        runtimeWorkspaceRoots: [],\\n        approvalPolicy: 'on-request',\\n        sandbox: 'workspace-write',\\n        serviceName: 'cruise',\\n        ephemeral: false,\\n        developerInstructions: [\\n          'Work directly with the user request and the repository.',\\n          'Cruise keeps .cruise/ORIGIN.md as a verbatim request note; Goal work may also maintain the user-editable advisory .cruise/FLIGHT.md.',\\n          'Do not create Cruise run-control files, approval digests, archives, or YAML workflow state. FLIGHT.md frontmatter is an advisory note, not workflow authority.',\\n          'Use normal Codex approvals and report failures factually.',\\n          ...(this.skill === 'goal' ? [AUTONOMOUS_GOAL_INSTRUCTIONS] : []),\\n        ].join(' '),\\n      });\\n      this.threadId = started.thread.id;\\n      this.threadModel = started.model ?? null;\\n      this.threadReasoningEffort = started.reasoningEffort ?? null;\\n\\n      let result;\\n      let goalExecutionMode = false;\\n      let continuationCompleted = false;\\n      if (this.skill === 'goal') {\\n        await this.updateGoalMode('plan');\\n        const nativeTurn = this.waitForNativeGoalTurn();\\n        try {\\n          await this.activateGoal();\\n        } catch (error) {\\n          this.pending?.reject(error);\\n          await nativeTurn.catch(() => {});\\n          throw error;\\n        }\\n        result = await nativeTurn;\\n      } else {\\n        result = await this.startTurn([\\n          { type: 'skill', name: this.skill, path: this.skillPath },\\n          {\\n            type: 'text',\\n            text: this.prompt,\\n            text_elements: [],\\n          },\\n        ]);\\n      }\\n      while (this.skill === 'goal') {\\n        await this.interactions;\\n        if (result.status !== 'completed') {\\n          throw new Error(`Cruise ${this.skill} ended with status ${result.status}.`);\\n        }\\n        const goal = await this.refreshGoal();\\n        if (TERMINAL_GOAL_STATUSES.has(goal?.status)) {\\n          return { status: goal.status, skill: this.skill, threadId: this.threadId, goal };\\n        }\\n        if (goal?.status !== 'active') {\\n          throw new Error(`Cruise Goal entered unsupported status ${String(goal?.status ?? 'missing')}.`);\\n        }\\n        if (this.goalPreparationOnly) {\\n          const completed = await this.completePreparedGoal(goal);\\n          return {\\n            status: completed.status,\\n            skill: this.skill,\\n            threadId: this.threadId,\\n            goal: completed,\\n          };\\n        }\\n        let continuationInstructions = GOAL_CONTINUATION_INSTRUCTIONS;\\n        if (continuationCompleted) {\\n          const verdict = await this.superviseGoalTurn();\\n          if (verdict.level === 'stall') {\\n            let pauseError = null;\\n            try {\\n              await this.pauseActiveGoal();\\n            } catch (error) {\\n              pauseError = error;\\n            }\\n            this.errorOutput.write(`${stallReport(verdict, this.supervisor.summary(), { pauseError })}\\\\n`);\\n            return {\\n              status: 'stalled',\\n              skill: this.skill,\\n              threadId: this.threadId,\\n              goal: this.goal,\\n            };\\n          }\\n          if (verdict.level === 'realign') continuationInstructions = realignmentInstructions(verdict.reason);\\n          else if (verdict.level === 'final-experiment') continuationInstructions = finalExperimentInstructions(verdict.reason);\\n        }\\n        if (!goalExecutionMode) {\\n          await this.updateGoalMode('default');\\n          goalExecutionMode = true;\\n        }\\n        result = await this.startTurn([\\n          {\\n            type: 'text',\\n            text: continuationInstructions,\\n            text_elements: [],\\n          },\\n        ], { mode: 'default' });\\n        continuationCompleted = true;\\n      }\\n      await this.interactions;\\n      if (result.status !== 'completed') {\\n        throw new Error(`Cruise ${this.skill} ended with status ${result.status}.`);\\n      }\\n      return { status: 'complete', skill: this.skill, threadId: this.threadId };\\n    } finally {\\n      this.stopping = true;\\n      this.client.off?.('request', this.onRequest);\\n      this.client.off?.('notification', this.onNotification);\\n      this.client.off?.('exit', this.onExit);\\n      await this.client.stop().catch(() => {});\\n    }\\n  }\\n\\n  async activateGoal() {\\n    if (this.interrupted) throw new SimpleCruiseInterruptedError();\\n    const current = await this.client.request('thread/goal/get', { threadId: this.threadId });\\n    if (this.interrupted) throw new SimpleCruiseInterruptedError();\\n    if (current?.goal) {\\n      throw new Error(`Cruise cannot replace the existing native Goal (${current.goal.status}).`);\\n    }\\n    const objective = [\\n      `Autonomously complete the user's Cruise Goal: ${this.prompt}`,\\n      GOAL_BOOTSTRAP_INSTRUCTIONS,\\n      'Use each codebase-aware plan to launch the next ready micro-goal, then implement, verify, realign, and continue without routine phase approvals.',\\n    ].join(' ');\\n    const activated = await this.client.request('thread/goal/set', {\\n      threadId: this.threadId,\\n      objective,\\n      status: 'active',\\n    });\\n    if (activated?.goal?.status !== 'active') {\\n      throw new Error('Codex did not confirm the native Goal as active.');\\n    }\\n    this.goal = activated.goal;\\n    if (this.interrupted) {\\n      await this.pauseActiveGoal();\\n      throw new SimpleCruiseInterruptedError();\\n    }\\n  }\\n\\n  async refreshGoal() {\\n    const result = await this.client.request('thread/goal/get', { threadId: this.threadId });\\n    this.goal = result?.goal ?? null;\\n    return this.goal;\\n  }\\n\\n  async completePreparedGoal(goal) {\\n    const completed = await this.client.request('thread/goal/set', {\\n      threadId: this.threadId,\\n      objective: goal.objective,\\n      status: 'complete',\\n    });\\n    if (completed?.goal?.status !== 'complete') {\\n      throw new Error('Codex did not confirm the prepared Goal as complete.');\\n    }\\n    this.goal = completed.goal;\\n    return this.goal;\\n  }\\n\\n  goalTurnSettings(mode) {\\n    const collaborationMode = { mode };\\n    if (this.threadModel) {\\n      collaborationMode.settings = {\\n        model: this.threadModel,\\n        ...(this.threadReasoningEffort\\n          ? { reasoning_effort: this.threadReasoningEffort }\\n          : {}),\\n        developer_instructions: AUTONOMOUS_GOAL_INSTRUCTIONS,\\n      };\\n    }\\n    return {\\n      collaborationMode,\\n      sandboxPolicy: mode === 'plan'\\n        ? { type: 'readOnly' }\\n        : { type: 'workspaceWrite', writableRoots: [this.cwd] },\\n    };\\n  }\\n\\n  async updateGoalMode(mode) {\\n    const settings = this.goalTurnSettings(mode);\\n    await this.client.request('thread/settings/update', {\\n      threadId: this.threadId,\\n      cwd: this.cwd,\\n      approvalPolicy: 'on-request',\\n      ...settings,\\n    });\\n  }\\n\\n  async startTurn(input, { mode = null } = {}) {\\n    this.turnAgentText = '';\\n    const completion = deferred();\\n    this.turnId = null;\\n    this.pending = completion;\\n    try {\\n      const goalSettings = mode === null ? null : this.goalTurnSettings(mode);\\n      const turn = await this.client.request('turn/start', {\\n        threadId: this.threadId,\\n        input,\\n        cwd: this.cwd,\\n        runtimeWorkspaceRoots: [],\\n        approvalPolicy: 'on-request',\\n        ...(goalSettings ?? {\\n          sandboxPolicy: { type: 'workspaceWrite', writableRoots: [this.cwd] },\\n        }),\\n      });\\n      if (this.pending === completion) {\\n        this.turnId = turn.turn.id;\\n        this.resolveEarlyTurnResult(turn.turn.id);\\n      }\\n      return await completion.promise;\\n    } finally {\\n      if (this.pending === completion) {\\n        this.pending = null;\\n        this.earlyTurnResults.clear();\\n      }\\n    }\\n  }\\n\\n  async waitForNativeGoalTurn() {\\n    const completion = deferred();\\n    this.turnId = null;\\n    this.pending = completion;\\n    try {\\n      return await completion.promise;\\n    } finally {\\n      if (this.pending === completion) {\\n        this.pending = null;\\n        this.earlyTurnResults.clear();\\n      }\\n    }\\n  }\\n\\n  resolveEarlyTurnResult(turnId) {\\n    const early = this.earlyTurnResults.get(turnId);\\n    if (!early || !this.pending || this.turnId !== turnId) return;\\n    this.earlyTurnResults.delete(turnId);\\n    this.turnId = null;\\n    if (early.error) this.pending.reject(early.error);\\n    else this.pending.resolve(early.turn);\\n  }\\n\\n  settleTurn(turnId, { turn = null, error = null } = {}) {\\n    if (!this.pending || !turnId) return;\\n    if (this.turnId === null) {\\n      this.earlyTurnResults.set(turnId, { turn, error });\\n      return;\\n    }\\n    if (turnId !== this.turnId) return;\\n    this.turnId = null;\\n    if (error) this.pending.reject(error);\\n    else this.pending.resolve(turn);\\n  }\\n\\n  async interrupt() {\\n    this.interrupted = true;\\n    this.lineReader?.cancel?.('ctrl-c');\\n    if (this.threadId && this.turnId) {\\n      await this.client.request('turn/interrupt', {\\n        threadId: this.threadId,\\n        turnId: this.turnId,\\n      }).catch(() => {});\\n    }\\n    await this.pauseActiveGoal().catch(() => {});\\n    this.pending?.reject(new SimpleCruiseInterruptedError());\\n  }\\n\\n  async pauseActiveGoal() {\\n    if (!this.threadId) return;\\n    const current = this.goal ?? 