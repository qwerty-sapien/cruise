ing(candidate) && candidate.id === milestone.id);\\n    const base = isMapping(milestone.raw) ? milestone.raw : rawMatch ?? {};\\n    const normalized = normalizeMilestone({\\n      ...base,\\n      ...milestone,\\n      non_goals: milestone.nonGoals ?? milestone.non_goals ?? base.non_goals,\\n    }, index);\\n    const directExtras = Object.fromEntries(Object.entries(milestone).filter(([key]) => ![\\n      ...MILESTONE_KEYS,\\n      'nonGoals',\\n      'raw',\\n    ].includes(key)));\\n    const extras = {\\n      ...Object.fromEntries(Object.entries(base).filter(([key]) => !MILESTONE_KEYS.has(key))),\\n      ...directExtras,\\n    };\\n    return {\\n      id: normalized.id,\\n      status: normalized.status,\\n      outcome: normalized.outcome,\\n      verify: normalized.verify,\\n      depends: normalized.depends,\\n      touchpoints: normalized.touchpoints,\\n      non_goals: normalized.nonGoals,\\n      invariants: normalized.invariants,\\n      ...extras,\\n    };\\n  });\\n  const frontmatter = {\\n    version: queue.version ?? raw.version ?? 1,\\n    milestones,\\n    ...Object.fromEntries(Object.entries(raw).filter(([key]) => !QUEUE_KEYS.has(key))),\\n    ...Object.fromEntries(Object.entries(queue).filter(([key]) => ![\\n      'version',\\n      'milestones',\\n      'body',\\n      'raw',\\n    ].includes(key))),\\n  };\\n  const body = queue.body ?? '';\\n  return { normalized: normalizeQueue(frontmatter, body), frontmatter };\\n}\\n\\nexport async function readQueue(cwd) {\\n  try {\\n    return parseQueue(await readFile(join(cwd, QUEUE_FILE), 'utf8'));\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nexport async function writeQueue(cwd, queue) {\\n  const { normalized, frontmatter } = serializableQueue(queue);\\n  const directory = join(cwd, '.cruise');\\n  await mkdir(directory, { recursive: true, mode: 0o700 });\\n  const directoryMetadata = await lstat(directory);\\n  if (directoryMetadata.isSymbolicLink() || !directoryMetadata.isDirectory()) {\\n    throw new Error(`${directory} must be a directory.`);\\n  }\\n  const path = join(cwd, QUEUE_FILE);\\n  try {\\n    const existing = await lstat(path);\\n    if (existing.isSymbolicLink() || !existing.isFile()) throw new Error(`${path} must be a regular file.`);\\n  } catch (error) {\\n    if (error?.code !== 'ENOENT') throw error;\\n  }\\n  const text = `---\\\\n${serializeObject(frontmatter).join('\\\\n')}\\\\n---\\\\n${normalized.body}`;\\n  await writeFile(path, text, { encoding: 'utf8', mode: 0o600 });\\n  return normalized;\\n}\\n\\nfunction dependencyCycle(milestones) {\\n  const pending = new Map(milestones.filter(({ status }) => status === 'pending').map((item) => [item.id, item]));\\n  const visiting = new Set();\\n  const visited = new Set();\\n  const path = [];\\n  const visit = (id) => {\\n    if (visiting.has(id)) return [...path.slice(path.indexOf(id)), id];\\n    if (visited.has(id)) return null;\\n    visiting.add(id);\\n    path.push(id);\\n    for (const dependency of pending.get(id)?.depends ?? []) {\\n      if (!pending.has(dependency)) continue;\\n      const cycle = visit(dependency);\\n      if (cycle) return cycle;\\n    }\\n    path.pop();\\n    visiting.delete(id);\\n    visited.add(id);\\n    return null;\\n  };\\n  for (const id of pending.keys()) {\\n    const cycle = visit(id);\\n    if (cycle) return cycle;\\n  }\\n  return null;\\n}\\n\\nexport function nextReadyMilestone(queue, {\\n  warn = (message) => process.emitWarning(message, { code: 'CRUISE_QUEUE_CYCLE' }),\\n} = {}) {\\n  const milestones = Array.isArray(queue?.milestones) ? queue.milestones : [];\\n  const byId = new Map(milestones.map((milestone) => [milestone.id, milestone]));\\n  const ready = milestones.find((milestone) => (\\n    milestone.status === 'pending' &&\\n    milestone.depends.every((id) => byId.get(id)?.status === 'complete')\\n  ));\\n  if (ready) return ready;\\n  const cycle = dependencyCycle(milestones);\\n  if (cycle) warn(`Queue dependency cycle detected: ${cycle.join(' -> ')}`);\\n  return null;\\n}\\n\\nexport function milestoneToFlightPlan(milestone, queueBody = '') {\\n  const normalized = normalizeMilestone(milestone, 0);\\n  if (typeof queueBody !== 'string') throw new TypeError('queue body must be a string');\\n  const inherited = queueBody.trim()\\n    ? `\\\\n\\\\n## Inherited queue context\\\\n\\\\n${queueBody.trim()}`\\n    : '\\\\n\\\\n## Inherited queue context\\\\n\\\\nNo additional cross-milestone obligations were recorded.';\\n  return {\\n    version: 1,\\n    status: 'active',\\n    outcome: normalized.outcome,\\n    verify: normalized.verify,\\n    scope: {\\n      touchpoints: normalized.touchpoints,\\n      nonGoals: normalized.nonGoals,\\n    },\\n    invariants: normalized.invariants,\\n    body: `# Queue milestone ${normalized.id}\\\\n\\\\nCompiled from .cruise/QUEUE.md. Reconcile this milestone with the queue's cross-milestone compatibility obligations.${inherited}`,\\n  };\\n}\\nimport assert from 'node:assert/strict';\\nimport { mkdtemp, readFile, readdir, rm } from 'node:fs/promises';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport test from 'node:test';\\n\\nimport { parseArgs, runQueue, runQueueStatus } from '../scripts/cruise.mjs';\\nimport { readFlightPlan } from '../scripts/lib/flight-plan.mjs';\\n\\nimport {\\n  QUEUE_FILE,\\n  milestoneToFlightPlan,\\n  nextReadyMilestone,\\n  parseQueue,\\n  readQueue,\\n  writeQueue,\\n} from '../scripts/lib/queue.mjs';\\n\\nconst PINNED_QUEUE = `---\\nversion: 1\\nmilestones:\\n  - id: M1\\n    status: complete\\n    outcome: Establish the parser seam\\n    verify: [npm test]\\n    depends: []\\n    touchpoints: [src/parser/]\\n    non_goals: [\\\"No API redesign\\\"]\\n    invariants: [\\\"CLI flags unchanged\\\"]\\n    reviewer: optional\\n  - id: M2\\n    status: pending\\n    outcome: Migrate callers\\n    verify:\\n      - npm test\\n      - npm run integration\\n    depends: [M1]\\n    touchpoints:\\n      - src/callers/\\n    non_goals: []\\n    invariants:\\n      - CLI flags unchanged\\nowner: user-editable\\n---\\n# Queue\\n\\nKeep old and new parser results compatible between milestones.\\n`;\\n\\ntest('queue parse/write round-trips the pinned schema and unknown keys', async () => {\\n  const parsed = parseQueue(PINNED_QUEUE);\\n  assert.equal(parsed.version, 1);\\n  assert.equal(parsed.milestones.length, 2);\\n  assert.deepEqual(parsed.milestones[0], {\\n    id: 'M1',\\n    status: 'complete',\\n    outcome: 'Establish the parser seam',\\n    verify: ['npm test'],\\n    depends: [],\\n    touchpoints: ['src/parser/'],\\n    nonGoals: ['No API redesign'],\\n    invariants: ['CLI flags unchanged'],\\n  });\\n  assert.equal(parsed.raw.owner, 'user-editable');\\n  assert.equal(parsed.raw.milestones[0].reviewer, 'optional');\\n  assert.match(parsed.body, /results compatible/u);\\n\\n  const cwd = await mkdtemp(join(tmpdir(), 'cruise-queue-'));\\n  try {\\n    parsed.milestones[1].status = 'complete';\\n    await writeQueue(cwd, parsed);\\n    const roundTrip = await readQueue(cwd);\\n    assert.equal(roundTrip.milestones[1].status, 'complete');\\n    assert.equal(roundTrip.raw.owner, 'user-editable');\\n    assert.equal(roundTrip.raw.milestones[0].reviewer, 'optional');\\n    assert.match(await readFile(join(cwd, QUEUE_FILE), 'utf8'), /^---\\\\nversion: 1\\\\nmilestones:/u);\\n  } finally {\\n    await rm(cwd, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('nextReadyMilestone selects the first dependency-satisfied pending item', () => {\\n  const queue = parseQueue(PINNED_QUEUE);\\n  assert.equal(nextReadyMilestone(queue).id, 'M2');\\n  queue.milestones[0].status = 'pending';\\n  assert.equal(nextReadyMilestone(queue).id, 'M1');\\n  queue.milestones[0].status = 'blocked';\\n  assert.equal(nextReadyMilestone(queue), null);\\n});\\n\\ntest('dependency cycles produce no ready milestone and a concrete warning', () => {\\n  const warnings = [];\\n  const q