6\\t    depends: []\\n    27\\t    touchpoints: [src/parser/]\\n    28\\t    non_goals: [\\\"No API redesign\\\"]\\n    29\\t    invariants: [\\\"CLI flags unchanged\\\"]\\n    30\\t    reviewer: optional\\n    31\\t  - id: M2\\n    32\\t    status: pending\\n    33\\t    outcome: Migrate callers\\n    34\\t    verify:\\n    35\\t      - npm test\\n    36\\t      - npm run integration\\n    37\\t    depends: [M1]\\n    38\\t    touchpoints:\\n    39\\t      - src/callers/\\n    40\\t    non_goals: []\\n    41\\t    invariants:\\n    42\\t      - CLI flags unchanged\\n    43\\towner: user-editable\\n    44\\t---\\n    45\\t# Queue\\n    46\\t\\n    47\\tKeep old and new parser results compatible between milestones.\\n    48\\t`;\\n    49\\t\\n    50\\ttest('queue parse/write round-trips the pinned schema and unknown keys', async () => {\\n    51\\t  const parsed = parseQueue(PINNED_QUEUE);\\n    52\\t  assert.equal(parsed.version, 1);\\n    53\\t  assert.equal(parsed.milestones.length, 2);\\n    54\\t  assert.deepEqual(parsed.milestones[0], {\\n    55\\t    id: 'M1',\\n    56\\t    status: 'complete',\\n    57\\t    outcome: 'Establish the parser seam',\\n    58\\t    verify: ['npm test'],\\n    59\\t    depends: [],\\n    60\\t    touchpoints: ['src/parser/'],\\n    61\\t    nonGoals: ['No API redesign'],\\n    62\\t    invariants: ['CLI flags unchanged'],\\n    63\\t  });\\n    64\\t  assert.equal(parsed.raw.owner, 'user-editable');\\n    65\\t  assert.equal(parsed.raw.milestones[0].reviewer, 'optional');\\n    66\\t  assert.match(parsed.body, /results compatible/u);\\n    67\\t\\n    68\\t  const cwd = await mkdtemp(join(tmpdir(), 'cruise-queue-'));\\n    69\\t  try {\\n    70\\t    parsed.milestones[1].status = 'complete';\\n    71\\t    await writeQueue(cwd, parsed);\\n    72\\t    const roundTrip = await readQueue(cwd);\\n    73\\t    assert.equal(roundTrip.milestones[1].status, 'complete');\\n    74\\t    assert.equal(roundTrip.raw.owner, 'user-editable');\\n    75\\t    assert.equal(roundTrip.raw.milestones[0].reviewer, 'optional');\\n    76\\t    assert.match(await readFile(join(cwd, QUEUE_FILE), 'utf8'), /^---\\\\nversion: 1\\\\nmilestones:/u);\\n    77\\t  } finally {\\n    78\\t    await rm(cwd, { recursive: true, force: true });\\n    79\\t  }\\n    80\\t});\\n    81\\t\\n    82\\ttest('nextReadyMilestone selects the first dependency-satisfied pending item', () => {\\n    83\\t  const queue = parseQueue(PINNED_QUEUE);\\n    84\\t  assert.equal(nextReadyMilestone(queue).id, 'M2');\\n    85\\t  queue.milestones[0].status = 'pending';\\n    86\\t  assert.equal(nextReadyMilestone(queue).id, 'M1');\\n    87\\t  queue.milestones[0].status = 'blocked';\\n    88\\t  assert.equal(nextReadyMilestone(queue), null);\\n    89\\t});\\n    90\\t\\n    91\\ttest('dependency cycles produce no ready milestone and a concrete warning', () => {\\n    92\\t  const warnings = [];\\n    93\\t  const queue = {\\n    94\\t    milestones: [\\n    95\\t      { id: 'M1', status: 'pending', depends: ['M2'] },\\n    96\\t      { id: 'M2', status: 'pending', depends: ['M1'] },\\n    97\\t    ],\\n    98\\t  };\\n    99\\t  assert.equal(nextReadyMilestone(queue, { warn: (message) => warnings.push(message) }), null);\\n   100\\t  assert.deepEqual(warnings, ['Queue dependency cycle detected: M1 -> M2 -> M1']);\\n   101\\t});\\n   102\\t\\n   103\\ttest('milestoneToFlightPlan carries scope and verification plus inherited obligations', () => {\\n   104\\t  const milestone = parseQueue(PINNED_QUEUE).milestones[1];\\n   105\\t  assert.deepEqual(\\n   106\\t    milestoneToFlightPlan(milestone, '# Queue\\\\n\\\\nKeep parser results backward compatible.'),\\n   107\\t    {\\n   108\\t      version: 1,\\n   109\\t      status: 'active',\\n   110\\t      outcome: 'Migrate callers',\\n   111\\t      verify: ['npm test', 'npm run integration'],\\n   112\\t      scope: {\\n   113\\t        touchpoints: ['src/callers/'],\\n   114\\t        nonGoals: [],\\n   115\\t      },\\n   116\\t      invariants: ['CLI flags unchanged'],\\n   117\\t      body: '# Queue milestone M2\\\\n\\\\nCompiled from .cruise/QUEUE.md. Reconcile this milestone with the queue\\\\'s cross-milestone compatibility obligations.\\\\n\\\\n## Inherited queue context\\\\n\\\\n# Queue\\\\n\\\\nKeep parser results backward compatible.',\\n   118\\t    },\\n   119\\t  );\\n   120\\t});\\n   121\\t\\n   122\\ttest('queue parsing never throws and rejects malformed advisory data', () => {\\n   123\\t  const malformed = [\\n   124\\t    null,\\n   125\\t    '',\\n   126\\t    '---\\\\nmilestones: nope\\\\n---\\\\n',\\n   127\\t    '---\\\\nmilestones:\\\\n  - id: M1\\\\n    id: duplicate\\\\n---\\\\n',\\n   128\\t    '---\\\\nmilestones:\\\\n  - id: M1\\\\n    status: invented\\\\n---\\\\n',\\n   129\\t    '---\\\\nmilestones:\\\\n  - id: M1\\\\n    verify: npm test\\\\n---\\\\n',\\n   130\\t    `---\\\\n${'nested:\\\\n  nested:\\\\n'.repeat(20)}value: nope\\\\n---\\\\n`,\\n   131\\t  ];\\n   132\\t  for (const value of malformed) {\\n   133\\t    assert.doesNotThrow(() => parseQueue(value));\\n   134\\t    assert.equal(parseQueue(value), null);\\n   135\\t  }\\n   136\\t});\\n   137\\t\\n   138\\tfunction projectQueue() {\\n   139\\t  return {\\n   140\\t    version: 1,\\n   141\\t    milestones: [\\n   142\\t      {\\n   143\\t        id: 'M1',\\n   144\\t        status: 'pending',\\n   145\\t        outcome: 'Build the seam',\\n   146\\t        verify: ['npm test'],\\n   147\\t        depends: [],\\n   148\\t        touchpoints: ['src/seam/'],\\n   149\\t        nonGoals: ['No caller migration'],\\n   150\\t        invariants: ['Public API unchanged'],\\n   151\\t      },\\n   152\\t      {\\n   153\\t        id: 'M2',\\n   154\\t        status: 'pending',\\n   155\\t        outcome: 'Migrate callers',\\n   156\\t        verify: ['npm test'],\\n   157\\t        depends: ['M1'],\\n   158\\t        touchpoints: ['src/callers/'],\\n   159\\t        nonGoals: [],\\n   160\\t        invariants: ['Public API unchanged'],\\n   161\\t      },\\n   162\\t    ],\\n   163\\t    body: '# Queue\\\\n\\\\nKeep old and new implementations compatible.',\\n   164\\t  };\\n   165\\t}\\n   166\\t\\n   167\\ttest('queue CLI parsing and status output require an explicit queue action', async () => {\\n   168\\t  assert.equal(parseArgs(['--claude', 'queue', 'run', '-C', '/tmp'], { env: {} }).queueAction, 'run');\\n   169\\t  assert.equal(parseArgs(['queue', 'status'], { env: {} }).queueAction, 'status');\\n   170\\t  assert.throws(() => parseArgs(['queue'], { env: {} }), /requires status or run/u);\\n   171\\t  assert.throws(() => parseArgs(['queue', 'skip'], { env: {} }), /Unexpected queue argument/u);\\n   172\\t\\n   173\\t  const cwd = await mkdtemp(join(tmpdir(), 'cruise-queue-status-'));\\n   174\\t  try {\\n   175\\t    await writeQueue(cwd, projectQueue());\\n   176\\t    let output = '';\\n   177\\t    assert.equal(await runQueueStatus({ cwd }, { output: { write: (text) => { output += text; } } }), 0);\\n   178\\t    assert.match(output, /M1\\\\tpending\\\\tdepends: -/u);\\n   179\\t    assert.match(output, /M2\\\\tpending\\\\tdepends: M1/u);\\n   180\\t  } finally {\\n   181\\t    await rm(cwd, { recursive: true, force: true });\\n   182\\t  }\\n   183\\t});\\n   184\\t\\n   185\\ttest('queue run preserves mid-queue edits and stops honestly on a stalled milestone', async () => {\\n   186\\t  const cwd = await mkdtemp(join(tmpdir(), 'cruise-queue-run-stall-'));\\n   187\\t  try {\\n   188\\t    await writeQueue(cwd, projectQueue());\\n   189\\t    const calls = [];\\n   190\\t    let output = '';\\n   191\\t    const exitCode = await runQueue({ cwd, provider: 'codex' }, {\\n   192\\t      output: { write: (text) => { output += text; } },\\n   193\\t      async milestoneRunner(input) {\\n   194\\t        calls.push({ id: input.milestone.id, outcome: input.milestone.outcome, prompt: input.prompt });\\n   195\\t        const flight = await readFlightPlan(cwd);\\n   196\\t        assert.equal(flight.status, 'active');\\n   197\\t        assert.equal(flight.outcome, input.milestone.outcome);\\n   198\\t        if (input.milestone.id === 'M1') {\\n   199\\t          const edited = await readQueue(cwd);\\n   200\\t          edited.milestones[1].outcome = 'Migrate the edited callers';\\n   201\\t          edited.body += '\\\\n\\\\nPreserve the compatibility shim until M2 verifies.';\\n   202\\t          await writeQueue(cwd, edited);\\n   203\\t          return { status: 'complete' };\\n   204\\t        }\\n   205\\t        assert.equal(input.milestone.outcome, 'Migrate the edited callers');\\n   206\\t        assert.match(flight.body, /Preserve the compatibility shim/u);\\n   207\\t        return { status: 'stalled', reason: 'no new workspace evidence' };\\n   208\\t      },\\n   209\\t    });\\n   210\\t\\n   211\\t    assert.equal(exitCode, 3);\\n   212\\t    assert.deepEqual(calls.map(({ id }) => id), ['M1', 'M2']);\\n   213\\t    assert.match(calls[1].prompt, /Migrate the edited callers/u);\\n   214\\t    const queue = await readQueue(cwd);\\n   215\\t    assert.deepEqual(queue.milestones.map(({ status }) => status), ['complete', 'stalled']);\\n   216\\t    assert.match(output, /Completed queue milestone M1/u);\\n   217\\t    assert.match(output, /Queue stopped at M2 \\\\(stalled\\\\)/u);\\n   218\\t    assert.deepEqual((await readdir(join(cwd, '.cruise'))).sort(), ['FLIGHT.md', 'QUEUE.md']);\\n   219\\t  } finally {\\n   220\\t    await rm(cwd, { recursive: true, force: true });\\n   221\\t  }\\n   222\\t});\\n   223\\t\\n   224\\ttest('queue run records a blocked milestone and never advances past it', async () => {\\n   225\\t  const cwd = await mkdtemp(join(tmpdir(), 'cruise-queue-run-blocked-'));\\n   226\\t  try {\\n   227\\t    await writeQueue(cwd, projectQueue());\\n   228\\t    const calls = [];\\n   229\\t    const exitCode = await runQueue({ cwd, provider: 'claude' }, {\\n   230\\t      output: { write() {} },\\n   231\\t      async milestoneRunner({ milestone }) {\\n   232\\t        calls.push(milestone.id);\\n   233\\t        return { status: 'blocked', reason: 'material user decision required' };\\n   234\\t      },\\n   235\\t    });\\n   236\\t    assert.equal(exitCode, 2);\\n   237\\t    assert.deepEqual(calls, ['M1']);\\n   238\\t    assert.deepEqual((await readQueue(cwd)).milestones.map(({ status }) => status), ['blocked', 'pending']);\\n   239\\t  } finally {\\n   240\\t    await rm(cwd, { recursive: true, force: true });\\n   241\\t  }\\n   242\\t});\\n     1\\t---\\n     2\\tname: build\\n     3\\tdescription: \\\"Clarify a project with the user and compile it into an advisory queue of goal-sized milestones. Build plans; queue runs execute.\\\"\\n     4\\t---\\n     5\\t\\n     6\\t# Cruise Build\\n     7\\t\\n     8\\tBuild is the bowling setup for a whole project: clarify the vision once, inspect the repository, and decompose the work into a sequence of independently verifiable Goal runs. Do not implement the milestones in this conversation. Execution belongs to `cruise queue run` or an explicit Goal invocation.\\n     9\\t\\n    10\\tInspect the repository before asking questions. Ask only material questions whose answers change the decomposition: product intent, hard constraints, compatibility obligations, required migrations, and what must never break. Resolve ordinary implementation details from repository evidence. Do not demand approval phrases, plan digests, or ceremonial checkpoints.\\n    11\\t\\n    12\\tCompile the result into goal-sized milestones. Every milestone must have a one-line falsifiable outcome, its own verification commands, explicit likely touchpoints, explicit non-goals, protected invariants, and only real dependencies. A milestone should be independently completable; split work that cannot be verified without an unrelated later phase. Use non-goals to stop later concerns from bleeding into the current milestone.\\n    13\\t\\n    14\\tState cross-milestone reconciliation obligations once in the queue body. Include backward and forward compatibility, migration reversibility, coexistence windows, and cleanup conditions when they matter. Every generated flight plan inherits this body, so write obligations as constraints that remain meaningful throughout the queue.\\n    15\\t\\n    16\\tWrite the compiled plan to `.cruise/QUEUE.md` using the pinned version 1 schema: `milestones` with `id`, `status`, `outcome`, `verify`, `depends`, `touchpoints`, `non_goals`, and `invariants`, followed by a concise Markdown body explaining the vision, milestone rationale, compatibility obligations, and sequencing. New milestones start `pending`.\\n    17\\t\\n    18\\tPresent the queue plainly in the conversation so the user can reorder, split, combine, or edit it before execution. The queue is advisory and user-editable between runs. It grants nothing, gates nothing, and never replaces the selected host's permissions. It is not a contract, ledger, digest, archive, approval record, or per-milestone run directory.\\n    19\\t\\n    20\\tTreat worker-level and communication-manner preferences as natural-language instructions for this request only. Never persist or globally enforce them. Override the ordinary worker level only when the user explicitly asks for a higher, lower, or numbered level; an explicit terminal `cruise worker --level <1-7>` selection has highest priority for that invocation.\\ntests/cli-simple.test.mjs:13:  runOneGoal,\\ntests/cli-simple.test.mjs:33:    provider: 'codex',\\ntests/cli-simple.test.mjs:45:    provider: 'codex',\\ntests/cli-simple.test.mjs:62:test('provider selectors are request-scoped, mutually exclusive, and default to Codex', () => {\\ntests/cli-simple.test.mjs:63:  assert.equal(parseArgs(['quick', 'Fix'], { env: {} }).provider, 'codex');\\ntests/cli-simple.test.mjs:64:  assert.equal(parseArgs(['--claude', 'quick', 'Fix'], { env: {} }).provider, 'claude');\\n