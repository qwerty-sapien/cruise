@@ -10,6 +10,22 @@ class TextToolsTest(unittest.TestCase):
     def test_tag_key_preserves_public_shape(self):
         self.assertEqual(tag_key("  Hello   WORLD  "), "hello_world")
 
+    def test_slugify_handles_mixed_unicode_whitespace(self):
+        self.assertEqual(
+            slugify(" HELLO World FOO\tBar\n"), "hello-world-foo-bar"
+        )
+
+    def test_tag_key_handles_mixed_unicode_whitespace(self):
+        self.assertEqual(
+            tag_key(" HELLO World FOO\tBar\n"), "hello_world_foo_bar"
+        )
+
+    def test_slugify_handles_unicode_casing(self):
+        self.assertEqual(slugify("STRASSE Ä\tÖ Ü"), "strasse-ä-ö-ü")
+
+    def test_tag_key_handles_unicode_casing(self):
+        self.assertEqual(tag_key("STRASSE Ä\tÖ Ü"), "strasse_ä_ö_ü")
+
 
 if __name__ == "__main__":
     unittest.main()
