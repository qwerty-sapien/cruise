irectory() as directory:\n            path = Path(directory) / \"settings.json\"\n            save_settings(path, {\"theme\": \"dark\"})\n            self.assertEqual(\n                load_settings(path), {\"theme\": \"dark\", \"language\": \"en\"}\n            )\n            self.assertEqual(json.loads(path.read_text()), {\n                \"preferences\": {\"theme\": \"dark\", \"language\": \"en\"},\n                \"version\": 2,\n            })\n\n    def test_round_trips_language_preference(self):\n        with tempfile.TemporaryDirectory() as directory:\n            path = Path(directory) / \"settings.json\"\n            save_settings(path, {\"theme\": \"dark\", \"language\": \"fr\"})\n            self.assertEqual(\n                load_settings(path), {\"theme\": \"dark\", \"language\": \"fr\"}\n            )\n            self.assertEqual(json.loads(path.read_text()), {\n                \"preferences\": {\"theme\": \"dark\", \"language\": \"fr\"},\n                \"version\": 2,\n            })\n\n    def test_migrates_legacy_file_preserving_theme(self):\n        with tempfile.TemporaryDirectory() as directory:\n            path = Path(directory) / \"settings.json\"\n            path.write_text('{\"theme\":\"dark\"}', encoding=\"utf-8\")\n\n            settings = load_settings(path)\n            save_settings(path, settings)\n\n            self.assertEqual(json.loads(path.read_text()), {\n                \"preferences\": {\"theme\": \"dark\", \"language\": \"en\"},\n                \"version\": 2,\n            })\n            self.assertEqual(\n                load_settings(path), {\"theme\": \"dark\", \"language\": \"en\"}\n            )\n\n    def test_save_is_deterministic(self):\n        with tempfile.TemporaryDirectory() as directory:\n            path = Path(directory) / \"settings.json\"\n            save_settings(path, {\"theme\": \"dark\", \"language\": \"fr\"})\n            first = path.read_text()\n            save_settings(path, {\"theme\": \"dark\", \"language\": \"fr\"})\n            second = path.read_text()\n            self.assertEqual(first, second)"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1163,"cache_read_input_tokens":18276,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1163},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"44af392f-ee4d-4fd0-aec3-e1eaea6ba3e8","uuid":"e7ffed9c-4e5e-4783-bcfd-224ca9432fff","request_id":"req_011CdEs1Si855gwJBySXMJDm"}
