{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qwerty-sapien/cruise/blob/main/evals/result.schema.json",
  "title": "Cruise paired evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "study_id",
    "pair_id",
    "task_family",
    "rubric_version",
    "scenario_id",
    "endpoint",
    "validity",
    "outcome",
    "fixture_digest",
    "verifier_digest",
    "prompt_digest",
    "operator_profile_digest",
    "replicate",
    "run_id",
    "blind_arm",
    "authority_model",
    "environment",
    "transcript",
    "artifacts",
    "checks",
    "metrics",
    "rubric_scores",
    "treatment_conformance",
    "blocking_failures",
    "total_score",
    "grader_ids",
    "arm_key_custody"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "run"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "pair_id": {
      "type": "string",
      "minLength": 1
    },
    "task_family": {
      "enum": [
        "goal",
        "plan"
      ]
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "enum": [
        "fit",
        "prepared",
        "executed"
      ]
    },
    "validity": {
      "enum": [
        "valid",
        "invalid"
      ]
    },
    "outcome": {
      "enum": [
        "fit_declined",
        "fit_handled",
        "prepared_inactive",
        "completed",
        "correctly_blocked",
        "failed",
        "timeout",
        "infrastructure_invalid"
      ]
    },
    "fixture_digest": {
      "$ref": "#/$defs/digest"
    },
    "verifier_digest": {
      "$ref": "#/$defs/digest"
    },
    "prompt_digest": {
      "$ref": "#/$defs/digest"
    },
    "operator_profile_digest": {
      "$ref": "#/$defs/digest",
      "description": "SHA-256 of the held-out operator policy serialized as canonical JSON with sorted keys and compact separators."
    },
    "replicate": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "blind_arm": {
      "enum": [
        "X",
        "Y"
      ]
    },
    "authority_model": {
      "enum": [
        "cruise_start",
        "native_goal_invocation",
        "none"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex_version",
        "model",
        "reasoning",
        "tool_profile",
        "permission_profile",
        "repo_tree",
        "skill_digest"
      ],
      "properties": {
        "codex_version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "tool_profile": {
          "type": "string"
        },
        "permission_profile": {
          "type": "string"
        },
        "repo_tree": {
          "type": "string"
        },
        "skill_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "const": "absent"
            }
          ]
        }
      }
    },
    "transcript": {
      "$ref": "#/$defs/artifact"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/metric"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "turns"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "elapsed_seconds"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "tokens"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "tool_calls"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "user_questions"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "post_start_interruptions"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      ]
    },
    "rubric_scores": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/rubric_score"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "criterion": {
                "const": "fit_scope_endpoint"
              }
            },
            "required": [
              "criterion"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "criterion": {
                "const": "repository_evidence"
              }
            },
            "required": [
              "criterion"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "criterion": {
                "const": "upfront_clarification"
              }
            },
            "required": [
              "criterion"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "criterion": {
                "const": "decomposition_ownership"
              }
            },
            "required": [
              "criterion"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "criterion": {
                "const": "staged_execution"
              }
            },
            "required": [
              "criterion"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "criterion": {
                "const": "verification_evidence"
              }
            },
            "required": [
              "criterion"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "criterion": {
                "const": "permissions_activation"
              }
            },
            "required": [
              "criterion"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "criterion": {
                "const": "interaction_efficiency"
              }
            },
            "required": [
              "criterion"
            ]
          }
        }
      ]
    },
    "treatment_conformance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "description": "Use an empty array for the native control."
    },
    "blocking_failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "total_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "grader_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "arm_key_custody": {
      "type": "string",
      "minLength": 1
    },
    "adjudication": {
      "type": [
        "object",
        "null"
      ]
    },
    "arm_key_reference": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reference only; never store the concealed key in a blind run record."
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "severity",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "advisory"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "not_run"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "unit",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "status": {
          "enum": [
            "measured",
            "estimated",
            "unavailable"
          ]
        }
      }
    },
    "rubric_score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "score",
        "max",
        "weight",
        "evidence"
      ],
      "properties": {
        "criterion": {
          "enum": [
            "fit_scope_endpoint",
            "repository_evidence",
            "upfront_clarification",
            "decomposition_ownership",
            "staged_execution",
            "verification_evidence",
            "permissions_activation",
            "interaction_efficiency"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "max": {
          "const": 4
        },
        "weight": {
          "enum": [
            5,
            10,
            15,
            20
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "criterion": {
                "const": "fit_scope_endpoint"
              }
            }
          },
          "then": {
            "properties": {
              "weight": {
                "const": 10
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "criterion": {
                "const": "repository_evidence"
              }
            }
          },
          "then": {
            "properties": {
              "weight": {
                "const": 10
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "criterion": {
                "const": "upfront_clarification"
              }
            }
          },
          "then": {
            "properties": {
              "weight": {
                "const": 10
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "criterion": {
                "const": "decomposition_ownership"
              }
            }
          },
          "then": {
            "properties": {
              "weight": {
                "const": 15
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "criterion": {
                "const": "staged_execution"
              }
            }
          },
          "then": {
            "properties": {
              "weight": {
                "const": 20
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "criterion": {
                "const": "verification_evidence"
              }
            }
          },
          "then": {
            "properties": {
              "weight": {
                "const": 15
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "criterion": {
                "const": "permissions_activation"
              }
            }
          },
          "then": {
            "properties": {
              "weight": {
                "const": 15
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "criterion": {
                "const": "interaction_efficiency"
              }
            }
          },
          "then": {
            "properties": {
              "weight": {
                "const": 5
              }
            }
          }
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence",
        "remediated"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "remediated": {
          "type": "boolean"
        }
      }
    }
  }
}
