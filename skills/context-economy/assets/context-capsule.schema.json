{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cruise context capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "level",
    "objective",
    "non_goals",
    "ownership",
    "evidence",
    "hypotheses",
    "protected_invariants",
    "focused_verification",
    "stop_conditions",
    "visible_output_cap_bytes",
    "handoff_cap_bytes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "non_goals": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "forbidden_paths"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "forbidden_paths": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact",
          "source"
        ],
        "properties": {
          "fact": {
            "type": "string",
            "maxLength": 1000
          },
          "source": {
            "type": "string",
            "maxLength": 500
          },
          "range_or_symbol": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "evidence_for",
          "evidence_against",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 20
          },
          "claim": {
            "type": "string",
            "maxLength": 1000
          },
          "evidence_for": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "evidence_against": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high",
              "verified"
            ]
          }
        }
      }
    },
    "protected_invariants": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "expected_change": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "focused_verification": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "read_more_conditions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "escalation_conditions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "visible_output_cap_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65536
    },
    "handoff_cap_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 16384
    }
  }
}
