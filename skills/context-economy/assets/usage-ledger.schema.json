{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cruise usage and quota ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "account_hash",
    "reset_epoch",
    "baseline",
    "high_watermarks",
    "reservations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "account_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reset_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used_percent",
        "window_duration_mins",
        "resets_at"
      ],
      "properties": {
        "used_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "window_duration_mins": {
          "type": "integer",
          "minimum": 1
        },
        "resets_at": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "high_watermarks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_tokens",
          "cached_input_tokens",
          "output_tokens",
          "reasoning_output_tokens",
          "total_tokens"
        ],
        "properties": {
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "cached_input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "reasoning_output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pid",
          "goal_id",
          "reserved_percent",
          "created_at",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          },
          "goal_id": {
            "type": "string",
            "minLength": 1
          },
          "reserved_percent": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "active",
              "released",
              "consumed",
              "stale"
            ]
          }
        }
      }
    }
  }
}
